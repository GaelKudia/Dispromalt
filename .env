# Ce fichier contient UNIQUEMENT des valeurs par défaut non-sensibles.
# Les vraies valeurs viennent des variables d'environnement en production
# (Coolify, Docker) et de .env.local en développement local.

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change_me_in_production
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> trusted proxies (requis par framework.yaml) ###
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto,x-forwarded-host,x-forwarded-port
###< trusted proxies ###

###> WebPush ###
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT="mailto:admin@example.com"
###< WebPush ###

                                                        <span class="tag tag-success"><i class="fas fa-arrow-down"></i>Entrée</span>
                                                    {% else %}
                                                        <span class="tag tag-danger"><i class="fas fa-arrow-up"></i>Sortie</span>
                                                    {% endif %}
                                                </td>
                                                <td class="cell-strong">
                                                    {{ m.montant|number_format(2, ',', ' ') }}
                                                    <span class="cell-muted">{{ m.devise }}</span>
                                                </td>
                                                <td>{{ m.provenance }}</td>
                                                <td><span class="tag tag-neutral">{{ m.categorie ?: '—' }}</span></td>
                                                <td class="cell-muted">
                                                    {% if m.effectuePar %}
                                                        {{ m.effectuePar.userIdentifier|split('@')|first }}
                                                    {% else %}
                                                        —
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% else %}
                                            <tr>
                                                <td colspan="6">
                                                    <div class="empty-pro">
                                                        <i class="fas fa-vault"></i>
                                                        <div class="title">Aucun mouvement enregistré</div>
                                                        <div class="sub">Commencez par ajouter une entrée de fonds</div>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                {# ═══ ONGLET 2 : WORKFLOW DEVIS ═══ #}
                <div class="tab-pane fade" id="devis-pane" role="tabpanel">
                    <div class="section-heading">
                        <div>
                            <h5><i class="fas fa-receipt"></i>Circuit d'approbation</h5>
                            <small>Suivi des devis et validations hiérarchiques</small>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <div class="total-panel">
                                <div class="label">Total USD</div>
                                <div class="amount">{{ totalDevisUSD|default(0)|number_format(2, ',', ' ') }}<small>USD</small></div>
                            </div>
                            <div class="total-panel alt">
                                <div class="label">Total CDF</div>
                                <div class="amount">{{ totalDevisCDF|default(0)|number_format(0, ',', ' ') }}<small>FC</small></div>
                            </div>
                        </div>
                    </div>

                    <form method="GET" action="{{ path('app_dashboard') }}" class="row g-2 align-items-end mb-4 p-3" style="background:linear-gradient(180deg,var(--ink-50),#fff);border:1px solid var(--ink-200);border-radius:14px;">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-secondary mb-1">Du</label>
                            <input type="date" name="date_debut" class="form-pro w-100" value="{{ date_debut }}">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-secondary mb-1">Au</label>
                            <input type="date" name="date_fin" class="form-pro w-100" value="{{ date_fin }}">
                        </div>
                        <div class="col-md-4 d-flex gap-2">
                            <button type="submit" class="btn-pro btn-pro-primary flex-grow-1 justify-content-center">
                                <i class="fas fa-filter"></i>Filtrer
                            </button>
                            <a href="{{ path('app_dashboard') }}" class="btn-pro btn-pro-ghost">
                                <i class="fas fa-rotate"></i>
                            </a>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-pro">
                            <thead>
                                <tr>
                                    <th>Émetteur</th>
                                    <th>Détail</th>
                                    <th>Montant</th>
                                    <th>Date</th>
                                    <th>Étape</th>
                                    <th class="text-end" style="min-width: 220px;">Décision</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for devis in devisListe %}
                                    <tr>
                                        <td class="cell-strong">{{ devis.createdBy }}</td>
                                        <td>
                                            {% if devis.entete is defined and devis.entete %}
                                                <div class="cell-strong">{{ devis.entete }}</div>
                                            {% endif %}
                                            <span class="cell-muted">{{ devis.description|nl2br }}</span>
                                        </td>
                                        <td class="cell-strong">
                                            {% if devis.devise == 'CDF' %}
                                                {{ devis.montant|number_format(0, ',', ' ') }} <span class="text-muted small">FC</span>
                                            {% else %}
                                                {{ devis.montant|number_format(2, ',', ' ') }} <span class="text-muted small">$</span>
                                            {% endif %}
                                        </td>
                                        <td class="cell-muted">{{ devis.createdAt|date('d/m/Y') }}</td>
                                        <td>
                                            {% if devis.statut == 'ATTENTE_COMPTA' %}
                                                <span class="tag tag-accent"><i class="fas fa-hand-pointer"></i>À aiguiller</span>
                                            {% elseif devis.statut == 'ATTENTE_CHEF_COMPTABLE' %}
                                                <span class="tag tag-neutral"><i class="fas fa-user-shield"></i>Chef compta</span>
                                            {% elseif devis.statut == 'ATTENTE_DIR' %}
                                                <span class="tag tag-accent"><i class="fas fa-gavel"></i>Direction</span>
                                            {% elseif devis.statut == 'ATTENTE_DECAISSEMENT' %}
                                                <span class="tag tag-neutral"><i class="fas fa-hand-holding-usd"></i>À décaisser</span>
                                            {% elseif devis.statut == 'ATTENTE_CAISSE' %}
                                                <span class="tag tag-accent"><i class="fas fa-money-check-alt"></i>Caisse</span>
                                            {% elseif devis.statut == 'DECAISSE' %}
                                                <span class="tag tag-success"><i class="fas fa-check-double"></i>Décaissé</span>
                                            {% elseif devis.statut == 'REJETE' %}
                                                <span class="tag tag-danger"><i class="fas fa-ban"></i>Rejeté</span>
                                            {% else %}
                                                <span class="tag tag-neutral">{{ devis.statut }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-end">
                                            {% if devis.statut == 'ATTENTE_COMPTA' and is_granted('ROLE_COMPTA') %}
                                                <div class="decision-dropdown">
                                                    <button type="button" class="decision-btn" onclick="toggleDecisionMenu({{ devis.id }}, event)">
                                                        <i class="fas fa-gavel"></i> Décider
                                                        <i class="fas fa-chevron-down caret"></i>
                                                    </button>

                                                    <div class="decision-menu" id="decisionMenu{{ devis.id }}">
                                                        <form method="POST" action="{{ path('app_devis_aiguiller', {'id': devis.id}) }}">
                                                            <input type="hidden" name="choix_procedure" value="circuit_complet">
                                                            <button type="submit" class="decision-item">
                                                                <div class="icon-wrap icon-blue"><i class="fas fa-route"></i></div>
                                                                <div class="item-text">
                                                                    <strong>Circuit complet</strong>
                                                                    <small>Chef Compta → Direction → Compta</small>
                                                                </div>
                                                            </button>
                                                        </form>

                                                        <form method="POST" action="{{ path('app_devis_aiguiller', {'id': devis.id}) }}">
                                                            <input type="hidden" name="choix_procedure" value="bon_caisse">
                                                            <button type="submit" class="decision-item">
                                                                <div class="icon-wrap icon-purple"><i class="fas fa-money-check-alt"></i></div>
                                                                <div class="item-text">
                                                                    <strong>Bon de caisse</strong>
                                                                    <small>Transmettre au caissier</small>
                                                                </div>
                                                            </button>
                                                        </form>

                                                        <form method="POST" action="{{ path('app_devis_aiguiller', {'id': devis.id}) }}"
                                                              onsubmit="return confirm('⚠️ Confirmer le décaissement direct ?\n\nVérification du solde en cours...');">
                                                            <input type="hidden" name="choix_procedure" value="decaisser_direct">
                                                            <button type="submit" class="decision-item">
                                                                <div class="icon-wrap icon-green"><i class="fas fa-hand-holding-usd"></i></div>
                                                                <div class="item-text">
                                                                    <strong>Décaissement direct</strong>
                                                                    <small>Payer immédiatement (vérif. solde)</small>
                                                                </div>
                                                            </button>
                                                        </form>

                                                        <div class="decision-sep"></div>

                                                        <button type="button" class="decision-item is-danger"
                                                                onclick="ouvrirModalRejet({{ devis.id }}, '{{ devis.createdBy|e('js') }}', '{{ devis.montant|number_format(2, ',', ' ') }}', '{{ devis.devise }}', '{{ devis.description|slice(0, 60)|e('js') }}')">
                                                            <div class="icon-wrap icon-red"><i class="fas fa-ban"></i></div>
                                                            <div class="item-text">
                                                                <strong>Rejeter le devis</strong>
                                                                <small>Avec motif obligatoire</small>
                                                            </div>
                                                        </button>
                                                    </div>
                                                </div>

                                            {% elseif devis.statut == 'ATTENTE_CHEF_COMPTABLE' and is_granted('ROLE_COMPTA') %}
                                                <form method="POST" action="{{ path('app_devis_valider_chef', {'id': devis.id}) }}" class="d-inline"
                                                      onsubmit="return confirm('Viser ce devis et l\'envoyer à la Direction ?');">
                                                    <button type="submit" class="btn-pro btn-pro-primary btn-pro-sm">
                                                        <i class="fas fa-forward"></i>Transmettre au Dir.
                                                    </button>
                                                </form>

                                            {% elseif devis.statut == 'ATTENTE_DIR' and is_granted('ROLE_DG') %}
                                                <form method="POST" action="{{ path('app_devis_valider_dg', {'id': devis.id}) }}" class="d-flex gap-2 justify-content-end">
                                                    <input type="number" step="0.01" name="nouveau_montant" class="form-pro"
                                                           style="max-width:100px;" value="{{ devis.montant }}" required>
                                                    <button type="submit" class="btn-pro btn-pro-primary btn-pro-sm">
                                                        <i class="fas fa-check"></i>Fixer
                                                    </button>
                                                </form>

                                            {% elseif devis.statut == 'ATTENTE_DECAISSEMENT' and is_granted('ROLE_COMPTA') %}
                                                <form method="POST" action="{{ path('app_devis_compta_decaisser', {'id': devis.id}) }}" class="d-inline"
                                                      onsubmit="return confirm('Confirmer le décaissement de ce devis ?');">
                                                    <button type="submit" class="btn-pro btn-pro-success btn-pro-sm">
                                                        <i class="fas fa-hand-holding-usd"></i>Décaisser
                                                    </button>
                                                </form>

                                            {% elseif devis.statut == 'ATTENTE_CAISSE' %}
                                                <span class="tag tag-neutral">
                                                    <i class="fas fa-hourglass-half"></i>En attente Caisse
                                                </span>

                                            {% elseif devis.statut == 'DECAISSE' %}
                                                <span class="tag tag-success">
                                                    <i class="fas fa-check-double"></i>Décaissé
                                                    {% if devis.decaissePar %}
                                                        <span style="font-size:0.7rem; opacity:0.7; margin-left:4px;">par {{ devis.decaissePar.userIdentifier|split('@')|first }}</span>
                                                    {% endif %}
                                                </span>

                                            {% elseif devis.statut == 'REJETE' %}
                                                <span class="tag tag-danger">
                                                    <i class="fas fa-ban"></i>Rejeté
                                                </span>

                                            {% else %}
                                                <span class="cell-muted">—</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="6">
                                            <div class="empty-pro">
                                                <i class="fas fa-file-invoice-dollar"></i>
                                                <div class="title">Aucun devis sur cette période</div>
                                                <div class="sub">Modifiez les filtres pour élargir la recherche</div>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {# ═══ ONGLET 3 : INVENTAIRE ═══ #}
                <div class="tab-pane fade" id="inventaire-pane" role="tabpanel">
                    <div class="section-heading">
                        <div>
                            <h5><i class="fas fa-warehouse"></i>État du stock</h5>
                            <small>Inventaire temps réel des articles</small>
                        </div>
                        <div class="d-flex gap-2 no-print">
                            <button onclick="window.print()" class="btn-pro btn-pro-ghost btn-pro-sm">
                                <i class="fas fa-print"></i>Imprimer
                            </button>
                            <button onclick="exportToExcel()" class="btn-pro btn-pro-ghost btn-pro-sm">
                                <i class="fas fa-file-excel"></i>Exporter
                            </button>
                        </div>
                    </div>

                    <form method="GET" class="mb-3 d-flex flex-wrap gap-2">
                        <select name="category" class="form-pro form-select" style="max-width:220px;" onchange="this.form.submit()">
                            <option value="">Toutes les catégories</option>
                            {% for cat in categories %}
                                <option value="{{ cat.id }}" {% if app.request.get('category') == cat.id %}selected{% endif %}>{{ cat.nom }}</option>
                            {% endfor %}
                        </select>
                        {% if subCategories is not empty %}
                            <select name="subCategory" class="form-pro form-select" style="max-width:220px;" onchange="this.form.submit()">
                                <option value="">Toutes sous-catégories</option>
                                {% for subCat in subCategories %}
                                    <option value="{{ subCat.id }}" {% if app.request.get('subCategory') == subCat.id %}selected{% endif %}>{{ subCat.nom }}</option>
                                {% endfor %}
                            </select>
                        {% endif %}
                    </form>

                    {% set activeSubCatName = selectedSubCategory ? selectedSubCategory.nom|lower : '' %}
                    <div class="table-responsive">
                        <table class="table table-pro">
                            <thead>
                                <tr>
                                    <th>Article</th>
                                    <th>Couleur</th>
                                    {% if 'encre' in activeSubCatName or 'solvant' in activeSubCatName %}
                                        <th>Litrage</th><th>Grammage</th><th>Machine</th>
                                    {% elseif 'media' in activeSubCatName or 'bache' in activeSubCatName %}
                                        <th>Laize</th><th>Longueur</th><th>Grammage</th>
                                    {% else %}
                                        <th>Grammage</th><th>Longueur</th><th>Dims.</th><th>Machine</th>
                                    {% endif %}
                                    <th class="text-center">Qté</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for attr in attributs %}
                                <tr>
                                    <td class="cell-strong">{{ attr.article.nom }}</td>
                                    <td>{% if attr.couleur %}<span class="tag tag-neutral">{{ attr.couleur }}</span>{% else %}<span class="cell-muted">—</span>{% endif %}</td>
                                    {% if 'encre' in activeSubCatName or 'solvant' in activeSubCatName %}
                                        <td>{{ attr.longueur ?: '—' }}</td>
                                        <td>{{ attr.grammage ?: '—' }}</td>
                                        <td>{{ attr.article.machine ? attr.article.machine.nom : '—' }}</td>
                                    {% elseif 'media' in activeSubCatName or 'bache' in activeSubCatName %}
                                        <td>{{ attr.dimension ?: '—' }}</td>
                                        <td>{{ attr.longueur ?: '—' }}</td>
                                        <td>{{ attr.grammage ?: '—' }}</td>
                                    {% else %}
                                        <td>{{ attr.grammage ?: '—' }}</td>
                                        <td>{{ attr.longueur ?: '—' }}</td>
                                        <td>{{ attr.dimension ?: '—' }}</td>
                                        <td>{{ attr.article.machine ? attr.article.machine.nom : '—' }}</td>
                                    {% endif %}
                                    <td class="text-center cell-strong">{{ attr.article.quantite }}</td>
                                    <td>
                                        {% if attr.article.quantite <= attr.article.seuilAlerte %}
                                            <span class="tag tag-danger"><span class="dot" style="background:var(--danger);"></span>Bas</span>
                                        {% else %}
                                            <span class="tag tag-success"><span class="dot" style="background:var(--success);"></span>Correct</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="10">
                                        <div class="empty-pro">
                                            <i class="fas fa-box-open"></i>
                                            <div class="title">Aucun article trouvé</div>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>

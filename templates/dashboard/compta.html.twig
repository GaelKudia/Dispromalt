                                    <div class="col-md-3">
                                        {{ form_label(formEntree.devise, 'Devise', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                        {{ form_widget(formEntree.devise, {'attr': {'class': 'form-pro form-select w-100'}}) }}
                                        {{ form_errors(formEntree.devise) }}
                                    </div>
                                    <div class="col-md-6">
                                        {{ form_label(formEntree.provenance, 'Libellé / Provenance', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                        {{ form_widget(formEntree.provenance, {'attr': {'class': 'form-pro w-100'}}) }}
                                        {{ form_errors(formEntree.provenance) }}
                                    </div>
                                    <div class="col-md-4">
                                        {{ form_label(formEntree.reference, 'Référence', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                        {{ form_widget(formEntree.reference, {'attr': {'class': 'form-pro w-100'}}) }}
                                        {{ form_errors(formEntree.reference) }}
                                    </div>
                                    <div class="col-md-4">
                                        {{ form_label(formEntree.categorie, 'Catégorie', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                        {{ form_widget(formEntree.categorie, {'attr': {'class': 'form-pro form-select w-100'}}) }}
                                        {{ form_errors(formEntree.categorie) }}
                                    </div>
                                    <div class="col-md-4">
                                        {{ form_label(formEntree.dateMouvement, 'Date', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                        {{ form_widget(formEntree.dateMouvement, {'attr': {'class': 'form-pro w-100'}}) }}
                                        {{ form_errors(formEntree.dateMouvement) }}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Espace Comptabilité - Gestion & Visites</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        .card-counter { border: none; border-radius: 10px; transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); }
        .card-counter:hover { transform: translateY(-4px); box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important; }
        .nav-tabs .nav-link.active { border-bottom: 3px solid #198754 !important; font-weight: bold; color: #198754 !important; }
        .nav-tabs .nav-link { color: #6c757d; transition: all 0.2s; }
        .nav-tabs .nav-link:hover { background-color: rgba(25, 135, 84, 0.04); color: #198754; }
        
        tr.fade-in-row {
            opacity: 0;
            transform: translateY(8px);
            animation: fadeInRow 0.35s ease forwards;
        }
        @keyframes fadeInRow {
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-light text-dark">

    {# Barre de navigation #}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-3">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold fs-4" href="#">
                Dispro<span class="text-primary">malt</span> <span class="fw-light fs-5 text-muted">| Espace Opérationnel</span>
            </a>
            <div class="d-flex align-items-center">
                <div class="bg-secondary bg-opacity-20 text-white px-3 py-1.5 rounded-pill me-3 small border border-secondary">
                    <i class="fas fa-wallet text-success me-2"></i>Rôle actif : <strong>{{ userRole }}</strong>
                </div>
                <a href="/logout" class="btn btn-primary btn-sm fw-bold px-3">
                    <i class="fas fa-sign-out-alt me-1"></i> Déconnexion
                </a>
            </div>
        </div>
    </nav>

    <div class="container-fluid py-4 px-4">
        
        <div class="mb-4 pb-3 border-bottom">
            <h1 class="fw-bold text-dark">Espace Financier & Logistique</h1>
            <p class="text-muted m-0">Accordez les budgets pour les livraisons, planifiez les visites et suivez l'analyse des consommables.</p>
        </div>

        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'danger' ? 'danger' : 'success' }} alert-dismissible fade show shadow-sm mb-4" role="alert" style="transition: opacity 0.5s ease;">
                    <i class="fas {{ label == 'danger' ? 'fa-exclamation-circle' : 'fa-check-circle' }} me-2"></i> {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {# Ligne de compteurs épurée #}
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="card card-counter bg-white p-4 shadow-sm border-start border-warning border-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase small fw-bold">Demandes logistiques en attente d'engagement</h6>
                            <h3 class="fw-bold m-0 text-warning">{{ stats.demandes_attente }} demandes</h3>
                        </div>
                        <i class="fas fa-file-invoice-dollar fa-2x text-warning bg-warning bg-opacity-10 p-3 rounded-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        {# Système d'onglets pour organiser les nouvelles fonctionnalités #}
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white p-2 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                <ul class="nav nav-tabs card-header-tabs m-0 border-bottom-0" id="comptaTab" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active py-3 px-4 fw-bold border-0" id="budget-tab" data-bs-toggle="tab" data-bs-target="#budget-pane" type="button" role="tab">
                            <i class="fas fa-coins me-2 text-success"></i>Engagements & Livraisons
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-3 px-4 fw-bold border-0" id="visite-tab" data-bs-toggle="tab" data-bs-target="#visite-pane" type="button" role="tab">
                            <i class="fas fa-calendar-plus me-2 text-primary"></i>Réserver une Visite
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-3 px-4 fw-bold border-0" id="devis-tab" data-bs-toggle="tab" data-bs-target="#devis-pane" type="button" role="tab">
                            <i class="fas fa-file-invoice-dollar me-2 text-warning"></i>Workflow Financier (Devis)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-3 px-4 fw-bold border-0" id="stats-tab" data-bs-toggle="tab" data-bs-target="#stats-pane" type="button" role="tab">
                            <i class="fas fa-chart-line me-2 text-danger"></i>Matériels les plus demandés
                        </button>
                    </li>
                </ul>

                <div class="d-flex gap-2 me-2">
                    <a href="{{ path('app_rapport_pdf', {'date_debut': date_debut, 'date_fin': date_fin}) }}" class="btn btn-danger btn-sm fw-bold">
                        <i class="fas fa-file-pdf me-1"></i> Exporter PDF
                    </a>
                    <a href="{{ path('app_rapport_excel', {'date_debut': date_debut, 'date_fin': date_fin}) }}" class="btn btn-success btn-sm fw-bold">
                        <i class="fas fa-file-excel me-1"></i> Exporter Excel
                    </a>
                </div>
            </div>
            
            <div class="card-body p-4">
                <div class="tab-content">
                    
                    {# 1️⃣ ONGLET : VALIDATION BUDGETAIRE #}
                    <div class="tab-pane fade show active" id="budget-pane" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle m-0">
                                <thead class="table-light small text-uppercase fw-bold text-secondary">
                                    <tr>
                                        <th>Code Demande</th>
                                        <th>Service Demandeur</th>
                                        <th>Consommable / Matériel</th>
                                        <th class="text-center">Quantité</th>
                                        <th class="text-center">Statut du Flux</th>
                                        <th class="text-center">Validation Compta</th>
                                    </tr>
                                </thead>
                                <tbody class="small">
                                    {% for d in demandes %}
                                        <tr>
                                            <td class="fw-bold">#DEM-{{ d.id }}</td>
                                            <td>
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1">
                                                    {{ d.departement }}
                                                </span>
                                            </td>
                                            <td class="fw-semibold text-dark">{{ d.materiel }}</td>
                                            <td class="text-center fw-bold text-secondary">{{ d.quantite|default('1') }}</td>
                                            <td class="text-center">
                                                {% if d.statut == 'En attente' %}
                                                    <span class="badge bg-warning text-dark px-2.5 py-1.5"><i class="fas fa-clock me-1"></i> En attente</span>
                                                {% elseif d.statut == 'Validé Compta' %}
                                                    <span class="badge bg-primary text-white px-2.5 py-1.5"><i class="fas fa-thumbs-up me-1"></i> Accordé</span>
                                                {% elseif d.statut == 'Livré par le Stock' %}
                                                    <span class="badge bg-info text-white px-2.5 py-1.5"><i class="fas fa-truck me-1"></i> Livré (Attente confirmation)</span>
                                                {% elseif d.statut == 'Reçu / Clôturé' %}
                                                    <span class="badge bg-success text-white px-2.5 py-1.5"><i class="fas fa-check-double me-1"></i> Reçu / Confirmé</span>
                                                {% else %}
                                                    <span class="badge bg-light text-dark border px-2.5 py-1.5">{{ d.statut }}</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                {% if d.statut == 'En attente' %}
                                                    <form action="{{ path('app_demande_compta_valider', {'id': d.id}) }}" method="POST" class="d-inline">
                                                        <button class="btn btn-sm btn-success fw-bold px-3">
                                                            <i class="fas fa-dollar-sign me-1"></i> Accorder 
                                                        </button>
                                                    </form>
                                                {% elseif d.statut == 'Validé Compta' %}
                                                    <span class="text-success fw-bold small"><i class="fas fa-check me-1"></i> Validé</span>
                                                {% else %}
                                                    <span class="text-muted small"><i class="fas fa-lock me-1"></i> Traité</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted">Aucun flux logistique en cours.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    {# 2️⃣ ONGLET : RESERVATION DE VISITE #}
                    <div class="tab-pane fade" id="visite-pane" role="tabpanel">
                        <div class="d-flex justify-content-center align-items-center py-2">
                            <div class="card border p-4 shadow-sm bg-white" style="width: 100%; max-width: 550px; border-radius: 12px;">
                                <div class="text-center mb-4">
                                    <i class="fas fa-id-card text-primary fa-2x mb-2"></i>
                                    <h5 class="fw-bold text-dark m-0">Enregistrer un Visiteur / Partenaire</h5>
                                    <small class="text-muted">Planification d'accès pour les auditeurs, clients ou prestataires</small>
                                </div>
                                
                                {% if formVisite is not null %}
                                    {{ form_start(formVisite) }}
                                        <div class="mb-3">
                                            {{ form_widget(formVisite) }}
                                        </div>
                                        <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                                            <i class="fas fa-calendar-check me-2"></i>Confirmer la réservation
                                        </button>
                                    {{ form_end(formVisite) }}
                                {% else %}
                                    <div class="alert alert-danger text-center m-0">
                                        <i class="fas fa-exclamation-triangle me-2"></i>Le formulaire de visite n'est pas chargé.
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                        {# 3️⃣ ONGLET : CIRCUIT DE VALIDATION DES DEVIS (MIS À JOUR) #}
                        <div class="tab-pane fade" id="devis-pane" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                                <div>
                                    <h5 class="fw-bold text-dark m-0"><i class="fas fa-receipt text-warning me-2"></i>Circuit d'Approbation Hiérarchique</h5>
                                    <small class="text-muted">Interface unique partagée selon les autorisations spécifiques de vos rôles</small>
                                </div>
                                <div class="d-flex gap-2">
                                <span class="badge bg-success text-white fw-bold fs-6 py-2 px-3 rounded-pill">
                                    <i class="fas fa-dollar-sign me-1"></i> Total décaissé : {{ totalDevisUSD|number_format(2, ',', ' ') }} USD
                                </span>
                                <span class="badge bg-primary text-white fw-bold fs-6 py-2 px-3 rounded-pill">
                                    <i class="fas fa-money-bill-wave me-1"></i> Total décaissé : {{ totalDevisCDF|number_format(0, ',', ' ') }} FC
                                </span>
                            </div>
                            </div>
                            
                            {# Barre de filtrage temporelle #}
                            <div class="card bg-light border-0 p-3 mb-4 shadow-sm rounded-3">
                                <form method="GET" action="{{ path('app_dashboard') }}" class="row g-3 align-items-end">
                                    <div class="col-md-4 col-sm-6">
                                        <label class="form-label small fw-bold text-secondary"><i class="fas fa-calendar-alt me-1"></i> Date de début</label>
                                        <input type="date" name="date_debut" class="form-control form-control-sm" value="{{ date_debut }}">
                                    </div>
                                    <div class="col-md-4 col-sm-6">
                                        <label class="form-label small fw-bold text-secondary"><i class="fas fa-calendar-alt me-1"></i> Date de fin</label>
                                        <input type="date" name="date_fin" class="form-control form-control-sm" value="{{ date_fin }}">
                                    </div>
                                    <div class="col-md-4 col-12 d-flex gap-2">
                                        <button type="submit" class="btn btn-sm btn-primary fw-bold flex-grow-1">
                                            <i class="fas fa-filter me-1"></i> Filtrer la période
                                        </button>
                                        <a href="{{ path('app_dashboard') }}" class="btn btn-sm btn-outline-secondary fw-bold">
                                            <i class="fas fa-sync-alt"></i>
                                        </a>
                                    </div>
                                </form>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover align-middle m-0">
                                    <thead class="table-light small text-uppercase fw-bold text-secondary">
                                        <tr>
                                            <th>Émetteur</th>
                                            <th>Libellé / Détail</th>
                                            <th>Montant Actuel</th>
                                            <th>Date de dépôt</th>
                                            <th class="text-center">Niveau de validation</th>
                                            <th class="text-center">Action Requise</th>
                                        </tr>
                                    </thead>
                                    <tbody class="small">
                                        {% for devis in devisListe %}
                                            <tr>
                                                <td><span class="fw-bold text-secondary"><i class="fas fa-user-circle me-1"></i> {{ devis.createdBy }}</span></td>
                                                <td style="max-width: 280px;" class="text-wrap">
                                                    {% if devis.entete is defined and devis.entete %}
                                                        <strong class="text-dark d-block mb-1">{{ devis.entete }}</strong>
                                                    {% endif %}
                                                    <span class="text-muted small">{{ devis.description|nl2br }}</span>
                                                </td>
                                                <td class="fw-bold text-dark">
                                                    {% if devis.devise == 'CDF' %}
                                                        {{ devis.montant|number_format(0, ',', ' ') }} <span class="text-primary fw-bold small">FC</span>
                                                    {% else %}
                                                        {{ devis.montant|number_format(2, ',', ' ') }} <span class="text-success fw-bold">$</span>
                                                    {% endif %}
                                                    {% if devis.montantInitial is defined and devis.montantInitial and devis.montantInitial != devis.montant %}
                                                        <br><small class="text-decoration-line-through text-muted fw-normal" style="font-size: 0.75rem;">Initial: {{ devis.montantInitial }} {{ devis.devise }}</small>
                                                    {% endif %}
                                                </td>
                                                <td><small class="text-muted">{{ devis.createdAt|date('d/m/Y H:i') }}</small></td>
    <td class="text-center">
        {# ... tes conditions de statut ... #}
        {% if devis.statut == 'ATTENTE_CHEF_COMPTA' %}
            <span class="badge bg-warning text-dark px-2.5 py-1.5 border border-warning border-opacity-50"><i class="fas fa-user-shield me-1"></i> Visé par Chef Compta</span>
        {% elseif devis.statut == 'ATTENTE_DIR' %}
            <span class="badge bg-info text-white px-2.5 py-1.5 border border-info border-opacity-50"><i class="fas fa-gavel me-1"></i> Attente Direction</span>
        {% elseif devis.statut == 'ATTENTE_CAISSE' %}
            <span class="badge bg-primary text-white px-2.5 py-1.5 border border-primary border-opacity-50"><i class="fas fa-money-check-alt me-1"></i> Prêt au décaissement</span>
        {% elseif devis.statut == 'DECAISSE' %}
            <span class="badge bg-success text-white px-2.5 py-1.5"><i class="fas fa-check-double me-1"></i> Archivé / Décaissé</span>
        {% elseif devis.statut == 'ATTENTE_TRAITEMENT' %}
            <span class="badge bg-secondary text-white px-2.5 py-1.5"><i class="fas fa-hand-pointer me-1"></i> En attente d'orientation</span>
        {% else %}
            <span class="badge bg-light text-dark border">{{ devis.statut }}</span>
        {% endif %}
    </td>
    <td class="text-center" style="min-width: 200px;">
        
        {# 0️⃣ NOUVELLE LOGIQUE : AIGUILLAGE DU COMPTABLE #}
        {% if devis.statut == 'ATTENTE_TRAITEMENT' and is_granted('ROLE_COMPTA') %}
            <form method="POST" action="{{ path('app_devis_aiguiller', {'id': devis.id}) }}" class="p-2 border rounded bg-light shadow-sm">
                <select name="choix_procédure" class="form-select form-select-sm mb-2" required>
                    <option value="" disabled selected>Choisir le flux...</option>
                    <option value="circuit_complet">1. Circuit complet (Visas)</option>
                    <option value="bon_caisse">2. Bon de demande (Caisse)</option>
                    <option value="decaisser_direct">3. Décaissement direct</option>
                </select>
                <button type="submit" class="btn btn-sm btn-primary w-100 fw-bold">
                    <i class="fas fa-play-circle me-1"></i> Démarrer
                </button>
            </form>

        {# 1️⃣ SÉCURITÉ CHEF COMPTABLE #}
        {% elseif devis.statut == 'ATTENTE_CHEF_COMPTA' %}
            {# ... reste de ton code ... #}
                                                        {% if is_granted('ROLE_CHEF_COMPTA') %}
                                                            <form method="POST" action="{{ path('app_devis_valider_chef', {'id': devis.id}) }}" onsubmit="return confirm('Viser ce devis et l\'envoyer à la Direction ?');" class="d-inline">
                                                                <button class="btn btn-xs btn-warning fw-bold px-2.5 py-1 shadow-sm text-dark btn-sm">
                                                                    <i class="fas fa-forward me-1"></i> Transmettre au Dir.
                                                                </button>
                                                            </form>
                                                        {% else %}
                                                            <span class="text-muted small italic"><i class="fas fa-hourglass-start me-1"></i> Attente Visa Supérieur</span>
                                                        {% endif %}

                                                    {# 2️⃣ SÉCURITÉ DIRECTEUR (Ajustement + Validation intégrés) #}
                                                    {% elseif devis.statut == 'ATTENTE_DIR' %}
                                                        {% if is_granted('ROLE_DIRECTEUR') %}
                                                            <form method="POST" action="{{ path('app_devis_valider_directeur', {'id': devis.id}) }}" class="p-1 border rounded bg-white shadow-sm">
                                                                <div class="input-group input-group-sm">
                                                                    <input type="number" step="0.01" name="nouveau_montant" class="form-control fw-bold text-primary" value="{{ devis.montant }}" required style="max-width: 90px;" placeholder="Montant">
                                                                    <span class="input-group-text bg-light small fw-bold px-1" style="font-size: 0.75rem;">{{ devis.devise }}</span>
                                                                    <button type="submit" class="btn btn-primary btn-sm fw-bold px-2" title="Ajuster et Valider définitivement">
                                                                        <i class="fas fa-check"></i> Fixer
                                                                    </button>
                                                                </div>
                                                            </form>
                                                        {% else %}
                                                            <span class="text-muted small"><i class="fas fa-user-clock me-1"></i> Arbitrage Direction</span>
                                                        {% endif %}

                                                    {# 3️⃣ TOUT COMPTABLE PEUT DÉCAISSER #}
                                            {# 3️⃣ SECTION CAISSE #}
 {% elseif devis.statut == 'ATTENTE_CAISSE' %}
                                                    {# N'importe qui connecté ici possède au moins ROLE_COMPTA #}
                                                    <form method="POST" action="{{ path('app_devis_decaisser', {'id': devis.id}) }}" onsubmit="return confirm('Confirmez-vous la sortie physique des fonds de la caisse ?');" class="d-inline">
                                                        <button class="btn btn-sm btn-success fw-bold px-3 shadow-sm">
                                                            <i class="fas fa-cash-register me-1"></i> Sortir les Fonds
                                                        </button>
                                                    </form>

                                                {# 4️⃣ ARCHIVAGE #}
                                                {% else %}
                                                    <span class="text-success small fw-bold"><i class="fas fa-lock me-1"></i> Fonds décaissés</span>
                                                {% endif %}

                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">Aucun devis enregistré pour cette période.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                            </div>
                        </div>

                    {# 4️⃣ ONGLET : ANALYSE DE LA CONSOMMATION #}
                    <div class="tab-pane fade" id="stats-pane" role="tabpanel">
                        <h5 class="fw-bold text-dark mb-3"><i class="fas fa-chart-pie text-danger me-2"></i>Analyse de la Consommation</h5>
                        <p class="text-muted">Classement des articles les plus sollicités par l'ensemble des départements de l'imprimerie.</p>
                        
                        <div class="row g-4 mt-1">
                            <div class="col-md-6">
                                <div class="table-responsive border rounded bg-white">
                                    <table class="table table-hover align-middle m-0">
                                        <thead class="table-light small fw-bold">
                                            <tr>
                                                <th>Rang</th>
                                                <th>Désignation du Matériel</th>
                                                <th class="text-center">Occurrences de demandes</th>
                                            </tr>
                                        </thead>
                                        <tbody class="small">
                                            {% set counts = {} %}
                                            {% for d in demandes %}
                                                {% set counts = counts|merge({ (d.materiel): (counts[d.materiel]|default(0) + 1) }) %}
                                            {% endfor %}
                                            
                                            {% set rank = 1 %}
                                            {% for mat, count in counts|sort|reverse %}
                                                {% if rank <= 5 %}
                                                <tr>
                                                    <td class="fw-bold text-muted">#{{ rank }}</td>
                                                    <td class="fw-semibold text-dark"><i class="fas fa-box text-secondary me-2"></i>{{ mat }}</td>
                                                    <td class="text-center"><span class="badge bg-danger bg-opacity-10 text-danger fw-bold px-3 py-1.5 fs-6 rounded-pill">{{ count }}</span></td>
                                                </tr>
                                                {% endif %}
                                                {% set rank = rank + 1 %}
                                            {% else %}
                                                <tr>
                                                    <td colspan="3" class="text-center py-4 text-muted">Données insuffisantes pour établir des statistiques.</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="card p-4 bg-white border h-100 d-flex flex-column justify-content-center align-items-center text-center">
                                    <i class="fas fa-info-circle text-info fa-2x mb-3"></i>
                                    <h6 class="fw-bold text-dark">Indicateur de flux direct</h6>
                                    <p class="text-muted small px-3">Ces calculs dynamiques permettent au service comptable de prévoir les futures lignes budgétaires à accorder en priorité pour éviter les ruptures critiques de stock au dépôt.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    {% verbatim %}
        document.addEventListener("DOMContentLoaded", function() {
            
            // 1. Animation du compteur numérique
            //const counterElement = document.querySelector('.js-counter');
            if (counterElement) {
                const targetValue = parseInt(counterElement.getAttribute('data-target')) || 0;
                let currentValue = 0;
                const duration = 1000;
                const stepTime = Math.max(Math.floor(duration / (targetValue || 1)), 20);
                
                if(targetValue > 0) {
                    const timer = setInterval(() => {
                        currentValue += Math.ceil(targetValue / 30);
                        if (currentValue >= targetValue) {
                            currentValue = targetValue;
                            clearInterval(timer);
                        }
                        counterElement.textContent = currentValue + (targetValue > 1 ? " demandes" : " demande");
                    }, stepTime);
                }
            }

            // 2. Cascade d'apparition des lignes de tableau
            function animateTableRows(paneId) {
                const rows = document.querySelectorAll(`${paneId} table tbody tr`);
                rows.forEach((row, index) => {
                    row.classList.remove('fade-in-row');
                    void row.offsetWidth; 
                    row.classList.add('fade-in-row');
                    row.style.animationDelay = `${index * 0.04}s`;
                });
            }
            
            animateTableRows('#budget-pane');

            const tabButtons = document.querySelectorAll('#comptaTab button');
            tabButtons.forEach(button => {
                button.addEventListener('shown.bs.tab', function(e) {
                    const targetPane = e.target.getAttribute('data-bs-target');
                    animateTableRows(targetPane);
                });
            });

            // 3. Persistance de l'onglet actif après filtrage
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('date_debut') || urlParams.has('date_fin')) {
                const devisTab = document.querySelector('#devis-tab');
                if (devisTab) {
                    bootstrap.Tab.getOrCreateInstance(devisTab).show();
                }
            }

            // 4. Auto-dismiss des alertes flash
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(alert => {
                setTimeout(() => {
                    alert.style.opacity = '0';
                    setTimeout(() => {
                        alert.remove();
                    }, 500);
                }, 5000);
            });
        });
    {% endverbatim %}
</script>
</body>
</html>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Espace Comptabilité - Gestion & Visites</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        :root {
            --primary-color: #0d6efd;
            --success-color: #198754;
            --warning-color: #ffc107;
            --danger-color: #dc3545;
            --gray-bg: #f8f9fa;
        }
        body {
            background-color: #f0f2f5;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }
        .navbar-brand span.text-primary { color: var(--primary-color) !important; }
        .card-counter {
            border: none;
            border-radius: 16px;
            transition: all 0.25s ease;
        }
        .card-counter:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(0,0,0,0.08) !important;
        }
        .nav-tabs .nav-link {
            color: #6c757d;
            border: none;
            padding: 0.75rem 1.25rem;
            font-weight: 600;
            transition: all 0.2s;
            border-radius: 10px 10px 0 0;
        }
        .nav-tabs .nav-link:hover {
            background-color: rgba(13, 110, 253, 0.04);
            color: var(--primary-color);
        }
        .nav-tabs .nav-link.active {
            color: var(--primary-color) !important;
            background: white;
            border-bottom: 3px solid var(--primary-color);
            font-weight: 700;
        }
        .nav-tabs .nav-link i { margin-right: 8px; }
        .tab-pane {
            padding-top: 1.5rem;
        }
        .table-modern thead th {
            background: var(--gray-bg);
            border-bottom: 2px solid #dee2e6;
            font-weight: 700;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #495057;
            padding: 1rem 0.75rem;
        }
        .table-modern tbody td {
            vertical-align: middle;
            padding: 0.85rem 0.75rem;
            font-size: 0.9rem;
        }
        .table-modern tbody tr {
            transition: background 0.15s ease;
        }
        .table-modern tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.03);
        }
        .badge-statut {
            font-weight: 600;
            padding: 0.4rem 0.9rem;
            border-radius: 50px;
            font-size: 0.75rem;
        }
        .badge-statut i { margin-right: 5px; }
        .badge-warning { background: #fff3cd; color: #856404; }
        .badge-success { background: #d1e7dd; color: #0f5132; }
        .badge-primary { background: #cfe2ff; color: #084298; }
        .badge-info { background: #cff4fc; color: #055160; }
        .badge-danger { background: #f8d7da; color: #842029; }
        .filter-card {
            background: white;
            border-radius: 16px;
            padding: 1.25rem 1.5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
            border: 1px solid #e9ecef;
            margin-bottom: 1.5rem;
        }
        .filter-card .form-label {
            font-weight: 600;
            font-size: 0.8rem;
            color: #6c757d;
        }
        .filter-card .form-control,
        .filter-card .form-select {
            border-radius: 10px;
            border: 1px solid #dee2e6;
            padding: 0.5rem 0.75rem;
            font-size: 0.9rem;
        }
        .filter-card .btn {
            border-radius: 50px;
            padding: 0.45rem 1.5rem;
            font-weight: 600;
        }
        .btn-soft-primary {
            background: #e7f1ff;
            color: var(--primary-color);
            border: 1px solid #cfe2ff;
        }
        .btn-soft-primary:hover {
            background: #cfe2ff;
            color: #0a58ca;
        }
        .card-visite {
            border: none;
            border-radius: 20px;
            background: white;
            box-shadow: 0 8px 24px rgba(0,0,0,0.06);
        }
        .total-card {
            border-radius: 16px;
            padding: 1rem 1.5rem;
            background: #212529;
            color: white;
        }
        .total-card .amount {
            font-size: 1.8rem;
            font-weight: 700;
            color: #ffd43b;
        }
        .total-card .label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            opacity: 0.7;
        }
        .fade-in-row {
            animation: fadeIn 0.4s ease forwards;
            opacity: 0;
        }
        @keyframes fadeIn {
            to { opacity: 1; }
        }
        .stat-card {
            border-radius: 16px;
            border: 1px solid #e9ecef;
            padding: 1.25rem;
            background: white;
            transition: all 0.2s;
            height: 100%;
        }
        .stat-card:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        }
        .stat-card .stat-number {
            font-size: 2.2rem;
            font-weight: 700;
            color: #212529;
        }
        .stat-card .stat-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6c757d;
        }
        @media (max-width: 768px) {
            .nav-tabs .nav-link { padding: 0.5rem 0.75rem; font-size: 0.85rem; }
            .total-card .amount { font-size: 1.4rem; }
            .filter-card .row > div { margin-bottom: 0.5rem; }
        }
    </style>
</head>
<body>

    {# ============================================
        NAVBAR
    ============================================ #}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-3">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold fs-4" href="#">
                Dispro<span class="text-primary">malt</span> <span class="fw-light fs-5 text-muted">| Espace Opérationnel</span>
            </a>
            <div class="d-flex align-items-center">
                <div class="bg-secondary bg-opacity-20 text-white px-3 py-1.5 rounded-pill me-3 small border border-secondary">
                    <i class="fas fa-wallet text-success me-2"></i>Rôle actif : <strong>{{ userRole }}</strong>
                </div>
                <a href="/logout" class="btn btn-primary btn-sm fw-bold px-3">
                    <i class="fas fa-sign-out-alt me-1"></i> Déconnexion
                </a>
            </div>
        </div>
    </nav>

    {# ============================================
        MAIN CONTAINER
    ============================================ #}
    <div class="container-fluid py-4 px-4">

        {# En-tête #}
        <div class="mb-4 pb-3 border-bottom">
            <h1 class="fw-bold text-dark"><i class="fas fa-coins text-success me-2"></i>Espace Financier & Logistique</h1>
            <p class="text-muted m-0">Accordez les budgets pour les livraisons, planifiez les visites et suivez l'analyse des consommables.</p>
        </div>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'danger' ? 'danger' : 'success' }} alert-dismissible fade show shadow-sm mb-4 border-0 rounded-4" role="alert">
                    <i class="fas {{ label == 'danger' ? 'fa-exclamation-triangle' : 'fa-check-circle' }} me-2"></i> {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {# Carte récapitulative des demandes en attente #}
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="card card-counter bg-white p-4 shadow-sm border-start border-warning border-5">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase small fw-bold mb-1">Demandes logistiques en attente d'engagement</h6>
                            <h3 class="fw-bold m-0 text-warning">{{ stats.demandes_attente }} demandes</h3>
                        </div>
                        <i class="fas fa-file-invoice-dollar fa-2x text-warning bg-warning bg-opacity-10 p-3 rounded-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        {# ============================================
            ONGLETS
        ============================================ #}
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white p-0 border-bottom">
                <ul class="nav nav-tabs card-header-tabs m-0 px-3 pt-2 border-bottom-0" id="comptaTab" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" id="budget-tab" data-bs-toggle="tab" data-bs-target="#budget-pane" type="button" role="tab">
                            <i class="fas fa-coins text-success"></i>Engagements & Livraisons
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="visite-tab" data-bs-toggle="tab" data-bs-target="#visite-pane" type="button" role="tab">
                            <i class="fas fa-calendar-plus text-primary"></i>Réserver une Visite
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="devis-tab" data-bs-toggle="tab" data-bs-target="#devis-pane" type="button" role="tab">
                            <i class="fas fa-file-invoice-dollar text-warning"></i>Workflow Financier (Devis)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="inventaire-tab" data-bs-toggle="tab" data-bs-target="#inventaire-pane" type="button" role="tab">
                            <i class="fas fa-warehouse text-success"></i>État du Stock
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="stats-tab" data-bs-toggle="tab" data-bs-target="#stats-pane" type="button" role="tab">
                            <i class="fas fa-chart-line text-danger"></i>Matériels les plus demandés
                        </button>
                    </li>
                    <li class="nav-item ms-auto d-flex align-items-center gap-2 me-2">
                        <a href="{{ path('app_rapport_pdf', {'date_debut': date_debut, 'date_fin': date_fin}) }}" class="btn btn-danger btn-sm fw-bold rounded-pill px-3">
                            <i class="fas fa-file-pdf me-1"></i> PDF
                        </a>
                        <a href="{{ path('app_rapport_excel', {'date_debut': date_debut, 'date_fin': date_fin}) }}" class="btn btn-success btn-sm fw-bold rounded-pill px-3">
                            <i class="fas fa-file-excel me-1"></i> Excel
                        </a>
                    </li>
                </ul>
            </div>

            <div class="card-body p-4">
                <div class="tab-content">

                    {# ==========================================
                       ONGLET 1 : BUDGET
                    ========================================== #}
                    <div class="tab-pane fade show active" id="budget-pane" role="tabpanel">
                        <div class="table-responsive">
                            <table class="table table-modern align-middle">
                                <thead>
                                    <tr>
                                        <th>Code Demande</th>
                                        <th>Service Demandeur</th>
                                        <th>Consommable / Matériel</th>
                                        <th class="text-center">Quantité</th>
                                        <th class="text-center">Statut du Flux</th>
                                        <th class="text-center">Validation Compta</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for d in demandes %}
                                        <tr class="fade-in-row" style="animation-delay: {{ loop.index * 0.05 }}s;">
                                            <td class="fw-bold">#DEM-{{ d.id }}</td>
                                            <td>
                                                <span class="badge bg-light text-dark border px-3 py-2">{{ d.departement }}</span>
                                            </td>
                                            <td class="fw-semibold text-dark">{{ d.materiel }}</td>
                                            <td class="text-center fw-bold">{{ d.quantite|default('1') }}</td>
                                            <td class="text-center">
                                                {% if d.statut == 'En attente' %}
                                                    <span class="badge badge-statut badge-warning"><i class="fas fa-clock"></i> En attente</span>
                                                {% elseif d.statut == 'Validé Compta' %}
                                                    <span class="badge badge-statut badge-primary"><i class="fas fa-thumbs-up"></i> Accordé</span>
                                                {% elseif d.statut == 'Livré par le Stock' %}
                                                    <span class="badge badge-statut badge-info"><i class="fas fa-truck"></i> Livré</span>
                                                {% elseif d.statut == 'Reçu / Clôturé' %}
                                                    <span class="badge badge-statut badge-success"><i class="fas fa-check-double"></i> Reçu / Confirmé</span>
                                                {% else %}
                                                    <span class="badge bg-light text-dark border">{{ d.statut }}</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-center">
                                                {% if d.statut == 'En attente' %}
                                                    <form action="{{ path('app_demande_compta_valider', {'id': d.id}) }}" method="POST" class="d-inline">
                                                        <button class="btn btn-sm btn-success fw-bold rounded-pill px-3">
                                                            <i class="fas fa-dollar-sign me-1"></i> Accorder
                                                        </button>
                                                    </form>
                                                {% elseif d.statut == 'Validé Compta' %}
                                                    <span class="text-success fw-bold"><i class="fas fa-check-circle me-1"></i> Validé</span>
                                                {% else %}
                                                    <span class="text-muted"><i class="fas fa-lock me-1"></i> Traité</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="6" class="text-center py-5 text-muted">Aucun flux logistique en cours.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    {# ==========================================
                       ONGLET 2 : RÉSERVER UNE VISITE
                    ========================================== #}
                    <div class="tab-pane fade" id="visite-pane" role="tabpanel">
                        <div class="row justify-content-center">
                            <div class="col-lg-8 col-xl-7">
                                <div class="card border-0 shadow-sm rounded-4 p-4">
                                    <div class="text-center mb-4">
                                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-2">
                                            <i class="fas fa-id-card text-primary fa-2x"></i>
                                        </div>
                                        <h5 class="fw-bold text-dark">Enregistrer un Visiteur / Partenaire</h5>
                                        <p class="text-muted small">Planification d’accès pour les auditeurs, clients ou prestataires</p>
                                    </div>
                                    {% if formVisite is not null %}
                                        {{ form_start(formVisite, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    {{ form_label(formVisite.nomVisiteur, 'Nom & Prénom', {'label_attr': {'class': 'form-label fw-semibold small'}}) }}
                                                    {{ form_widget(formVisite.nomVisiteur, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Jean Dupont'}}) }}
                                                    {{ form_errors(formVisite.nomVisiteur) }}
                                                </div>
                                                <div class="col-md-6">
                                                    {{ form_label(formVisite.departement, 'Département visité', {'label_attr': {'class': 'form-label fw-semibold small'}}) }}
                                                    {{ form_widget(formVisite.departement, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Production'}}) }}
                                                    {{ form_errors(formVisite.departement) }}
                                                </div>
                                                <div class="col-12">
                                                    {{ form_label(formVisite.motif, 'Motif de la visite', {'label_attr': {'class': 'form-label fw-semibold small'}}) }}
                                                    {{ form_widget(formVisite.motif, {'attr': {'class': 'form-control', 'rows': 2, 'placeholder': 'Raison de la visite'}}) }}
                                                    {{ form_errors(formVisite.motif) }}
                                                </div>
                                                {% if formVisite.telephone is defined %}
                                                    <div class="col-md-6">
                                                        {{ form_label(formVisite.telephone, 'Téléphone', {'label_attr': {'class': 'form-label fw-semibold small'}}) }}
                                                        {{ form_widget(formVisite.telephone, {'attr': {'class': 'form-control', 'placeholder': 'Numéro de téléphone'}}) }}
                                                        {{ form_errors(formVisite.telephone) }}
                                                    </div>
                                                {% endif %}
                                                {% if formVisite.email is defined %}
                                                    <div class="col-md-6">
                                                        {{ form_label(formVisite.email, 'Email', {'label_attr': {'class': 'form-label fw-semibold small'}}) }}
                                                        {{ form_widget(formVisite.email, {'attr': {'class': 'form-control', 'placeholder': 'email@exemple.com'}}) }}
                                                        {{ form_errors(formVisite.email) }}
                                                    </div>
                                                {% endif %}
                                                {% if formVisite.pieceIdentite is defined %}
                                                    <div class="col-12">
                                                        {{ form_label(formVisite.pieceIdentite, 'Pièce d’identité', {'label_attr': {'class': 'form-label fw-semibold small'}}) }}
                                                        {{ form_widget(formVisite.pieceIdentite, {'attr': {'class': 'form-control', 'placeholder': 'CIN, Passeport, etc.'}}) }}
                                                        {{ form_errors(formVisite.pieceIdentite) }}
                                                    </div>
                                                {% endif %}
                                            </div>
                                            <div class="d-grid gap-2 mt-4">
                                                <button type="submit" class="btn btn-primary fw-bold py-2 rounded-pill shadow-sm">
                                                    <i class="fas fa-calendar-check me-2"></i>Confirmer la réservation
                                                </button>
                                            </div>
                                        {{ form_end(formVisite) }}
                                    {% else %}
                                        <div class="alert alert-warning text-center mb-0">
                                            <i class="fas fa-exclamation-triangle me-2"></i>Le formulaire de visite n’est pas disponible.
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>

                    {# ==========================================
                       ONGLET 3 : WORKFLOW DEVIS (COMPLET avec conditions is_granted)
                    ========================================== #}
                    <div class="tab-pane fade" id="devis-pane" role="tabpanel">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                            <div>
                                <h5 class="fw-bold text-dark m-0"><i class="fas fa-receipt text-warning me-2"></i>Circuit d'Approbation Hiérarchique</h5>
                                <small class="text-muted">Interface unique partagée selon les autorisations spécifiques</small>
                            </div>
                            <div class="d-flex gap-2 flex-wrap mt-2 mt-sm-0">
                                <div class="total-card">
                                    <div class="label"><i class="fas fa-dollar-sign me-1"></i>Total décaissé</div>
                                    <div class="amount">{{ totalDevisUSD|number_format(2, ',', ' ') }} USD</div>
                                </div>
                                <div class="total-card" style="background: #0d6efd;">
                                    <div class="label"><i class="fas fa-money-bill-wave me-1"></i>Total décaissé</div>
                                    <div class="amount" style="color: white;">{{ totalDevisCDF|number_format(0, ',', ' ') }} FC</div>
                                </div>
                            </div>
                        </div>

                        {# Filtres temporels #}
                        <div class="filter-card">
                            <form method="GET" action="{{ path('app_dashboard') }}" class="row g-3 align-items-end">
                                <div class="col-md-3 col-sm-6">
                                    <label class="form-label"><i class="fas fa-calendar-alt me-1"></i>Date début</label>
                                    <input type="date" name="date_debut" class="form-control" value="{{ date_debut }}">
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <label class="form-label"><i class="fas fa-calendar-alt me-1"></i>Date fin</label>
                                    <input type="date" name="date_fin" class="form-control" value="{{ date_fin }}">
                                </div>
                                <div class="col-md-6 d-flex gap-2">
                                    <button type="submit" class="btn btn-primary flex-grow-1">
                                        <i class="fas fa-filter me-1"></i> Filtrer
                                    </button>
                                    <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary">
                                        <i class="fas fa-sync-alt"></i>
                                    </a>
                                </div>
                            </form>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-modern align-middle">
                                <thead>
                                    <tr>
                                        <th>Émetteur</th>
                                        <th>Libellé / Détail</th>
                                        <th>Montant Actuel</th>
                                        <th>Date dépôt</th>
                                        <th class="text-center">Niveau validation</th>
                                        <th class="text-center">Action Requise</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for devis in devisListe %}
                                        <tr class="fade-in-row" style="animation-delay: {{ loop.index * 0.05 }}s;">
                                            <td><span class="fw-bold text-secondary"><i class="fas fa-user-circle me-1"></i> {{ devis.createdBy }}</span></td>
                                            <td>
                                                {% if devis.entete is defined and devis.entete %}
                                                    <strong class="text-dark d-block">{{ devis.entete }}</strong>
                                                {% endif %}
                                                <span class="text-muted small">{{ devis.description|nl2br }}</span>
                                            </td>
                                            <td class="fw-bold">
                                                {% if devis.devise == 'CDF' %}
                                                    {{ devis.montant|number_format(0, ',', ' ') }} <span class="text-primary small">FC</span>
                                                {% else %}
                                                    {{ devis.montant|number_format(2, ',', ' ') }} <span class="text-success">$</span>
                                                {% endif %}
                                                {% if devis.montantInitial is defined and devis.montantInitial and devis.montantInitial != devis.montant %}
                                                    <br><small class="text-decoration-line-through text-muted" style="font-size:0.7rem;">Initial: {{ devis.montantInitial }} {{ devis.devise }}</small>
                                                {% endif %}
                                            </td>
                                            <td><small class="text-muted">{{ devis.createdAt|date('d/m/Y H:i') }}</small></td>
                                            <td class="text-center">
                                                {# === AFFICHAGE DES BADGES DE STATUT === #}
                                                {% if devis.statut == 'ATTENTE_CHEF_COMPTA' %}
                                                    <span class="badge badge-statut badge-warning"><i class="fas fa-user-shield"></i> Visé Chef Compta</span>
                                                {% elseif devis.statut == 'ATTENTE_DIR' %}
                                                    <span class="badge badge-statut badge-info"><i class="fas fa-gavel"></i> Attente Direction</span>
                                                {% elseif devis.statut == 'ATTENTE_CAISSE' %}
                                                    <span class="badge badge-statut badge-primary"><i class="fas fa-money-check-alt"></i> Prêt décaissement</span>
                                                {% elseif devis.statut == 'DECAISSE' %}
                                                    <span class="badge badge-statut badge-success"><i class="fas fa-check-double"></i> Décaissé</span>
                                                {% elseif devis.statut == 'ATTENTE_TRAITEMENT' %}
                                                    <span class="badge badge-statut bg-secondary text-white"><i class="fas fa-hand-pointer"></i> En attente</span>
                                                {% else %}
                                                    <span class="badge bg-light text-dark border">{{ devis.statut }}</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-center" style="min-width: 200px;">
                                                {# === 0️⃣ AIGUILLAGE PAR LE COMPTABLE === #}
                                                {% if devis.statut == 'ATTENTE_TRAITEMENT' and is_granted('ROLE_COMPTA') %}
                                                    <form method="POST" action="{{ path('app_devis_aiguiller', {'id': devis.id}) }}" class="p-2 border rounded bg-light shadow-sm">
                                                        <select name="choix_procédure" class="form-select form-select-sm mb-2" required>
                                                            <option value="" disabled selected>Choisir le flux...</option>
                                                            <option value="circuit_complet">1. Circuit complet (Visas)</option>
                                                            <option value="bon_caisse">2. Bon de demande (Caisse)</option>
                                                            <option value="decaisser_direct">3. Décaissement direct</option>
                                                        </select>
                                                        <button type="submit" class="btn btn-sm btn-primary w-100 fw-bold">
                                                            <i class="fas fa-play-circle me-1"></i> Démarrer
                                                        </button>
                                                    </form>

                                                {# === 1️⃣ VISA CHEF COMPTABLE === #}
                                                {% elseif devis.statut == 'ATTENTE_CHEF_COMPTA' %}
                                                    {% if is_granted('ROLE_CHEF_COMPTA') %}
                                                        <form method="POST" action="{{ path('app_devis_valider_chef', {'id': devis.id}) }}" onsubmit="return confirm('Viser ce devis et l\'envoyer à la Direction ?');" class="d-inline">
                                                            <button class="btn btn-sm btn-warning fw-bold rounded-pill px-3">
                                                                <i class="fas fa-forward me-1"></i> Transmettre au Dir.
                                                            </button>
                                                        </form>
                                                    {% else %}
                                                        <span class="text-muted small"><i class="fas fa-hourglass-start me-1"></i> Attente Visa</span>
                                                    {% endif %}

                                                {# === 2️⃣ VALIDATION DIRECTEUR === #}
                                                {% elseif devis.statut == 'ATTENTE_DIR' %}
                                                    {% if is_granted('ROLE_DIRECTEUR') %}
                                                        <form method="POST" action="{{ path('app_devis_valider_directeur', {'id': devis.id}) }}" class="p-1 border rounded bg-white">
                                                            <div class="input-group input-group-sm">
                                                                <input type="number" step="0.01" name="nouveau_montant" class="form-control fw-bold text-primary" value="{{ devis.montant }}" required style="max-width: 90px;">
                                                                <span class="input-group-text bg-light small fw-bold">{{ devis.devise }}</span>
                                                                <button type="submit" class="btn btn-primary btn-sm fw-bold px-2">
                                                                    <i class="fas fa-check"></i> Fixer
                                                                </button>
                                                            </div>
                                                        </form>
                                                    {% else %}
                                                        <span class="text-muted small"><i class="fas fa-user-clock me-1"></i> Arbitrage Direction</span>
                                                    {% endif %}

                                                {# === 3️⃣ DÉCAISSEMENT CAISSE === #}
                                                {% elseif devis.statut == 'ATTENTE_CAISSE' %}
                                                    <form method="POST" action="{{ path('app_devis_decaisser', {'id': devis.id}) }}" onsubmit="return confirm('Confirmez-vous la sortie physique des fonds ?');" class="d-inline">
                                                        <button class="btn btn-sm btn-success fw-bold rounded-pill px-3">
                                                            <i class="fas fa-cash-register me-1"></i> Sortir les Fonds
                                                        </button>
                                                    </form>

                                                {# === 4️⃣ ARCHIVAGE === #}
                                                {% else %}
                                                    <span class="text-success small fw-bold"><i class="fas fa-lock me-1"></i> Fonds décaissés</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="6" class="text-center py-5 text-muted">Aucun devis enregistré pour cette période.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    {# ==========================================
                       ONGLET 4 : INVENTAIRE
                    ========================================== #}
                    <div class="tab-pane fade" id="inventaire-pane" role="tabpanel">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold text-secondary m-0"><i class="fas fa-warehouse text-success me-2"></i>État Actuel du Stock</h5>
                            <div>
                                <button class="btn btn-outline-primary btn-sm me-1" onclick="window.print()"><i class="fas fa-print"></i> Imprimer</button>
                                <button class="btn btn-outline-success btn-sm" onclick="exportToExcel()"><i class="fas fa-file-excel"></i> Exporter</button>
                            </div>
                        </div>

                        {# Filtres par catégorie et sous-catégorie #}
                        <form method="GET" class="mb-3 d-flex flex-wrap gap-2">
                            <select name="category" class="form-select w-auto" onchange="this.form.submit()">
                                <option value="">Toutes catégories</option>
                                {% for cat in categories %}
                                    <option value="{{ cat.id }}" {% if app.request.get('category') == cat.id %}selected{% endif %}>{{ cat.nom }}</option>
                                {% endfor %}
                            </select>
                            {% if subCategories is not empty %}
                                <select name="subCategory" class="form-select w-auto" onchange="this.form.submit()">
                                    <option value="">Toutes sous-cat.</option>
                                    {% for subCat in subCategories %}
                                        <option value="{{ subCat.id }}" {% if app.request.get('subCategory') == subCat.id %}selected{% endif %}>{{ subCat.nom }}</option>
                                    {% endfor %}
                                </select>
                            {% endif %}
                        </form>

                        {% set activeSubCatName = selectedSubCategory ? selectedSubCategory.nom|lower : '' %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Article</th><th>Couleur</th>
                                        {% if 'encre' in activeSubCatName or 'solvant' in activeSubCatName %}
                                            <th>Litrage</th><th>Grammage</th><th>Machine</th>
                                        {% elseif 'media' in activeSubCatName or 'bache' in activeSubCatName %}
                                            <th>Laize</th><th>Longueur</th><th>Grammage</th>
                                        {% else %}
                                            <th>Grammage</th><th>Longueur</th><th>Dimensions</th><th>Machine</th>
                                        {% endif %}
                                        <th>Qté</th><th>Statut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for attr in attributs %}
                                    <tr>
                                        <td><strong>{{ attr.article.nom }}</strong></td>
                                        <td>{% if attr.couleur %}<span class="badge bg-secondary">{{ attr.couleur }}</span>{% else %}<span class="text-muted">-</span>{% endif %}</td>
                                        {% if 'encre' in activeSubCatName or 'solvant' in activeSubCatName %}
                                            <td>{{ attr.longueur ?: '-' }}</td>
                                            <td>{{ attr.grammage ?: '-' }}</td>
                                            <td>{{ attr.article.machine ? attr.article.machine.nom : '-' }}</td>
                                        {% elseif 'media' in activeSubCatName or 'bache' in activeSubCatName %}
                                            <td>{{ attr.dimension ?: '-' }}</td>
                                            <td>{{ attr.longueur ?: '-' }}</td>
                                            <td>{{ attr.grammage ?: '-' }}</td>
                                        {% else %}
                                            <td>{{ attr.grammage ?: '-' }}</td>
                                            <td>{{ attr.longueur ?: '-' }}</td>
                                            <td>{{ attr.dimension ?: '-' }}</td>
                                            <td>{{ attr.article.machine ? attr.article.machine.nom : '-' }}</td>
                                        {% endif %}
                                        <td><span class="fw-bold">{{ attr.article.quantite }}</span></td>
                                        <td>{% if attr.article.quantite <= attr.article.seuilAlerte %}<span class="badge bg-warning text-dark">Stock Bas</span>{% else %}<span class="badge bg-success">Correct</span>{% endif %}</td>
                                    </tr>
                                    {% else %}
                                    <tr><td colspan="10" class="text-center text-muted py-4">Aucun article trouvé.</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        {# Formulaire d'ajout de stock – réservé au rôle STOCK #}
                        {% if formStock is defined and formStock is not null %}
                            <div class="mt-4 p-4 border rounded-4 bg-light">
                                <h6 class="fw-bold text-secondary"><i class="fas fa-plus-circle me-2"></i>Ajouter un nouvel article</h6>
                                {{ form_start(formStock) }}
                                    {{ form_widget(formStock) }}
                                    <div class="text-center mb-3">
                                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2" id="show-attributs-btn">
                                            <i class="fas fa-cog me-2"></i> Ajouter des caractéristiques techniques
                                        </button>
                                        <small class="d-block text-muted mt-1">(Optionnel - pour les articles avec des spécificités)</small>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 rounded-pill shadow-sm mt-2">
                                        <i class="fas fa-save me-2"></i> Enregistrer dans le stock
                                    </button>
                                {{ form_end(formStock) }}
                            </div>
                        {% endif %}
                    </div>

                    {# ==========================================
                       ONGLET 5 : STATISTIQUES (TOP MATÉRIELS)
                    ========================================== #}
                    <div class="tab-pane fade" id="stats-pane" role="tabpanel">
                        <h5 class="fw-bold text-dark mb-3"><i class="fas fa-chart-pie text-danger me-2"></i>Analyse de la Consommation</h5>
                        <p class="text-muted mb-4">Classement des articles les plus sollicités par l'ensemble des départements de l'imprimerie.</p>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                                    <div class="table-responsive">
                                        <table class="table table-modern align-middle m-0">
                                            <thead>
                                                <tr>
                                                    <th>Rang</th>
                                                    <th>Désignation du Matériel</th>
                                                    <th class="text-center">Occurrences</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {% set counts = {} %}
                                                {% for d in demandes %}
                                                    {% set counts = counts|merge({ (d.materiel): (counts[d.materiel]|default(0) + 1) }) %}
                                                {% endfor %}
                                                {% set rank = 1 %}
                                                {% for mat, count in counts|sort|reverse %}
                                                    {% if rank <= 5 %}
                                                        <tr>
                                                            <td class="fw-bold text-muted">#{{ rank }}</td>
                                                            <td class="fw-semibold"><i class="fas fa-box text-secondary me-2"></i>{{ mat }}</td>
                                                            <td class="text-center"><span class="badge bg-danger bg-opacity-10 text-danger fw-bold px-3 py-2 rounded-pill">{{ count }}</span></td>
                                                        </tr>
                                                    {% endif %}
                                                    {% set rank = rank + 1 %}
                                                {% else %}
                                                    <tr>
                                                        <td colspan="3" class="text-center py-5 text-muted">Données insuffisantes pour établir des statistiques.</td>
                                                    </tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card h-100 p-4 bg-white border shadow-sm rounded-4 d-flex flex-column justify-content-center align-items-center text-center">
                                    <i class="fas fa-info-circle text-primary fa-3x mb-3"></i>
                                    <h6 class="fw-bold">Indicateur de flux direct</h6>
                                    <p class="text-muted small px-3">Ces calculs dynamiques permettent au service comptable de prévoir les futures lignes budgétaires à accorder en priorité pour éviter les ruptures critiques de stock au dépôt.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div> {# fin tab-content #}
            </div> {# fin card-body #}
        </div> {# fin card #}

    </div> {# fin container #}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Auto‑dismiss des alertes flash
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(alert => {
                setTimeout(() => {
                    alert.style.opacity = '0';
                    setTimeout(() => alert.remove(), 500);
                }, 5000);
            });

            // Persistance de l'onglet devis après filtrage
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('date_debut') || urlParams.has('date_fin')) {
                const devisTab = document.querySelector('#devis-tab');
                if (devisTab) {
                    bootstrap.Tab.getOrCreateInstance(devisTab).show();
                }
            }

            // Bouton pour afficher les caractéristiques techniques (optionnel)
            const btn = document.getElementById('show-attributs-btn');
            if (btn) {
                btn.addEventListener('click', function() {
                    const attributsRow = document.querySelector('.attributs-row');
                    if (attributsRow) {
                        attributsRow.style.display = attributsRow.style.display === 'none' ? 'block' : 'none';
                    }
                });
            }
        });
    </script>
</body>
</html>
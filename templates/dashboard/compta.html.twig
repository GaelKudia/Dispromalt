<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Espace Comptabilité — Dispromalt</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        :root {
            /* Neutres profonds */
            --ink-950: #0a0f1c;
            --ink-900: #0f172a;
            --ink-800: #1e293b;
            --ink-700: #334155;
            --ink-600: #475569;
            --ink-500: #64748b;
            --ink-400: #94a3b8;
            --ink-300: #cbd5e1;
            --ink-200: #e2e8f0;
            --ink-100: #f1f5f9;
            --ink-50:  #f8fafc;

            /* Indigo raffiné */
            --primary: #4f46e5;
            --primary-dark: #4338ca;
            --primary-darker: #3730a3;
            --primary-light: #818cf8;
            --primary-soft: rgba(79, 70, 229, 0.10);
            --primary-softer: rgba(79, 70, 229, 0.05);

            /* Sémantiques */
            --success: #059669;
            --success-soft: rgba(5, 150, 105, 0.10);

            --warning: #d97706;
            --warning-soft: rgba(217, 119, 6, 0.10);

            --danger: #dc2626;
            --danger-soft: rgba(220, 38, 38, 0.10);

            --bg-main: #f4f6fb;

            --radius: 16px;
            --radius-sm: 10px;
            --radius-lg: 22px;

            --shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.04);
            --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
            --shadow-md: 0 4px 12px -2px rgba(15, 23, 42, 0.08), 0 2px 6px -2px rgba(15, 23, 42, 0.04);
            --shadow-lg: 0 20px 40px -12px rgba(15, 23, 42, 0.14), 0 8px 16px -8px rgba(15, 23, 42, 0.06);
            --shadow-glow: 0 0 0 4px rgba(79, 70, 229, 0.10);
        }

        * { transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
        html, body { overflow-x: hidden; }

        body {
            background: var(--bg-main);
            background-image:
                radial-gradient(at 8% 0%, rgba(99, 102, 241, 0.06) 0px, transparent 45%),
                radial-gradient(at 92% 5%, rgba(139, 92, 246, 0.05) 0px, transparent 40%),
                radial-gradient(at 50% 100%, rgba(59, 130, 246, 0.04) 0px, transparent 50%);
            background-attachment: fixed;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            color: var(--ink-700);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            min-height: 100vh;
            width: 100%;
            max-width: 100%;
            margin: 0;
            padding: 0;
            letter-spacing: -0.01em;
        }

        .full-container {
            width: 100% !important;
            max-width: 100% !important;
            padding-left: clamp(1rem, 2.5vw, 3rem);
            padding-right: clamp(1rem, 2.5vw, 3rem);
            margin: 0 auto;
        }

        /* ═══════════════════════════════════════════════════════
           NAVBAR — dégradé profond, glass, accents
        ═══════════════════════════════════════════════════════ */
        .navbar-pro {
            background: linear-gradient(135deg, #0a0f1c 0%, #141b32 45%, #1e1b4b 100%);
            padding: 0.9rem 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04), 0 8px 24px -12px rgba(0, 0, 0, 0.4);
            position: relative;
            z-index: 100;
            width: 100%;
            backdrop-filter: blur(12px);
        }
        .navbar-pro::after {
            content: '';
            position: absolute;
            bottom: -1px; left: 0; right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(129, 140, 248, 0.5), transparent);
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 1.2rem;
            letter-spacing: -0.5px;
        }
        .brand-text-primary { color: #fff; }
        .brand-text-accent {
            color: #a5b4fc;
            font-weight: 800;
            background: linear-gradient(135deg, #a5b4fc, #c7d2fe);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .brand-role-badge {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.25), rgba(139, 92, 246, 0.20));
            border: 1px solid rgba(129, 140, 248, 0.35);
            color: #c7d2fe;
            padding: 3px 10px;
            border-radius: 6px;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .btn-ghost-light {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.10);
            color: #cbd5e1;
            padding: 0.5rem 1rem;
            border-radius: 9px;
            font-size: 0.82rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-ghost-light:hover {
            background: rgba(255, 255, 255, 0.12);
            color: #fff;
            border-color: rgba(255, 255, 255, 0.22);
            transform: translateY(-1px);
        }

        .notif-btn {
            width: 40px; height: 40px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.10);
            color: #cbd5e1;
            position: relative;
        }
        .notif-btn:hover {
            background: rgba(255, 255, 255, 0.12);
            color: #fff;
            transform: translateY(-1px);
        }
        .notif-btn .badge-dot {
            position: absolute;
            top: -5px; right: -5px;
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: #fff;
            font-size: 0.65rem;
            font-weight: 700;
            padding: 0.15rem 0.45rem;
            border-radius: 20px;
            border: 2px solid #0a0f1c;
            min-width: 20px;
            box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.20);
        }

        .nav-pill {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.10);
            color: #cbd5e1;
            padding: 0.5rem 1rem;
            border-radius: 9px;
            font-size: 0.82rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .nav-pill .role-indicator {
            width: 8px; height: 8px;
            border-radius: 50%;
            background: #10b981;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.20);
        }

        .btn-logout {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.10);
            color: #cbd5e1;
            padding: 0.5rem 0.85rem;
            border-radius: 9px;
            font-size: 0.82rem;
            width: 40px; height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .btn-logout:hover {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            border-color: transparent;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px -4px rgba(220, 38, 38, 0.5);
        }

        /* ═══════════════════════════════════════════════════════
           PAGE HEADER
        ═══════════════════════════════════════════════════════ */
        .page-header {
            padding: 2.25rem 0 1.75rem;
        }
        .page-header h1 {
            font-size: clamp(1.6rem, 2.4vw, 2.1rem);
            font-weight: 800;
            letter-spacing: -0.7px;
            margin: 0 0 0.5rem;
            color: var(--ink-900);
            background: linear-gradient(135deg, #0f172a 0%, #3730a3 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .page-header p {
            color: var(--ink-500);
            font-size: 0.95rem;
            margin: 0;
            font-weight: 400;
            max-width: 640px;
        }
        .page-header-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: linear-gradient(135deg, rgba(79, 70, 229, 0.12), rgba(139, 92, 246, 0.10));
            color: var(--primary-dark);
            padding: 5px 14px;
            border-radius: 50px;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 0.85rem;
            border: 1px solid rgba(99, 102, 241, 0.20);
        }

        /* ═══════════════════════════════════════════════════════
           STAT TILES — icônes en pastille + accent coloré
        ═══════════════════════════════════════════════════════ */
        .stat-tile {
            background: #fff;
            border: 1px solid var(--ink-200);
            border-radius: var(--radius-lg);
            padding: 1.4rem 1.45rem;
            position: relative;
            overflow: hidden;
            height: 100%;
            box-shadow: var(--shadow-sm);
        }
        .stat-tile:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-lg);
            border-color: var(--primary-light);
        }
        .stat-tile::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--ink-300), var(--ink-200));
        }
        .stat-tile.is-warning::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
        .stat-tile.is-accent::before  { background: linear-gradient(90deg, #6366f1, #8b5cf6); }
        .stat-tile.is-success::before { background: linear-gradient(90deg, #10b981, #34d399); }
        .stat-tile.is-danger::before  { background: linear-gradient(90deg, #ef4444, #f87171); }

        .stat-tile .stat-icon {
            position: absolute;
            top: 1.2rem; right: 1.2rem;
            width: 44px; height: 44px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            background: var(--ink-100);
            color: var(--ink-500);
            transition: all 0.3s ease;
        }
        .stat-tile:hover .stat-icon {
            transform: scale(1.08) rotate(-4deg);
        }
        .stat-tile.is-warning .stat-icon { background: var(--warning-soft); color: var(--warning); }
        .stat-tile.is-accent  .stat-icon { background: var(--primary-soft); color: var(--primary); }
        .stat-tile.is-success .stat-icon { background: var(--success-soft); color: var(--success); }
        .stat-tile.is-danger  .stat-icon { background: var(--danger-soft);  color: var(--danger); }

        .stat-tile .stat-label {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--ink-500);
            text-transform: uppercase;
            letter-spacing: 0.07em;
            margin-bottom: 0.6rem;
            padding-right: 3.2rem;
        }
        .stat-tile .stat-value {
            font-size: 2.1rem;
            font-weight: 800;
            color: var(--ink-900);
            line-height: 1;
            letter-spacing: -1.2px;
            font-variant-numeric: tabular-nums;
        }
        .stat-tile .stat-hint {
            font-size: 0.78rem;
            color: var(--ink-400);
            margin-top: 0.6rem;
            font-weight: 500;
        }

        /* ═══════════════════════════════════════════════════════
           ALERT BANNER
        ═══════════════════════════════════════════════════════ */
        .alert-banner {
            background: #fff;
            border: 1px solid var(--ink-200);
            border-left: 4px solid transparent;
            border-image: linear-gradient(180deg, #ef4444, #dc2626) 1;
            border-image-slice: 1;
            border-radius: var(--radius-lg);
            overflow: hidden;
            margin-bottom: 1.85rem;
            box-shadow: var(--shadow-md);
        }
        .alert-banner-header {
            padding: 1.2rem 1.5rem;
            border-bottom: 1px solid var(--ink-100);
            background: linear-gradient(180deg, rgba(220, 38, 38, 0.02), transparent);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.75rem;
        }
        .alert-banner-header h6 {
            font-weight: 700;
            font-size: 0.98rem;
            color: var(--ink-900);
            margin: 0;
            letter-spacing: -0.2px;
        }
        .alert-banner-header h6 i {
            color: var(--danger);
            margin-right: 0.5rem;
        }
        .alert-banner-header small { color: var(--ink-500); font-size: 0.82rem; }
        .alert-banner .count-chip {
            background: linear-gradient(135deg, var(--danger), #b91c1c);
            color: #fff;
            padding: 0.4rem 0.95rem;
            border-radius: 50px;
            font-size: 0.76rem;
            font-weight: 700;
            box-shadow: 0 4px 12px -4px rgba(220, 38, 38, 0.5);
        }

        /* ═══════════════════════════════════════════════════════
           CARD PRO
        ═══════════════════════════════════════════════════════ */
        .card-pro {
            background: #fff;
            border: 1px solid var(--ink-200);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            overflow: hidden;
            width: 100%;
        }
        .card-pro-body { padding: 1.6rem clamp(1rem, 2vw, 2rem); }

        /* ═══════════════════════════════════════════════════════
           TABS — style pill raffiné
        ═══════════════════════════════════════════════════════ */
        .tabs-pro {
            border-bottom: 1px solid var(--ink-100);
            padding: 0.75rem 1rem 0;
            gap: 0.25rem;
            flex-wrap: nowrap;
            overflow-x: auto;
            scrollbar-width: none;
            background: linear-gradient(180deg, #fff, var(--ink-50));
        }
        .tabs-pro::-webkit-scrollbar { display: none; }
        .tabs-pro .nav-link {
            border: none !important;
            color: var(--ink-500);
            font-weight: 600;
            font-size: 0.85rem;
            padding: 0.7rem 1.05rem;
            margin-bottom: 0.75rem;
            white-space: nowrap;
            border-radius: 10px;
            position: relative;
            background: transparent;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        .tabs-pro .nav-link:hover {
            color: var(--ink-900);
            background: var(--ink-100);
        }
        .tabs-pro .nav-link.active {
            color: #fff !important;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            font-weight: 700;
            box-shadow: 0 6px 16px -6px rgba(79, 70, 229, 0.5);
        }
        .tabs-pro .nav-link.active::after { display: none; }
        .tabs-pro .nav-link i {
            font-size: 0.9rem;
        }
        .tabs-pro .nav-link.active i {
            color: #fff;
        }

        /* ═══════════════════════════════════════════════════════
           TABLE PRO
        ═══════════════════════════════════════════════════════ */
        .table-pro { margin: 0; font-size: 0.87rem; }
        .table-pro thead th {
            background: var(--ink-50);
            color: var(--ink-500);
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            padding: 0.95rem 1rem;
            border-bottom: 1px solid var(--ink-200);
            border-top: none;
            white-space: nowrap;
        }
        .table-pro tbody td {
            padding: 1rem 1rem;
            vertical-align: middle;
            border-color: var(--ink-100);
            color: var(--ink-700);
        }
        .table-pro tbody tr {
            transition: background 0.15s ease;
        }
        .table-pro tbody tr:hover {
            background: linear-gradient(90deg, var(--primary-softer), transparent);
        }
        .table-pro .cell-strong { font-weight: 600; color: var(--ink-900); }
        .table-pro .cell-muted { color: var(--ink-400); font-size: 0.8rem; }

        /* ═══════════════════════════════════════════════════════
           TAGS
        ═══════════════════════════════════════════════════════ */
        .tag {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.35rem 0.75rem;
            border-radius: 7px;
            font-size: 0.75rem;
            font-weight: 600;
            line-height: 1;
            background: var(--ink-100);
            color: var(--ink-600);
            letter-spacing: -0.1px;
        }
        .tag i { font-size: 0.7rem; }
        .tag .dot { width: 6px; height: 6px; border-radius: 50%; display: inline-block; }
        .tag-success { background: var(--success-soft); color: var(--success); }
        .tag-warn    { background: var(--warning-soft); color: var(--warning); }
        .tag-danger  { background: var(--danger-soft); color: var(--danger); }
        .tag-accent  { background: var(--primary-soft); color: var(--primary-dark); }
        .tag-neutral { background: var(--ink-100); color: var(--ink-500); }

        /* ═══════════════════════════════════════════════════════
           BOUTONS PRO
        ═══════════════════════════════════════════════════════ */
        .btn-pro {
            font-weight: 600;
            font-size: 0.82rem;
            padding: 0.6rem 1.15rem;
            border-radius: 10px;
            border: 1px solid transparent;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            letter-spacing: -0.1px;
        }
        .btn-pro:active { transform: scale(0.98); }
        .btn-pro-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: #fff;
            border-color: transparent;
            box-shadow: 0 4px 12px -4px rgba(79, 70, 229, 0.5);
        }
        .btn-pro-primary:hover {
            background: linear-gradient(135deg, var(--primary-dark), var(--primary-darker));
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px -6px rgba(79, 70, 229, 0.6);
        }
        .btn-pro-success {
            background: linear-gradient(135deg, #10b981, #059669);
            color: #fff;
            border-color: transparent;
            box-shadow: 0 4px 12px -4px rgba(16, 185, 129, 0.5);
        }
        .btn-pro-success:hover {
            background: linear-gradient(135deg, #059669, #047857);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px -6px rgba(16, 185, 129, 0.6);
        }
        .btn-pro-danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: #fff;
            border-color: transparent;
            box-shadow: 0 4px 12px -4px rgba(220, 38, 38, 0.5);
        }
        .btn-pro-danger:hover {
            background: linear-gradient(135deg, #dc2626, #b91c1c);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px -6px rgba(220, 38, 38, 0.6);
        }
        .btn-pro-ghost {
            background: #fff;
            color: var(--ink-700);
            border-color: var(--ink-200);
        }
        .btn-pro-ghost:hover {
            background: var(--ink-50);
            color: var(--ink-900);
            border-color: var(--ink-300);
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
        }
        .btn-pro-sm { padding: 0.45rem 0.9rem; font-size: 0.78rem; border-radius: 8px; }

        /* ═══════════════════════════════════════════════════════
           MENU DÉCISION
        ═══════════════════════════════════════════════════════ */
        .decision-dropdown { position: relative; display: inline-block; }
        .decision-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.6rem 1.15rem;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 4px 12px -4px rgba(79, 70, 229, 0.5);
        }
        .decision-btn:hover {
            background: linear-gradient(135deg, var(--primary-dark), var(--primary-darker));
            transform: translateY(-1px);
            box-shadow: 0 8px 20px -6px rgba(79, 70, 229, 0.6);
        }
        .decision-btn .caret { margin-left: 0.25rem; font-size: 0.7rem; opacity: 0.85; }

        .decision-menu {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            min-width: 290px;
            background: #fff;
            border: 1px solid var(--ink-200);
            border-radius: 16px;
            box-shadow: 0 24px 48px -12px rgba(15, 23, 42, 0.18), 0 8px 16px -8px rgba(15, 23, 42, 0.10);
            padding: 0.5rem;
            z-index: 1050;
            display: none;
        }
        .decision-menu.show { display: block; animation: slideDown 0.18s cubic-bezier(0.4, 0, 0.2, 1); }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-8px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .decision-item {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 0.75rem 0.9rem;
            border-radius: 10px;
            cursor: pointer;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            font-size: 0.85rem;
            color: var(--ink-700);
            font-weight: 500;
        }
        .decision-item:hover {
            background: var(--ink-50);
            color: var(--ink-900);
        }

        .decision-item .icon-wrap {
            width: 36px; height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            flex-shrink: 0;
            background: var(--ink-100);
            color: var(--ink-600);
        }
        .decision-item .icon-wrap.icon-blue   { background: var(--primary-soft); color: var(--primary); }
        .decision-item .icon-wrap.icon-green  { background: var(--success-soft); color: var(--success); }
        .decision-item .icon-wrap.icon-purple { background: rgba(139, 92, 246, 0.12); color: #7c3aed; }
        .decision-item .icon-wrap.icon-red    { background: var(--danger-soft); color: var(--danger); }

        .decision-item .item-text { display: flex; flex-direction: column; line-height: 1.35; }
        .decision-item .item-text strong { color: var(--ink-900); font-size: 0.86rem; font-weight: 700; }
        .decision-item .item-text small { color: var(--ink-400); font-size: 0.73rem; margin-top: 2px; }

        .decision-sep { height: 1px; background: var(--ink-100); margin: 0.35rem 0.5rem; }

        .decision-item.is-danger:hover {
            background: var(--danger-soft);
        }
        .decision-item.is-danger:hover strong { color: var(--danger); }

        /* ═══════════════════════════════════════════════════════
           MODAL REJET
        ═══════════════════════════════════════════════════════ */
        .modal-pro .modal-content {
            border: none;
            border-radius: 22px;
            box-shadow: 0 32px 80px -20px rgba(15, 23, 42, 0.35);
            overflow: hidden;
        }
        .modal-pro .modal-header {
            border: none;
            padding: 1.6rem 1.85rem 1.1rem;
            background: linear-gradient(180deg, var(--ink-50), #fff);
            border-bottom: 1px solid var(--ink-100);
        }
        .modal-pro .modal-header .modal-icon {
            width: 54px; height: 54px;
            border-radius: 15px;
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            box-shadow: 0 8px 20px -6px rgba(220, 38, 38, 0.5);
        }
        .modal-pro .modal-title { font-weight: 800; color: var(--ink-900); font-size: 1.15rem; margin: 0; letter-spacing: -0.3px; }
        .modal-pro .modal-subtitle { color: var(--ink-500); font-size: 0.85rem; margin: 0.3rem 0 0; }

        .modal-pro .modal-body { padding: 1.6rem 1.85rem; }
        .modal-pro .modal-footer { border: none; padding: 1rem 1.85rem 1.6rem; gap: 0.5rem; }

        .recap-devis {
            background: linear-gradient(180deg, var(--ink-50), #fff);
            border: 1px solid var(--ink-200);
            border-radius: 14px;
            padding: 1.1rem 1.25rem;
            margin-bottom: 1.35rem;
        }
        .recap-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.6rem 0;
            font-size: 0.88rem;
        }
        .recap-row + .recap-row { border-top: 1px dashed var(--ink-200); }
        .recap-row .label { color: var(--ink-500); font-weight: 500; }
        .recap-row .value { color: var(--ink-900); font-weight: 600; }

        .motif-field {
            border: 1.5px solid var(--ink-200);
            border-radius: 12px;
            padding: 0.95rem 1.1rem;
            font-size: 0.9rem;
            width: 100%;
            resize: vertical;
            font-family: inherit;
            min-height: 110px;
            background: #fff;
        }
        .motif-field:focus {
            outline: none;
            border-color: var(--danger);
            box-shadow: 0 0 0 4px var(--danger-soft);
        }

        /* ═══════════════════════════════════════════════════════
           FORMS
        ═══════════════════════════════════════════════════════ */
        .form-pro {
            border: 1.5px solid var(--ink-200);
            border-radius: 10px;
            padding: 0.65rem 0.95rem;
            font-size: 0.87rem;
            background: #fff;
            color: var(--ink-800);
            font-weight: 500;
            font-family: inherit;
        }
        .form-pro:focus {
            border-color: var(--primary);
            box-shadow: var(--shadow-glow);
            outline: none;
        }
        .form-select.form-pro { padding-right: 2.25rem; }

        /* ═══════════════════════════════════════════════════════
           TOTAL PANEL — dégradé sombre + accent
        ═══════════════════════════════════════════════════════ */
        .total-panel {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border-radius: var(--radius);
            padding: 1.2rem 1.45rem;
            color: #fff;
            min-width: 220px;
            box-shadow: var(--shadow-md);
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        .total-panel::before {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 4px; height: 100%;
            background: linear-gradient(180deg, #6366f1, #8b5cf6);
        }
        .total-panel .label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #94a3b8;
            margin-bottom: 0.4rem;
            font-weight: 700;
        }
        .total-panel .amount {
            font-size: 1.55rem;
            font-weight: 800;
            letter-spacing: -0.8px;
            color: #fff;
            font-variant-numeric: tabular-nums;
        }
        .total-panel .amount small {
            font-size: 0.75rem;
            color: #94a3b8;
            font-weight: 500;
            margin-left: 0.35rem;
        }
        .total-panel.alt::before {
            background: linear-gradient(180deg, #10b981, #34d399);
        }

        /* ═══════════════════════════════════════════════════════
           EMPTY STATE
        ═══════════════════════════════════════════════════════ */
        .empty-pro {
            text-align: center;
            padding: 3.5rem 1rem;
            color: var(--ink-400);
        }
        .empty-pro i {
            font-size: 2.5rem;
            color: var(--ink-200);
            margin-bottom: 1rem;
            display: block;
        }
        .empty-pro .title { font-weight: 600; color: var(--ink-500); font-size: 0.95rem; }
        .empty-pro .sub { font-size: 0.83rem; color: var(--ink-400); margin-top: 4px; }

        /* ═══════════════════════════════════════════════════════
           SECTION HEADING
        ═══════════════════════════════════════════════════════ */
        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.45rem;
            flex-wrap: wrap;
            gap: 0.75rem;
        }
        .section-heading h5 {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--ink-900);
            margin: 0;
            letter-spacing: -0.3px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .section-heading h5 i {
            color: var(--primary);
            background: var(--primary-soft);
            width: 34px; height: 34px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.88rem;
        }
        .section-heading small {
            color: var(--ink-500);
            font-size: 0.82rem;
            font-weight: 400;
            display: block;
            margin-top: 4px;
            margin-left: 44px;
        }

        /* Décor du badge chef */
        .page-header-badge i { color: var(--primary); }

        /* ═══════════════════════════════════════════════════════
           RESPONSIVE
        ═══════════════════════════════════════════════════════ */
        @media (max-width: 1200px) {
            .card-pro-body { padding: 1.35rem 1.25rem; }
        }
        @media (max-width: 992px) {
            .stat-tile .stat-value { font-size: 1.85rem; }
        }
        @media (max-width: 768px) {
            .page-header h1 { font-size: 1.4rem; }
            .stat-tile { padding: 1.2rem 1.25rem; }
            .stat-tile .stat-value { font-size: 1.6rem; }
            .stat-tile .stat-icon { width: 38px; height: 38px; font-size: 0.95rem; }
            .total-panel .amount { font-size: 1.25rem; }
            .card-pro-body { padding: 1.1rem; }
            .tabs-pro .nav-link { padding: 0.6rem 0.85rem; font-size: 0.8rem; }
        }
        @media (max-width: 576px) {
            .full-container {
                padding-left: 0.85rem;
                padding-right: 0.85rem;
            }
        }

        @media print {
            .navbar-pro, .tabs-pro, .btn-pro, .no-print, .decision-dropdown { display: none !important; }
            .card-pro { box-shadow: none; border-color: #ddd; }
            .tab-content > .tab-pane { display: block !important; opacity: 1 !important; }
            body { background: #fff !important; }
        }
    </style>
</head>
<body>

{# ═══ NAVBAR ═══ #}
<nav class="navbar-pro">
    <div class="full-container">
        <div class="d-flex justify-content-between align-items-center w-100">
            <a class="navbar-brand text-white d-flex align-items-center text-decoration-none" href="#">
                <div class="brand-logo">
                    <img src="{{ asset('images/logo.png') }}" alt="Logo Dispromalt" style="height: 36px; width: auto;">
                    <span>
                        <span class="brand-text-primary">Dispro</span><span class="brand-text-accent">malt</span>
                    </span>
                    <span class="brand-role-badge ms-2 d-none d-md-inline-block">Comptabilité</span>
                </div>
            </a>

            <div class="d-flex align-items-center gap-2">
                <a href="{{ path('app_historique_reappro') }}" class="btn-ghost-light text-decoration-none d-none d-md-inline-flex">
                    <i class="fas fa-clock-rotate-left"></i>Historique
                </a>

                <div class="dropdown">
                    <button class="notif-btn" type="button" data-bs-toggle="dropdown">
                        <i class="fas fa-bell"></i>
                        {% set totalNotifs = (reunionsDelegation is defined ? reunionsDelegation|length : 0) + (nbAlertesStock|default(0)) %}
                        {% if totalNotifs > 0 %}
                            <span class="badge-dot">{{ totalNotifs }}</span>
                        {% endif %}
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-2 mt-2" style="width: 340px;">
                        <li class="px-3 py-2 mb-1 border-bottom">
                            <span class="fw-bold text-dark small">
                                <i class="fas fa-bell me-2 text-primary"></i>Notifications
                            </span>
                        </li>
                        {% if nbAlertesStock|default(0) > 0 %}
                            <li class="px-3 pt-2 pb-1">
                                <small class="text-danger fw-bold" style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;">
                                    <i class="fas fa-exclamation-triangle me-1"></i>Alertes stock ({{ nbAlertesStock }})
                                </small>
                            </li>
                            {% for art in articlesEnAlerte|slice(0, 4) %}
                                <li>
                                    <a class="dropdown-item rounded-3 py-2" href="#alerte-stock-{{ art.id }}">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="small fw-medium text-dark">{{ art.nom }}</span>
                                            <span class="tag tag-danger" style="font-size:0.7rem;">{{ art.quantite }}/{{ art.seuilAlerte }}</span>
                                        </div>
                                    </a>
                                </li>
                            {% endfor %}
                        {% endif %}
                        {% if reunionsDelegation is defined and reunionsDelegation is not empty %}
                            <li class="px-3 pt-2 pb-1">
                                <small class="text-muted fw-bold" style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.05em;">
                                    <i class="fas fa-calendar me-1"></i>Réunions ({{ reunionsDelegation|length }})
                                </small>
                            </li>
                            {% for reunion in reunionsDelegation %}
                                <li>
                                    <a class="dropdown-item rounded-3 py-2" href="#">
                                        <div class="small fw-bold text-dark">{{ reunion.titre }}</div>
                                        <div class="text-muted" style="font-size:0.72rem;">
                                            <i class="far fa-clock me-1"></i>{{ reunion.date|date('d/m/Y H:i') }}
                                        </div>
                                    </a>
                                </li>
                            {% endfor %}
                        {% endif %}
                        {% if (nbAlertesStock|default(0) == 0) and (reunionsDelegation is not defined or reunionsDelegation is empty) %}
                            <li class="text-center text-muted py-4 small">
                                <i class="fas fa-check-circle mb-2 d-block" style="font-size:1.5rem;color:var(--success);"></i>
                                Aucune notification
                            </li>
                        {% endif %}
                    </ul>
                </div>

                <div class="nav-pill d-none d-lg-inline-flex">
                    <span class="role-indicator"></span>
                    <span class="text-white-50" style="font-size:0.75rem;">Rôle</span>
                    <strong class="text-white">{{ userRole }}</strong>
                </div>

                <a href="/logout" class="btn-logout text-decoration-none">
                    <i class="fas fa-power-off"></i>
                </a>
            </div>
        </div>
    </div>
</nav>

{# ═══ MAIN ═══ #}
<div class="full-container py-4">

    <div class="page-header">
        <div class="page-header-badge">
            <i class="fas fa-crown"></i>Espace Comptabilité
        </div>
        <h1>Espace Financier &amp; Logistique</h1>
        <p>Gestion des engagements budgétaires, alertes de stock et suivi des consommables.</p>
    </div>

    {# Flash messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show shadow-sm mb-4 border-0 rounded-4" role="alert" style="font-size:0.9rem;">
                <i class="fas {{ label == 'danger' ? 'fa-circle-exclamation' : (label == 'warning' ? 'fa-circle-info' : 'fa-circle-check') }} me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# STAT CARDS #}
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="stat-tile is-warning">
                <div class="stat-icon"><i class="fas fa-hourglass-half"></i></div>
                <div class="stat-label">Demandes en attente</div>
                <div class="stat-value">{{ stats.demandes_attente }}</div>
                <div class="stat-hint">Engagement budgétaire requis</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-tile is-accent">
                <div class="stat-icon"><i class="fas fa-sync-alt"></i></div>
                <div class="stat-label">Devis en circulation</div>
                <div class="stat-value">{{ devisListe|default([])|length }}</div>
                <div class="stat-hint">Circuit d'approbation</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-tile is-success">
                <div class="stat-icon"><i class="fas fa-hand-holding-usd"></i></div>
                <div class="stat-label">Décaissés (USD)</div>
                <div class="stat-value">{{ totalDevisUSD|default(0)|number_format(0, ',', ' ') }}</div>
                <div class="stat-hint">Fonds sortis ce cycle</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-tile is-danger">
                <div class="stat-icon"><i class="fas fa-exclamation-triangle"></i></div>
                <div class="stat-label">Alertes stock</div>
                <div class="stat-value">{{ nbAlertesStock|default(0) }}</div>
                <div class="stat-hint">Articles sous le seuil</div>
            </div>
        </div>
    </div>

    {# ALERTES STOCK #}
    {% if nbAlertesStock|default(0) > 0 %}
    <div class="alert-banner" id="alerte-stock-section">
        <div class="alert-banner-header">
            <div>
                <h6><i class="fas fa-exclamation-triangle"></i>Alertes de stock — Action requise</h6>
                <small>{{ nbAlertesStock }} article(s) nécessitent un réapprovisionnement</small>
            </div>
            <span class="count-chip">{{ nbAlertesStock }} à traiter</span>
        </div>
        <div class="table-responsive">
            <table class="table table-pro mb-0">
                <thead>
                    <tr>
                        <th>Article</th>
                        <th class="text-center">Stock</th>
                        <th class="text-center">Seuil</th>
                        <th>Statut réappro</th>
                        <th style="min-width: 380px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for art in articlesEnAlerte %}
                        <tr id="alerte-stock-{{ art.id }}">
                            <td>
                                <div class="cell-strong">{{ art.nom }}</div>
                                {% if art.dateSignalementAlerte %}
                                    <div class="cell-muted mt-1">
                                        Signalé le {{ art.dateSignalementAlerte|date('d/m/Y à H:i') }}
                                    </div>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <span class="tag tag-danger"><span class="dot" style="background:var(--danger);"></span>{{ art.quantite }}</span>
                            </td>
                            <td class="text-center">
                                <span class="tag tag-neutral"><span class="dot" style="background:var(--ink-500);"></span>{{ art.seuilAlerte }}</span>
                            </td>
                            <td>
                                {% if art.reapprovisionnementEnCours %}
                                    <span class="tag tag-accent"><i class="fas fa-truck-loading"></i>En cours</span>
                                    {% if art.dateReapprovisionnement %}
                                        <div class="cell-muted mt-1">
                                            Prévu : <strong style="color:var(--ink-700);">{{ art.dateReapprovisionnement|date('d/m/Y') }}</strong>
                                        </div>
                                    {% endif %}
                                {% else %}
                                    <span class="tag tag-neutral"><i class="fas fa-hourglass-start"></i>Non lancé</span>
                                {% endif %}
                            </td>
                            <td>
                                <form action="{{ path('app_article_reappro', {'id': art.id}) }}" method="POST" class="d-flex gap-2 align-items-center flex-wrap">
                                    <input type="date" name="date_reapprovisionnement" class="form-pro" style="max-width: 160px;"
                                           value="{{ art.dateReapprovisionnement ? art.dateReapprovisionnement|date('Y-m-d') : '' }}"
                                           min="{{ 'now'|date('Y-m-d') }}">
                                    <select name="reapprovisionnement_en_cours" class="form-pro form-select" style="max-width: 140px;">
                                        <option value="0" {% if not art.reapprovisionnementEnCours %}selected{% endif %}>Non lancé</option>
                                        <option value="1" {% if art.reapprovisionnementEnCours %}selected{% endif %}>En cours</option>
                                    </select>
                                    <button type="submit" class="btn-pro btn-pro-primary btn-pro-sm">
                                        <i class="fas fa-check"></i>Enregistrer
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    {# TABS PRINCIPAUX #}
    <div class="card-pro mb-4">
        <ul class="nav nav-tabs tabs-pro" id="comptaTab" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" id="budget-tab" data-bs-toggle="tab" data-bs-target="#budget-pane" type="button">
                    <i class="fas fa-coins"></i>Engagements
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="devis-tab" data-bs-toggle="tab" data-bs-target="#devis-pane" type="button">
                    <i class="fas fa-file-invoice-dollar"></i>Workflow devis
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="tresorerie-tab" data-bs-toggle="tab" data-bs-target="#tresorerie-pane" type="button">
                    <i class="fas fa-vault"></i>Trésorerie
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="inventaire-tab" data-bs-toggle="tab" data-bs-target="#inventaire-pane" type="button">
                    <i class="fas fa-warehouse"></i>Stock
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="visite-tab" data-bs-toggle="tab" data-bs-target="#visite-pane" type="button">
                    <i class="fas fa-calendar-plus"></i>Visite
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="stats-tab" data-bs-toggle="tab" data-bs-target="#stats-pane" type="button">
                    <i class="fas fa-chart-line"></i>Statistiques
                </button>
            </li>
            <li class="nav-item ms-auto d-flex align-items-center gap-2 pe-2 mb-2 no-print">
                <a href="{{ path('app_rapport_pdf', {'date_debut': date_debut, 'date_fin': date_fin}) }}" class="btn-pro btn-pro-ghost btn-pro-sm">
                    <i class="fas fa-file-pdf"></i>PDF
                </a>
                <a href="{{ path('app_rapport_excel', {'date_debut': date_debut, 'date_fin': date_fin}) }}" class="btn-pro btn-pro-ghost btn-pro-sm">
                    <i class="fas fa-file-excel"></i>Excel
                </a>
            </li>
        </ul>

        <div class="card-pro-body">
            <div class="tab-content">

                {# ═══ ONGLET 1 : ENGAGEMENTS ═══ #}
                <div class="tab-pane fade show active" id="budget-pane" role="tabpanel">
                    <div class="section-heading">
                        <div>
                            <h5><i class="fas fa-list-check"></i>Demandes à engager</h5>
                            <small>Validez budgétairement les demandes logistiques</small>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-pro">
                            <thead>
                                <tr>
                                    <th>Réf.</th>
                                    <th>Service</th>
                                    <th>Article</th>
                                    <th class="text-center">Qté</th>
                                    <th>Statut</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for d in demandes %}
                                    <tr>
                                        <td class="cell-strong">#DEM-{{ d.id }}</td>
                                        <td><span class="tag tag-neutral">{{ d.departement }}</span></td>
                                        <td class="cell-strong">{{ d.materiel }}</td>
                                        <td class="text-center cell-strong">{{ d.quantite|default(1) }}</td>
                                        <td>
                                            {% if d.statut == 'En attente' %}
                                                <span class="tag tag-neutral"><i class="fas fa-clock"></i>En attente</span>
                                            {% elseif d.statut == 'Validé Chef' %}
                                                <span class="tag tag-accent"><i class="fas fa-user-check"></i>Validé chef</span>
                                            {% elseif d.statut == 'Validé Compta' %}
                                                <span class="tag tag-accent"><i class="fas fa-thumbs-up"></i>Accordé</span>
                                            {% elseif d.statut == 'Livré par le Stock' %}
                                                <span class="tag tag-success"><i class="fas fa-truck"></i>Livré</span>
                                            {% elseif d.statut == 'Reçu / Clôturé' %}
                                                <span class="tag tag-success"><i class="fas fa-check-double"></i>Clôturé</span>
                                            {% else %}
                                                <span class="tag tag-neutral">{{ d.statut }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-end">
                                            {% if d.statut == 'En attente' or d.statut == 'Validé Chef' %}
                                                <form action="{{ path('app_demande_compta_valider', {'id': d.id}) }}" method="POST" class="d-inline">
                                                    <button class="btn-pro btn-pro-primary btn-pro-sm">
                                                        <i class="fas fa-check"></i>Accorder
                                                    </button>
                                                </form>
                                            {% else %}
                                                <span class="cell-muted">—</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="6">
                                            <div class="empty-pro">
                                                <i class="fas fa-inbox"></i>
                                                <div class="title">Aucune demande à traiter</div>

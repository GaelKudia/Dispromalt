                        <div class="mt-4 p-4" style="background:linear-gradient(180deg,var(--ink-50),#fff);border:1px solid var(--ink-200);border-radius:var(--radius-lg);">
                            <h6 class="fw-bold mb-3" style="font-size:0.95rem;color:var(--ink-900);">
                                <i class="fas fa-plus-circle me-2" style="color:var(--primary);"></i>Ajouter un article
                            </h6>
                            {{ form_start(formStock) }}
                                {{ form_widget(formStock) }}
                                <div class="text-center my-3">
                                    <button type="button" class="btn-pro btn-pro-ghost" id="show-attributs-btn">
                                        <i class="fas fa-cog"></i>Caractéristiques techniques
                                    </button>
                                </div>
                                <button type="submit" class="btn-pro btn-pro-primary w-100 justify-content-center py-2">
                                    <i class="fas fa-save"></i>Enregistrer
                                </button>
                            {{ form_end(formStock) }}
                        </div>
                    {% endif %}
                </div>

                {# ═══ ONGLET 4 : VISITE ═══ #}
                <div class="tab-pane fade" id="visite-pane" role="tabpanel">
                    <div class="section-heading">
                        <div>
                            <h5><i class="fas fa-calendar-plus"></i>Enregistrer une visite</h5>
                            <small>Planification d'accès pour visiteurs et partenaires</small>
                        </div>
                    </div>

                    {% if formVisite is not null %}
                        <div class="row justify-content-center">
                            <div class="col-lg-8">
                                {{ form_start(formVisite, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            {{ form_label(formVisite.nomVisiteur, 'Nom & prénom', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                            {{ form_widget(formVisite.nomVisiteur, {'attr': {'class': 'form-pro w-100', 'placeholder': 'Ex: Jean Dupont'}}) }}
                                            {{ form_errors(formVisite.nomVisiteur) }}
                                        </div>
                                        <div class="col-md-6">
                                            {{ form_label(formVisite.departement, 'Département', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                            {{ form_widget(formVisite.departement, {'attr': {'class': 'form-pro w-100', 'placeholder': 'Ex: Production'}}) }}
                                            {{ form_errors(formVisite.departement) }}
                                        </div>
                                        <div class="col-12">
                                            {{ form_label(formVisite.motif, 'Motif', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                            {{ form_widget(formVisite.motif, {'attr': {'class': 'form-pro w-100', 'rows': 3, 'placeholder': 'Raison de la visite'}}) }}
                                            {{ form_errors(formVisite.motif) }}
                                        </div>
                                        {% if formVisite.telephone is defined %}
                                            <div class="col-md-6">
                                                {{ form_label(formVisite.telephone, 'Téléphone', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                                {{ form_widget(formVisite.telephone, {'attr': {'class': 'form-pro w-100'}}) }}
                                            </div>
                                        {% endif %}
                                        {% if formVisite.email is defined %}
                                            <div class="col-md-6">
                                                {{ form_label(formVisite.email, 'Email', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                                {{ form_widget(formVisite.email, {'attr': {'class': 'form-pro w-100'}}) }}
                                            </div>
                                        {% endif %}
                                        {% if formVisite.pieceIdentite is defined %}
                                            <div class="col-12">
                                                {{ form_label(formVisite.pieceIdentite, 'Pièce d\'identité', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                                {{ form_widget(formVisite.pieceIdentite, {'attr': {'class': 'form-pro w-100'}}) }}
                                            </div>
                                        {% endif %}
                                    </div>
                                    <button type="submit" class="btn-pro btn-pro-primary w-100 justify-content-center py-2 mt-4">
                                        <i class="fas fa-calendar-check"></i>Confirmer la réservation
                                    </button>
                                {{ form_end(formVisite) }}
                            </div>
                        </div>
                    {% else %}
                        <div class="empty-pro">
                            <i class="fas fa-calendar-times"></i>
                            <div class="title">Formulaire indisponible</div>
                            <div class="sub">Le formulaire de visite n'est pas accessible</div>
                        </div>
                    {% endif %}
                </div>

                {# ═══ ONGLET 5 : STATISTIQUES ═══ #}
                <div class="tab-pane fade" id="stats-pane" role="tabpanel">
                    <div class="section-heading">
                        <div>
                            <h5><i class="fas fa-chart-line"></i>Analyse de consommation</h5>
                            <small>Articles les plus sollicités par les services</small>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-7">
                            <div class="table-responsive">
                                <table class="table table-pro">
                                    <thead>
                                        <tr>
                                            <th style="width:60px;">Rang</th>
                                            <th>Article</th>
                                            <th class="text-center" style="width:120px;">Occurrences</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% set counts = {} %}
                                        {% for d in demandes %}
                                            {% set counts = counts|merge({ (d.materiel): (counts[d.materiel]|default(0) + 1) }) %}
                                        {% endfor %}
                                        {% set rank = 1 %}
                                        {% for mat, count in counts|sort|reverse %}
                                            {% if rank <= 5 %}
                                                <tr>
                                                    <td class="cell-strong text-muted">#{{ rank }}</td>
                                                    <td class="cell-strong">{{ mat }}</td>
                                                    <td class="text-center">
                                                        <span class="tag tag-accent">{{ count }}</span>
                                                    </td>
                                                </tr>
                                            {% endif %}
                                            {% set rank = rank + 1 %}
                                        {% else %}
                                            <tr>
                                                <td colspan="3">
                                                    <div class="empty-pro">
                                                        <i class="fas fa-chart-simple"></i>
                                                        <div class="title">Données insuffisantes</div>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="p-4 h-100 d-flex flex-column justify-content-center" style="background:linear-gradient(135deg, rgba(99,102,241,0.06), rgba(139,92,246,0.04));border:1px solid rgba(99,102,241,0.15);border-radius:var(--radius-lg);">
                                <i class="fas fa-lightbulb mb-3" style="font-size:1.75rem;color:var(--primary);"></i>
                                <h6 class="fw-bold mb-2" style="font-size:0.95rem;color:var(--ink-900);">Indicateur de flux</h6>
                                <p class="text-muted small mb-0" style="line-height:1.7;">
                                    Ces statistiques permettent de prévoir les futures lignes budgétaires à accorder en priorité, afin d'éviter les ruptures critiques de stock au dépôt.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="text-center py-4" style="color:var(--ink-400);font-size:0.8rem;font-weight:500;">
        Dispromalt — Espace Comptabilité &copy; {{ 'now'|date('Y') }}
    </div>
</div>

{# ═══ MODAL DE REJET DE DEVIS ═══ #}
<div class="modal fade modal-pro" id="modalRejetDevis" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-start gap-3">
                    <div class="modal-icon">
                        <i class="fas fa-ban"></i>
                    </div>
                    <div>
                        <h5 class="modal-title">Rejeter le devis</h5>
                        <p class="modal-subtitle">Cette action est irréversible. Veuillez indiquer un motif.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>

            <form method="POST" id="formRejetDevis">
                <input type="hidden" name="choix_procedure" value="rejeter_devis">
                <input type="hidden" name="_token" id="rejetCsrfToken" value="">

                <div class="modal-body">
                    <div class="recap-devis">
                        <div class="recap-row">
                            <span class="label"><i class="fas fa-hashtag me-1"></i>Devis</span>
                            <span class="value" id="rejetRecapId">#—</span>
                        </div>
                        <div class="recap-row">
                            <span class="label"><i class="fas fa-user me-1"></i>Émetteur</span>
                            <span class="value" id="rejetRecapEmetteur">—</span>
                        </div>
                        <div class="recap-row">
                            <span class="label"><i class="fas fa-coins me-1"></i>Montant</span>
                            <span class="value" id="rejetRecapMontant">—</span>
                        </div>
                        <div class="recap-row">
                            <span class="label"><i class="fas fa-align-left me-1"></i>Description</span>
                            <span class="value text-end" id="rejetRecapDesc" style="max-width: 60%;">—</span>
                        </div>
                    </div>

                    <label class="form-label small fw-bold text-secondary mb-2">
                        <i class="fas fa-pen me-1"></i>Motif du rejet <span class="text-danger">*</span>
                    </label>
                    <textarea name="motif_rejet" id="motifRejet" class="motif-field" required
                              placeholder="Expliquez pourquoi ce devis est rejeté (ex: Montant trop élevé, informations incomplètes, doublon…)"></textarea>
                    <small class="text-muted d-block mt-2">
                        <i class="fas fa-info-circle me-1"></i>
                        Le motif sera enregistré et consultable par l'équipe comptable.
                    </small>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-pro btn-pro-ghost" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i>Annuler
                    </button>
                    <button type="submit" class="btn-pro btn-pro-danger">
                        <i class="fas fa-ban"></i>Confirmer le rejet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll('.alert-dismissible').forEach(alert => {
            setTimeout(() => {
                alert.style.opacity = '0';
                setTimeout(() => alert.remove(), 400);
            }, 5000);
        });

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('date_debut') || urlParams.has('date_fin')) {
            const devisTab = document.querySelector('#devis-tab');
            if (devisTab) bootstrap.Tab.getOrCreateInstance(devisTab).show();
        }

        const btn = document.getElementById('show-attributs-btn');
        if (btn) {
            btn.addEventListener('click', function () {
                const row = document.querySelector('.attributs-row');
                if (row) row.style.display = row.style.display === 'none' ? 'block' : 'none';
            });
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.decision-dropdown')) {
                document.querySelectorAll('.decision-menu.show').forEach(m => m.classList.remove('show'));
            }
        });
    });

    function toggleDecisionMenu(devisId, event) {
        event.stopPropagation();
        const menu = document.getElementById('decisionMenu' + devisId);
        const isOpen = menu.classList.contains('show');
        document.querySelectorAll('.decision-menu.show').forEach(m => m.classList.remove('show'));
        if (!isOpen) menu.classList.add('show');
    }

    function ouvrirModalRejet(devisId, emetteur, montant, devise, description) {
        document.querySelectorAll('.decision-menu.show').forEach(m => m.classList.remove('show'));
        document.getElementById('rejetRecapId').textContent = '#' + devisId;
        document.getElementById('rejetRecapEmetteur').textContent = emetteur || '—';
        document.getElementById('rejetRecapMontant').textContent = montant + ' ' + devise;
        document.getElementById('rejetRecapDesc').textContent = description || '—';
        document.getElementById('formRejetDevis').action = '/dashboard/compta/devis/aiguiller/' + devisId;
        document.getElementById('motifRejet').value = '';
        const modal = new bootstrap.Modal(document.getElementById('modalRejetDevis'));
        modal.show();
        document.getElementById('modalRejetDevis').addEventListener('shown.bs.modal', function() {
            document.getElementById('motifRejet').focus();
        }, { once: true });
    }
</script>
</body>
</html>
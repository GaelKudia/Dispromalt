<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Espace Accueil - Dispromalt</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        .nav-tabs .nav-link.active { border-bottom: 3px solid #0d6efd !important; font-weight: bold; color: #0d6efd !important; }
        .nav-tabs .nav-link { color: #6c757d; }
        .badge-statut { font-size: 0.75rem; padding: 0.35rem 0.75rem; }
        .visitor-card { transition: all 0.3s ease; }
        .visitor-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.08); }
    </style>
</head>
<body class="bg-light text-dark">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-3">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold fs-4" href="#">
                Dispro<span class="text-primary">malt</span> <span class="fw-light fs-5 text-muted">| Accueil</span>
            </a>
            <div class="d-flex align-items-center">
                <div class="bg-secondary bg-opacity-20 text-white px-3 py-1.5 rounded-pill me-3 small border border-secondary">
                    <i class="fas fa-concierge-bell text-warning me-2"></i>Rôle actif : <strong>{{ userRole }}</strong>
                </div>
                <a href="/logout" class="btn btn-primary btn-sm fw-bold px-3">
                    <i class="fas fa-sign-out-alt me-1"></i> Déconnexion
                </a>
            </div>
        </div>
    </nav>

    <div class="container py-5">
        <div class="mb-4 pb-3 border-bottom d-flex justify-content-between align-items-center">
            <div>
                <h1 class="fw-bold"><i class="fas fa-desktop text-info me-2"></i>Espace Opérationnel - Accueil</h1>
                <p class="text-muted m-0">Gérez le registre des présences, planifiez des visites et créez des bons de sortie de matériel.</p>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-info bg-opacity-10 text-info border border-info py-2 px-3">
                    <i class="fas fa-users me-1"></i> {{ visites|length }} présent(s)
                </span>
                <span class="badge bg-success bg-opacity-10 text-success border border-success py-2 px-3">
                    <i class="fas fa-calendar-check me-1"></i> {{ rdvReserves|default([])|length }} réservations
                </span>
            </div>
        </div>

        {# Messages Flash #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{% if label == 'danger' %}danger{% else %}info{% endif %} alert-dismissible fade show shadow-sm mb-4" role="alert">
                    <i class="fas {% if label == 'danger' %}fa-exclamation-triangle{% else %}fa-check-circle{% endif %} me-2"></i> {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white p-0 border-bottom">
                <ul class="nav nav-tabs card-header-tabs m-0 border-bottom-0" id="accueilTab" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active py-3 px-4 fw-bold border-0" id="registre-tab" data-bs-toggle="tab" data-bs-target="#registre-pane" type="button" role="tab">
                            <i class="fas fa-users text-info me-2"></i>Visiteurs Présents
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-3 px-4 fw-bold border-0" id="visite-tab" data-bs-toggle="tab" data-bs-target="#visite-pane" type="button" role="tab">
                            <i class="fas fa-calendar-plus text-success me-2"></i>Enregistrer une Visite
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-3 px-4 fw-bold border-0" id="rdv-tab" data-bs-toggle="tab" data-bs-target="#rdv-pane" type="button" role="tab">
                            <i class="fas fa-calendar-check text-primary me-2"></i>Rendez-vous Réservés
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-3 px-4 fw-bold border-0" id="bon-tab" data-bs-toggle="tab" data-bs-target="#bon-pane" type="button" role="tab">
                            <i class="fas fa-ticket-alt text-primary me-2"></i>Créer un Bon de Sortie
                        </button>
                    </li>
                </ul>
            </div>
            
            <div class="card-body p-4">
                <div class="tab-content">
                    
                    {# ============================================================
                    ONGLET 1 : REGISTRE DES VISITEURS PRÉSENTS
                    ============================================================ #}
                    <div class="tab-pane fade show active" id="registre-pane" role="tabpanel">
                        {% if visites|length > 0 %}
                            <div class="row g-3 mb-3">
                                {% for v in visites %}
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card visitor-card border-0 shadow-sm h-100">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <h6 class="fw-bold text-dark mb-1">
                                                            <i class="fas fa-user-circle text-info me-1"></i>
                                                            {{ v.nomVisiteur }}
                                                        </h6>
                                                        <span class="badge bg-info bg-opacity-10 text-info border border-info px-2 py-1">
                                                            {{ v.departement }}
                                                        </span>
                                                    </div>
                                                    <span class="badge bg-success badge-statut">
                                                        <i class="fas fa-check-circle me-1"></i>Présent
                                                    </span>
                                                </div>
                                                <p class="text-muted small mt-2 mb-0">
                                                    <i class="fas fa-info-circle me-1"></i> {{ v.motif }}
                                                </p>
                                                <p class="text-muted small mb-2">
                                                    <i class="fas fa-clock me-1"></i> 
                                                    Arrivée: {{ v.dateArrivee ? v.dateArrivee|date('H:i') : 'N/A' }}
                                                </p>
                                                <form action="{{ path('app_visite_cloturer', {'id': v.id}) }}" method="POST" class="mt-2">
                                                    <button type="submit" class="btn btn-outline-dark btn-sm w-100 fw-bold">
                                                        <i class="fas fa-door-open me-1"></i> Signaler le Départ
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="text-center py-5 text-muted">
                                <i class="fas fa-user-clock fa-3x mb-3 text-muted opacity-50 d-block"></i>
                                <h5>Aucun visiteur présent à l'accueil</h5>
                                <p class="small">Les visiteurs enregistrés par la guérite apparaîtront ici.</p>
                            </div>
                        {% endif %}
                    </div>

                    {# ============================================================
                    ONGLET 2 : FORMULAIRE DE RÉSERVATION DE VISITE
                    ============================================================ #}
                    <div class="tab-pane fade" id="visite-pane" role="tabpanel">
    <div class="d-flex justify-content-center py-2">
        <div class="card border p-4 shadow-sm bg-white" style="width: 100%; max-width: 600px; border-radius: 12px;">
            <div class="text-center mb-4">
                <i class="fas fa-id-card text-success fa-2x mb-2"></i>
                <h5 class="fw-bold text-dark m-0">Nouvelle Fiche Visiteur</h5>
                <small class="text-muted">Planifier l'accès d'un tiers dans l'imprimerie</small>
            </div>

            {% if formVisite is defined and formVisite is not null %}
                {{ form_start(formVisite) }}
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold text-secondary">
                                <i class="fas fa-user me-1"></i>Nom & Prénom <span class="text-danger">*</span>
                            </label>
                            {{ form_widget(formVisite.nomVisiteur, {'attr': {'class': 'form-control py-2', 'placeholder': 'Ex: Jean Dupont'}}) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold text-secondary">
                                <i class="fas fa-building me-1"></i>Département <span class="text-danger">*</span>
                            </label>
                            {{ form_widget(formVisite.departement, {'attr': {'class': 'form-control py-2', 'placeholder': 'Ex: Production'}}) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label small fw-bold text-secondary">
                                <i class="fas fa-info-circle me-1"></i>Motif <span class="text-danger">*</span>
                            </label>
                            {{ form_widget(formVisite.motif, {'attr': {'class': 'form-control py-2', 'rows': '2', 'placeholder': 'Raison de la visite'}}) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold text-secondary">
                                <i class="fas fa-phone me-1"></i>Téléphone
                            </label>
                            {{ form_widget(formVisite.telephone, {'attr': {'class': 'form-control py-2', 'placeholder': 'Numéro de téléphone'}}) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold text-secondary">
                                <i class="fas fa-envelope me-1"></i>Email
                            </label>
                            {{ form_widget(formVisite.email, {'attr': {'class': 'form-control py-2', 'placeholder': 'email@exemple.com'}}) }}
                        </div>
                    </div>

                    {# --- AJOUT DU CHAMP PIÈCE D'IDENTITÉ --- #}
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label small fw-bold text-secondary">
                                <i class="fas fa-id-card me-1"></i>Pièce d'identité
                            </label>
                            {{ form_widget(formVisite.pieceIdentite, {'attr': {'class': 'form-control py-2', 'placeholder': 'CIN, Passeport, etc.'}}) }}
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success w-100 fw-bold py-2 mt-2">
                        <i class="fas fa-save me-2"></i>Enregistrer et Réserver
                    </button>
                {{ form_end(formVisite) }}
            {% else %}
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Le formulaire de visite n'est pas disponible.
                </div>
            {% endif %}
        </div>
    </div>
</div>

                    {# ============================================================
                    ONGLET 3 : RENDEZ-VOUS RÉSERVÉS
                    ============================================================ #}
                    <div class="tab-pane fade" id="rdv-pane" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark m-0">
                                <i class="fas fa-calendar-alt text-primary me-2"></i>Rendez-vous Réservés
                            </h5>
                            <span class="badge bg-primary">{{ rdvReserves|default([])|length }} réservation(s)</span>
                        </div>
                        
                        <div class="table-responsive">
                            <table class="table table-hover align-middle m-0">
                                <thead class="table-light small text-uppercase fw-bold text-secondary">
                                    <tr>
                                        <th>Visiteur</th>
                                        <th>Département</th>
                                        <th>Motif</th>
                                        <th>Date réservation</th>
                                        <th>Statut</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody class="small">
                                    {% for rdv in rdvReserves|default([]) %}
                                        <tr>
                                            <td class="fw-bold text-dark">{{ rdv.nomVisiteur }}</td>
                                            <td><span class="badge bg-info bg-opacity-10 text-info border px-2 py-1">{{ rdv.departement }}</span></td>
                                            <td class="text-muted">{{ rdv.motif }}</td>
                                            <td class="text-muted">{{ rdv.dateArrivee ? rdv.dateArrivee|date('d/m/Y H:i') : '-' }}</td>
                                            <td>
                                                <span class="badge bg-warning text-dark badge-statut">
                                                    <i class="fas fa-clock me-1"></i>En attente
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <form action="{{ path('app_visite_valider_guerite', {'id': rdv.id}) }}" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-success fw-bold px-3">
                                                        <i class="fas fa-check me-1"></i> Accueillir
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="6" class="text-center py-5 text-muted">
                                                <i class="fas fa-calendar-times fa-2x mb-3 d-block text-muted opacity-50"></i>
                                                Aucun rendez-vous réservé.
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    {# ============================================================
                    ONGLET 4 : FORMULAIRE DE BON DE SORTIE (CORRIGÉ)
                    ============================================================ #}
                    <div class="tab-pane fade" id="bon-pane" role="tabpanel">
                        <div class="d-flex justify-content-center py-2">
                            <div class="card border p-4 shadow-sm bg-white" style="width: 100%; max-width: 600px; border-radius: 12px;">
                                <div class="text-center mb-4">
                                    <i class="fas fa-exchange-alt text-primary fa-2x mb-2"></i>
                                    <h5 class="fw-bold text-dark m-0">Créer un Bon de Sortie</h5>
                                    <small class="text-muted">Déclarer la sortie physique d'un matériel ou équipement</small>
                                </div>
                                
                                {% if formBon is defined and formBon is not null %}
                                    {{ form_start(formBon) }}
                                        {# On affiche les champs un par un pour éviter le double rendu #}
                                        <div class="mb-3">
                                            {{ form_label(formBon.nomEmploye, 'Agent responsable', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                            {{ form_widget(formBon.nomEmploye, {'attr': {'class': 'form-control py-2', 'readonly': true}}) }}
                                        </div>
                                        <div class="mb-3">
                                            {{ form_label(formBon.departement, 'Département', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                            {{ form_widget(formBon.departement, {'attr': {'class': 'form-control py-2'}}) }}
                                        </div>
                                        {# Ajoute ici les autres champs du formulaire BonSortie si besoin (ex: materiel, quantite) #}
                                        {# Ne pas utiliser {{ form_widget(formBon) }} pour éviter les doublons #}
                                        <button type="submit" class="btn btn-primary w-100 fw-bold py-2 mt-2">
                                            <i class="fas fa-paper-plane me-2"></i>Transmettre pour Signature
                                        </button>
                                    {{ form_end(formBon) }}
                                {% else %}
                                    <div class="alert alert-warning">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        Le formulaire de Bon de Sortie n'est pas disponible.
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
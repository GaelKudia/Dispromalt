                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                {# ============================================================
                   ONGLET : NOUVEAU BON
                ============================================================ #}
                <div class="tab-pane fade" id="pane-new-bon" role="tabpanel">
                    <div class="row justify-content-center">
                        <div class="col-lg-8">
                            <div class="form-card">
                                <div class="form-card-header">
                                    <div class="form-card-icon form-card-icon-green"><i class="fas fa-file-invoice"></i></div>

                                                            <i class="fas fa-check me-1"></i> Valider
                                                        </button>
                                                        <button type="submit" name="action" value="rejeter" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Rejeter"
                                                                onclick="return confirm('Rejeter cette demande ?');">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </form>
                                                {% else %}
                                                    <span class="text-muted small">—</span>
                                                {% endif %}
                                            </td>
                                        {% endif %}

                                                <form action="{{ path('app_demande_livrer', {'id': d.id}) }}" method="POST" class="d-inline">
                                                    <button class="btn btn-sm btn-success fw-bold rounded-pill px-3">
                                                        <i class="fas fa-truck me-1"></i> Livrer
                                                    </button>
                                                </form>
                                            </td>
                                        {% endif %}

                                        
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="6">
                                            <div class="empty-state">
                                                <i class="fas fa-inbox"></i>
                                                <div class="fw-bold">Aucune demande</div>
                                                <small>{% if isChefService|default(false) %}Aucune demande en attente de validation.{% else %}Aucune demande logistique en cours.{% endif %}</small>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Espace Membre - Dispromalt</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        :root {
            --dg-primary: #1e293b;
            --dg-accent: #dc2626;
        }
        body { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; background-color: #f4f6f9; }
        .card-counter { border: none; border-radius: 12px; transition: all 0.25s ease; }
        .card-counter:hover { transform: translateY(-4px); box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important; }
        .nav-tabs .nav-link { border: none; color: #64748b; transition: all 0.2s; position: relative; }
        .nav-tabs .nav-link.active { color: var(--dg-primary) !important; font-weight: 700; background: none; }
        .nav-tabs .nav-link.active::after { content: ''; position: absolute; bottom: 0; left: 1.5rem; right: 1.5rem; height: 3.5px; background: #0d6efd; border-radius: 3px; }
        .table-modern thead { background-color: #f8fafc; border-bottom: 2px solid #e2e8f0; }
        .table-modern th { font-size: 0.75rem; letter-spacing: 0.05em; text-transform: uppercase; color: #475569; padding: 1rem 0.75rem; }
        .table-modern td { padding: 1rem 0.75rem; vertical-align: middle; }
    </style>
</head>
<body class="bg-light text-dark">

    {# ============================================
       NAVBAR (avec cloche de notification)
    ============================================ #}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-3">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold fs-4" href="#">
                <i class="fas fa-print text-danger me-2"></i>Dispro<span class="text-primary">malt</span> <span class="fw-light fs-5 text-muted">| Espace Opérationnel</span>
            </a>
            <div class="d-flex align-items-center">
                {# === Cloche de notification === #}
                <div class="dropdown me-3">
                    <button class="btn btn-outline-light btn-sm position-relative rounded-circle p-2" type="button" id="notificationsMenu" data-bs-toggle="dropdown" aria-expanded="false" style="width: 38px; height: 38px;">
                        <i class="fas fa-bell"></i>
                        {% if reunionsDelegation is defined and reunionsDelegation|length > 0 %}
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                {{ reunionsDelegation|length }}
                            </span>
                        {% endif %}
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow p-2" aria-labelledby="notificationsMenu" style="width: 300px;">
                        <li class="dropdown-header fw-bold text-dark border-bottom pb-2 mb-2">
                            <i class="fas fa-calendar-alt text-primary me-2"></i>Réunions / Ordres Délégués
                        </li>
                        {% if reunionsDelegation is defined and reunionsDelegation is not empty %}
                            {% for reunion in reunionsDelegation %}
                                <li>
                                    <a class="dropdown-item p-2 rounded mb-1 bg-light-subtle" href="#">
                                        <div class="fw-bold text-dark small">{{ reunion.titre }}</div>
                                        <div class="text-muted extra-small" style="font-size: 0.75rem;">
                                            <i class="far fa-clock me-1"></i>{{ reunion.date|date('d/m/Y H:i') }}
                                        </div>
                                    </a>
                                </li>
                            {% endfor %}
                        {% else %}
                            <li class="text-center text-muted py-3 small">
                                <i class="fas fa-check-circle text-success mb-1 d-block"></i>
                                Aucune notification.
                            </li>
                        {% endif %}
                    </ul>
                </div>

                {# Infos utilisateur #}
                <div class="bg-secondary bg-opacity-20 text-white px-3 py-1.5 rounded-pill me-3 small border border-secondary">
                    <i class="fas fa-user text-info me-2"></i>Rôle actif : <strong>{{ userRole }}</strong>
                </div>
                <a href="/logout" class="btn btn-primary btn-sm fw-bold px-3">
                    <i class="fas fa-sign-out-alt me-1"></i> Déconnexion
                </a>
            </div>
        </div>
    </nav>

    {# ============================================
       MAIN CONTAINER
    ============================================ #}
    <div class="container-fluid py-4 px-4">

        {# En-tête #}
        <div class="mb-4 pb-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="fw-bold text-dark m-0 tracking-tight">Espace de Gestion des Flux</h1>
                <p class="text-muted m-0 fs-6">
                    Créez vos demandes, rédigez vos devis et traitez les autorisations logistiques selon vos privilèges de service.
                </p>
            </div>
        </div>

        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'danger' ? 'danger' : 'success' }} alert-dismissible fade show shadow-sm mb-4 border-0 rounded-3" role="alert">
                    <i class="fas {{ label == 'danger' ? 'fa-exclamation-triangle' : 'fa-check-circle' }} me-2"></i> {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {# Cartes de statistiques supérieures #}
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card card-counter bg-white p-4 shadow-sm border-start border-warning border-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase small fw-bold mb-1">Demandes en attente</h6>
                            <h3 class="fw-bold m-0 text-warning fs-2">{{ stats.demandes_attente|default(0) }}</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded-3 text-warning">
                            <i class="fas fa-clock fa-xl"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-counter bg-white p-4 shadow-sm border-start border-primary border-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase small fw-bold mb-1">Bons à signer (Coordon)</h6>
                            <h3 class="fw-bold m-0 text-primary fs-2">{{ stats.bons_a_valider|default(0) }}</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded-3 text-primary">
                            <i class="fas fa-pen-nib fa-xl"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-counter bg-white p-4 shadow-sm border-start border-success border-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase small fw-bold mb-1">Bons validés Guérite</h6>
                            <h3 class="fw-bold m-0 text-success fs-2">{{ stats.bons_guerite|default(0) }}</h3>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded-3 text-success">
                            <i class="fas fa-shield-alt fa-xl"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ============================================
           MAIN ROW : GAUCHE (formulaires) + DROITE (onglets)
        ============================================ #}
        <div class="row g-4">

            {# --- COLONNE DE GAUCHE (formulaires) --- #}
            {% if not is_granted('ROLE_COORDON') and not is_granted('ROLE_STOCK') and not is_granted('ROLE_DG') and not is_granted('ROLE_GUERITE') %}
                <div class="col-xl-4 col-lg-5">
                    {# Formulaire Demande de Matériel #}
                    <div class="card border-0 shadow-sm mb-4 rounded-3" style="border-top: 4px solid #0d6efd !important;">
                        <div class="card-header bg-white py-3">
                            <h5 class="card-title m-0 fw-bold"><i class="fas fa-box-open text-primary me-2"></i>Demander du Matériel</h5>
                        </div>
                        <div class="card-body">
                            {% if formDemande is defined and formDemande is not null %}
                                {{ form_start(formDemande) }}
                                    <div class="mb-3">
                                        {{ form_label(formDemande.materiel) }}
                                        {{ form_widget(formDemande.materiel, {'attr': {'class': 'form-control', 'id': 'demande_materiel', 'placeholder': 'Tapez le nom de l\'article'}}) }}
                                    </div>
                                    <div class="mb-3" id="attribut-wrapper">
                                        {{ form_label(formDemande.attribut) }}
                                        {{ form_widget(formDemande.attribut, {'attr': {'class': 'form-select', 'id': 'demande_attribut', 'disabled': 'disabled'}}) }}
                                    </div>
                                    <div class="mb-3">
                                        {{ form_label(formDemande.quantite) }}
                                        {{ form_widget(formDemande.quantite, {'attr': {'class': 'form-control'}}) }}
                                    </div>
                                    {% if formDemande.destination is defined %}
                                        <div class="mb-3">
                                            {{ form_label(formDemande.destination) }}
                                            {{ form_widget(formDemande.destination, {'attr': {'class': 'form-select'}}) }}
                                        </div>
                                    {% endif %}
                                    {{ form_rest(formDemande) }}
                                    <button type="submit" class="btn btn-primary w-100 fw-bold mt-3 shadow-sm">Envoyer la Demande</button>
                                {{ form_end(formDemande) }}
                            {% else %}
                                <div class="alert alert-info mb-0">
                                    <i class="fas fa-info-circle me-2"></i> Vous n’avez pas les droits pour faire une demande de matériel.
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    {# Formulaire Devis #}
                    <div class="card border-0 shadow-sm mb-4 rounded-3" style="border-top: 4px solid #ffc107 !important;">
                        <div class="card-header bg-white py-3">
                            <h5 class="card-title m-0 fw-bold"><i class="fas fa-file-invoice-dollar text-warning me-2"></i>Soumettre un Devis</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small">Saisissez les informations financières liées à votre commande avant de générer l'aperçu.</p>
                            <a href="{{ path('app_devis_nouveau') }}" class="btn btn-warning w-100 fw-bold text-dark shadow-sm">
                                <i class="fas fa-plus-circle me-1"></i> Rédiger Devis
                            </a>
                        </div>
                    </div>

                    {# Formulaire Bon de Sortie #}
                    <div class="card border-0 shadow-sm mb-4 rounded-3" style="border-top: 4px solid #198754 !important;">
                        <div class="card-header bg-white py-3">
                            <h5 class="card-title m-0 fw-bold"><i class="fas fa-file-invoice text-success me-2"></i>Créer un Bon de Sortie</h5>
                        </div>
                        <div class="card-body">
                            {% if formBon is defined and formBon is not null %}
                                {{ form_start(formBon) }}
                                    {{ form_widget(formBon) }}
                                    <button type="submit" class="btn btn-success w-100 fw-bold mt-3 shadow-sm">Émettre le Bon</button>
                                {{ form_end(formBon) }}
                            {% else %}
                                <div class="alert alert-info mb-0">
                                    <i class="fas fa-info-circle me-2"></i> Vous n’avez pas les droits pour créer un bon de sortie.
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}

            {# --- COLONNE DE DROITE (onglets) --- #}
            <div class="{% if is_granted('ROLE_COORDON') or is_granted('ROLE_STOCK') or is_granted('ROLE_GUERITE') or is_granted('ROLE_DG') %}col-12{% else %}col-xl-8 col-lg-7{% endif %}">
                <div class="card border-0 shadow-sm mb-4 rounded-3 overflow-hidden">
                    <div class="card-header bg-white p-0 border-bottom">
                        <ul class="nav nav-tabs card-header-tabs m-0 border-bottom-0" id="memberTab" role="tablist">
                            {# ONGLET SUIVI DES DEMANDES #}
                            <li class="nav-item">
                                <button class="nav-link active py-3 px-4 fw-bold border-0 text-primary" id="dem-tab" data-bs-toggle="tab" data-bs-target="#dem-pane" type="button" role="tab">
                                    <i class="fas fa-boxes me-2"></i>Suivi des Demandes
                                </button>
                            </li>
                            {# ONGLET REGISTRE DES BONS DE SORTIE #}
                            <li class="nav-item">
                                <button class="nav-link py-3 px-4 fw-bold border-0 text-success" id="bon-tab" data-bs-toggle="tab" data-bs-target="#bon-pane" type="button" role="tab">
                                    <i class="fas fa-file-signature me-2"></i>Registre des Bons de Sortie
                                </button>
                            </li>
                            {# ONGLET DEVIS DU SERVICE (si chef de service) #}
                            <li class="nav-item">
                                <button class="nav-link py-3 px-4 fw-bold border-0 text-warning" id="devis-service-tab" data-bs-toggle="tab" data-bs-target="#devis-service-pane" type="button" role="tab">
                                    <i class="fas fa-file-invoice-dollar me-2"></i>Devis de mon Service
                                </button>
                            </li>
                        </ul>
                    </div>

                    <div class="card-body p-4">
                        <div class="tab-content">

                            {# ==========================================
                               ONGLET : SUIVI DES DEMANDES
                            ========================================== #}
                            <div class="tab-pane fade show active" id="dem-pane" role="tabpanel">
                                <div class="table-responsive">
                                    <table class="table table-hover table-modern align-middle m-0 border rounded">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>Département</th>
                                                <th>Localisation</th>
                                                <th>Matériel</th>
                                                <th class="text-center">Quantité</th>
                                                <th>Statut</th>
                                                {% if is_granted('ROLE_STOCK') %}<th class="text-center">Action Stock</th>{% endif %}
                                            </tr>
                                        </thead>
                                        <tbody class="small">
                                            {% for d in demandes %}
                                                <tr>
                                                    <td class="fw-bold">#{{ d.id }}</td>
                                                    <td><span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1">{{ d.departement }}</span></td>
                                                    <td>
                                                        <span class="badge bg-dark bg-opacity-10 text-dark border px-2 py-1">
                                                            <i class="fas fa-building me-1 text-muted"></i>{{ d.localisation|default('Direction')|upper }}
                                                        </span>
                                                    </td>
                                                    <td class="fw-semibold text-dark">{{ d.materiel }}</td>
                                                    <td class="text-center fw-bold text-primary font-monospace">
                                                        {% if d.materiel|lower == 'gilet' or d.materiel|lower == 'gilets' %}
                                                            {% set p_dem = (d.quantite / 25)|round(0, 'floor') %}
                                                            {% set r_dem = d.quantite % 25 %}
                                                            <span>{{ p_dem }} pqt(s) {% if r_dem > 0 %}{{ r_dem }} u{% endif %}</span>
                                                        {% else %}
                                                            {{ d.quantite|default('1') }}
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <span class="badge px-2.5 py-1.5 {% if 'attente' in d.statut|lower %}bg-warning text-dark{% else %}bg-light text-dark border{% endif %}">
                                                            {{ d.statut }}
                                                        </span>
                                                    </td>
                                                    {% if is_granted('ROLE_STOCK') %}
                                                        <td class="text-center">
                                                            <form action="{{ path('app_demande_livrer', {'id': d.id}) }}" method="POST" class="d-inline">
                                                                <button class="btn btn-sm btn-success fw-bold px-3 shadow-sm"><i class="fas fa-truck me-1"></i> Livrer</button>
                                                            </form>
                                                        </td>
                                                    {% endif %}
                                                </tr>
                                            {% else %}
                                                <tr><td colspan="7" class="text-center py-4 text-muted">Aucune demande logistique enregistrée aujourd'hui.</td></tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            {# ==========================================
                               ONGLET : REGISTRE DES BONS DE SORTIE
                            ========================================== #}
                            <div class="tab-pane fade" id="bon-pane" role="tabpanel">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle m-0">
                                        <thead class="table-light small text-uppercase fw-bold text-secondary">
                                            <tr>
                                                <th>ID</th>
                                                <th>Employé</th>
                                                <th>Département</th>
                                                <th>État du Bon</th>
                                                {% if is_granted('ROLE_COORDON') %}<th class="text-center">Signature Coordon</th>{% endif %}
                                            </tr>
                                        </thead>
                                        <tbody class="small">
                                            {% for b in bonsSortie %}
                                                <tr>
                                                    <td class="fw-bold">#{{ b.id }}</td>
                                                    <td class="fw-semibold text-dark">{{ b.nomEmploye }}</td>
                                                    <td><span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1">{{ b.departement }}</span></td>
                                                    <td><span class="badge rounded-pill px-2.5 py-1 bg-primary text-white">{{ b.statut }}</span></td>
                                                    {% if is_granted('ROLE_COORDON') %}
                                                        <td class="text-center">
                                                            <form action="{{ path('app_bon_valider', {'id': b.id}) }}" method="POST" class="d-inline">
                                                                <button class="btn btn-sm btn-success fw-bold px-3 shadow-sm">
                                                                    <i class="fas fa-pen-fancy me-1"></i> Signer le Bon
                                                                </button>
                                                            </form>
                                                        </td>
                                                    {% endif %}
                                                </tr>
                                            {% else %}
                                                <tr><td colspan="5" class="text-center py-4 text-muted">Aucun bon de sortie en traitement.</td></tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            {# ==========================================
                               ONGLET : DEVIS DU SERVICE
                            ========================================== #}
                            <div class="tab-pane fade" id="devis-service-pane" role="tabpanel">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h5 class="fw-bold text-dark m-0"><i class="fas fa-file-invoice-dollar text-warning me-2"></i>Devis émis par mon service</h5>
            <small class="text-muted">Suivi financier des demandes de budget de votre équipe.</small>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning px-3 py-2 rounded-3 fw-bold">Total USD : {{ totalDevisUSD|default(0)|number_format(2, ',', ' ') }} $</span>
            <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-3 fw-bold">Total CDF : {{ totalDevisCDF|default(0)|number_format(2, ',', ' ') }} FC</span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-modern align-middle border rounded m-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Demandeur (Créateur)</th>
                    <th>Description / Objet</th>
                    <th>Statut</th>
                    <th class="text-end">Montant</th>
                    {% if isChefService %}
                        <th class="text-center">Action</th>
                    {% endif %}
                </tr>
            </thead>
            <tbody class="small">
                {% for devis in devisListe %}
                    <tr>
                        <td class="fw-bold text-secondary">#{{ devis.id }}</td>
                        <td class="text-muted">{{ devis.createdAt|date('d/m/Y') }}</td>
                        <td>
                            <span class="badge bg-white text-dark border px-2 py-1">
                                {{ devis.user ? devis.user.userIdentifier : devis.createdBy }}
                            </span>
                        </td>
                        <td class="fw-semibold text-dark">{{ devis.description }}</td>
                        <td>
                            {% if devis.statut == 'DECAISSE' %}
                                <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1"><i class="fas fa-check-double me-1"></i>Décaissé</span>
                            {% elseif devis.statut == 'REJETE' %}
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1"><i class="fas fa-ban me-1"></i>Rejeté</span>
                            {% elseif devis.statut == 'VALIDÉ_CHEF_SERVICE' %}
                                <span class="badge bg-info bg-opacity-10 text-info border border-info px-2 py-1"><i class="fas fa-check-circle me-1"></i>Validé par Chef</span>
                            {% else %}
                                <span class="badge bg-warning bg-opacity-10 text-dark border border-warning px-2 py-1"><i class="fas fa-clock me-1"></i>{{ devis.statut }}</span>
                            {% endif %}
                        </td>
                        <td class="text-end font-monospace fw-bold text-dark">
                            {{ devis.montant|number_format(2, ',', ' ') }} <span class="small text-muted">{{ devis.devise }}</span>
                        </td>
                        {% if isChefService %}
                            <td class="text-center">
                                {% if devis.statut == 'ATTENTE_TRAITEMENT' %}
                                    <form action="{{ path('app_chef_service_valider_devis', {'id': devis.id}) }}" method="POST" class="d-flex gap-2 justify-content-center align-items-center flex-wrap">
                                        <div class="input-group input-group-sm" style="max-width: 130px;">
                                            <input type="number" step="0.01" name="nouveau_montant" class="form-control form-control-sm text-end fw-bold text-primary" value="{{ devis.montant }}">
                                            <span class="input-group-text bg-light small fw-bold" style="font-size:0.7rem;">{{ devis.devise }}</span>
                                        </div>
                                        <button type="submit" class="btn btn-sm btn-success fw-bold px-3">
                                            <i class="fas fa-check me-1"></i> Valider
                                        </button>
                                    </form>
                                {% elseif devis.statut == 'VALIDÉ_CHEF_SERVICE' %}
                                    <span class="badge bg-info"><i class="fas fa-check-circle me-1"></i> Déjà validé</span>
                                {% else %}
                                    <span class="text-muted small">Non modifiable</span>
                                {% endif %}
                            </td>
                        {% endif %}
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="{% if isChefService %}7{% else %}6{% endif %}" class="text-center py-5 text-muted">
                            <i class="fas fa-folder-open fa-2x mb-2 text-black-50 d-block"></i>
                            Aucun devis enregistré pour les membres de votre service.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div> {# fin tab-content #}
                    </div> {# fin card-body #}
                </div> {# fin card onglets #}

                {# ============================================
                   FORMULAIRE DE VISITE (bas de page)
                ============================================ #}
                {% if not is_granted('ROLE_DG') and not is_granted('ROLE_GUERITE') and formVisite is defined and formVisite is not null %}
                <div class="card border-0 shadow-sm mt-4 rounded-3" style="border-top: 4px solid #ffc107 !important;">
                    <div class="card-header bg-white py-3">
                        <h5 class="card-title m-0 fw-bold text-warning"><i class="fas fa-calendar-alt me-2"></i>Réserver une Visite</h5>
                    </div>
                    <div class="card-body">
                        {{ form_start(formVisite) }}
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label small fw-bold">Nom du Visiteur</label>
                                    {{ form_widget(formVisite.nomVisiteur, {'attr': {'class': 'form-control'}}) }}
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label small fw-bold">Département Visité</label>
                                    {{ form_widget(formVisite.departement, {'attr': {'class': 'form-control'}}) }}
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label small fw-bold">Motif</label>
                                    {{ form_widget(formVisite.motif, {'attr': {'class': 'form-control'}}) }}
                                </div>
                            </div>
                            <button type="submit" class="btn btn-warning fw-bold px-4 text-dark mt-2 shadow-sm">Enregistrer la Visite</button>
                        {{ form_end(formVisite) }}
                    </div>
                </div>
                {% endif %}

            </div> {# fin colonne droite #}
        </div> {# fin row #}
    </div> {# fin container #}

    {# ============================================
       SCRIPTS (un seul bloc)
    ============================================ #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {

            // 1. Obligation de la commune pour les gilets
            const champMateriel = document.getElementById('demande_materiel');
            const champDestination = document.getElementById('demande_destination');
            if (champMateriel && champDestination) {
                function verifierConditionCommune() {
                    const valeurMateriel = champMateriel.value.trim().toLowerCase();
                    if (valeurMateriel.includes('gilet')) {
                        champDestination.setAttribute('required', 'required');
                        champDestination.classList.add('border-danger');
                        const label = champDestination.closest('.mb-3').querySelector('.form-label');
                        if (label && !label.innerHTML.includes('*')) {
                            label.innerHTML = 'Commune de destination <span class="text-danger">*</span>';
                        }
                    } else {
                        champDestination.removeAttribute('required');
                        champDestination.classList.remove('border-danger');
                        const label = champDestination.closest('.mb-3').querySelector('.form-label');
                        if (label) {
                            label.innerHTML = 'Commune de destination (Optionnel)';
                        }
                    }
                }
                champMateriel.addEventListener('input', verifierConditionCommune);
                champMateriel.addEventListener('blur', verifierConditionCommune);
                verifierConditionCommune();
            }

            // 2. Chargement dynamique des attributs par recherche d'article
            const champRecherche = document.getElementById('demande_materiel');
            const attributSelect = document.getElementById('demande_attribut');

            if (champRecherche && attributSelect) {
                let timeoutId = null;

                function chargerAttributs(nom) {
                    if (!nom || nom.length < 2) {
                        attributSelect.innerHTML = '<option value="">Saisissez au moins 2 caractères</option>';
                        attributSelect.disabled = true;
                        return;
                    }

                    fetch('/api/recherche-article?nom=' + encodeURIComponent(nom))
                        .then(response => {
                            if (!response.ok) throw new Error('Erreur réseau');
                            return response.json();
                        })
                        .then(data => {
                            if (data.error) {
                                attributSelect.innerHTML = '<option value="">Erreur serveur</option>';
                                attributSelect.disabled = true;
                                return;
                            }
                            if (!data.found) {
                                attributSelect.innerHTML = '<option value="">Aucun article trouvé</option>';
                                attributSelect.disabled = true;
                                return;
                            }
                            // Article trouvé, on remplit les attributs
                            attributSelect.innerHTML = '<option value="">Choisissez une variante</option>';
                            if (data.attributs.length === 0) {
                                attributSelect.innerHTML = '<option value="">Aucune variante disponible</option>';
                                attributSelect.disabled = true;
                            } else {
                                data.attributs.forEach(attr => {
                                    const option = document.createElement('option');
                                    option.value = attr.id;
                                    option.textContent = attr.valeur;
                                    attributSelect.appendChild(option);
                                });
                                attributSelect.disabled = false;
                            }
                        })
                        .catch(error => {
                            console.error('Erreur lors du chargement des attributs :', error);
                            attributSelect.innerHTML = '<option value="">Erreur de chargement</option>';
                            attributSelect.disabled = true;
                        });
                }

                champRecherche.addEventListener('input', function() {
                    clearTimeout(timeoutId);
                    const nom = this.value.trim();
                    timeoutId = setTimeout(() => {
                        chargerAttributs(nom);
                    }, 500);
                });

                // Si une valeur est déjà préremplie (après validation avec erreur)
                if (champRecherche.value.trim()) {
                    chargerAttributs(champRecherche.value.trim());
                }
            }
        });
    </script>
</body>
</html>
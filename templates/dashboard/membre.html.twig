<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Espace Membre - Dispromalt</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        :root {
            --gradient-1: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --gradient-3: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            --gradient-4: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
            --gradient-5: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            --shadow-soft: 0 4px 20px rgba(0,0,0,0.06);
            --shadow-hover: 0 12px 30px rgba(0,0,0,0.10);
        }
        * { transition: all 0.25s ease; }
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: #f0f2f7;
            background-image:
                radial-gradient(at 0% 0%, rgba(102, 126, 234, 0.08) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(220, 38, 38, 0.06) 0px, transparent 50%);
            min-height: 100vh;
        }
        .navbar-modern { background: rgba(30,41,59,0.98); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255,255,255,0.06); }
        .navbar-brand-modern { font-weight: 800; font-size: 1.4rem; letter-spacing: -0.5px; }
        .notification-bell {
            width: 42px; height: 42px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12);
            color: #fff; position: relative;
        }
        .notification-bell:hover { background: rgba(220,38,38,0.9); transform: scale(1.05); }
        .role-pill {
            background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12);
            color: #e2e8f0; padding: 8px 16px; border-radius: 50px; font-size: 0.85rem;
        }
        .stat-card { border: none; border-radius: 18px; padding: 1.4rem; position: relative; overflow: hidden; background: #fff; box-shadow: var(--shadow-soft); }
        .stat-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--gradient-1); }
        .stat-card.stat-warning::before { background: var(--gradient-5); }
        .stat-card.stat-primary::before { background: var(--gradient-3); }
        .stat-card.stat-success::before { background: var(--gradient-4); }
        .stat-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-hover); }
        .stat-icon { width: 56px; height: 56px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
        .stat-icon-warning { background: rgba(250,112,154,0.12); color: #f5576c; }
        .stat-icon-primary { background: rgba(79,172,254,0.12); color: #3b82f6; }
        .stat-icon-success { background: rgba(67,233,123,0.12); color: #10b981; }
        .main-card { border: none; border-radius: 20px; box-shadow: var(--shadow-soft); background: #fff; overflow: hidden; }
        .nav-tabs-modern { border-bottom: 1px solid #e2e8f0; padding: 0 1rem; gap: 0.25rem; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
        .nav-tabs-modern::-webkit-scrollbar { display: none; }
        .nav-tabs-modern .nav-link {
            border: none !important; color: #64748b; font-weight: 600;
            font-size: 0.9rem; padding: 1rem 1.1rem; white-space: nowrap;
            border-radius: 0; position: relative; background: none;
        }
        .nav-tabs-modern .nav-link:hover { color: #1e293b; }
        .nav-tabs-modern .nav-link.active { color: #1e293b !important; background: none; }
        .nav-tabs-modern .nav-link.active::after {
            content: ''; position: absolute; bottom: -1px; left: 1rem; right: 1rem;
            height: 3px; background: var(--gradient-1); border-radius: 3px 3px 0 0;
        }
        .nav-tabs-modern .nav-link i { margin-right: 0.5rem; }
        .nav-tabs-modern .nav-link .tab-badge {
            background: #ef4444;
            color: #fff;
            padding: 0.15rem 0.5rem;
            border-radius: 999px;
            font-size: 0.68rem;
            font-weight: 800;
            margin-left: 0.35rem;
            animation: pulse 1.8s infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: .6; transform: scale(1.1); }
        }
        .table-modern { margin: 0; }
        .table-modern thead th {
            background: #f8fafc; color: #475569; font-size: 0.72rem;
            font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
            padding: 1rem 0.9rem; border-bottom: 2px solid #e2e8f0; white-space: nowrap;
        }
        .table-modern tbody td { padding: 1rem 0.9rem; vertical-align: middle; border-color: #f1f5f9; }
        .table-modern tbody tr:hover { background: #f8fafc; }
        .badge-soft { padding: 0.4rem 0.75rem; border-radius: 8px; font-weight: 600; font-size: 0.75rem; }
        .badge-soft-warning { background: rgba(250,112,154,0.12); color: #d63384; }
        .badge-soft-primary { background: rgba(79,172,254,0.12); color: #2563eb; }
        .badge-soft-success { background: rgba(67,233,123,0.15); color: #059669; }
        .badge-soft-danger  { background: rgba(220,38,38,0.12); color: #dc2626; }
        .badge-soft-info    { background: rgba(14,165,233,0.12); color: #0284c7; }
        .badge-soft-secondary { background: #f1f5f9; color: #475569; }
        .form-card { border: 1px solid #eef2f7; border-radius: 16px; background: #fff; padding: 1.75rem; }
        .form-card-header {
            display: flex; align-items: center; gap: 0.85rem;
            margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px dashed #e2e8f0;
        }
        .form-card-icon {
            width: 48px; height: 48px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem; flex-shrink: 0;
        }
        .form-card-icon-blue { background: rgba(79,172,254,0.12); color: #2563eb; }
        .form-card-icon-green { background: rgba(67,233,123,0.15); color: #059669; }
        .form-card-icon-yellow { background: rgba(250,210,90,0.18); color: #ca8a04; }
        .form-card-icon-purple { background: rgba(168,85,247,0.12); color: #9333ea; }
        .btn-modern { border-radius: 10px; font-weight: 600; padding: 0.7rem 1.25rem; border: none; }
        .btn-modern:hover { transform: translateY(-2px); box-shadow: 0 8px 16px rgba(0,0,0,0.12); }
        .form-control, .form-select { border-radius: 10px; border: 1px solid #e2e8f0; padding: 0.65rem 0.9rem; font-size: 0.9rem; }
        .form-control:focus, .form-select:focus { border-color: #667eea; box-shadow: 0 0 0 4px rgba(102,126,234,0.10); }
        .empty-state { text-align: center; padding: 3rem 1rem; color: #94a3b8; }
        .empty-state i { font-size: 3rem; color: #cbd5e1; margin-bottom: 1rem; display: block; }
        .page-title { font-weight: 800; font-size: 1.85rem; letter-spacing: -0.5px; color: #1e293b; margin: 0; }
        .page-subtitle { color: #64748b; font-size: 0.95rem; margin: 0; }
        .hero-banner {
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
            border-radius: 20px; padding: 1.75rem 2rem; color: #fff;
            margin-bottom: 1.75rem; position: relative; overflow: hidden;
            box-shadow: 0 12px 30px rgba(30,41,59,0.15);
        }
        .hero-banner::before {
            content: ''; position: absolute; top: -50%; right: -10%;
            width: 380px; height: 380px; border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            opacity: 0.25; filter: blur(60px);
        }
        .hero-banner-content { position: relative; z-index: 1; }
        .hero-badge-chef {
            display: inline-flex; align-items: center; gap: 0.5rem;
            background: rgba(212,175,55,0.15); border: 1px solid rgba(212,175,55,0.3);
            color: #f9d976; padding: 0.4rem 1rem; border-radius: 50px;
            font-size: 0.72rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem;
        }

        .chef-devis-banner {
            background: linear-gradient(135deg, rgba(250,210,90,0.12) 0%, rgba(250,210,90,0.03) 100%);
            border: 1.5px dashed rgba(202, 138, 4, 0.35);
            border-radius: 16px;
            padding: 1.35rem 1.5rem;
            margin-bottom: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .chef-devis-banner-left { display: flex; align-items: center; gap: 1rem; }
        .chef-devis-banner-icon {
            width: 52px; height: 52px;
            border-radius: 14px;
            background: var(--gradient-5);
            color: #fff;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.35rem; flex-shrink: 0;
            box-shadow: 0 6px 16px rgba(250, 112, 154, 0.35);
        }
        .chef-devis-banner-title {
            font-size: 1rem; font-weight: 800;
            color: #1e293b; margin: 0; letter-spacing: -0.2px;
        }
        .chef-devis-banner-subtitle {
            font-size: 0.83rem; color: #64748b;
            margin: 0.15rem 0 0; font-weight: 500;
        }
        .btn-creer-devis {
            background: var(--gradient-5);
            color: #fff; border: none;
            border-radius: 12px;
            padding: 0.75rem 1.4rem;
            font-weight: 700; font-size: 0.92rem;
            display: inline-flex; align-items: center; gap: 0.5rem;
            box-shadow: 0 8px 20px rgba(250, 112, 154, 0.35);
            text-decoration: none; white-space: nowrap;
        }
        .btn-creer-devis:hover {
            color: #fff; transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(250, 112, 154, 0.5);
        }

        .chef-stats-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
        .chef-stat-chip {
            display: inline-flex; align-items: center; gap: 0.5rem;
            padding: 0.55rem 1rem;
            background: #f8fafc; border: 1px solid #e2e8f0;
            border-radius: 10px;
            font-size: 0.82rem; font-weight: 700; color: #475569;
        }
        .chef-stat-chip i { font-size: 0.95rem; }
        .chef-stat-chip.chip-warning { background: rgba(250,112,154,0.08); border-color: rgba(250,112,154,0.25); color: #d63384; }
        .chef-stat-chip.chip-success { background: rgba(67,233,123,0.08); border-color: rgba(67,233,123,0.25); color: #059669; }
        .chef-stat-chip.chip-info    { background: rgba(14,165,233,0.08); border-color: rgba(14,165,233,0.25); color: #0284c7; }

        .bons-section {
            background: linear-gradient(135deg, #fffbeb, #fff);
            border: 2px solid #f59e0b;
            border-radius: 18px;
            overflow: hidden;
            margin-bottom: 1.5rem;
            box-shadow: 0 8px 24px rgba(245, 158, 11, 0.12);
        }
        .bons-section-head {
            background: linear-gradient(135deg, #fef3c7, #fde68a);
            padding: 1.15rem 1.4rem;
            border-bottom: 2px solid rgba(245, 158, 11, 0.3);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }
        .bons-section-head-left { display: flex; align-items: center; gap: 1rem; }
        .bons-section-icon {
            width: 48px; height: 48px;
            border-radius: 13px;
            background: linear-gradient(135deg, #f59e0b, #ef4444);
            color: #fff;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem;
            box-shadow: 0 6px 16px rgba(245, 158, 11, 0.4);
            flex-shrink: 0;
        }
        .bons-section-title {
            font-size: 1rem; font-weight: 800;
            color: #78350f; margin: 0; letter-spacing: -0.2px;
        }
        .bons-section-sub {
            font-size: 0.8rem; color: #92400e;
            margin: 0.1rem 0 0; font-weight: 500;
        }
        .bons-section-count {
            background: #fff;
            color: #b45309;
            padding: 0.45rem 0.95rem;
            border-radius: 999px;
            font-size: 0.76rem;
            font-weight: 800;
            border: 1.5px solid rgba(245, 158, 11, 0.4);
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }
        .bons-section-count .dot-live {
            width: 7px; height: 7px;
            background: #ef4444; border-radius: 50%;
            box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.20);
            animation: pulse 1.8s infinite;
        }
    </style>
</head>
<body>

{# ============================================
   NAVBAR
============================================ #}
<nav class="navbar navbar-expand-lg navbar-modern py-3 sticky-top">
    <div class="container-fluid px-4">
        <a class="navbar-brand navbar-brand-modern text-white d-flex align-items-center" href="#">
            <img src="{{ asset('images/logo.png') }}" alt="Logo Dispromalt" style="height: 40px; width: auto; margin-right: 10px;">
            Dispro<span class="text-primary">malt</span>
            <span class="fw-light fs-6 text-white-50 ms-2">| Espace Opérationnel</span>
        </a>
        <div class="d-flex align-items-center gap-3">
            <div class="dropdown">
                <button class="notification-bell" type="button" id="notificationsMenu" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-bell"></i>
                    {% set totalNotifs = (reunionsDelegation is defined ? reunionsDelegation|length : 0) + (bonsChefService|default([])|length) %}
                    {% if totalNotifs > 0 %}
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.7rem;">{{ totalNotifs }}</span>
                    {% endif %}
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 p-2 mt-3" style="width: 340px;">
                    {% if bonsChefService|default([])|length > 0 %}
                        <li class="dropdown-header fw-bold text-warning border-bottom pb-2 mb-2">
                            <i class="fas fa-hourglass-half me-2"></i>Bons à valider ({{ bonsChefService|length }})
                        </li>
                        {% for bon in bonsChefService|slice(0, 5) %}
                            <li>
                                <a class="dropdown-item p-2 rounded mb-1" href="#pane-bons-chef" data-bs-toggle="tab">
                                    <div class="fw-bold text-dark small">#{{ bon.id }} — {{ bon.nomEmploye }}</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">
                                        <i class="fas fa-building me-1"></i>{{ bon.departement }}
                                    </div>
                                </a>
                            </li>
                        {% endfor %}
                    {% endif %}
                    <li class="dropdown-header fw-bold text-dark border-bottom pb-2 mb-2">
                        <i class="fas fa-calendar-alt text-primary me-2"></i>Réunions / Ordres Délégués
                    </li>
                    {% if reunionsDelegation is defined and reunionsDelegation is not empty %}
                        {% for reunion in reunionsDelegation %}
                            <li>
                                <a class="dropdown-item p-2 rounded mb-1 bg-light" href="#">
                                    <div class="fw-bold text-dark small">{{ reunion.titre }}</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        <i class="far fa-clock me-1"></i>{{ reunion.date|date('d/m/Y H:i') }}
                                    </div>
                                </a>
                            </li>
                        {% endfor %}
                    {% else %}
                        <li class="text-center text-muted py-3 small">
                            <i class="fas fa-check-circle text-success mb-1 d-block"></i>
                            Aucune réunion planifiée.
                        </li>
                    {% endif %}
                </ul>
            </div>
            <div class="role-pill d-none d-md-inline-flex align-items-center">
                <i class="fas fa-user-shield text-info me-2"></i>
                <span class="fw-bold">{{ userRole }}</span>
            </div>
            <a href="/logout" class="btn btn-danger btn-sm fw-bold px-3 rounded-pill">
                <i class="fas fa-sign-out-alt me-1"></i> Déconnexion
            </a>
        </div>
    </div>
</nav>

{# ============================================
   MAIN CONTAINER
============================================ #}
<div class="container-fluid py-4 px-4" style="max-width: 1500px;">

    {# HERO BANNER CHEF DE SERVICE #}
    {% if isChefService|default(false) %}
    <div class="hero-banner">
        <div class="hero-banner-content">
            <div class="hero-badge-chef">
                <i class="fas fa-user-tie"></i>
                Chef de service
            </div>
            <h1 class="fw-bold mb-1" style="font-size: 1.7rem; letter-spacing: -0.5px;">
                Espace de supervision — {{ app.user.service ? app.user.service.nom : 'Service' }}
            </h1>
            <p class="mb-0" style="color: rgba(255,255,255,0.75); font-size: 0.92rem;">
                Validez les demandes de votre équipe et suivez les devis émis par vos collaborateurs.
            </p>
        </div>
    </div>
    {% else %}
    <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1 class="page-title">Espace de Gestion des Flux</h1>
            <p class="page-subtitle">Créez vos demandes, rédigez vos devis et traitez les autorisations logistiques.</p>
        </div>
    </div>
    {% endif %}

    {# Flash Messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show shadow-sm mb-4 border-0 rounded-3" role="alert">
                <i class="fas {{ label == 'danger' ? 'fa-exclamation-triangle' : (label == 'warning' ? 'fa-info-circle' : 'fa-check-circle') }} me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# STATISTIQUES #}
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card stat-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">
                            {% if isChefService|default(false) %}Demandes à valider{% else %}Demandes en attente{% endif %}
                        </h6>
                        <h3 class="fw-bold m-0 text-dark" style="font-size: 2rem;">{{ stats.demandes_attente|default(0) }}</h3>
                    </div>
                    <div class="stat-icon stat-icon-warning"><i class="fas fa-clock"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card stat-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Bons à signer</h6>
                        <h3 class="fw-bold m-0 text-dark" style="font-size: 2rem;">{{ stats.bons_a_valider|default(0) }}</h3>
                    </div>
                    <div class="stat-icon stat-icon-primary"><i class="fas fa-pen-nib"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card stat-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Bons validés Guérite</h6>
                        <h3 class="fw-bold m-0 text-dark" style="font-size: 2rem;">{{ stats.bons_guerite|default(0) }}</h3>
                    </div>
                    <div class="stat-icon stat-icon-success"><i class="fas fa-shield-alt"></i></div>
                </div>
            </div>
        </div>
    </div>

    {# ============================================
       CARTE PRINCIPALE À ONGLETS
    ============================================ #}
    <div class="main-card">
        <ul class="nav nav-tabs nav-tabs-modern" id="mainTabs" role="tablist">

            {% if isChefService|default(false) %}
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-devis-service" data-bs-toggle="tab" data-bs-target="#pane-devis-service" type="button" role="tab">
                    <i class="fas fa-file-invoice-dollar text-warning"></i>Devis du service
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-demandes" data-bs-toggle="tab" data-bs-target="#pane-demandes" type="button" role="tab">
                    <i class="fas fa-boxes text-primary"></i>Demandes à valider
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-bons-chef" data-bs-toggle="tab" data-bs-target="#pane-bons-chef" type="button" role="tab">
                    <i class="fas fa-file-signature text-warning"></i>Bons à valider
                    {% if bonsChefService|default([])|length > 0 %}
                        <span class="tab-badge">{{ bonsChefService|length }}</span>
                    {% endif %}
                </button>
            </li>

            {% if is_granted('ROLE_STOCK') or is_granted('ROLE_COORDON') or is_granted('ROLE_GUERITE') or is_granted('ROLE_COMPTA') or is_granted('ROLE_DG') %}
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-bons" data-bs-toggle="tab" data-bs-target="#pane-bons" type="button" role="tab">
                    <i class="fas fa-file-signature text-success"></i>Registre Bons
                </button>
            </li>
            {% endif %}
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-ma-demande" data-bs-toggle="tab" data-bs-target="#pane-ma-demande" type="button" role="tab">
                    <i class="fas fa-plus-circle text-primary"></i>Ma Demande
                </button>
            </li>
            {% else %}
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-demandes" data-bs-toggle="tab" data-bs-target="#pane-demandes" type="button" role="tab">
                    <i class="fas fa-boxes text-primary"></i>Suivi des Demandes
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-mes-devis" data-bs-toggle="tab" data-bs-target="#pane-mes-devis" type="button" role="tab">
                    <i class="fas fa-file-invoice-dollar text-warning"></i>Mes Devis
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-new-demande" data-bs-toggle="tab" data-bs-target="#pane-new-demande" type="button" role="tab">
                    <i class="fas fa-plus-circle text-primary"></i>Nouvelle Demande
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-new-bon" data-bs-toggle="tab" data-bs-target="#pane-new-bon" type="button" role="tab">
                    <i class="fas fa-plus-circle text-success"></i>Nouveau Bon
                </button>
            </li>
            {% endif %}

            {% if not is_granted('ROLE_DG') and not is_granted('ROLE_GUERITE') and formVisite is defined and formVisite is not null %}
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-visite" data-bs-toggle="tab" data-bs-target="#pane-visite" type="button" role="tab">
                        <i class="fas fa-calendar-alt text-warning"></i>Réserver Visite
                    </button>
                </li>
            {% endif %}
        </ul>

        <div class="p-4">
            <div class="tab-content">

                {# ============================================================
                   ONGLET CHEF : DEVIS DU SERVICE
                ============================================================ #}
                {% if isChefService|default(false) %}
                <div class="tab-pane fade show active" id="pane-devis-service" role="tabpanel">

                    <div class="chef-devis-banner">
                        <div class="chef-devis-banner-left">
                            <div class="chef-devis-banner-icon">
                                <i class="fas fa-file-invoice-dollar"></i>
                            </div>
                            <div>
                                <h5 class="chef-devis-banner-title">Gestion des devis de mon service</h5>
                                <p class="chef-devis-banner-subtitle">
                                    Créez vos propres devis, validez et ajustez ceux émis par vos collaborateurs.
                                </p>
                            </div>
                        </div>
                        <a href="{{ path('app_devis_nouveau') }}" class="btn-creer-devis">
                            <i class="fas fa-plus-circle"></i>
                            Rédiger un Devis
                        </a>
                    </div>

                    <div class="chef-stats-row">
                        <span class="chef-stat-chip chip-warning">
                            <i class="fas fa-clock"></i>
                            En attente :
                            {% set nb_attente = 0 %}
                            {% for devis in devisListe %}
                                {% if devis.statut == 'ATTENTE_TRAITEMENT' or devis.statut == 'ATTENTE_CHEF_COMPTA' %}
                                    {% set nb_attente = nb_attente + 1 %}
                                {% endif %}
                            {% endfor %}
                            {{ nb_attente }}
                        </span>
                        <span class="chef-stat-chip chip-success">
                            <i class="fas fa-dollar-sign"></i>
                            Total USD : {{ totalDevisUSD|default(0)|number_format(2, ',', ' ') }}
                        </span>
                        <span class="chef-stat-chip chip-success">
                            <i class="fas fa-coins"></i>
                            Total CDF : {{ totalDevisCDF|default(0)|number_format(2, ',', ' ') }}
                        </span>
                        <span class="chef-stat-chip chip-info">
                            <i class="fas fa-list"></i>
                            Total : {{ devisListe|length }} devis
                        </span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-modern table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Date</th>
                                    <th>Émetteur</th>
                                    <th>Description</th>
                                    <th>Statut</th>
                                    <th class="text-end">Montant</th>
                                    <th class="text-center">Action Chef</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for devis in devisListe %}
                                    <tr>
                                        <td class="fw-bold text-secondary">#{{ devis.id }}</td>
                                        <td class="text-muted small">{{ devis.createdAt|date('d/m/Y') }}</td>
                                        <td>
                                            <span class="badge badge-soft badge-soft-secondary">
                                                <i class="fas fa-user me-1"></i>{{ devis.user ? devis.user.userIdentifier : devis.createdBy }}
                                            </span>
                                        </td>
                                        <td class="fw-semibold text-dark">{{ devis.description }}</td>
                                        <td>
                                            {% if devis.statut == 'DECAISSE' %}
                                                <span class="badge badge-soft badge-soft-success"><i class="fas fa-check-double me-1"></i>Décaissé</span>
                                            {% elseif devis.statut == 'REJETE' %}
                                                <span class="badge badge-soft badge-soft-danger"><i class="fas fa-ban me-1"></i>Rejeté</span>
                                            {% elseif devis.statut == 'VALIDÉ_CHEF_SERVICE' %}
                                                <span class="badge badge-soft badge-soft-info"><i class="fas fa-check-circle me-1"></i>Transmis au DG</span>
                                            {% elseif devis.statut == 'ATTENTE_DIRECTION' %}
                                                <span class="badge badge-soft badge-soft-primary"><i class="fas fa-hourglass-half me-1"></i>Chez le DG</span>
                                            {% else %}
                                                <span class="badge badge-soft badge-soft-warning"><i class="fas fa-clock me-1"></i>En attente validation</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-end font-monospace fw-bold text-dark">
                                            {{ devis.montant|number_format(2, ',', ' ') }}
                                            <span class="small text-muted">{{ devis.devise }}</span>
                                        </td>
                                        <td class="text-center">
                                            {% if devis.statut == 'ATTENTE_TRAITEMENT' or devis.statut == 'ATTENTE_CHEF_COMPTA' %}
                                                <form action="{{ path('app_chef_service_valider_devis', {'id': devis.id}) }}" method="POST" class="d-flex gap-2 justify-content-center align-items-center flex-wrap">
                                                    <div class="input-group input-group-sm" style="max-width: 130px;">
                                                        <input type="number" step="0.01" name="nouveau_montant" class="form-control text-end fw-bold text-primary" value="{{ devis.montant }}">
                                                        <span class="input-group-text bg-light small fw-bold" style="font-size: 0.7rem;">{{ devis.devise }}</span>
                                                    </div>
                                                    <button type="submit" class="btn btn-sm btn-success fw-bold rounded-pill px-3">
                                                        <i class="fas fa-check me-1"></i> Transmettre
                                                    </button>
                                                </form>
                                            {% elseif devis.statut == 'VALIDÉ_CHEF_SERVICE' %}
                                                <span class="badge badge-soft badge-soft-info">
                                                    <i class="fas fa-check-circle me-1"></i> Transmis au DG
                                                </span>
                                            {% else %}
                                                <span class="text-muted small">Non modifiable</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="7">
                                            <div class="empty-state">
                                                <i class="fas fa-folder-open"></i>
                                                <div class="fw-bold">Aucun devis dans mon service</div>
                                                <small>Cliquez sur "Rédiger un Devis" pour créer votre premier devis.</small>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {# ============================================================
                   🎯 ONGLET DÉDIÉ : BONS À VALIDER PAR LE CHEF
                ============================================================ #}
                <div class="tab-pane fade" id="pane-bons-chef" role="tabpanel">

                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark m-0">
                                <i class="fas fa-hourglass-half text-warning me-2"></i>
                                Bons de sortie à valider
                            </h5>
                            <small class="text-muted">
                                Bons qui vous ont été délégués par l'accueil — action requise
                            </small>
                        </div>
                        {% if bonsChefService|default([])|length > 0 %}
                            <span class="badge badge-soft badge-soft-warning px-3 py-2" style="font-size:0.8rem;">
                                <i class="fas fa-bell me-1"></i>
                                {{ bonsChefService|length }} en attente
                            </span>
                        {% endif %}
                    </div>

                    {% if bonsChefService|default([])|length > 0 %}

                        <div class="bons-section">
                            <div class="bons-section-head">
                                <div class="bons-section-head-left">
                                    <div class="bons-section-icon">
                                        <i class="fas fa-file-signature"></i>
                                    </div>
                                    <div>
                                        <h5 class="bons-section-title">Liste des bons à traiter</h5>
                                        <p class="bons-section-sub">
                                            Validez ou rejetez chaque bon ci-dessous
                                        </p>
                                    </div>
                                </div>
                                <span class="bons-section-count">
                                    <span class="dot-live"></span>
                                    {{ bonsChefService|length }} bon(s)
                                </span>
                            </div>

                            <div class="table-responsive">
                                <table class="table mb-0" style="font-size: 0.9rem;">
                                    <thead style="background: #f8fafc;">
                                        <tr>
                                            <th style="padding:1rem;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:#475569;border-bottom:2px solid #e2e8f0;">ID</th>
                                            <th style="padding:1rem;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:#475569;border-bottom:2px solid #e2e8f0;">Employé</th>
                                            <th style="padding:1rem;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:#475569;border-bottom:2px solid #e2e8f0;">Département</th>
                                            <th style="padding:1rem;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:#475569;border-bottom:2px solid #e2e8f0;">Motif</th>
                                            <th style="padding:1rem;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:#475569;border-bottom:2px solid #e2e8f0;">Date</th>
                                            <th style="padding:1rem;font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;color:#475569;border-bottom:2px solid #e2e8f0;" class="text-center">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for bon in bonsChefService %}
                                            <tr style="border-bottom:1px solid #f1f5f9;">
                                                <td style="padding:1rem;font-weight:700;color:#0a0f1e;">
                                                    #{{ bon.id }}
                                                </td>
                                                <td style="padding:1rem;">
                                                    <span class="badge" style="background:#e0e7ff;color:#3730a3;padding:.4rem .75rem;border-radius:8px;font-weight:600;">
                                                        <i class="fas fa-user me-1"></i>{{ bon.nomEmploye }}
                                                    </span>
                                                </td>
                                                <td style="padding:1rem;">
                                                    <span class="badge" style="background:#cffafe;color:#0e7490;padding:.4rem .75rem;border-radius:8px;font-weight:600;">
                                                        {{ bon.departement }}
                                                    </span>
                                                </td>
                                                <td style="padding:1rem;color:#64748b;font-size:.85rem;">
                                                    {{ bon.raison|default(bon.motif|default('—')) }}
                                                </td>
                                                <td style="padding:1rem;color:#64748b;font-size:.82rem;">
                                                    {{ bon.dateCreation ? bon.dateCreation|date('d/m/Y H:i') : '—' }}
                                                </td>
                                                <td style="padding:1rem;text-align:center;">
                                                    <div class="d-flex justify-content-center gap-2 flex-wrap">

                                                        {# ✅ VALIDER #}
                                                        <form action="{{ path('app_chef_service_bon_valider', {'id': bon.id}) }}"
                                                              method="POST"
                                                              class="d-inline"
                                                              onsubmit="return confirm('Valider ce bon de sortie ?\n\nIl sera transmis au coordonnateur.');">
                                                            <button type="submit"
                                                                    class="btn btn-sm fw-bold"
                                                                    style="background:linear-gradient(135deg,#10b981,#059669);color:#fff;border:none;border-radius:8px;padding:.5rem 1rem;font-size:.78rem;box-shadow:0 4px 12px rgba(16,185,129,.3);">
                                                                <i class="fas fa-check me-1"></i>Valider
                                                            </button>
                                                        </form>

                                                        {# ❌ REJETER — ouvre la modal #}
                                                        <button type="button"
                                                                class="btn btn-sm fw-bold"
                                                                style="background:#fff;color:#dc2626;border:1.5px solid #fecaca;border-radius:8px;padding:.5rem 1rem;font-size:.78rem;"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#modalRejetBonChef"
                                                                data-bon-id="{{ bon.id }}"
                                                                data-bon-employe="{{ bon.nomEmploye }}">
                                                            <i class="fas fa-ban me-1"></i>Rejeter
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    {% else %}
                        <div class="empty-state">
                            <i class="fas fa-check-circle" style="color:#10b981;"></i>
                            <div class="fw-bold">Aucun bon en attente</div>
                            <small>Tous les bons qui vous ont été délégués ont été traités.</small>
                        </div>
                    {% endif %}
                </div>

                {# ═══════════════════════════════════════════════════════════════
                   MODAL : Motif de rejet
                ═══════════════════════════════════════════════════════════════ #}
                <div class="modal fade" id="modalRejetBonChef" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="border:none;border-radius:18px;overflow:hidden;box-shadow:0 24px 60px rgba(15,23,42,.25);">

                            <div class="modal-header" style="background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;border:none;padding:1.25rem 1.5rem;">
                                <h5 class="modal-title fw-bold mb-0">
                                    <i class="fas fa-ban me-2"></i>Rejeter le bon
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>

                            <form id="formRejetBonChef" method="POST">
                                <div class="modal-body p-4">

                                    <div class="mb-3 p-3 rounded-3" style="background:#fef2f2;border:1px solid #fecaca;">
                                        <div class="small" style="color:#991b1b;">
                                            <strong><i class="fas fa-file-signature me-1"></i>Bon concerné :</strong>
                                            <span id="rejetBonRecap">#— — —</span>
                                        </div>
                                    </div>

                                    <label class="form-label small fw-bold text-secondary text-uppercase">
                                        Motif du rejet <span style="color:#ef4444;">*</span>
                                    </label>
                                    <textarea name="motif_rejet"
                                              class="form-control"
                                              rows="3"
                                              required
                                              placeholder="Expliquez pourquoi ce bon est rejeté…"
                                              style="border:1.5px solid #e2e8f0;border-radius:10px;font-size:.9rem;"></textarea>

                                    <small class="text-muted d-block mt-2" style="font-size:.78rem;">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Le motif sera enregistré et consultable par l'accueil.
                                    </small>
                                </div>

                                <div class="modal-footer border-0 p-4 pt-0 gap-2">
                                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                                        Annuler
                                    </button>
                                    <button type="submit"
                                            class="btn fw-bold rounded-pill px-4"
                                            style="background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;border:none;">
                                        <i class="fas fa-ban me-1"></i>Confirmer le rejet
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                {# ============================================================
                   ONGLET CHEF : MA NOUVELLE DEMANDE (STRUCTURE CORRIGÉE)
                ============================================================ #}
                <div class="tab-pane fade" id="pane-ma-demande" role="tabpanel">

                    <div class="chef-devis-banner mb-4" style="border-color: rgba(79,172,254,0.35);">
                        <div class="chef-devis-banner-left">
                            <div class="chef-devis-banner-icon" style="background: var(--gradient-3);">
                                <i class="fas fa-box-open"></i>
                            </div>
                            <div>
                                <h5 class="chef-devis-banner-title">Créer ma propre demande de matériel</h5>
                                <p class="chef-devis-banner-subtitle">
                                    Remplissez le formulaire pour soumettre une demande au nom de votre service.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-lg-8">
                            <div class="form-card">
                                <div class="form-card-header">
                                    <div class="form-card-icon form-card-icon-blue">
                                        <i class="fas fa-box-open"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold m-0 text-dark">Ma demande de matériel</h5>
                                        <small class="text-muted">La demande sera transmise à la comptabilité après validation.</small>
                                    </div>
                                </div>

                                {% if formDemande is defined and formDemande is not null %}
                                    {{ form_start(formDemande, {'attr': {'autocomplete': 'off', 'id': 'form-demande-chef'}}) }}

                                        <div class="row">
                                            <div class="col-md-8 mb-3">
                                                {{ form_label(formDemande.materiel, null, {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                                {{ form_widget(formDemande.materiel, {'attr': {
                                                    'class': 'form-control demande-materiel-input',
                                                    'placeholder': 'Tapez le nom de l\'article',
                                                    'autocomplete': 'off',
                                                    'autocorrect': 'off',
                                                    'autocapitalize': 'off',
                                                    'spellcheck': 'false'
                                                }}) }}
                                            </div>
                                            <div class="col-md-4 mb-3">
                                                {{ form_label(formDemande.quantite, null, {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                                {{ form_widget(formDemande.quantite, {'attr': {'class': 'form-control'}}) }}
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                {{ form_label(formDemande.attribut, null, {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                                {{ form_widget(formDemande.attribut, {'attr': {
                                                    'class': 'form-select demande-attribut-select'
                                                }}) }}
                                            </div>
                                            {% if formDemande.destination is defined %}
                                                <div class="col-md-6 mb-3">
                                                    {{ form_label(formDemande.destination, null, {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                                    {{ form_widget(formDemande.destination, {'attr': {'class': 'form-select'}}) }}
                                                </div>
                                            {% endif %}
                                        </div>

                                        {{ form_rest(formDemande) }}

                                        {# 🔍 AFFICHAGE DES ERREURS #}
                                        {% if formDemande.vars.errors|length > 0 %}
                                            <div class="alert alert-danger rounded-3 border-0 mt-3 mb-2" style="font-size:0.85rem;">
                                                <i class="fas fa-exclamation-triangle me-2"></i>
                                                <strong>Erreurs à corriger :</strong>
                                                <ul class="mb-0 mt-2" style="padding-left:1rem;">
                                                    {% for error in formDemande.vars.errors %}
                                                        <li>{{ error.message }}</li>
                                                    {% endfor %}
                                                </ul>
                                            </div>
                                        {% endif %}

                                        <button type="submit" class="btn btn-modern btn-primary w-100 mt-2">
                                            <i class="fas fa-paper-plane me-2"></i>Envoyer ma Demande
                                        </button>

                                    {{ form_end(formDemande) }}
                                {% else %}
                                    <div class="alert alert-info mb-0 rounded-3">
                                        <i class="fas fa-info-circle me-2"></i> Formulaire de demande indisponible.
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="form-card h-100">
                                <div class="form-card-header">
                                    <div class="form-card-icon form-card-icon-yellow">
                                        <i class="fas fa-lightbulb"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold m-0 text-dark">Bon à savoir</h5>
                                        <small class="text-muted">Informations utiles</small>
                                    </div>
                                </div>
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-3 d-flex">
                                        <i class="fas fa-check-circle text-success me-2 mt-1"></i>
                                        <span class="small text-muted">Votre demande sera transmise à la comptabilité après validation.</span>
                                    </li>
                                    <li class="mb-3 d-flex">
                                        <i class="fas fa-check-circle text-success me-2 mt-1"></i>
                                        <span class="small text-muted">Pour les gilets, précisez la commune de destination.</span>
                                    </li>
                                    <li class="d-flex">
                                        <i class="fas fa-check-circle text-success me-2 mt-1"></i>
                                        <span class="small text-muted">Le stock disponible est vérifié automatiquement.</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}

                {# ============================================================
                   ONGLET DEMANDES
                ============================================================ #}
                <div class="tab-pane fade {% if not isChefService|default(false) %}show active{% endif %}" id="pane-demandes" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark m-0">
                                <i class="fas fa-boxes text-primary me-2"></i>
                                {% if isChefService|default(false) %}Demandes à valider — {{ app.user.service ? app.user.service.nom : '' }}{% else %}Suivi des demandes{% endif %}
                            </h5>
                            <small class="text-muted">
                                {% if isChefService|default(false) %}Demandes de votre équipe en attente de validation.{% else %}Vos demandes de matériel en cours.{% endif %}
                            </small>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-modern table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Département</th>
                                    <th>Matériel</th>
                                    <th class="text-center">Quantité</th>
                                    <th>Statut</th>
                                    {% if isChefService|default(false) %}<th class="text-center">Action Chef</th>{% endif %}
                                    {% if is_granted('ROLE_STOCK') %}<th class="text-center">Action Stock</th>{% endif %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for d in demandes %}
                                    <tr>
                                        <td class="fw-bold text-secondary">#{{ d.id }}</td>
                                        <td><span class="badge badge-soft badge-soft-secondary">{{ d.departement }}</span></td>
                                        <td class="fw-semibold text-dark">{{ d.materiel }}</td>
                                        <td class="text-center fw-bold text-primary font-monospace">
                                            {% if d.materiel|lower == 'gilet' or d.materiel|lower == 'gilets' %}
                                                {% set p_dem = (d.quantite / 25)|round(0, 'floor') %}
                                                {% set r_dem = d.quantite % 25 %}
                                                <span>{{ p_dem }} pqt(s) {% if r_dem > 0 %}{{ r_dem }} u{% endif %}</span>
                                            {% else %}
                                                {{ d.quantite|default('1') }}
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if 'attente' in d.statut|lower %}
                                                <span class="badge badge-soft badge-soft-warning"><i class="fas fa-clock me-1"></i>{{ d.statut }}</span>
                                            {% elseif 'validé chef' in d.statut|lower %}
                                                <span class="badge badge-soft badge-soft-primary"><i class="fas fa-check-circle me-1"></i>{{ d.statut }}</span>
                                            {% else %}
                                                <span class="badge badge-soft badge-soft-info"><i class="fas fa-circle me-1" style="font-size: 0.5rem;"></i>{{ d.statut }}</span>
                                            {% endif %}
                                        </td>
                                        {% if isChefService|default(false) %}
                                            <td class="text-center">
                                                {% if d.statut == 'En attente' %}
                                                    <form action="{{ path('app_chef_service_traiter', {'id': d.id}) }}" method="POST" class="d-inline-flex gap-1">
                                                        <button type="submit" name="action" value="valider" class="btn btn-sm btn-success fw-bold rounded-pill px-3" title="Valider la demande">
                                                            <i class="fas fa-check me-1"></i> Valider
                                                        </button>
                                                        <button type="submit" name="action" value="rejeter" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Rejeter"
                                                                onclick="return confirm('Rejeter cette demande ?');">
                                                            <i class="fas fa-times"></i>
                                                        </button>
                                                    </form>
                                                {% else %}
                                                    <span class="text-muted small">—</span>
                                                {% endif %}
                                            </td>
                                        {% endif %}
                                        {% if is_granted('ROLE_STOCK') %}
                                            <td class="text-center">
                                                <form action="{{ path('app_demande_livrer', {'id': d.id}) }}" method="POST" class="d-inline">
                                                    <button class="btn btn-sm btn-success fw-bold rounded-pill px-3">
                                                        <i class="fas fa-truck me-1"></i> Livrer

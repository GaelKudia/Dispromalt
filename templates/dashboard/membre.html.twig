</div>

{# ============================================
   SCRIPTS
============================================ #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {

        // ============================================================
        // 1. Gestion de la recherche d'articles (multi-formulaires)
        // ============================================================
        document.querySelectorAll('.demande-materiel-input').forEach(champMateriel => {
            // Trouver les champs associés dans le MÊME form
            const form = champMateriel.closest('form');
            if (!form) return;

            const attributSelect = form.querySelector('.demande-attribut-select');
            const champDestination = form.querySelector('select[id$="_destination"]');

            if (!attributSelect) return;

            let timeoutId = null;
            let lastQuery = '';

            async function chargerAttributs(nom) {
                if (!nom || nom.length < 2) {
                    attributSelect.innerHTML = '<option value="">Saisissez au moins 2 caractères</option>';
                    attributSelect.disabled = false;
                    return;
                }

                attributSelect.innerHTML = '<option value="">Recherche en cours…</option>';
                attributSelect.disabled = false;

                try {
                    const r = await fetch('/api/recherche-article?nom=' + encodeURIComponent(nom));
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    const data = await r.json();

                    if (!data.found) {
                        attributSelect.innerHTML = '<option value="">Aucun article trouvé — vous pouvez envoyer quand même</option>';
                        attributSelect.disabled = false;
                        return;
                    }

                    if (data.attributs.length === 0) {
                        attributSelect.innerHTML = '<option value="">Aucune variante disponible</option>';
                        attributSelect.disabled = false;
                    } else {
                        attributSelect.innerHTML = '<option value="">-- Choisissez la variante / couleur --</option>';
                        data.attributs.forEach(attr => {
                            const option = document.createElement('option');
                            option.value = attr.id;
                            option.textContent = attr.valeur;
                            attributSelect.appendChild(option);
                        });
                        attributSelect.disabled = false;
                    }
                } catch (e) {
                    console.error('Erreur recherche article:', e);
                    attributSelect.innerHTML = '<option value="">Erreur — vous pouvez envoyer quand même</option>';
                    attributSelect.disabled = false;
                }
            }

            // Debounce 300ms + évite les doublons
            champMateriel.addEventListener('input', function() {
                const val = this.value.trim();
                if (val === lastQuery) return;
                lastQuery = val;
                clearTimeout(timeoutId);
                timeoutId = setTimeout(() => chargerAttributs(val), 300);
            });

            // Force le chargement au blur
            champMateriel.addEventListener('blur', function() {
                clearTimeout(timeoutId);
                const nom = this.value.trim();
                if (nom.length >= 2 && attributSelect.options.length <= 1) {
                    chargerAttributs(nom);
                }
            });

            // Obligation commune pour gilets
            if (champDestination) {
                function verifierCommuneGilet() {
                    const val = champMateriel.value.trim().toLowerCase();
                    if (val.includes('gilet')) {
                        champDestination.setAttribute('required', 'required');
                        champDestination.classList.add('border-danger');
                    } else {
                        champDestination.removeAttribute('required');
                        champDestination.classList.remove('border-danger');
                    }
                }
                champMateriel.addEventListener('input', verifierCommuneGilet);
                champMateriel.addEventListener('blur', verifierCommuneGilet);
                verifierCommuneGilet();
            }
        });

        // ============================================================
        // 2. Empêcher l'autocomplete navigateur de bloquer le 1er clic
        // ============================================================
        document.querySelectorAll('input[type="text"], input[type="email"]').forEach(input => {
            input.setAttribute('autocomplete', 'off');
            input.setAttribute('autocorrect', 'off');
            input.setAttribute('autocapitalize', 'off');
            input.setAttribute('spellcheck', 'false');
        });

        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', function() {
                // Fermer les dropdowns autocomplete ouverts
                if (document.activeElement && document.activeElement.blur) {
                    document.activeElement.blur();
                }
            });
        });

        // ============================================================
        // 3. Mémorisation de l'onglet actif via l'URL
        // ============================================================
        const urlHash = window.location.hash;
        if (urlHash) {
            const triggerEl = document.querySelector(`button[data-bs-target="${urlHash}"]`);
            if (triggerEl) new bootstrap.Tab(triggerEl).show();
        }
        document.querySelectorAll('#mainTabs button[data-bs-toggle="tab"]').forEach(btn => {
            btn.addEventListener('shown.bs.tab', e => {
                history.replaceState(null, null, e.target.dataset.bsTarget);
            });
        });

        // ============================================================
        // 4. MODAL DE REJET — alimenter les infos du bon
        // ============================================================
        const modalRejet = document.getElementById('modalRejetBonChef');
        if (modalRejet) {
            modalRejet.addEventListener('show.bs.modal', function (event) {
                const btn     = event.relatedTarget;
                const bonId   = btn.getAttribute('data-bon-id');
                const employe = btn.getAttribute('data-bon-employe');

                document.getElementById('rejetBonRecap').textContent = `#${bonId} — ${employe}`;
                document.getElementById('formRejetBonChef').action =
                    '/dashboard/chef-service/bon/rejeter/' + bonId;
            });
        }
    });
</script>
</body>
</html>
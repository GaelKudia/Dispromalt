{% extends 'base.html.twig' %}
{% block title %}Planning PDG - Dispromalt{% endblock %}

{% block main_content %}
<div class="container-fluid py-4">

    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">
                    <i class="fa-solid fa-calendar-days text-primary me-2"></i>Planning des RDV du PDG
                </h1>
                <p class="text-muted mb-0">Nombre de visites par jour et gestion des réunions.</p>
            </div>
            <a href="{{ path('app_caisse_rdv_nouveau') }}" class="btn btn-primary shadow-sm">
                <i class="fa-solid fa-plus me-1"></i> Programmer une réunion
            </a>
        </div>
    </div>

    {# Filtre par jour #}
    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted">Choisir une date</label>
                    <input type="date" name="jour" value="{{ jour }}" class="form-control">
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100">
                        <i class="fa-solid fa-search me-1"></i> Voir
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="alert alert-info rounded-4 shadow-sm">
        <i class="fa-solid fa-info-circle me-2"></i>
        <strong>{{ nbJour }}</strong> rendez-vous PDG programmé(s) le <strong>{{ jour }}</strong>.
    </div>

    {# Stats semaine #}
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white rounded-top-4">
            <h5 class="mb-0 fw-semibold">
                <i class="fa-solid fa-chart-bar text-primary me-2"></i>Nombre de RDV PDG cette semaine
            </h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Jour</th>
                            <th class="text-center">Nombre de RDV</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for s in statsSemaine %}
                        <tr>
                            <td>{{ s.jour }}</td>
                            <td class="text-center">
                                <span class="badge bg-primary">{{ s.nb }}</span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2" class="text-muted text-center py-3">
                                Aucun RDV cette semaine.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# Liste des RDV du jour #}
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white rounded-top-4">
            <h5 class="mb-0 fw-semibold">
                <i class="fa-solid fa-list text-success me-2"></i>RDV du jour
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Heure</th>
                        <th>Visiteur</th>
                        <th>Motif</th>
                        <th>Statut</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for v in visitesDuJour %}
                    <tr>
                        <td>
                            <span class="badge bg-dark">
                                {{ v.dateArrivee ? v.dateArrivee|date('H:i') : '—' }}
                            </span>
                        </td>
                        <td class="fw-semibold">{{ v.nomVisiteur }}</td>
                        <td>{{ v.motif ?? '—' }}</td>
                        <td>
                            {% if v.statut == 'DELEGUE' %}
                                <span class="badge bg-warning text-dark">
                                    <i class="fa-solid fa-share me-1"></i>
                                    Délégué à {{ v.responsableDelegue ? v.responsableDelegue.userIdentifier : '' }}
                                </span>
                            {% else %}
                                <span class="badge bg-info text-dark">{{ v.statut }}</span>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            <a href="{{ path('app_caisse_rdv_imprimer', {id: v.id}) }}"
                               target="_blank"
                               class="btn btn-sm btn-outline-secondary"
                               title="Imprimer">
                                <i class="fa-solid fa-print"></i>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            <i class="fa-solid fa-calendar-xmark fa-2x d-block mb-2 opacity-50"></i>
                            Aucun RDV pour ce jour.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
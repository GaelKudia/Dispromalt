{% extends 'base.html.twig' %}
{% block title %}Mes mouvements de caisse - Dispromalt{% endblock %}

{% block main_content %}
<div class="container-fluid py-4">

    {# En-tête #}
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">
                    <i class="fa-solid fa-cash-register text-primary me-2"></i>Mes mouvements
                </h1>
                <p class="text-muted mb-0">
                    Historique de vos propres encaissements et décaissements
                    <span class="badge bg-secondary ms-1">{{ app.user.userIdentifier }}</span>
                </p>
            </div>
            <div class="d-flex gap-2">
                <a href="{{ path('app_caisse_entree') }}" class="btn btn-success shadow-sm">
                    <i class="fa-solid fa-plus me-1"></i> Nouvelle entrée
                </a>
                <a href="{{ path('app_caisse_rapport_imprimer', {date_debut: date_debut, date_fin: date_fin}) }}"
                   target="_blank" class="btn btn-outline-primary shadow-sm">
                    <i class="fa-solid fa-print me-1"></i> Imprimer mon rapport
                </a>
            </div>
        </div>
    </div>

    {# Soldes personnels du caissier connecté #}
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size:0.7rem;">
                                Mon solde USD
                            </h6>
                            <h3 class="fw-bold m-0 text-success">
                                {{ soldeUSD|number_format(2, ',', ' ') }} $
                            </h3>
                        </div>
                        <i class="fa-solid fa-dollar-sign fa-2x text-success opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size:0.7rem;">
                                Mon solde CDF
                            </h6>
                            <h3 class="fw-bold m-0 text-primary">
                                {{ soldeCDF|number_format(2, ',', ' ') }} FC
                            </h3>
                        </div>
                        <i class="fa-solid fa-coins fa-2x text-primary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Filtres #}
    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Du</label>
                    <input type="date" name="date_debut" value="{{ date_debut }}" class="form-control">
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Au</label>
                    <input type="date" name="date_fin" value="{{ date_fin }}" class="form-control">
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Devise</label>
                    <select name="devise" class="form-select">
                        <option value="">Toutes</option>
                        <option value="USD" {% if devise == 'USD' %}selected{% endif %}>USD</option>
                        <option value="CDF" {% if devise == 'CDF' %}selected{% endif %}>CDF</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Type</label>
                    <select name="type" class="form-select">
                        <option value="">Tous</option>
                        <option value="ENTREE" {% if type == 'ENTREE' %}selected{% endif %}>Entrée</option>
                        <option value="SORTIE" {% if type == 'SORTIE' %}selected{% endif %}>Sortie</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100">
                        <i class="fa-solid fa-filter me-1"></i> Filtrer
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# Liste des mouvements du caissier connecté #}
    <div class="card border-0 shadow-sm rounded-4">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Devise</th>
                        <th class="text-end">Montant</th>
                        <th>Provenance</th>
                        <th class="text-center">Reçu</th>
                    </tr>
                </thead>
                <tbody>
                {% for m in mouvements %}
                    <tr>
                        <td>{{ m.dateMouvement ? m.dateMouvement|date('d/m/Y H:i') : '—' }}</td>
                        <td>
                            {% if m.type == 'ENTREE' %}
                                <span class="badge bg-success">
                                    <i class="fa-solid fa-arrow-down me-1"></i>Entrée
                                </span>
                            {% else %}
                                <span class="badge bg-danger">
                                    <i class="fa-solid fa-arrow-up me-1"></i>Sortie
                                </span>
                            {% endif %}
                        </td>
                        <td><span class="badge bg-secondary">{{ m.devise }}</span></td>
                        <td class="text-end fw-bold">{{ m.montant|number_format(2, ',', ' ') }}</td>
                        <td>
                            {{ m.provenance }}
                            {% if m.devis %}
                                <small class="text-muted">(Devis #{{ m.devis.id }})</small>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            {% if m.type == 'ENTREE' %}
                                <a href="{{ path('app_caisse_entree_imprimer', {id: m.id}) }}"
                                   target="_blank" class="btn btn-sm btn-outline-secondary"
                                   title="Imprimer le reçu">
                                    <i class="fa-solid fa-print"></i>
                                </a>
                            {% else %}
                                <span class="text-muted small">—</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="fa-solid fa-inbox fa-2x d-block mb-2 opacity-50"></i>
                            Vous n'avez encore effectué aucun mouvement.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: DejaVu Sans, sans-serif; font-size: 12px; color: #1e293b; }
        .header { text-align: center; border-bottom: 2px solid #10b981; padding-bottom: 15px; margin-bottom: 20px; }
        .header h1 { color: #059669; margin: 0; font-size: 22px; }
        .header p { margin: 4px 0 0; color: #64748b; font-size: 11px; }
        .info-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        .info-table td { padding: 8px 10px; border-bottom: 1px solid #e2e8f0; }
        .info-table td:first-child { font-weight: bold; color: #475569; width: 40%; }
        .montant-box { background: #f0fdf4; border: 2px solid #10b981; border-radius: 8px; padding: 15px; text-align: center; margin: 20px 0; }
        .montant-box .label { font-size: 10px; text-transform: uppercase; color: #059669; letter-spacing: 1px; }
        .montant-box .value { font-size: 24px; font-weight: 800; color: #065f46; margin-top: 5px; }
        .footer { text-align: center; margin-top: 40px; padding-top: 15px; border-top: 1px dashed #cbd5e1; color: #64748b; font-size: 10px; }
        .signature { margin-top: 40px; display: flex; justify-content: space-between; }
        .signature div { border-top: 1px solid #cbd5e1; width: 40%; padding-top: 5px; text-align: center; color: #64748b; font-size: 10px; }
    </style>
</head>
<body>

    <div class="header">
        <h1>DISPROMALT</h1>
        <p>Reçu d'entrée de fonds — N° {{ mouvement.id }}</p>
    </div>

    <table class="info-table">
        <tr><td>Date du mouvement</td><td>{{ mouvement.dateMouvement ? mouvement.dateMouvement|date('d/m/Y') : '-' }}</td></tr>
        <tr><td>Provenance</td><td>{{ mouvement.provenance }}</td></tr>
        <tr><td>Catégorie</td><td>{{ mouvement.categorie ?: '—' }}</td></tr>
        {% if mouvement.reference %}
        <tr><td>N° de facture</td><td>{{ mouvement.reference }}</td></tr>
        {% endif %}
        <tr><td>Enregistré par</td><td>{{ mouvement.effectuePar ? mouvement.effectuePar.userIdentifier : '—' }}</td></tr>
    </table>

    <div class="montant-box">
        <div class="label">Montant encaissé</div>
        <div class="value">{{ mouvement.montant|number_format(2, ',', ' ') }} {{ mouvement.devise }}</div>
    </div>

    <div class="signature">
        <div>Le Caissier</div>
        <div>Le Client</div>
    </div>

    <div class="footer">
        Dispromalt — Imprimerie • Ce reçu est généré automatiquement.<br>
        Imprimé le {{ date|date('d/m/Y à H:i') }}
    </div>

</body>
</html>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if isPDG|default(false) %}Direction Générale (PDG){% else %}Direction Générale{% endif %} - Dispromalt</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        :root {
            --dg-primary: #1e293b;
            --gradient-1: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --gradient-3: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            --gradient-4: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
            --gradient-5: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            --gradient-gold: linear-gradient(135deg, #d4af37 0%, #f9d976 50%, #b8860b 100%);
            --gradient-dg: linear-gradient(135deg, #2c3e50 0%, #4b6584 100%);
            --shadow-soft: 0 4px 20px rgba(0,0,0,0.06);
            --shadow-hover: 0 12px 30px rgba(0,0,0,0.10);
        }
        * { transition: all 0.25s ease; }
        html, body { width: 100%; max-width: 100%; overflow-x: hidden; }
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: #f0f2f7;
            background-image:
                radial-gradient(at 0% 0%, rgba(212, 175, 55, 0.06) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(44, 62, 80, 0.06) 0px, transparent 50%);
            min-height: 100vh;
        }
        .navbar-modern {
            background: rgba(30, 41, 59, 0.98);
            backdrop-filter: blur(12px);
            border-bottom: 3px solid transparent;
            border-image: var(--gradient-gold) 1;
            width: 100%;
            padding-left: 1.5rem;
            padding-right: 1.5rem;
        }
        .navbar-brand-modern { font-weight: 800; font-size: 1.4rem; letter-spacing: -0.5px; }
        .role-pill {
            background: var(--gradient-gold);
            color: #1e293b;
            padding: 8px 18px;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 800;
            box-shadow: 0 4px 15px rgba(212, 175, 55, 0.35);
        }
        .dg-hero {
            background: var(--gradient-dg);
            border-radius: 22px;
            padding: 2rem 2.25rem;
            color: #fff;
            position: relative;
            overflow: hidden;
            margin-bottom: 1.75rem;
            box-shadow: 0 15px 40px rgba(30, 41, 59, 0.2);
        }
        .dg-hero::before {
            content: '';
            position: absolute;
            top: -50%; right: -10%;
            width: 400px; height: 400px;
            border-radius: 50%;
            background: var(--gradient-gold);
            opacity: 0.15;
            filter: blur(60px);
        }
        .dg-hero::after {
            content: '';
            position: absolute;
            bottom: -60%; left: -5%;
            width: 300px; height: 300px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            opacity: 0.25;
            filter: blur(70px);
        }
        .dg-hero-content { position: relative; z-index: 1; }
        .dg-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.2);
            color: #f9d976;
            padding: 0.4rem 1rem;
            border-radius: 50px;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 1rem;
        }
        .dg-hero h1 { font-size: 2rem; font-weight: 800; letter-spacing: -0.5px; margin: 0 0 0.5rem; }
        .dg-hero p { color: rgba(255,255,255,0.75); margin: 0; font-size: 0.95rem; }
        .dg-hero-meta { display: flex; gap: 1.5rem; margin-top: 1.25rem; flex-wrap: wrap; }
        .dg-hero-meta-item {
            display: flex; align-items: center; gap: 0.5rem;
            color: rgba(255,255,255,0.85); font-size: 0.85rem;
        }
        .dg-hero-meta-item i { color: #f9d976; }

        .stat-card {
            border: none; border-radius: 18px; padding: 1.4rem;
            position: relative; overflow: hidden;
            background: #fff; box-shadow: var(--shadow-soft);
        }
        .stat-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0;
            height: 4px; background: var(--gradient-1);
        }
        .stat-card.stat-warning::before { background: var(--gradient-5); }
        .stat-card.stat-primary::before { background: var(--gradient-3); }
        .stat-card.stat-success::before { background: var(--gradient-4); }
        .stat-card.stat-gold::before    { background: var(--gradient-gold); }
        .stat-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-hover); }
        .stat-icon {
            width: 56px; height: 56px; border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem; flex-shrink: 0;
        }
        .stat-icon-warning { background: rgba(250, 112, 154, 0.12); color: #f5576c; }
        .stat-icon-primary { background: rgba(79, 172, 254, 0.12); color: #3b82f6; }
        .stat-icon-success { background: rgba(67, 233, 123, 0.12); color: #10b981; }
        .stat-icon-gold    { background: rgba(212, 175, 55, 0.15); color: #b8860b; }
        .stat-trend {
            display: inline-flex; align-items: center; gap: 0.25rem;
            font-size: 0.72rem; font-weight: 700;
            padding: 0.2rem 0.5rem; border-radius: 6px; margin-top: 0.5rem;
        }
        .stat-trend-up   { background: rgba(67, 233, 123, 0.15); color: #059669; }
        .stat-trend-info { background: rgba(79, 172, 254, 0.12); color: #2563eb; }

        .treso-card {
            border-radius: 18px; padding: 1.15rem 1.4rem;
            display: flex; justify-content: space-between; align-items: center;
            box-shadow: var(--shadow-soft); height: 100%;
        }
        .treso-card .treso-label {
            font-size: 0.7rem; text-transform: uppercase;
            font-weight: 700; letter-spacing: 0.05em; margin-bottom: 0.35rem;
        }
        .treso-card .treso-value {
            font-size: 1.6rem; font-weight: 800; line-height: 1;
            letter-spacing: -0.5px;
        }
        .treso-card .treso-icon { font-size: 2rem; opacity: 0.25; }
        .treso-usd { background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); border: 1px solid rgba(5, 150, 105, 0.25); }
        .treso-usd .treso-label { color: #065f46; }
        .treso-usd .treso-value { color: #059669; }
        .treso-cdf { background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border: 1px solid rgba(37, 99, 235, 0.25); }
        .treso-cdf .treso-label { color: #1e40af; }
        .treso-cdf .treso-value { color: #2563eb; }
        .treso-caisse { background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border: 1px solid rgba(212, 175, 55, 0.35); }
        .treso-caisse .treso-label { color: #92400e; }
        .treso-caisse .treso-value { color: #78350f; }

        .main-card {
            border: none; border-radius: 20px;
            box-shadow: var(--shadow-soft); background: #fff;
            overflow: hidden; width: 100%;
        }
        .nav-tabs-modern {
            border-bottom: 1px solid #e2e8f0;
            padding: 0 1rem; gap: 0.25rem;
            flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none;
        }
        .nav-tabs-modern::-webkit-scrollbar { display: none; }
        .nav-tabs-modern .nav-link {
            border: none !important; color: #64748b;
            font-weight: 600; font-size: 0.9rem;
            padding: 1rem 1.1rem; white-space: nowrap;
            border-radius: 0; position: relative; background: none;
        }
        .nav-tabs-modern .nav-link:hover { color: var(--dg-primary); }
        .nav-tabs-modern .nav-link.active { color: var(--dg-primary) !important; background: none; }
        .nav-tabs-modern .nav-link.active::after {
            content: ''; position: absolute;
            bottom: -1px; left: 1rem; right: 1rem;
            height: 3px; background: var(--gradient-gold);
            border-radius: 3px 3px 0 0;
        }
        .nav-tabs-modern .nav-link i { margin-right: 0.5rem; }

        .table-responsive { width: 100%; }
        .table-modern { margin: 0; width: 100% !important; }
        .table-modern thead th {
            background: #f8fafc; color: #475569;
            font-size: 0.72rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.06em;
            padding: 1rem 0.9rem; border-bottom: 2px solid #e2e8f0;
            white-space: nowrap;
        }
        .table-modern tbody td {
            padding: 1rem 0.9rem; vertical-align: middle;
            border-color: #f1f5f9;
        }
        .table-modern tbody tr:hover { background: #f8fafc; }

        .badge-soft {
            padding: 0.4rem 0.75rem; border-radius: 8px;
            font-weight: 600; font-size: 0.75rem;
        }
        .badge-soft-warning { background: rgba(250, 112, 154, 0.12); color: #d63384; }
        .badge-soft-primary { background: rgba(79, 172, 254, 0.12); color: #2563eb; }
        .badge-soft-success { background: rgba(67, 233, 123, 0.15); color: #059669; }
        .badge-soft-danger  { background: rgba(220, 38, 38, 0.12); color: #dc2626; }
        .badge-soft-info    { background: rgba(14, 165, 233, 0.12); color: #0284c7; }
        .badge-soft-secondary { background: #f1f5f9; color: #475569; }
        .badge-soft-gold    { background: rgba(212, 175, 55, 0.15); color: #8b6508; }

        .filter-bar {
            background: #f8fafc; border-radius: 14px;
            padding: 1rem 1.25rem; border: 1px solid #e2e8f0;
            display: flex; flex-wrap: wrap; gap: 0.75rem;
            align-items: end; margin-bottom: 1.25rem;
        }
        .filter-bar .form-label {
            font-size: 0.72rem; font-weight: 700; color: #64748b;
            text-transform: uppercase; letter-spacing: 0.04em;
            margin-bottom: 0.35rem;
        }
        .filter-bar .form-control,
        .filter-bar .form-select {
            border-radius: 10px; border: 1px solid #e2e8f0;
            padding: 0.55rem 0.85rem; font-size: 0.88rem;
            background: #fff;
        }
        .filter-bar .form-control:focus,
        .filter-bar .form-select:focus {
            border-color: #d4af37;
            box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.10);
        }

        .kpi-mini {
            background: #f8fafc; border: 1px solid #eef2f7;
            border-radius: 14px; padding: 1rem 1.15rem; text-align: center;
        }
        .kpi-mini .kpi-value {
            font-size: 1.6rem; font-weight: 800; line-height: 1;
            margin-bottom: 0.35rem; letter-spacing: -0.5px;
        }
        .kpi-mini .kpi-label {
            font-size: 0.7rem; color: #64748b; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.05em;
        }
        .kpi-mini.kpi-warning  { background: rgba(250, 112, 154, 0.06); border-color: rgba(250, 112, 154, 0.15); }
        .kpi-mini.kpi-primary  { background: rgba(79, 172, 254, 0.06); border-color: rgba(79, 172, 254, 0.15); }
        .kpi-mini.kpi-success  { background: rgba(67, 233, 123, 0.06); border-color: rgba(67, 233, 123, 0.15); }
        .kpi-mini.kpi-gold     { background: rgba(212, 175, 55, 0.08); border-color: rgba(212, 175, 55, 0.2); }

        .empty-state { text-align: center; padding: 3rem 1rem; color: #94a3b8; }
        .empty-state i { font-size: 3rem; color: #cbd5e1; margin-bottom: 1rem; display: block; }

        .btn-export {
            background: var(--gradient-gold); color: #1e293b;
            border: none; font-weight: 700; border-radius: 10px;
            padding: 0.65rem 1.15rem; font-size: 0.88rem;
            box-shadow: 0 6px 16px rgba(212, 175, 55, 0.3);
        }
        .btn-export:hover { color: #1e293b; transform: translateY(-2px); box-shadow: 0 10px 24px rgba(212, 175, 55, 0.4); }

        .status-timeline {
            display: flex; gap: 0.25rem; height: 8px;
            border-radius: 4px; overflow: hidden;
            margin-top: 0.75rem; background: #f1f5f9;
        }
        .status-segment { height: 100%; }
        .status-seg-attente { background: #fa709a; }
        .status-seg-valide  { background: #4facfe; }
        .status-seg-livre   { background: #43e97b; }
        .legend-dot {
            width: 10px; height: 10px; border-radius: 50%;
            display: inline-block; margin-right: 0.4rem;
        }

        .container-fluid { width: 100% !important; max-width: 100% !important; }
        @media (min-width: 1920px) {
            .container-fluid { padding-left: 3rem !important; padding-right: 3rem !important; }
        }
        @media (max-width: 1200px) {
            .container-fluid { padding-left: 1.5rem !important; padding-right: 1.5rem !important; }
            .dg-hero { padding: 1.75rem 1.5rem; }
            .dg-hero h1 { font-size: 1.6rem; }
        }
        @media (max-width: 768px) {
            .container-fluid { padding-left: 1rem !important; padding-right: 1rem !important; }
            .navbar-modern { padding-left: 0.75rem; padding-right: 0.75rem; }
            .navbar-brand-modern { font-size: 1rem; }
            .navbar-brand-modern img { height: 32px !important; }
            .dg-hero { padding: 1.25rem 1.15rem; border-radius: 18px; }
            .dg-hero h1 { font-size: 1.35rem; }
            .dg-hero p { font-size: 0.85rem; }
            .dg-hero-meta { gap: 0.75rem; }
            .dg-hero-meta-item { font-size: 0.78rem; }
            .stat-card { padding: 1.1rem; }
            .stat-card h3 { font-size: 1.6rem !important; }
            .stat-icon { width: 46px; height: 46px; font-size: 1.2rem; }
            .treso-card { padding: 1rem 1.15rem; }
            .treso-card .treso-value { font-size: 1.35rem; }
            .nav-tabs-modern .nav-link { font-size: 0.82rem; padding: 0.85rem 0.75rem; }
            .nav-tabs-modern .nav-link i { margin-right: 0.3rem; }
            .table-modern thead th,
            .table-modern tbody td { padding: 0.75rem 0.6rem; font-size: 0.82rem; }
            .kpi-mini { padding: 0.85rem 0.75rem; }
            .kpi-mini .kpi-value { font-size: 1.35rem; }
            .kpi-mini .kpi-label { font-size: 0.65rem; }
            .main-card { border-radius: 16px; }
            .main-card > .p-4 { padding: 1rem !important; }
        }
        @media (max-width: 576px) {
            .container-fluid { padding-left: 0.75rem !important; padding-right: 0.75rem !important; }
            .dg-hero { padding: 1rem 1rem; }
            .dg-hero h1 { font-size: 1.15rem; }
            .dg-hero-badge { font-size: 0.65rem; padding: 0.3rem 0.75rem; }
            .dg-hero-meta { flex-direction: column; gap: 0.5rem; }
            .stat-card h3 { font-size: 1.4rem !important; }
            .stat-card h6 { font-size: 0.62rem !important; }
            .treso-card { flex-direction: column; align-items: flex-start !important; gap: 0.5rem; }
            .treso-card .treso-icon { display: none; }
            .treso-card .treso-value { font-size: 1.2rem; }
            .nav-tabs-modern { padding: 0 0.5rem; }
            .nav-tabs-modern .nav-link { font-size: 0.75rem; padding: 0.75rem 0.6rem; }
            .nav-tabs-modern .nav-link i { display: none; }
            .nav-tabs-modern .nav-link.active::after { left: 0.4rem; right: 0.4rem; }
            .filter-bar { padding: 0.75rem; }
            .table-modern thead th,
            .table-modern tbody td { padding: 0.6rem 0.5rem; font-size: 0.75rem; }
            .badge-soft { font-size: 0.65rem; padding: 0.3rem 0.5rem; }
            .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }
            .stat-icon { width: 38px; height: 38px; font-size: 1rem; }
        }
        @media print {
            .navbar-modern, .nav-tabs-modern, .filter-bar, .btn-export, .no-print { display: none !important; }
            .main-card { box-shadow: none; }
            .tab-content > .tab-pane { display: block !important; opacity: 1 !important; }
            .tab-pane { page-break-inside: avoid; margin-bottom: 2rem; }
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-modern py-3 sticky-top">
    <div class="container-fluid px-4">
        <a class="navbar-brand navbar-brand-modern text-white d-flex align-items-center" href="#">
            <img src="{{ asset('images/logo.png') }}" alt="Logo Dispromalt" style="height: 40px; width: auto; margin-right: 10px;">
            Dispro<span class="text-primary">malt</span>
            <span class="fw-light fs-6 text-white-50 ms-2">
                | {% if isPDG|default(false) %}Direction Générale (PDG){% else %}Direction Générale{% endif %}
            </span>
        </a>
        <div class="d-flex align-items-center gap-3">
            <div class="role-pill d-none d-md-inline-flex align-items-center">
                <i class="fas fa-crown me-2"></i>
                <span>{% if isPDG|default(false) %}PDG{% else %}{{ userRole }}{% endif %}</span>
            </div>
            <a href="{{ path('app_historique_reappro') }}" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold">
                <i class="fas fa-history me-1"></i> Historique Réappro
            </a>
            <button onclick="window.print()" class="btn btn-outline-light btn-sm rounded-pill px-3 d-none d-md-inline-flex align-items-center">
                <i class="fas fa-print me-1"></i> Imprimer
            </button>
            <a href="/logout" class="btn btn-danger btn-sm fw-bold px-3 rounded-pill">
                <i class="fas fa-sign-out-alt me-1"></i> Déconnexion
            </a>
        </div>
    </div>
</nav>

<div class="container-fluid py-4" style="max-width: 100%; padding-left: 2rem; padding-right: 2rem;">

    <div class="dg-hero">
        <div class="dg-hero-content">
            <div class="dg-hero-badge">
                <i class="fas fa-crown"></i>
                {% if isPDG|default(false) %}Tableau de bord PDG{% else %}Tableau de bord exécutif{% endif %}
            </div>
            <h1>Bienvenue, {% if isPDG|default(false) %}Président-Directeur Général{% else %}Direction Générale{% endif %}</h1>
            <p>Vue stratégique de l'activité — supervision des demandes, bons, devis et performances globales.</p>
            <div class="dg-hero-meta">
                <div class="dg-hero-meta-item">
                    <i class="fas fa-calendar-day"></i>
                    <span>Période : <strong>{{ date_debut|date('d/m/Y') }}</strong> → <strong>{{ date_fin|date('d/m/Y') }}</strong></span>
                </div>
                <div class="dg-hero-meta-item">
                    <i class="fas fa-shield-alt"></i>
                    <span>Accès : <strong>{% if isPDG|default(false) %}PDG — supervision + agenda{% else %}Supervision totale{% endif %}</strong></span>
                </div>
            </div>
        </div>
    </div>

    {# ═══════════════════════════════════════════════════════
       TRÉSORERIE — 3 cartes
    ═══════════════════════════════════════════════════════ #}
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="treso-card treso-usd">
                <div>
                    <div class="treso-label"><i class="fas fa-hand-holding-usd me-1"></i>Solde USD — Comptabilité</div>
                    <div class="treso-value">
                        {{ soldeUSD|default(0)|number_format(2, ',', ' ') }}
                        <small style="font-size:0.9rem; font-weight:600; opacity:0.6;">$</small>
                    </div>
                </div>
                <i class="fas fa-dollar-sign treso-icon"></i>
            </div>
        </div>
        <div class="col-md-4">
            <div class="treso-card treso-cdf">
                <div>
                    <div class="treso-label"><i class="fas fa-money-bill-wave me-1"></i>Solde CDF — Comptabilité</div>
                    <div class="treso-value">
                        {{ soldeCDF|default(0)|number_format(0, ',', ' ') }}
                        <small style="font-size:0.9rem; font-weight:600; opacity:0.6;">FC</small>
                    </div>
                </div>
                <i class="fas fa-coins treso-icon"></i>
            </div>
        </div>
        <div class="col-md-4">
            <div class="treso-card treso-caisse">
                <div>
                    <div class="treso-label"><i class="fas fa-cash-register me-1"></i>Solde Caisse (global)</div>
                    <div class="treso-value" style="font-size: 1.15rem;">
                        {{ soldeCaisseUSD|default(0)|number_format(2, ',', ' ') }} $
                        <span style="opacity:0.5;">•</span>
                        {{ soldeCaisseCDF|default(0)|number_format(0, ',', ' ') }} FC
                    </div>
                </div>
                <i class="fas fa-vault treso-icon"></i>
            </div>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'danger' ? 'danger' : 'success' }} alert-dismissible fade show shadow-sm mb-4 border-0 rounded-3" role="alert">
                <i class="fas {{ label == 'danger' ? 'fa-exclamation-triangle' : 'fa-check-circle' }} me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# ═══════════════════════════════════════════════════════
       STATS GLOBALES — 4 cartes
       La 4ème change selon PDG ou DG
    ═══════════════════════════════════════════════════════ #}
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="stat-card stat-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Demandes totales</h6>
                        <h3 class="fw-bold m-0 text-dark" style="font-size: 2rem;">{{ demandes|length }}</h3>
                        <span class="stat-trend stat-trend-up"><i class="fas fa-chart-line"></i> Activité en cours</span>
                    </div>
                    <div class="stat-icon stat-icon-warning"><i class="fas fa-boxes"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-card stat-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Bons de sortie</h6>
                        <h3 class="fw-bold m-0 text-dark" style="font-size: 2rem;">{{ bonsSortie|default([])|length }}</h3>
                        <span class="stat-trend stat-trend-info"><i class="fas fa-truck"></i> Logistique</span>
                    </div>
                    <div class="stat-icon stat-icon-primary"><i class="fas fa-file-signature"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-card stat-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Devis émis</h6>
                        <h3 class="fw-bold m-0 text-dark" style="font-size: 2rem;">{{ devisListe|default([])|length }}</h3>
                        <span class="stat-trend stat-trend-up"><i class="fas fa-file-invoice-dollar"></i> Financier</span>
                    </div>
                    <div class="stat-icon stat-icon-success"><i class="fas fa-file-invoice-dollar"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            {% if isPDG|default(false) %}
                {# Carte RDV — visible seulement pour le PDG #}
                <div class="stat-card stat-gold">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Mes rendez-vous</h6>
                            <h3 class="fw-bold m-0 text-dark" style="font-size: 2rem;">{{ mesRdv|default([])|length }}</h3>
                            <span class="stat-trend stat-trend-info"><i class="fas fa-calendar-check"></i> Agenda PDG</span>
                        </div>
                        <div class="stat-icon stat-icon-gold"><i class="fas fa-calendar-check"></i></div>
                    </div>
                </div>
            {% else %}
                {# Carte Départements — visible pour le DG normal #}
                <div class="stat-card stat-gold">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Départements actifs</h6>
                            <h3 class="fw-bold m-0 text-dark" style="font-size: 2rem;">
                                {% set depts = [] %}
                                {% for d in demandes %}
                                    {% if d.departement not in depts %}
                                        {% set depts = depts|merge([d.departement]) %}
                                    {% endif %}
                                {% endfor %}
                                {{ depts|length }}
                            </h3>
                            <span class="stat-trend stat-trend-info"><i class="fas fa-building"></i> Multi-services</span>
                        </div>
                        <div class="stat-icon stat-icon-gold"><i class="fas fa-sitemap"></i></div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    {# ═══════════════════════════════════════════════════════
       CARTE PRINCIPALE — ONGLETS
    ═══════════════════════════════════════════════════════ #}
    <div class="main-card">

        <ul class="nav nav-tabs nav-tabs-modern" id="dgTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-overview" data-bs-toggle="tab" data-bs-target="#pane-overview" type="button" role="tab">
                    <i class="fas fa-chart-pie text-warning"></i>Vue d'ensemble
                </button>
            </li>

            {# ── Onglet RDV — UNIQUEMENT pour le PDG ── #}
            {% if isPDG|default(false) %}
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-rdv" data-bs-toggle="tab" data-bs-target="#pane-rdv" type="button" role="tab">
                    <i class="fas fa-calendar-check text-primary"></i>Mes Rendez-vous
                </button>
            </li>
            {% endif %}

            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-demandes" data-bs-toggle="tab" data-bs-target="#pane-demandes" type="button" role="tab">
                    <i class="fas fa-boxes text-primary"></i>Demandes Globales
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-bons" data-bs-toggle="tab" data-bs-target="#pane-bons" type="button" role="tab">
                    <i class="fas fa-file-signature text-success"></i>Bons de Sortie
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-devis" data-bs-toggle="tab" data-bs-target="#pane-devis" type="button" role="tab">
                    <i class="fas fa-file-invoice-dollar text-warning"></i>Devis & Finances
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-stock" data-bs-toggle="tab" data-bs-target="#pane-stock" type="button" role="tab">
                    <i class="fas fa-warehouse text-success"></i>État du Stock
                </button>
            </li>
        </ul>

        <div class="p-4">
            <div class="tab-content">

                {# ═══════════════════════════════════════════════
                   ONGLET 1 : VUE D'ENSEMBLE
                ═══════════════════════════════════════════════ #}
                <div class="tab-pane fade show active" id="pane-overview" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark m-0"><i class="fas fa-chart-pie text-warning me-2"></i>Synthèse de l'activité</h5>
                            <small class="text-muted">Aperçu consolidé sur la période sélectionnée.</small>
                        </div>
                        <a href="{{ path('app_rapport_pdf', {'date_debut': date_debut, 'date_fin': date_fin}) }}" class="btn btn-export">
                            <i class="fas fa-file-pdf me-1"></i> Exporter PDF
                        </a>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini kpi-warning">
                                <div class="kpi-value text-warning">{{ stats.demandes_attente|default(0) }}</div>
                                <div class="kpi-label">En attente</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini kpi-primary">
                                <div class="kpi-value text-primary">{{ stats.bons_a_valider|default(0) }}</div>
                                <div class="kpi-label">Bons à signer</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini kpi-success">
                                <div class="kpi-value text-success">{{ stats.bons_guerite|default(0) }}</div>
                                <div class="kpi-label">Bons validés guérite</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini kpi-gold">
                                <div class="kpi-value" style="color: #b8860b;">
                                    {{ demandes|length + (bonsSortie|default([])|length) + (devisListe|default([])|length) }}
                                </div>
                                <div class="kpi-label">Total flux</div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-lg-4">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <h6 class="fw-bold text-dark mb-3"><i class="fas fa-chart-bar text-primary me-2"></i>Répartition des demandes</h6>
                                {% set nb_total = demandes|length %}
                                {% set nb_attente = 0 %}
                                {% set nb_valide = 0 %}
                                {% set nb_livre = 0 %}
                                {% for d in demandes %}
                                    {% if 'attente' in d.statut|lower %}
                                        {% set nb_attente = nb_attente + 1 %}
                                    {% elseif 'livr' in d.statut|lower %}
                                        {% set nb_livre = nb_livre + 1 %}
                                    {% else %}
                                        {% set nb_valide = nb_valide + 1 %}
                                    {% endif %}
                                {% endfor %}
                                {% if nb_total > 0 %}
                                    <div class="d-flex justify-content-between mb-2 small fw-bold">
                                        <span><span class="legend-dot" style="background: #fa709a;"></span>Attente : {{ nb_attente }}</span>
                                        <span><span class="legend-dot" style="background: #4facfe;"></span>Validées : {{ nb_valide }}</span>
                                        <span><span class="legend-dot" style="background: #43e97b;"></span>Livrées : {{ nb_livre }}</span>
                                    </div>
                                    <div class="status-timeline">
                                        <div class="status-segment status-seg-attente" style="width: {{ (nb_attente / nb_total * 100)|round }}%;"></div>
                                        <div class="status-segment status-seg-valide"  style="width: {{ (nb_valide / nb_total * 100)|round }}%;"></div>
                                        <div class="status-segment status-seg-livre"   style="width: {{ (nb_livre / nb_total * 100)|round }}%;"></div>
                                    </div>
                                {% else %}
                                    <p class="text-muted small mb-0">Aucune donnée à afficher.</p>
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <h6 class="fw-bold text-dark mb-3"><i class="fas fa-coins text-warning me-2"></i>Performance financière</h6>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small text-muted">Devis totaux émis</span>
                                    <span class="fw-bold text-dark">{{ devisListe|default([])|length }}</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small text-muted">Bons de sortie traités</span>
                                    <span class="fw-bold text-dark">{{ bonsSortie|default([])|length }}</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="small text-muted">Période analysée</span>
                                    <span class="fw-bold text-dark small">{{ date_debut|date('d/m') }} → {{ date_fin|date('d/m') }}</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="p-3 rounded-3 border h-100" style="background: linear-gradient(135deg, #fef9e7 0%, #fdf2d0 100%); border-color: rgba(212, 175, 55, 0.3) !important;">
                                <h6 class="fw-bold mb-3" style="color: #8b6508;"><i class="fas fa-vault me-2"></i>Trésorerie (Comptabilité)</h6>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small text-muted fw-semibold">Solde USD</span>
                                    <span class="fw-bold" style="color: #059669; font-size: 1.15rem;">
                                        {{ soldeUSD|default(0)|number_format(2, ',', ' ') }} <small class="text-muted">$</small>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="small text-muted fw-semibold">Solde CDF</span>
                                    <span class="fw-bold" style="color: #2563eb; font-size: 1.15rem;">
                                        {{ soldeCDF|default(0)|number_format(0, ',', ' ') }} <small class="text-muted">FC</small>
                                    </span>
                                </div>
                                <hr class="my-2" style="opacity: 0.2;">
                                <div class="d-flex align-items-center gap-2 small text-muted">
                                    <i class="fas fa-info-circle"></i>
                                    <span>Solde = Σ entrées − Σ sorties</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    {% if nbAlertesStock|default(0) > 0 %}
                    <div class="p-3 rounded-3 border mb-4 mt-4" style="background: rgba(220, 38, 38, 0.04); border-color: rgba(220, 38, 38, 0.15) !important;">
                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                            <h6 class="fw-bold text-danger mb-0">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                Alertes de Stock Critiques — {{ nbAlertesStock }} article(s)
                            </h6>
                            <span class="badge badge-soft badge-soft-danger px-3 py-2">Action comptable en cours</span>
                        </div>
                        <div class="row g-3">
                            {% for art in articlesEnAlerte %}
                                <div class="col-md-6 col-xl-4">
                                    <div class="p-3 bg-white rounded-3 border h-100">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div class="fw-bold text-dark"><i class="fas fa-box text-danger me-2"></i>{{ art.nom }}</div>
                                            <span class="badge bg-danger">{{ art.quantite }} / {{ art.seuilAlerte }}</span>
                                        </div>
                                        <div class="small text-muted mb-2"><i class="fas fa-info-circle me-1"></i>Stock sous le seuil critique</div>
                                        {% if art.reapprovisionnementEnCours %}
                                            <span class="badge badge-soft badge-soft-primary"><i class="fas fa-truck-loading me-1"></i>Réappro en cours</span>
                                            {% if art.dateReapprovisionnement %}
                                                <div class="small text-muted mt-2">
                                                    Prévision : <strong class="text-primary">{{ art.dateReapprovisionnement|date('d/m/Y') }}</strong>
                                                </div>
                                            {% endif %}
                                        {% else %}
                                            <span class="badge badge-soft badge-soft-secondary"><i class="fas fa-hourglass-start me-1"></i>Non lancé</span>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endif %}

                    <div class="row g-3 mt-2">
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini" style="background: rgba(220, 38, 38, 0.06); border-color: rgba(220, 38, 38, 0.15);">
                                <div class="kpi-value text-danger">{{ nbAlertesStock|default(0) }}</div>
                                <div class="kpi-label">Alertes stock</div>
                            </div>
                        </div>
                    </div>
                </div>

                {# ═══════════════════════════════════════════════
                   ONGLET 2 : MES RENDEZ-VOUS — UNIQUEMENT PDG
                ═══════════════════════════════════════════════ #}
                {% if isPDG|default(false) %}
                <div class="tab-pane fade" id="pane-rdv" role="tabpanel">

                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark m-0">
                                <i class="fas fa-calendar-check text-primary me-2"></i>Mes rendez-vous
                            </h5>
                            <small class="text-muted">Rendez-vous et réunions planifiés par le secrétariat / la caisse.</small>
                        </div>
                        <span class="badge badge-soft badge-soft-primary px-3 py-2">
                            <i class="fas fa-list me-1"></i>{{ mesRdv|default([])|length }} RDV
                        </span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini kpi-primary">
                                <div class="kpi-value text-primary">{{ mesRdv|default([])|length }}</div>
                                <div class="kpi-label">RDV totaux</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini kpi-success">
                                <div class="kpi-value text-success">{{ mesRdv|default([])|filter(r => r.statut == 'RESERVE')|length }}</div>
                                <div class="kpi-label">Réservés</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini kpi-warning">
                                <div class="kpi-value text-warning">{{ mesRdv|default([])|filter(r => r.statut == 'DELEGUE')|length }}</div>
                                <div class="kpi-label">Délégués</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini kpi-gold">
                                <div class="kpi-value" style="color: #b8860b;">{{ rdvDelegues|default([])|length }}</div>
                                <div class="kpi-label">Délégués par moi</div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-white rounded-3 border mb-4">
                        <h6 class="fw-bold text-dark mb-3">
                            <i class="fas fa-inbox text-primary me-2"></i>Rendez-vous qui me sont destinés
                        </h6>
                        <div class="table-responsive">
                            <table class="table table-modern table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Date & heure</th>
                                        <th>Visiteur</th>
                                        <th>Objet</th>
                                        <th>Statut</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for rdv in mesRdv|default([]) %}
                                    <tr>
                                        <td class="fw-semibold text-dark">
                                            <i class="fas fa-clock text-muted me-1"></i>
                                            {{ rdv.dateArrivee ? rdv.dateArrivee|date('d/m/Y H:i') : '—' }}
                                        </td>
                                        <td><i class="fas fa-user-circle text-muted me-2"></i>{{ rdv.nomVisiteur }}</td>
                                        <td>{{ rdv.motif ?? '—' }}</td>
                                        <td>
                                            {% if rdv.statut == 'DELEGUE' %}
                                                <span class="badge badge-soft badge-soft-warning">
                                                    <i class="fas fa-share me-1"></i>Délégué à
                                                    {{ rdv.responsableDelegue ? rdv.responsableDelegue.userIdentifier|split('@')|first : '?' }}
                                                </span>
                                            {% elseif rdv.statut == 'RESERVE' %}
                                                <span class="badge badge-soft badge-soft-primary">
                                                    <i class="fas fa-calendar me-1"></i>Réservé
                                                </span>
                                            {% elseif rdv.statut == 'TERMINE' %}
                                                <span class="badge badge-soft badge-soft-success">
                                                    <i class="fas fa-check me-1"></i>Terminé
                                                </span>
                                            {% else %}
                                                <span class="badge badge-soft badge-soft-secondary">{{ rdv.statut }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-center">
                                            <a href="{{ path('app_caisse_rdv_imprimer', {id: rdv.id}) }}"
                                               target="_blank"
                                               class="btn btn-sm btn-outline-secondary"
                                               title="Imprimer">
                                                <i class="fas fa-print"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="5">
                                            <div class="empty-state">
                                                <i class="fas fa-calendar-xmark"></i>
                                                <div class="fw-bold">Aucun rendez-vous planifié</div>
                                                <small>Le secrétariat ou la caisse n'a encore rien enregistré pour vous.</small>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    {% if rdvDelegues|default([])|length > 0 %}
                        <div class="p-3 rounded-3 border" style="background: rgba(250, 112, 154, 0.04); border-color: rgba(250, 112, 154, 0.15) !important;">
                            <h6 class="fw-bold text-dark mb-3">
                                <i class="fas fa-share-nodes text-warning me-2"></i>
                                Rendez-vous que j'ai délégués
                            </h6>
                            <div class="table-responsive">
                                <table class="table table-modern table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Visiteur</th>
                                            <th>Objet</th>
                                            <th>Délégué à</th>
                                            <th>Motif</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    {% for rdv in rdvDelegues %}
                                        <tr>
                                            <td>{{ rdv.dateArrivee ? rdv.dateArrivee|date('d/m/Y H:i') : '—' }}</td>
                                            <td><i class="fas fa-user-circle text-muted me-2"></i>{{ rdv.nomVisiteur }}</td>
                                            <td>{{ rdv.motif ?? '—' }}</td>
                                            <td>
                                                <span class="badge badge-soft badge-soft-info">
                                                    {{ rdv.responsableDelegue ? rdv.responsableDelegue.userIdentifier : '—' }}
                                                </span>
                                            </td>
                                            <td class="text-muted small">{{ rdv.motifDelegation ?? '—' }}</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% endif %}

                </div>
                {% endif %}

                {# ═══════════════════════════════════════════════
                   ONGLET 3 : DEMANDES GLOBALES
                ═══════════════════════════════════════════════ #}
                <div class="tab-pane fade" id="pane-demandes" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark m-0"><i class="fas fa-boxes text-primary me-2"></i>Toutes les demandes de matériel</h5>
                            <small class="text-muted">Vue consolidée de tous les services de l'imprimerie.</small>
                        </div>
                    </div>

                    <form method="get" class="filter-bar no-print">
                        <div>
                            <label class="form-label">Du</label>
                            <input type="date" name="date_debut" class="form-control" value="{{ date_debut }}">
                        </div>
                        <div>
                            <label class="form-label">Au</label>
                            <input type="date" name="date_fin" class="form-control" value="{{ date_fin }}">
                        </div>
                        <div>
                            <label class="form-label">Localisation</label>
                            <select name="localisation" class="form-select">
                                <option value="">Toutes</option>
                                <option value="sedwe">Sedwe</option>
                                <option value="bonagere">Bonagère</option>
                            </select>
                        </div>
                        <div class="ms-auto d-flex gap-2">
                            <button type="submit" class="btn btn-primary rounded-3 fw-bold"><i class="fas fa-search me-1"></i> Filtrer</button>
                            <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary rounded-3"><i class="fas fa-undo"></i></a>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-modern table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Département</th>
                                    <th>Localisation</th>
                                    <th>Matériel</th>
                                    <th class="text-center">Quantité</th>
                                    <th>Statut</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for d in rapportGlobal|default(demandes) %}
                                    <tr>
                                        <td class="fw-bold text-secondary">#{{ d.id }}</td>
                                        <td><span class="badge badge-soft badge-soft-secondary">{{ d.departement }}</span></td>
                                        <td>
                                            {% if d.localisation == 'sedwe' %}
                                                <span class="badge badge-soft badge-soft-primary"><i class="fas fa-map-marker-alt me-1"></i>SEDWE</span>
                                            {% elseif d.localisation == 'bonagere' %}
                                                <span class="badge badge-soft badge-soft-info"><i class="fas fa-map-marker-alt me-1"></i>BONAGÈRE</span>
                                            {% else %}
                                                <span class="badge badge-soft badge-soft-secondary"><i class="fas fa-building me-1"></i>DIRECTION</span>
                                            {% endif %}
                                        </td>
                                        <td class="fw-semibold text-dark">{{ d.materiel }}</td>
                                        <td class="text-center"><span class="badge badge-soft badge-soft-secondary font-monospace">{{ d.quantite|default(1) }}</span></td>
                                        <td>
                                            {% if 'attente' in d.statut|lower %}
                                                <span class="badge badge-soft badge-soft-warning"><i class="fas fa-clock me-1"></i>{{ d.statut }}</span>
                                            {% elseif 'livr' in d.statut|lower %}
                                                <span class="badge badge-soft badge-soft-success"><i class="fas fa-truck me-1"></i>{{ d.statut }}</span>
                                            {% elseif 'rejet' in d.statut|lower %}
                                                <span class="badge badge-soft badge-soft-danger"><i class="fas fa-ban me-1"></i>{{ d.statut }}</span>
                                            {% else %}
                                                <span class="badge badge-soft badge-soft-info"><i class="fas fa-check me-1"></i>{{ d.statut }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-muted small">{{ d.createdAt ? d.createdAt|date('d/m/Y') : '-' }}</td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="7">
                                            <div class="empty-state">
                                                <i class="fas fa-inbox"></i>
                                                <div class="fw-bold">Aucune demande sur cette période</div>
                                                <small>Modifiez les filtres pour élargir la recherche.</small>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {# ═══════════════════════════════════════════════
                   ONGLET 4 : BONS DE SORTIE
                ═══════════════════════════════════════════════ #}
                <div class="tab-pane fade" id="pane-bons" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark m-0"><i class="fas fa-file-signature text-success me-2"></i>Registre des bons de sortie</h5>
                            <small class="text-muted">Toutes les sorties de matériel de l'entreprise.</small>
                        </div>
                        <span class="badge badge-soft badge-soft-success px-3 py-2">
                            <i class="fas fa-list me-1"></i>{{ bonsSortie|default([])|length }} bon(s)
                        </span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-modern table-hover">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Nom de l'agent</th>
                                    <th>Département</th>
                                    <th>Date création</th>
                                    <th>État</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for b in bonsSortie|default([]) %}
                                    <tr>
                                        <td class="fw-bold text-secondary">#{{ b.id }}</td>
                                        <td class="fw-semibold text-dark"><i class="fas fa-user-circle text-muted me-2"></i>{{ b.nomEmploye }}</td>
                                        <td><span class="badge badge-soft badge-soft-secondary">{{ b.departement }}</span></td>
                                        <td class="text-muted small">{{ b.dateCreation ? b.dateCreation|date('d/m/Y H:i') : '-' }}</td>
                                        <td>
                                            {% if b.statut == 'Créé' %}
                                                <span class="badge badge-soft badge-soft-warning"><i class="fas fa-clock me-1"></i>Créé</span>
                                            {% elseif b.statut == 'Validé Coordon' %}
                                                <span class="badge badge-soft badge-soft-primary"><i class="fas fa-pen-nib me-1"></i>Validé Coordon</span>
                                            {% elseif b.statut == 'Sortie effective' %}
                                                <span class="badge badge-soft badge-soft-success"><i class="fas fa-check-circle me-1"></i>Sortie effective</span>
                                            {% else %}
                                                <span class="badge badge-soft badge-soft-secondary">{{ b.statut }}</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="5">
                                            <div class="empty-state">
                                                <i class="fas fa-file-signature"></i>
                                                <div class="fw-bold">Aucun bon de sortie</div>
                                                <small>Aucun bon n'a été émis sur la période.</small>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {# ═══════════════════════════════════════════════
                   ONGLET 5 : DEVIS & FINANCES
                ═══════════════════════════════════════════════ #}
                <div class="tab-pane fade" id="pane-devis" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark m-0"><i class="fas fa-file-invoice-dollar text-warning me-2"></i>Devis & situation financière</h5>
                            <small class="text-muted">Suivi consolidé des devis émis dans l'entreprise.</small>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini kpi-primary">
                                <div class="kpi-value text-primary">{{ devisListe|default([])|length }}</div>
                                <div class="kpi-label">Devis émis</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini kpi-success">
                                <div class="kpi-value text-success">
                                    {{ devisListe|default([])|filter(d => d.statut == 'DECAISSE')|length }}
                                </div>
                                <div class="kpi-label">Décaissés</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini kpi-warning">
                                <div class="kpi-value text-warning">
                                    {{ devisListe|default([])|filter(d => d.statut != 'DECAISSE' and d.statut != 'REJETE')|length }}
                                </div>
                                <div class="kpi-label">En cours</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini" style="background: rgba(220,38,38,0.06); border-color: rgba(220,38,38,0.15);">
                                <div class="kpi-value text-danger">{{ nbAlertesStock|default(0) }}</div>
                                <div class="kpi-label">Alertes stock</div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-modern table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Date</th>
                                    <th>Demandeur</th>
                                    <th>Description</th>
                                    <th>Statut</th>
                                    <th class="text-end">Montant</th>
                                    <th class="text-center" style="min-width: 240px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for devis in devisListe|default([]) %}
                                    <tr>
                                        <td class="fw-bold text-secondary">#{{ devis.id }}</td>
                                        <td class="text-muted small">{{ devis.createdAt ? devis.createdAt|date('d/m/Y') : '-' }}</td>
                                        <td>
                                            <span class="badge badge-soft badge-soft-secondary">
                                                <i class="fas fa-user me-1"></i>
                                                {{ devis.user ? devis.user.userIdentifier : (devis.createdBy|default('N/A')) }}
                                            </span>
                                        </td>
                                        <td class="fw-semibold text-dark">{{ devis.description }}</td>
                                        <td>
                                            {% if devis.statut == 'DECAISSE' %}
                                                <span class="badge badge-soft badge-soft-success"><i class="fas fa-check-double me-1"></i>Décaissé</span>
                                            {% elseif devis.statut == 'REJETE' %}
                                                <span class="badge badge-soft badge-soft-danger"><i class="fas fa-ban me-1"></i>Rejeté</span>
                                            {% elseif devis.statut == 'VALIDÉ_CHEF_SERVICE' %}
                                                <span class="badge badge-soft badge-soft-info"><i class="fas fa-check-circle me-1"></i>Validé Chef</span>
                                            {% else %}
                                                <span class="badge badge-soft badge-soft-warning"><i class="fas fa-clock me-1"></i>{{ devis.statut }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-end font-monospace fw-bold text-dark">
                                            {{ devis.montant|number_format(2, ',', ' ') }}
                                            <span class="small text-muted">{{ devis.devise }}</span>
                                        </td>
                                        <td class="text-center">
                                            {% if devis.statut == 'ATTENTE_DIRECTEUR' %}
                                                <form method="POST" action="{{ path('app_devis_valider_dg', {'id': devis.id}) }}"
                                                      class="d-inline-flex gap-2 justify-content-center align-items-center mb-1">
                                                    <div class="input-group input-group-sm" style="max-width: 140px;">
                                                        <input type="number" step="0.01" name="nouveau_montant"
                                                               class="form-control text-end fw-bold"
                                                               value="{{ devis.montant }}" required>
                                                        <span class="input-group-text bg-light small fw-bold" style="font-size:0.7rem;">{{ devis.devise }}</span>
                                                    </div>
                                                    <button type="submit" class="btn btn-sm btn-success fw-bold rounded-pill px-3">
                                                        <i class="fas fa-check me-1"></i> Valider
                                                    </button>
                                                </form>
                                                <form method="POST" action="{{ path('app_devis_rejeter_dg', {'id': devis.id}) }}"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Confirmer le rejet définitif de ce devis ?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 mt-1">
                                                        <i class="fas fa-ban"></i> Rejeter
                                                    </button>
                                                </form>
                                            {% elseif devis.statut == 'ATTENTE_DECAISSEMENT' %}
                                                <span class="badge badge-soft badge-soft-info">
                                                    <i class="fas fa-check-circle me-1"></i>Validé — chez la Compta
                                                </span>
                                            {% elseif devis.statut == 'DECAISSE' %}
                                                <span class="badge badge-soft badge-soft-success">
                                                    <i class="fas fa-check-double me-1"></i>Décaissé
                                                    {% if devis.decaissePar %}
                                                        <span style="font-size:0.7rem; opacity:0.7; margin-left:4px;">
                                                            par {{ devis.decaissePar.userIdentifier|split('@')|first }}
                                                        </span>
                                                    {% endif %}
                                                </span>
                                            {% elseif devis.statut == 'REJETE' %}
                                                <span class="badge badge-soft badge-soft-danger"><i class="fas fa-ban me-1"></i>Rejeté</span>
                                            {% else %}
                                                <span class="text-muted small"><i class="fas fa-hourglass-half me-1"></i>En cours de traitement</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="7">
                                            <div class="empty-state">
                                                <i class="fas fa-file-invoice-dollar"></i>
                                                <div class="fw-bold">Aucun devis sur cette période</div>
                                                <small>Aucun devis n'a été émis.</small>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {# ═══════════════════════════════════════════════
                   ONGLET 6 : ÉTAT DU STOCK
                ═══════════════════════════════════════════════ #}
                <div class="tab-pane fade" id="pane-stock" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark m-0"><i class="fas fa-warehouse text-success me-2"></i>État consolidé du stock</h5>
                            <small class="text-muted">Vue synthétique de l'inventaire pour la Direction Générale.</small>
                        </div>
                        <a href="{{ path('app_historique_reappro') }}" class="btn btn-export">
                            <i class="fas fa-history me-1"></i> Historique Réappro
                        </a>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini kpi-primary">
                                <div class="kpi-value text-primary">{{ articlesDG|length }}</div>
                                <div class="kpi-label">Articles référencés</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini kpi-success">
                                <div class="kpi-value text-success">{{ totalQuantiteStock|number_format(0, ',', ' ') }}</div>
                                <div class="kpi-label">Quantité totale</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini kpi-warning">
                                <div class="kpi-value text-warning">{{ articlesParCategorie|length }}</div>
                                <div class="kpi-label">Catégories</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-mini" style="background: rgba(220,38,38,0.06); border-color: rgba(220,38,38,0.15);">
                                <div class="kpi-value text-danger">{{ nbAlertesStock|default(0) }}</div>
                                <div class="kpi-label">Alertes critiques</div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-lg-7">
                            <div class="p-3 bg-white rounded-3 border h-100">
                                <h6 class="fw-bold text-dark mb-3"><i class="fas fa-chart-bar text-primary me-2"></i>Top 10 articles (par quantité)</h6>
                                <div style="position: relative; height: 320px;"><canvas id="chartTopArticles"></canvas></div>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="p-3 bg-white rounded-3 border h-100">
                                <h6 class="fw-bold text-dark mb-3"><i class="fas fa-chart-pie text-success me-2"></i>Répartition par catégorie</h6>
                                <div style="position: relative; height: 320px;"><canvas id="chartCategories"></canvas></div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-white rounded-3 border mb-4">
                        <h6 class="fw-bold text-dark mb-3"><i class="fas fa-list text-secondary me-2"></i>Synthèse par catégorie</h6>
                        <div class="table-responsive">
                            <table class="table table-modern table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Catégorie</th>
                                        <th class="text-center">Nb articles</th>
                                        <th class="text-center">Quantité totale</th>
                                        <th class="text-center">Part</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% set totalGlobal = totalQuantiteStock > 0 ? totalQuantiteStock : 1 %}
                                    {% for cat, data in articlesParCategorie|sort((a, b) => b.quantite <=> a.quantite) %}
                                        <tr>
                                            <td class="fw-semibold text-dark"><i class="fas fa-tag text-muted me-2"></i>{{ cat }}</td>
                                            <td class="text-center"><span class="badge badge-soft badge-soft-secondary">{{ data.count }}</span></td>
                                            <td class="text-center fw-bold text-dark">{{ data.quantite|number_format(0, ',', ' ') }}</td>
                                            <td class="text-center">
                                                <div class="d-flex align-items-center gap-2 justify-content-center">
                                                    <div class="progress" style="width: 80px; height: 6px;">
                                                        <div class="progress-bar bg-success" style="width: {{ (data.quantite / totalGlobal * 100)|round }}%;"></div>
                                                    </div>
                                                    <span class="small text-muted fw-bold">{{ (data.quantite / totalGlobal * 100)|round(1) }}%</span>
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr><td colspan="4" class="text-center text-muted py-4">Aucune catégorie enregistrée.</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    {% if nbAlertesStock|default(0) > 0 %}
                    <div class="p-3 rounded-3 border" style="background: rgba(220, 38, 38, 0.04); border-color: rgba(220, 38, 38, 0.15) !important;">
                        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                            <h6 class="fw-bold text-danger mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Articles sous le seuil critique</h6>
                            <span class="badge badge-soft badge-soft-danger px-3 py-2">{{ nbAlertesStock }} article(s)</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-modern table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Article</th>
                                        <th class="text-center">Stock actuel</th>
                                        <th class="text-center">Seuil</th>
                                        <th class="text-center">Écart</th>
                                        <th>Réappro</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for art in articlesEnAlerte %}
                                        <tr>
                                            <td class="fw-semibold text-dark"><i class="fas fa-box text-danger me-2"></i>{{ art.nom }}</td>
                                            <td class="text-center"><span class="badge badge-soft badge-soft-danger">{{ art.quantite }}</span></td>
                                            <td class="text-center"><span class="badge badge-soft badge-soft-warning">{{ art.seuilAlerte }}</span></td>
                                            <td class="text-center fw-bold text-danger">-{{ art.seuilAlerte - art.quantite }}</td>
                                            <td>
                                                {% if art.reapprovisionnementEnCours %}
                                                    <span class="badge badge-soft badge-soft-primary"><i class="fas fa-truck-loading me-1"></i>En cours</span>
                                                    {% if art.dateReapprovisionnement %}
                                                        <div class="small text-muted mt-1">Prévu : <strong>{{ art.dateReapprovisionnement|date('d/m/Y') }}</strong></div>
                                                    {% endif %}
                                                {% else %}
                                                    <span class="badge badge-soft badge-soft-secondary">Non lancé</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    {% endif %}
                </div>

            </div>
        </div>
    </div>

    <div class="text-center text-muted small mt-4 py-3">
        <i class="fas fa-shield-alt me-1"></i>
        Console de supervision — {% if isPDG|default(false) %}PDG{% else %}Direction Générale{% endif %} • Dispromalt {{ 'now'|date('Y') }}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const urlHash = window.location.hash;
        if (urlHash) {
            const triggerEl = document.querySelector(`button[data-bs-target="${urlHash}"]`);
            if (triggerEl) new bootstrap.Tab(triggerEl).show();
        }
        document.querySelectorAll('#dgTabs button[data-bs-toggle="tab"]').forEach(btn => {
            btn.addEventListener('shown.bs.tab', e => {
                history.replaceState(null, null, e.target.getAttribute('data-bs-target'));
            });
        });
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const topArticlesData = {{ topArticles|default([])|json_encode|raw }};
        const canvas1 = document.getElementById('chartTopArticles');
        if (canvas1 && topArticlesData.length > 0) {
            new Chart(canvas1, {
                type: 'bar',
                data: {
                    labels: topArticlesData.map(a => a.nom.length > 18 ? a.nom.substring(0, 18) + '…' : a.nom),
                    datasets: [{
                        label: 'Quantité en stock',
                        data: topArticlesData.map(a => a.quantite),
                        backgroundColor: topArticlesData.map(a => a.quantite <= a.seuil ? 'rgba(220, 38, 38, 0.7)' : 'rgba(5, 150, 105, 0.7)'),
                        borderColor: topArticlesData.map(a => a.quantite <= a.seuil ? 'rgb(220, 38, 38)' : 'rgb(5, 150, 105)'),
                        borderWidth: 1, borderRadius: 6,
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { afterLabel: function(context) {
                            const art = topArticlesData[context.dataIndex];
                            return 'Seuil : ' + art.seuil + (art.quantite <= art.seuil ? ' ⚠️ ALERTE' : '');
                        }}}
                    },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
        }
        const categoriesLabels   = {{ categoriesLabels|default([])|json_encode|raw }};
        const categoriesQuantites = {{ categoriesQuantites|default([])|json_encode|raw }};
        const canvas2 = document.getElementById('chartCategories');
        if (canvas2 && categoriesLabels.length > 0) {
            const palette = ['#4f46e5', '#059669', '#d97706', '#dc2626', '#0891b2','#7c3aed', '#be185d', '#0d9488', '#65a30d', '#ea580c','#1e40af', '#9333ea', '#c026d3', '#0f766e', '#b45309'];
            new Chart(canvas2, {
                type: 'doughnut',
                data: {
                    labels: categoriesLabels,
                    datasets: [{
                        data: categoriesQuantites,
                        backgroundColor: categoriesLabels.map((_, i) => palette[i % palette.length]),
                        borderWidth: 2, borderColor: '#fff',
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, padding: 10, font: { size: 11 } } } }
                }
            });
        }
    });
</script>
</body>
</html>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Espace Coordonnateur - Dispromalt</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        :root {
            --gradient-1: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --gradient-3: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            --gradient-4: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
            --gradient-5: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            --gradient-coord: linear-gradient(135deg, #2c3e50 0%, #4b6584 100%);
            --shadow-soft: 0 4px 20px rgba(0,0,0,0.06);
            --shadow-hover: 0 12px 30px rgba(0,0,0,0.10);
        }
        * { transition: all 0.25s ease; }
        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: #f0f2f7;
            background-image:
                radial-gradient(at 0% 0%, rgba(102, 126, 234, 0.08) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(79, 172, 254, 0.06) 0px, transparent 50%);
            min-height: 100vh;
        }
        .navbar-modern { background: rgba(30, 41, 59, 0.98); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255,255,255,0.06); }
        .navbar-brand-modern { font-weight: 800; font-size: 1.4rem; letter-spacing: -0.5px; }
        .notification-bell { width: 42px; height: 42px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); color: #fff; position: relative; }
        .notification-bell:hover { background: rgba(79,172,254,0.9); transform: scale(1.05); }
        .role-pill { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); color: #e2e8f0; padding: 8px 16px; border-radius: 50px; font-size: 0.85rem; }
        .hero-banner { background: var(--gradient-coord); border-radius: 20px; padding: 1.75rem 2rem; color: #fff; margin-bottom: 1.75rem; position: relative; overflow: hidden; box-shadow: 0 12px 30px rgba(30,41,59,0.18); }
        .hero-banner::before { content: ''; position: absolute; top: -50%; right: -10%; width: 380px; height: 380px; border-radius: 50%; background: linear-gradient(135deg, #4facfe, #00f2fe); opacity: 0.25; filter: blur(60px); }
        .hero-banner-content { position: relative; z-index: 1; }
        .hero-badge { display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(79,172,254,0.15); border: 1px solid rgba(79,172,254,0.3); color: #93c5fd; padding: 0.4rem 1rem; border-radius: 50px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem; }
        .stat-card { border: none; border-radius: 18px; padding: 1.4rem; position: relative; overflow: hidden; background: #fff; box-shadow: var(--shadow-soft); }
        .stat-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--gradient-1); }
        .stat-card.stat-warning::before { background: var(--gradient-5); }
        .stat-card.stat-primary::before { background: var(--gradient-3); }
        .stat-card.stat-success::before { background: var(--gradient-4); }
        .stat-card.stat-danger::before  { background: linear-gradient(135deg, #dc2626, #ef4444); }
        .stat-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-hover); }
        .stat-icon { width: 56px; height: 56px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
        .stat-icon-warning { background: rgba(250,112,154,0.12); color: #f5576c; }
        .stat-icon-primary { background: rgba(79,172,254,0.12); color: #3b82f6; }
        .stat-icon-success { background: rgba(67,233,123,0.12); color: #10b981; }
        .stat-icon-danger  { background: rgba(220,38,38,0.12); color: #dc2626; }
        .main-card { border: none; border-radius: 20px; box-shadow: var(--shadow-soft); background: #fff; overflow: hidden; }
        .nav-tabs-modern { border-bottom: 1px solid #e2e8f0; padding: 0 1rem; gap: 0.25rem; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
        .nav-tabs-modern::-webkit-scrollbar { display: none; }
        .nav-tabs-modern .nav-link { border: none !important; color: #64748b; font-weight: 600; font-size: 0.9rem; padding: 1rem 1.1rem; white-space: nowrap; border-radius: 0; position: relative; background: none; }
        .nav-tabs-modern .nav-link:hover { color: #1e293b; }
        .nav-tabs-modern .nav-link.active { color: #1e293b !important; background: none; }
        .nav-tabs-modern .nav-link.active::after { content: ''; position: absolute; bottom: -1px; left: 1rem; right: 1rem; height: 3px; background: var(--gradient-3); border-radius: 3px 3px 0 0; }
        .nav-tabs-modern .nav-link i { margin-right: 0.5rem; }
        .table-modern { margin: 0; }
        .table-modern thead th { background: #f8fafc; color: #475569; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 1rem 0.9rem; border-bottom: 2px solid #e2e8f0; white-space: nowrap; }
        .table-modern tbody td { padding: 1rem 0.9rem; vertical-align: middle; border-color: #f1f5f9; }
        .table-modern tbody tr:hover { background: #f8fafc; }
        .badge-soft { padding: 0.4rem 0.75rem; border-radius: 8px; font-weight: 600; font-size: 0.75rem; }
        .badge-soft-warning { background: rgba(250,112,154,0.12); color: #d63384; }
        .badge-soft-primary { background: rgba(79,172,254,0.12); color: #2563eb; }
        .badge-soft-success { background: rgba(67,233,123,0.15); color: #059669; }
        .badge-soft-danger  { background: rgba(220,38,38,0.12); color: #dc2626; }
        .badge-soft-info    { background: rgba(14,165,233,0.12); color: #0284c7; }
        .badge-soft-secondary { background: #f1f5f9; color: #475569; }
        .badge-soft-purple  { background: rgba(168,85,247,0.12); color: #9333ea; }
        .empty-state { text-align: center; padding: 3rem 1rem; color: #94a3b8; }
        .empty-state i { font-size: 3rem; color: #cbd5e1; margin-bottom: 1rem; display: block; }
        .form-card { border: 1px solid #eef2f7; border-radius: 16px; background: #fff; padding: 1.75rem; }
        .form-control, .form-select { border-radius: 10px; border: 1px solid #e2e8f0; padding: 0.65rem 0.9rem; font-size: 0.9rem; }
        .form-control:focus, .form-select:focus { border-color: #4facfe; box-shadow: 0 0 0 4px rgba(79,172,254,0.10); }
        .row-pending { border-left: 4px solid #dc2626; background-color: #fef2f2 !important; }
        .row-pending:hover { background-color: #fee2e2 !important; }

        /* 🔎 FILTRE UNIFIÉ */
        .filter-bar {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 1rem;
        }
        .filter-bar .form-label { font-size: 0.8rem; font-weight: 600; color: #475569; margin-bottom: 0.3rem; }
        .filter-bar .form-control { font-size: 0.88rem; }
    </style>
</head>
<body>

{# ============================================
   NAVBAR
============================================ #}
<nav class="navbar navbar-expand-lg navbar-modern py-3 sticky-top">
    <div class="container-fluid px-4">
        <a class="navbar-brand navbar-brand-modern text-white d-flex align-items-center" href="#">
    <img src="{{ asset('images/logo.png') }}"
         alt="Logo Dispromalt"
         style="height: 40px; width: auto; margin-right: 10px;">
    Dispro<span class="text-primary">malt</span>
    <span class="fw-light fs-6 text-white-50 ms-2">| Coordonnateur</span>
</a>
        <div class="d-flex align-items-center gap-3">
            <div class="dropdown">
                <button class="notification-bell" type="button" id="notificationsMenu" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-bell"></i>
                    {% set totalNotifsCoordon = (reunionsDelegation is defined ? reunionsDelegation|length : 0) + (nbAlertesStock|default(0)) %}
                    {% if totalNotifsCoordon > 0 %}
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.7rem;">{{ totalNotifsCoordon }}</span>
                    {% endif %}
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 p-2 mt-3" style="width: 340px;">
                    {% if nbAlertesStock|default(0) > 0 %}
                        <li class="dropdown-header text-danger fw-bold small"><i class="fas fa-exclamation-triangle me-1"></i>Alertes Stock ({{ nbAlertesStock }})</li>
                        {% for art in articlesEnAlerte|slice(0, 5) %}
                            <li>
                                <a class="dropdown-item p-2 rounded mb-1" href="#alerteCollapseCoordon" data-bs-toggle="collapse">
                                    <div class="fw-bold text-danger small"><i class="fas fa-box me-1"></i>{{ art.nom }}</div>
                                    <div class="text-muted" style="font-size: 0.72rem;">Stock : <strong class="text-danger">{{ art.quantite }}</strong> / Seuil : {{ art.seuilAlerte }}</div>
                                </a>
                            </li>
                        {% endfor %}
                    {% endif %}
                    {% if reunionsDelegation is defined and reunionsDelegation is not empty %}
                        <li class="dropdown-header text-primary fw-bold small mt-2"><i class="fas fa-calendar-alt me-1"></i>Réunions ({{ reunionsDelegation|length }})</li>
                        {% for reunion in reunionsDelegation %}
                            <li>
                                <a class="dropdown-item p-2 rounded mb-1 bg-light" href="#">
                                    <div class="fw-bold text-dark small">{{ reunion.titre }}</div>
                                    <div class="text-muted" style="font-size: 0.75rem;"><i class="far fa-clock me-1"></i>{{ reunion.date|date('d/m/Y H:i') }}</div>
                                </a>
                            </li>
                        {% endfor %}
                    {% endif %}
                    {% if (nbAlertesStock|default(0) == 0) and (reunionsDelegation is not defined or reunionsDelegation is empty) %}
                        <li class="text-center text-muted py-3 small"><i class="fas fa-check-circle text-success mb-1 d-block"></i>Aucune notification.</li>
                    {% endif %}
                </ul>
            </div>
            <div class="role-pill d-none d-md-inline-flex align-items-center">
                <i class="fas fa-user-check text-success me-2"></i>
                <span class="fw-bold">{{ userRole|default('Coordonnateur') }}</span>
            </div>
            <a href="/logout" class="btn btn-danger btn-sm fw-bold px-3 rounded-pill">
                <i class="fas fa-sign-out-alt me-1"></i> Déconnexion
            </a>
        </div>
    </div>
</nav>

<div class="container-fluid py-4 px-4" style="max-width: 1600px;">

    {# HERO #}
    <div class="hero-banner">
        <div class="hero-banner-content">
            <div class="hero-badge"><i class="fas fa-tasks"></i>Supervision intermédiaire</div>
            <h1 class="fw-bold mb-1" style="font-size: 1.75rem; letter-spacing: -0.5px;">Espace de Coordination</h1>
            <p class="mb-0" style="color: rgba(255,255,255,0.75); font-size: 0.92rem;">
                Validez les bons de sortie, arbitrez les devis de tous les services et supervisez la logistique.
            </p>
        </div>
    </div>

    {# Flash Messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'danger' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show shadow-sm mb-4 border-0 rounded-3" role="alert">
                <i class="fas {{ label == 'danger' ? 'fa-exclamation-triangle' : (label == 'warning' ? 'fa-info-circle' : 'fa-check-circle') }} me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# STATISTIQUES #}
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="stat-card stat-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Demandes à valider</h6>
                        <h3 class="fw-bold m-0 text-dark" style="font-size: 2rem;">{{ demandes|filter(d => d.statut == 'Validé Chef')|length }}</h3>
                    </div>
                    <div class="stat-icon stat-icon-warning"><i class="fas fa-clock"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-card stat-danger">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Devis à arbitrer</h6>
                        <h3 class="fw-bold m-0 text-dark" style="font-size: 2rem;">{{ devisListe|filter(d => d.statut == 'VALIDÉ_CHEF_SERVICE')|length }}</h3>
                    </div>
                    <div class="stat-icon stat-icon-danger"><i class="fas fa-file-invoice-dollar"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-card stat-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Bons à valider</h6>
                        <h3 class="fw-bold m-0 text-dark" style="font-size: 2rem;">{{ bonsSortie|filter(b => b.statut == 'Créé')|length }}</h3>
                    </div>
                    <div class="stat-icon stat-icon-success"><i class="fas fa-file-signature"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="stat-card stat-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Total devis</h6>
                        <h3 class="fw-bold m-0 text-dark" style="font-size: 2rem;">{{ devisListe|length }}</h3>
                    </div>
                    <div class="stat-icon stat-icon-primary"><i class="fas fa-list"></i></div>
                </div>
            </div>
        </div>
    </div>

    {# 🚨 BANNIÈRE ALERTES STOCK #}
    {% if nbAlertesStock|default(0) > 0 %}
    <div class="alert border-0 shadow-sm rounded-4 mb-4 p-0 overflow-hidden" style="background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);">
        <div class="p-3 d-flex justify-content-between align-items-center flex-wrap gap-2 border-bottom" style="border-color: rgba(220,38,38,0.2) !important;">
            <div>
                <h6 class="fw-bold text-danger m-0"><i class="fas fa-exclamation-triangle me-2"></i>{{ nbAlertesStock }} article(s) sous le seuil critique</h6>
                <small class="text-muted">Suivi de réapprovisionnement géré par la comptabilité.</small>
            </div>
            <button class="btn btn-sm btn-danger rounded-pill px-3 fw-bold" data-bs-toggle="collapse" data-bs-target="#alerteCollapseCoordon">
                <i class="fas fa-eye me-1"></i> Voir le détail
            </button>
        </div>
        <div class="collapse" id="alerteCollapseCoordon">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle m-0 bg-white">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Article & Machine</th>
                            <th class="text-center">Stock</th>
                            <th class="text-center">Seuil</th>
                            <th class="text-center">Statut réappro</th>
                            <th>Date prévue</th>
                            <th>Signalé le</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for art in articlesEnAlerte %}
                            <tr>
                                <td class="ps-3 fw-bold text-dark">
                                    <i class="fas fa-box text-danger me-2"></i>{{ art.nom }}
                                    
                                    {# ✅ CORRECTIF : Afficher la machine uniquement pour les encres (ou si l'article y est lié) #}
                                    {% if art.machine is defined and art.machine is not null %}
                                        {% if 'encre' in art.nom|lower or (art.subCategory is defined and art.subCategory and 'encre' in art.subCategory.nom|lower) %}
                                            <br>
                                            <span class="badge badge-soft badge-soft-secondary mt-1" style="font-size: 0.7rem;">
                                                <i class="fas fa-cog me-1"></i>Machine : {{ art.machine.nom }}
                                            </span>
                                        {% endif %}
                                    {% endif %}
                                </td>
                                <td class="text-center"><span class="badge bg-danger">{{ art.quantite }}</span></td>
                                <td class="text-center"><span class="badge bg-warning text-dark">{{ art.seuilAlerte }}</span></td>
                                <td class="text-center">
                                    {% if art.reapprovisionnementEnCours %}
                                        <span class="badge bg-primary"><i class="fas fa-truck-loading me-1"></i>En cours</span>
                                    {% else %}
                                        <span class="badge bg-secondary"><i class="fas fa-hourglass-start me-1"></i>Non lancé</span>
                                    {% endif %}
                                </td>
                                <td>{% if art.dateReapprovisionnement %}<strong class="text-primary">{{ art.dateReapprovisionnement|date('d/m/Y') }}</strong>{% else %}<span class="text-muted">—</span>{% endif %}</td>
                                <td class="text-muted small">{{ art.dateSignalementAlerte ? art.dateSignalementAlerte|date('d/m/Y H:i') : '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% endif %}

    {# ============================================
       CARTE PRINCIPALE À ONGLETS
    ============================================ #}
    <div class="main-card">
        <ul class="nav nav-tabs nav-tabs-modern" id="coordonTab" role="tablist">

            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="devis-tab" data-bs-toggle="tab" data-bs-target="#devis-pane" type="button" role="tab">
                    <i class="fas fa-file-invoice-dollar text-danger"></i>Arbitrage des Devis
                    {% set nb_devis_attente = devisListe|filter(d => d.statut == 'VALIDÉ_CHEF_SERVICE')|length %}
                    {% if nb_devis_attente > 0 %}<span class="badge bg-danger ms-1">{{ nb_devis_attente }}</span>{% endif %}
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link" id="validation-tab" data-bs-toggle="tab" data-bs-target="#validation-pane" type="button" role="tab">
                    <i class="fas fa-eye text-primary"></i>Suivi des Demandes
                    {% set nb_dem_attente = demandes|filter(d => d.statut == 'Validé Chef')|length %}
                    {% if nb_dem_attente > 0 %}<span class="badge bg-warning text-dark ms-1">{{ nb_dem_attente }}</span>{% endif %}
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link" id="bons-tab" data-bs-toggle="tab" data-bs-target="#bons-pane" type="button" role="tab">
                    <i class="fas fa-file-signature text-success"></i>Bons de Sortie
                    {% set nb_bons = bonsSortie|filter(b => b.statut == 'Créé')|length %}
                    {% if nb_bons > 0 %}<span class="badge bg-success ms-1">{{ nb_bons }}</span>{% endif %}
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link" id="report-tab" data-bs-toggle="tab" data-bs-target="#report-pane" type="button" role="tab">
                    <i class="fas fa-history text-info"></i>Historique & Traçabilité
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link" id="visite-tab" data-bs-toggle="tab" data-bs-target="#visite-pane" type="button" role="tab">
                    <i class="fas fa-calendar-plus text-warning"></i>Réserver Visite
                </button>
            </li>
        </ul>

        <div class="p-4">
            <div class="tab-content">

                {# ============================================================
                   ONGLET 1 : ARBITRAGE DES DEVIS
                ============================================================ #}
                <div class="tab-pane fade show active" id="devis-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark m-0"><i class="fas fa-gavel text-danger me-2"></i>Dossiers budgétaires à arbitrer</h5>
                            <small class="text-muted">Devis validés par les chefs de service. Vous pouvez ajuster le montant avant transmission au Comptable.</small>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <span class="badge badge-soft badge-soft-warning px-3 py-2"><i class="fas fa-dollar-sign me-1"></i>USD : {{ totalDevisUSD|default(0)|number_format(2, ',', ' ') }}</span>
                            <span class="badge badge-soft badge-soft-success px-3 py-2"><i class="fas fa-coins me-1"></i>CDF : {{ totalDevisCDF|default(0)|number_format(2, ',', ' ') }}</span>
                        </div>
                    </div>

                    {# 🔎 FILTRE #}
                    <form method="GET" action="{{ path('app_dashboard') }}" class="filter-bar row g-2 align-items-end mb-4">
                        <input type="hidden" name="tab" value="devis">
                        <div class="col-md-4">
                            <label class="form-label"><i class="fas fa-calendar-alt me-1"></i>Du</label>
                            <input type="date" name="date_debut" class="form-control" value="{{ date_debut|default('now'|date('Y-m-d')) }}">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label"><i class="fas fa-calendar-alt me-1"></i>Au</label>
                            <input type="date" name="date_fin" class="form-control" value="{{ date_fin|default('now'|date('Y-m-d')) }}">
                        </div>
                        <div class="col-md-4 d-flex gap-2">
                            <button type="submit" class="btn btn-danger flex-grow-1 fw-bold rounded-pill"><i class="fas fa-filter me-1"></i>Filtrer</button>
                            <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary rounded-pill" title="Réinitialiser"><i class="fas fa-rotate"></i></a>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-modern table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th><th>Date</th><th>Émetteur</th><th>Département</th>
                                    <th>Description</th><th>Statut</th><th class="text-end">Montant</th><th class="text-center">Action Coordon</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for devis in devisListe %}
                                    <tr class="{% if devis.statut == 'VALIDÉ_CHEF_SERVICE' %}row-pending{% endif %}">
                                        <td class="fw-bold text-secondary">#{{ devis.id }}</td>
                                        <td class="text-muted small">{{ devis.createdAt|date('d/m/Y') }}</td>
                                        <td><span class="badge badge-soft badge-soft-secondary"><i class="fas fa-user me-1"></i>{{ devis.user ? devis.user.userIdentifier : devis.createdBy }}</span></td>
                                        <td>
                                            {% if devis.user and devis.user.service %}
                                                <span class="badge badge-soft badge-soft-info"><i class="fas fa-building me-1"></i>{{ devis.user.service.nom }}</span>
                                            {% else %}
                                                <span class="badge badge-soft badge-soft-secondary">—</span>
                                            {% endif %}
                                        </td>
                                        <td class="fw-semibold text-dark">{{ devis.description }}</td>
                                        <td>
    {% if devis.statut == 'VALIDÉ_CHEF_SERVICE' %}<span class="badge badge-soft badge-soft-danger"><i class="fas fa-hourglass-half me-1"></i>À arbitrer</span>
    {% elseif devis.statut == 'ATTENTE_COMPTA' %}<span class="badge badge-soft badge-soft-primary"><i class="fas fa-arrow-right me-1"></i>Chez le Comptable</span>
    {% elseif devis.statut == 'ATTENTE_CHEF_SERVICE' %}<span class="badge badge-soft badge-soft-warning"><i class="fas fa-user-tie me-1"></i>Chez le Chef Compta</span>
    {% elseif devis.statut == 'ATTENTE_DIR' %}<span class="badge badge-soft badge-soft-primary"><i class="fas fa-gavel me-1"></i>Chez le DG</span>
    {% elseif devis.statut == 'ATTENTE_CAISSE' %}<span class="badge badge-soft badge-soft-info"><i class="fas fa-cash-register me-1"></i>Chez la Caisse</span>
    {% elseif devis.statut == 'ATTENTE_DECAISSEMENT' %}<span class="badge badge-soft badge-soft-warning"><i class="fas fa-hand-holding-usd me-1"></i>À décaisser</span>
    {% elseif devis.statut == 'DECAISSE' %}<span class="badge badge-soft badge-soft-success"><i class="fas fa-check-double me-1"></i>Décaissé</span>
    {% elseif devis.statut == 'REJETE' %}<span class="badge badge-soft badge-soft-danger"><i class="fas fa-ban me-1"></i>Rejeté</span>
    {% else %}<span class="badge badge-soft badge-soft-secondary">{{ devis.statut }}</span>
    {% endif %}
</td><td class="text-end font-monospace fw-bold text-dark">{{ devis.montant|number_format(2, ',', ' ') }} <span class="small text-muted">{{ devis.devise }}</span></td>
                                        <td class="text-center">
                                            {% if devis.statut == 'VALIDÉ_CHEF_SERVICE' %}
                                                <form action="{{ path('app_coordonnateur_valider_devis', {'id': devis.id}) }}" method="POST" class="d-flex gap-2 justify-content-center align-items-center flex-wrap">
                                                    <div class="input-group input-group-sm" style="max-width: 130px;">
                                                        <input type="number" step="0.01" name="nouveau_montant" class="form-control text-end fw-bold text-danger" value="{{ devis.montant }}" required>
                                                        <span class="input-group-text bg-light small fw-bold" style="font-size:0.7rem;">{{ devis.devise }}</span>
                                                    </div>
                                                    <button type="submit" class="btn btn-sm btn-success fw-bold rounded-pill px-3"><i class="fas fa-check me-1"></i> Valider</button>
                                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2"
                                                            onclick="if(confirm('Rejeter ce devis ?')) { document.getElementById('rejeter-{{ devis.id }}').submit(); }">
                                                        <i class="fas fa-ban"></i>
                                                    </button>
                                                </form>
                                                <form id="rejeter-{{ devis.id }}" action="{{ path('app_coordonnateur_rejeter_devis', {'id': devis.id}) }}" method="POST" class="d-none"></form>
                                            {% else %}
                                                <span class="text-muted small">—</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="8">
                                            <div class="empty-state">
                                                <i class="fas fa-folder-open"></i>
                                                <div class="fw-bold">Aucun devis sur cette période</div>
                                                <small>Modifiez les dates du filtre ou attendez de nouvelles validations.</small>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {# ============================================================
                   ONGLET 2 : SUIVI DES DEMANDES (lecture seule)
                ============================================================ #}
                <div class="tab-pane fade" id="validation-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark m-0"><i class="fas fa-eye text-primary me-2"></i>Suivi des demandes validées</h5>
                            <small class="text-muted">Demandes validées par les chefs de service et transmises à la comptabilité. Consultation uniquement.</small>
                        </div>
                    </div>

                    {# 🔎 FILTRE #}
                    <form method="GET" action="{{ path('app_dashboard') }}" class="filter-bar row g-2 align-items-end mb-4">
                        <input type="hidden" name="tab" value="validation">
                        <div class="col-md-4">
                            <label class="form-label"><i class="fas fa-calendar-alt me-1"></i>Du</label>
                            <input type="date" name="date_debut" class="form-control" value="{{ date_debut|default('now'|date('Y-m-d')) }}">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label"><i class="fas fa-calendar-alt me-1"></i>Au</label>
                            <input type="date" name="date_fin" class="form-control" value="{{ date_fin|default('now'|date('Y-m-d')) }}">
                        </div>
                        <div class="col-md-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-grow-1 fw-bold rounded-pill"><i class="fas fa-filter me-1"></i>Filtrer</button>
                            <a href="{{ path('app_dashboard', {'tab': 'validation'}) }}" class="btn btn-outline-secondary rounded-pill" title="Réinitialiser"><i class="fas fa-rotate"></i></a>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-modern table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Demandeur</th>
                                    <th>Matériel</th>
                                    <th class="text-center">Quantité</th>
                                    <th>Département</th>
                                    <th>Date</th>
                                    <th class="text-center">Statut actuel</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% set hasPending = false %}
                                {% for demande in demandes %}
                                    {% if demande.statut == 'Validé Chef' %}
                                        {% set hasPending = true %}
                                        <tr class="row-pending">
                                            <td class="fw-bold text-secondary">#{{ demande.id }}</td>
                                            <td><span class="badge badge-soft badge-soft-secondary">{{ demande.demandeur ? demande.demandeur.userIdentifier : 'Inconnu' }}</span></td>
                                            <td class="fw-semibold text-dark">{{ demande.materiel }}</td>
                                            <td class="text-center fw-bold text-primary font-monospace">{{ demande.quantite ?? 1 }}</td>
                                            <td><span class="badge badge-soft badge-soft-secondary">{{ demande.departement }}</span></td>
                                            <td class="text-muted small">{{ demande.createdAt ? demande.createdAt|date('d/m/Y H:i') : '' }}</td>
                                            <td class="text-center">
                                                <span class="badge badge-soft badge-soft-primary">
                                                    <i class="fas fa-hourglass-half me-1"></i>En attente de la comptabilité
                                                </span>
                                            </td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}

                                {% if not hasPending %}
                                    <tr>
                                        <td colspan="7">
                                            <div class="empty-state">
                                                <i class="fas fa-check-circle" style="color:#10b981;"></i>
                                                <div class="fw-bold">Aucune demande en attente sur cette période</div>
                                                <small>Toutes les demandes ont été traitées ou élargissez le filtre.</small>
                                            </div>
                                        </td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {# ============================================================
                   ONGLET 3 : BONS DE SORTIE — ACTIONS DU COORDONNATEUR
                ============================================================ #}
                <div class="tab-pane fade" id="bons-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark m-0"><i class="fas fa-file-signature text-success me-2"></i>Bons de sortie à valider</h5>
                            <small class="text-muted">Bons créés par les membres et le stock. Vous pouvez <strong>accorder</strong> ou <strong>rejeter</strong>.</small>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-modern table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Employé</th>
                                    <th>Département</th>
                                    <th>Motif</th>
                                    <th>Date</th>
                                    <th>Statut</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% set hasBons = false %}
                                {% for bon in bonsSortie %}
                                    {% if bon.statut == 'Créé' %}
                                        {% set hasBons = true %}
                                        <tr class="row-pending">
                                            <td class="fw-bold text-secondary">#{{ bon.id }}</td>
                                            <td>
                                                <span class="badge badge-soft badge-soft-secondary">
                                                    <i class="fas fa-user me-1"></i>{{ bon.nomEmploye }}
                                                </span>
                                            </td>
                                            <td><span class="badge badge-soft badge-soft-info">{{ bon.departement }}</span></td>
                                            <td class="fw-semibold text-dark">
                                                {{ bon.raison|default(bon.motif|default('—')) }}
                                            </td>
                                            <td class="text-muted small">{{ bon.dateCreation ? bon.dateCreation|date('d/m/Y H:i') : '—' }}</td>
                                            <td>
                                                <span class="badge badge-soft badge-soft-danger">
                                                    <i class="fas fa-hourglass-half me-1"></i>En attente
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <div class="d-flex justify-content-center gap-1">
                                                    {# ✅ ACCORDER #}
                                                    <form action="{{ path('app_bon_valider', {'id': bon.id}) }}" method="post" class="d-inline"
                                                          onsubmit="return confirm('Accorder ce bon de sortie ?');">
                                                        <button type="submit" class="btn btn-sm btn-success fw-bold rounded-pill px-3">
                                                            <i class="fas fa-check me-1"></i>Accorder
                                                        </button>
                                                    </form>

                                                    {# ❌ REJETER #}
                                                    <form action="{{ path('app_bon_rejeter', {'id': bon.id}) }}" method="post" class="d-inline"
                                                          onsubmit="return confirm('Rejeter ce bon de sortie ?');">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                            <i class="fas fa-ban me-1"></i>Rejeter
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}

                                {% if not hasBons %}
                                    <tr>
                                        <td colspan="7">
                                            <div class="empty-state">
                                                <i class="fas fa-check-circle" style="color:#10b981;"></i>
                                                <div class="fw-bold">Aucun bon de sortie en attente</div>
                                                <small>Tous les bons ont été traités.</small>
                                            </div>
                                        </td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>

                    {# Historique des bons traités #}
                    <div class="mt-5">
                        <h6 class="fw-bold text-secondary mb-3"><i class="fas fa-history me-2"></i>Historique des bons traités</h6>
                        <div class="table-responsive">
                            <table class="table table-modern table-hover">
                                <thead>
                                    <tr>
                                        <th>ID</th><th>Employé</th><th>Département</th><th>Date</th><th>Statut final</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% set hasHistory = false %}
                                    {% for bon in bonsSortie %}
                                        {% if bon.statut == 'Validé Coordon' or bon.statut == 'Rejeté Coordon' or bon.statut == 'Sortie effective' %}
                                            {% set hasHistory = true %}
                                            <tr>
                                                <td class="fw-bold text-secondary">#{{ bon.id }}</td>
                                                <td>{{ bon.nomEmploye }}</td>
                                                <td><span class="badge badge-soft badge-soft-secondary">{{ bon.departement }}</span></td>
                                                <td class="text-muted small">{{ bon.dateCreation ? bon.dateCreation|date('d/m/Y H:i') : '—' }}</td>
                                                <td>
                                                    {% if bon.statut == 'Validé Coordon' %}
                                                        <span class="badge badge-soft badge-soft-success"><i class="fas fa-check me-1"></i>Accordé</span>
                                                    {% elseif bon.statut == 'Rejeté Coordon' %}
                                                        <span class="badge badge-soft badge-soft-danger"><i class="fas fa-ban me-1"></i>Rejeté</span>
                                                    {% elseif bon.statut == 'Sortie effective' %}
                                                        <span class="badge badge-soft badge-soft-primary"><i class="fas fa-truck me-1"></i>Sortie effective</span>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endif %}
                                    {% endfor %}
                                    {% if not hasHistory %}
                                        <tr>
                                            <td colspan="5">
                                                <div class="empty-state"><i class="fas fa-inbox"></i><div class="fw-bold">Aucun bon traité</div></div>
                                            </td>
                                        </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                {# ============================================================
                   ONGLET 4 : HISTORIQUE & TRAÇABILITÉ
                ============================================================ #}
                <div class="tab-pane fade" id="report-pane" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark m-0"><i class="fas fa-history text-info me-2"></i>Registre de sortie & traçabilité logistique</h5>
                            <small class="text-muted">Tous les mouvements de matériel sur la période sélectionnée.</small>
                        </div>
                    </div>

                    {# 🔎 FILTRE UNIFIÉ #}
                    <form method="GET" action="{{ path('app_dashboard') }}" class="filter-bar row g-2 align-items-end mb-4">
                        <input type="hidden" name="tab" value="report">
                        <div class="col-md-4">
                            <label class="form-label"><i class="fas fa-calendar-alt me-1"></i>Du</label>
                            <input type="date" name="date_debut" class="form-control" value="{{ date_debut|default('now'|date('Y-m-d')) }}">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label"><i class="fas fa-calendar-alt me-1"></i>Au</label>
                            <input type="date" name="date_fin" class="form-control" value="{{ date_fin|default('now'|date('Y-m-d')) }}">
                        </div>
                        <div class="col-md-4 d-flex gap-2">
                            <button type="submit" class="btn btn-info text-white flex-grow-1 fw-bold rounded-pill"><i class="fas fa-filter me-1"></i>Filtrer</button>
                            <a href="{{ path('app_dashboard', {'tab': 'report'}) }}" class="btn btn-outline-secondary rounded-pill" title="Réinitialiser"><i class="fas fa-rotate"></i></a>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-modern table-hover">
                            <thead>
                                <tr>
                                    <th>Date</th><th>Département</th><th>Origine</th><th>Article</th>
                                    <th class="text-center">Quantité</th><th>Destination</th><th class="text-center">État</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for rg in rapportGlobal %}
                                    <tr>
                                        <td class="text-muted small font-monospace">{{ rg.createdAt|date('d/m/Y H:i') }}</td>
                                        <td><span class="badge badge-soft badge-soft-secondary">{{ rg.departement }}</span></td>
                                        <td><span class="badge badge-soft badge-soft-secondary">{{ rg.localisation|default('Direction')|upper }}</span></td>
                                        <td class="fw-semibold text-dark">{{ rg.materiel }}</td>
                                        <td class="text-center fw-bold font-monospace">
                                            {% if rg.materiel|lower == 'gilet' or rg.materiel|lower == 'gilets' %}
                                                {% set p_rep = (rg.quantite / 25)|round(0, 'floor') %}
                                                {% set r_rep = rg.quantite % 25 %}
                                                <span class="text-success">{{ p_rep }} pqt(s) {% if r_rep > 0 %}{{ r_rep }} u{% endif %}</span>
                                            {% else %}
                                                {{ rg.quantite }}
                                            {% endif %}
                                        </td>
                                        <td class="fw-bold text-secondary"><i class="fas fa-map-marker-alt text-primary me-1"></i>{{ rg.destination|default('Dépôt central')|upper }}</td>
                                        <td class="text-center">
                                            {% if rg.statut == 'Livré par le Stock' %}
                                                <span class="badge badge-soft badge-soft-success"><i class="fas fa-check me-1"></i>Confirmée</span>
                                            {% else %}
                                                <span class="badge badge-soft badge-soft-secondary">{{ rg.statut }}</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="7">
                                            <div class="empty-state">
                                                <i class="fas fa-inbox"></i>
                                                <div class="fw-bold">Aucun mouvement trouvé</div>
                                                <small>Aucune donnée pour cette période.</small>
                                            </div>
                                        </td>
                                    </tr>

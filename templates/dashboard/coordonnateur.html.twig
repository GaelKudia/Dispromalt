                            <div class="col-lg-8 col-xl-7">
                                <div class="form-card">
                                    <div class="text-center mb-4">
                                        <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex p-3 mb-2">
                                            <i class="fas fa-calendar-alt text-warning fa-2x"></i>
                                        </div>
                                        <h5 class="fw-bold text-dark">Planifier une Visite</h5>
                                        <p class="text-muted small mb-0">Enregistrez l'arrivée d'un visiteur ou d'un partenaire.</p>
                                    </div>
                                    {{ form_start(formVisite, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                {{ form_label(formVisite.nomVisiteur, 'Nom & Prénom', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                                {{ form_widget(formVisite.nomVisiteur, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Jean Dupont'}}) }}
                                                {{ form_errors(formVisite.nomVisiteur) }}
                                            </div>
                                            <div class="col-md-6">
                                                {{ form_label(formVisite.departement, 'Département visité', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                                {{ form_widget(formVisite.departement, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Production'}}) }}
                                                {{ form_errors(formVisite.departement) }}
                                            </div>
                                            <div class="col-12">
                                                {{ form_label(formVisite.motif, 'Motif de la visite', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                                {{ form_widget(formVisite.motif, {'attr': {'class': 'form-control', 'rows': 2, 'placeholder': 'Raison de la visite'}}) }}
                                                {{ form_errors(formVisite.motif) }}
                                            </div>
                                            {% if formVisite.telephone is defined %}
                                                <div class="col-md-6">
                                                    {{ form_label(formVisite.telephone, 'Téléphone', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                                    {{ form_widget(formVisite.telephone, {'attr': {'class': 'form-control'}}) }}
                                                </div>
                                            {% endif %}
                                            {% if formVisite.email is defined %}
                                                <div class="col-md-6">
                                                    {{ form_label(formVisite.email, 'Email', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                                    {{ form_widget(formVisite.email, {'attr': {'class': 'form-control'}}) }}
                                                </div>
                                            {% endif %}
                                            {% if formVisite.pieceIdentite is defined %}
                                                <div class="col-12">
                                                    {{ form_label(formVisite.pieceIdentite, 'Pièce d\'identité', {'label_attr': {'class': 'form-label small fw-bold text-secondary'}}) }}
                                                    {{ form_widget(formVisite.pieceIdentite, {'attr': {'class': 'form-control'}}) }}
                                                </div>
                                            {% endif %}
                                        </div>
                                        <button type="submit" class="btn btn-warning fw-bold w-100 py-2 mt-3 rounded-3 text-dark"><i class="fas fa-save me-2"></i>Enregistrer la Visite</button>
                                    {{ form_end(formVisite) }}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="alert alert-warning text-center mb-0 rounded-3"><i class="fas fa-exclamation-triangle me-2"></i>Le formulaire de visite n'est pas disponible.</div>
                    {% endif %}
                </div>

            </div>
        </div>
    </div>
</div>

{# ============================================
   SCRIPTS
============================================ #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // 🔎 Restaurer l'onglet actif à partir du paramètre GET "tab"
        const params = new URLSearchParams(window.location.search);
        const tabParam = params.get('tab');
        if (tabParam) {
            const triggerEl = document.querySelector(`#coordonTab button[data-bs-target="#${tabParam}-pane"]`);
            if (triggerEl) new bootstrap.Tab(triggerEl).show();
        }

        // Mémorisation de l'onglet actif via URL (hash)
        document.querySelectorAll('#coordonTab button[data-bs-toggle="tab"]').forEach(btn => {
            btn.addEventListener('shown.bs.tab', e => {
                const target = e.target.getAttribute('data-bs-target').replace('#', '').replace('-pane', '');
                history.replaceState(null, null, '?tab=' + target);
            });
        });
    });
</script>
</body>
</html>
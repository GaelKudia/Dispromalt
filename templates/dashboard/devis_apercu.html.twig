<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Aperçu du Devis - Dispromalt</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        @media print {
            .no-print { display: none !important; }
            .card { border: none !important; shadow: none !important; }
        }
    </style>
</head>
<body class="bg-light">

    <div class="container py-5">
        
        <div class="d-flex justify-content-between align-items-center mb-4 no-print">
            <a href="{{ path('app_devis_nouveau') }}" class="btn btn-outline-secondary fw-semibold">
                <i class="fas fa-edit me-1"></i> Modifier le brouillon
            </a>
            
            <div class="d-flex gap-2">
                <button onclick="window.print();" class="btn btn-danger fw-bold">
                    <i class="fas fa-file-pdf me-1"></i> Version PDF / Imprimer
                </button>
                
                <form method="POST" action="{{ path('app_devis_apercu') }}" class="d-inline">
                    <button type="submit" class="btn btn-success fw-bold">
                        <i class="fas fa-paper-plane me-1"></i> Confirmer & Envoyer à la Compta
                    </button>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm p-5 bg-white mx-auto" style="max-width: 800px; border-top: 6px solid #212529 !important;">
            
            <div class="row border-bottom pb-4 mb-4 align-items-center">
                <div class="col-6">
                    <h4 class="fw-bold m-0">DISPRO<span class="text-primary">MALT</span></h4>
                    <p class="text-muted small m-0">Service Impression / Logistique</p>
                </div>
                <div class="col-6 text-end">
                    <h5 class="fw-bold text-dark m-0">Devis de : <span class="text-secondary">{{ app.user.userIdentifier }}</span></h5>
                    <p class="text-muted small m-0">Date : <strong>{{ "now"|date("d/m/Y") }}</strong></p>
                </div>
            </div>

            <div class="text-center my-4">
                <h3 class="fw-bold text-uppercase tracking-wide">Fiche de Devis Estimatif</h3>
                <span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-1.5 small">Statut : BROUILLON / AVANT-PROJET</span>
            </div>



<div class="text-center my-4">
    <h3 class="fw-bold text-uppercase tracking-wide"{{ devis.entete ?? 'Nouveau Devis' }}</h3>
    <span class="badge bg-secondary bg-opacity-10 text-secondary border px-3 py-1.5 small">Statut : BROUILLON</span>
</div>
            <div class="my-4">
                <h6 class="fw-bold text-secondary text-uppercase small border-bottom pb-2 mb-3">Détails de la demande</h6>
                <div class="p-4 bg-light rounded border text-dark style-textarea-content" style="white-space: pre-line; min-height: 150px;">
                    {{ devis.description }}
                </div>
            </div>

            <div class="row justify-content-end mt-4">
                <div class="col-md-5">
                    <div class="p-3 bg-dark text-white rounded shadow-sm text-end">
                        <h6 class="text-uppercase small text-muted m-0 fw-bold">Montant Global Estimé</h6>
                        <h3 class="fw-bold m-0 text-warning">{{ devis.montant|number_format(2, ',', ' ') }} $</h3>
                    </div>
                </div>
            </div>

            <div class="mt-5 pt-4 border-top text-center text-muted small">
                <p class="m-0">Document généré électroniquement depuis l'Espace Opérationnel Dispromalt.</p>
                <p class="small text-muted">Ce document fait office de proposition interne avant validation budgétaire.</p>
            </div>

        </div>
    </div>

</body>
</html>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Poste de Contrôle - Guérite Sécurité</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        /* --- Styles généraux --- */
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Roboto, system-ui, sans-serif;
        }

        .filter-section {
            background: #ffffff;
            border-radius: 12px;
            padding: 1.25rem 1.5rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
            margin-bottom: 1.5rem;
            border: 1px solid #e9ecef;
        }
        .filter-section .form-label {
            font-weight: 600;
            font-size: 0.8rem;
            color: #495057;
        }

        /* --- Cartes statistiques --- */
        .stat-card {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            border-radius: 16px;
            border: none;
        }
        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.06) !important;
        }
        .stat-card .stat-icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(0, 0, 0, 0.04);
        }

        /* --- Badges statuts --- */
        .badge-statut {
            font-size: 0.7rem;
            padding: 0.35rem 0.75rem;
            border-radius: 50px;
            font-weight: 600;
            letter-spacing: 0.2px;
            transition: all 0.2s;
        }

        /* --- Animations des lignes de tableau --- */
        .fade-in-row {
            opacity: 0;
            animation: fadeInUp 0.4s ease forwards;
        }
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* --- Effet de survol des cartes --- */
        .card-hover {
            transition: box-shadow 0.25s ease, transform 0.2s ease;
        }
        .card-hover:hover {
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06) !important;
            transform: translateY(-2px);
        }

        /* --- Boutons d'action --- */
        .btn-action {
            border-radius: 50px;
            padding: 0.35rem 1rem;
            font-weight: 600;
            transition: all 0.2s;
        }
        .btn-action:hover {
            transform: scale(1.02);
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.2);
        }

        /* --- Flash messages --- */
        .flash-message {
            transition: opacity 0.5s ease;
        }
    </style>
</head>
<body>

    <!-- ============================================
    NAVBAR
    ============================================ -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-3">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold fs-4" href="#">
                <i class="fas fa-shield-alt text-warning me-2"></i>Dispro<span class="text-primary">malt</span>
                <span class="fw-light fs-5 text-muted">| Sécurité Guérite</span>
            </a>
            <div class="d-flex align-items-center">
                <div class="bg-secondary bg-opacity-20 text-white px-3 py-1.5 rounded-pill me-3 small border border-secondary">
                    <i class="fas fa-user-shield text-warning me-2"></i><strong>Agent de Sécurité</strong>
                </div>
                <a href="/logout" class="btn btn-primary btn-sm fw-bold px-3">
                    <i class="fas fa-sign-out-alt me-1"></i> Déconnexion
                </a>
            </div>
        </div>
    </nav>

    <!-- ============================================
    MAIN CONTAINER
    ============================================ -->
    <div class="container py-4">

        <!-- En‑tête -->
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-2">
            <div>
                <h1 class="fw-bold text-dark m-0">Contrôle de Sécurité Entrées / Sorties</h1>
                <p class="text-muted m-0">Gestion en temps réel des flux de matériel et des visiteurs de l'usine.</p>
            </div>
            <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#modalVisiteur">
                <i class="fas fa-user-plus me-2"></i>Enregistrer un Visiteur
            </button>
        </div>

        <!-- Flash Messages -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'danger' ? 'danger' : 'success' }} alert-dismissible fade show shadow-sm mb-4 border-0 rounded-4 flash-message" role="alert">
                    <i class="fas {{ label == 'danger' ? 'fa-exclamation-triangle' : 'fa-check-circle' }} me-2"></i>
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <!-- ============================================
        SECTION FILTRAGE
        ============================================ -->
        <div class="filter-section">
            <form method="GET" action="{{ path('app_dashboard') }}" class="row g-3 align-items-end">
                <div class="col-md-3 col-sm-6">
                    <label class="form-label"><i class="far fa-calendar me-1"></i>Date début</label>
                    <input type="date" name="filtre_date_debut" class="form-control form-control-sm" value="{{ filtre_date_debut }}">
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label"><i class="far fa-calendar me-1"></i>Date fin</label>
                    <input type="date" name="filtre_date_fin" class="form-control form-control-sm" value="{{ filtre_date_fin }}">
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label"><i class="fas fa-filter me-1"></i>Type</label>
                    <select name="filtre_type" class="form-select form-select-sm">
                        <option value="tous" {% if filtre_type == 'tous' %}selected{% endif %}>Tous</option>
                        <option value="visites" {% if filtre_type == 'visites' %}selected{% endif %}>Visites</option>
                        <option value="bons" {% if filtre_type == 'bons' %}selected{% endif %}>Bons de sortie</option>
                        <option value="rdv" {% if filtre_type == 'rdv' %}selected{% endif %}>Rendez-vous</option>
                    </select>
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label"><i class="fas fa-tag me-1"></i>Statut</label>
                    <select name="filtre_statut" class="form-select form-select-sm">
                        <option value="tous" {% if filtre_statut == 'tous' %}selected{% endif %}>Tous</option>
                        <option value="A_L_ACCUEIL" {% if filtre_statut == 'A_L_ACCUEIL' %}selected{% endif %}>En attente accueil</option>
                        <option value="RESERVE" {% if filtre_statut == 'RESERVE' %}selected{% endif %}>Réservé</option>
                        <option value="VALIDE" {% if filtre_statut == 'VALIDE' %}selected{% endif %}>Validé</option>
                        <option value="TERMINE" {% if filtre_statut == 'TERMINE' %}selected{% endif %}>Terminé</option>
                        <option value="Créé" {% if filtre_statut == 'Créé' %}selected{% endif %}>Bon créé</option>
                        <option value="Validé Coordon" {% if filtre_statut == 'Validé Coordon' %}selected{% endif %}>Bon validé</option>
                        <option value="Sortie effective" {% if filtre_statut == 'Sortie effective' %}selected{% endif %}>Sortie effective</option>
                    </select>
                </div>
                <div class="col-md-12 text-end">
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4">
                        <i class="fas fa-search me-1"></i> Filtrer
                    </button>
                    <a href="{{ path('app_dashboard') }}" class="btn btn-secondary btn-sm rounded-pill px-4">
                        <i class="fas fa-undo me-1"></i> Réinitialiser
                    </a>
                </div>
            </form>
        </div>

        <!-- ============================================
        STATISTIQUES
        ============================================ -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="card stat-card bg-white p-3 shadow-sm border-start border-warning border-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase small fw-bold">Bons de sortie</h6>
                            <h3 class="fw-bold m-0 text-warning">{{ bonsSortie|length }}</h3>
                        </div>
                        <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                            <i class="fas fa-file-invoice fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card stat-card bg-white p-3 shadow-sm border-start border-info border-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase small fw-bold">Visiteurs en attente</h6>
                            <h3 class="fw-bold m-0 text-info">{{ visites|length }}</h3>
                        </div>
                        <div class="stat-icon bg-info bg-opacity-10 text-info">
                            <i class="fas fa-user-check fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card stat-card bg-white p-3 shadow-sm border-start border-success border-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase small fw-bold">Rendez-vous réservés</h6>
                            <h3 class="fw-bold m-0 text-success">{{ rdvReserves|default([])|length }}</h3>
                        </div>
                        <div class="stat-icon bg-success bg-opacity-10 text-success">
                            <i class="fas fa-calendar-check fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card stat-card bg-white p-3 shadow-sm border-start border-danger border-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase small fw-bold">Visites terminées</h6>
                            <h3 class="fw-bold m-0 text-danger">{{ visitesTerminees|default(0) }}</h3>
                        </div>
                        <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                            <i class="fas fa-check-double fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================
        LISTE DES VISITES EN ATTENTE
        ============================================ -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5 card-hover">
            <div class="card-header bg-info bg-opacity-10 py-3 border-bottom border-info border-opacity-25">
                <h4 class="card-title m-0 fw-bold text-dark">
                    <i class="fas fa-users-viewfinder me-2 text-info"></i>Visiteurs en Attente d'Accueil
                </h4>
            </div>
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table table-hover align-middle m-0">
                        <thead class="table-light small text-uppercase fw-bold text-secondary">
                            <tr>
                                <th>ID</th>
                                <th>Nom du Visiteur</th>
                                <th>Département</th>
                                <th>Motif</th>
                                <th>Date arrivée</th>
                                <th>Statut</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for v in visites %}
                                <tr class="fade-in-row" style="animation-delay: {{ loop.index * 0.05 }}s;">
                                    <td class="fw-bold text-secondary">#{{ v.id }}</td>
                                    <td class="fw-semibold text-dark">{{ v.nomVisiteur }}</td>
                                    <td><span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">{{ v.departement }}</span></td>
                                    <td class="text-muted fw-light">{{ v.motif }}</td>
                                    <td class="text-muted">{{ v.dateArrivee ? v.dateArrivee|date('d/m/Y H:i') : '-' }}</td>
                                    <td>
                                        <span class="badge-statut {% if v.statut == 'A_L_ACCUEIL' %}bg-warning text-dark{% elseif v.statut == 'RESERVE' %}bg-info{% elseif v.statut == 'VALIDE' %}bg-success{% else %}bg-secondary{% endif %}">
                                            {{ v.statut }}
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        {% if v.statut == 'A_L_ACCUEIL' %}
                                            <form action="{{ path('app_visite_valider_guerite', {'id': v.id}) }}" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success btn-action px-3">
                                                    <i class="fas fa-check me-1"></i> Valider
                                                </button>
                                            </form>
                                        {% endif %}
                                        {% if v.statut == 'VALIDE' or v.statut == 'RESERVE' %}
                                            <form action="{{ path('app_visite_cloturer', {'id': v.id}) }}" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger btn-action px-3">
                                                    <i class="fas fa-door-open me-1"></i> Clôturer
                                                </button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="fas fa-user-clock fa-2x mb-2 d-block"></i>
                                        Aucun visiteur en attente.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ============================================
        RENDEZ-VOUS RÉSERVÉS
        ============================================ -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5 card-hover">
            <div class="card-header bg-primary bg-opacity-10 py-3 border-bottom border-primary border-opacity-25">
                <h4 class="card-title m-0 fw-bold text-dark">
                    <i class="fas fa-calendar-alt me-2 text-primary"></i>Rendez-vous Réservés
                </h4>
            </div>
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table table-hover align-middle m-0">
                        <thead class="table-light small text-uppercase fw-bold text-secondary">
                            <tr>
                                <th>ID</th>
                                <th>Visiteur</th>
                                <th>Département</th>
                                <th>Motif</th>
                                <th>Date réservation</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for rdv in rdvReserves|default([]) %}
                                <tr class="fade-in-row" style="animation-delay: {{ loop.index * 0.05 }}s;">
                                    <td class="fw-bold text-secondary">#{{ rdv.id }}</td>
                                    <td class="fw-semibold text-dark">{{ rdv.nomVisiteur }}</td>
                                    <td><span class="badge bg-info bg-opacity-10 text-info border px-2 py-1">{{ rdv.departement }}</span></td>
                                    <td class="text-muted fw-light">{{ rdv.motif }}</td>
                                    <td class="text-muted">{{ rdv.dateArrivee ? rdv.dateArrivee|date('d/m/Y H:i') : '-' }}</td>
                                    <td>
                                        <span class="badge-statut bg-primary text-white">{{ rdv.statut }}</span>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-calendar-times fa-2x mb-2 d-block"></i>
                                        Aucun rendez-vous réservé.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ============================================
        REGISTRE DES BONS DE SORTIE (AVEC ACTION)
        ============================================ -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden card-hover">
            <div class="card-header bg-white py-3">
                <h4 class="card-title m-0 fw-bold text-dark">
                    <i class="fas fa-list-check me-2 text-muted"></i>Registre des Bons de Sortie
                </h4>
            </div>
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table table-hover align-middle m-0">
                        <thead class="table-light small text-uppercase fw-bold text-secondary">
                            <tr>
                                <th>Code</th>
                                <th>Nom Agent</th>
                                <th>Département</th>
                                <th>Date création</th>
                                <th>Statut</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for b in bonsSortie %}
                                <tr class="fade-in-row" style="animation-delay: {{ loop.index * 0.05 }}s;">
                                    <td class="fw-bold text-secondary">#{{ b.id }}</td>
                                    <td class="fw-semibold text-dark">{{ b.nomEmploye }}</td>
                                    <td><span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1">{{ b.departement }}</span></td>
                                    <td class="text-muted">{{ b.dateCreation ? b.dateCreation|date('d/m/Y H:i') : '-' }}</td>
                                    <td>
                                        <span class="badge-statut {% if b.statut == 'Créé' %}bg-warning text-dark{% elseif b.statut == 'Validé Coordon' %}bg-success text-white{% elseif b.statut == 'Sortie effective' %}bg-info text-white{% else %}bg-secondary text-white{% endif %}">
                                            {{ b.statut }}
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        {% if b.statut == 'Validé Coordon' %}
                                            <form action="{{ path('app_guerite_sortie_bon', {'id': b.id}) }}" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-primary btn-action px-3" onclick="return confirm('Confirmer la sortie physique du matériel pour ce bon ?')">
                                                    <i class="fas fa-door-open me-1"></i> Sortie effective
                                                </button>
                                            </form>
                                        {% elseif b.statut == 'Sortie effective' %}
                                            <span class="badge bg-success px-3 py-2"><i class="fas fa-check-circle me-1"></i> Sortie confirmée</span>
                                        {% else %}
                                            <span class="text-muted small">En attente de validation</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-box-open fa-2x mb-2 d-block"></i>
                                        Aucun bon de sortie enregistré.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================
    MODAL : ENREGISTRER UN VISITEUR
    ============================================ -->
    <div class="modal fade" id="modalVisiteur" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header bg-primary text-white border-0">
                    <h5 class="modal-title"><i class="fas fa-user-plus me-2"></i>Enregistrer un Visiteur</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    {% if formVisiteGuerite is defined and formVisiteGuerite is not null %}
                        {{ form_start(formVisiteGuerite) }}
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Nom du Visiteur <span class="text-danger">*</span></label>
                                    {{ form_widget(formVisiteGuerite.nomVisiteur, {'attr': {'class': 'form-control', 'placeholder': 'Nom complet'}}) }}
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Département Visité <span class="text-danger">*</span></label>
                                    {{ form_widget(formVisiteGuerite.departement, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Production, Compta...'}}) }}
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Motif de la visite <span class="text-danger">*</span></label>
                                    {{ form_widget(formVisiteGuerite.motif, {'attr': {'class': 'form-control', 'placeholder': 'Raison de la visite'}}) }}
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Téléphone</label>
                                    {{ form_widget(formVisiteGuerite.telephone, {'attr': {'class': 'form-control', 'placeholder': 'Numéro de téléphone'}}) }}
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Email</label>
                                    {{ form_widget(formVisiteGuerite.email, {'attr': {'class': 'form-control', 'placeholder': 'email@example.com'}}) }}
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Pièce d'identité</label>
                                    {{ form_widget(formVisiteGuerite.pieceIdentite, {'attr': {'class': 'form-control', 'placeholder': 'CIN, Passeport...'}}) }}
                                </div>
                            </div>
                            <div class="d-flex justify-content-end gap-2 mt-4">
                                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-primary rounded-pill px-4">
                                    <i class="fas fa-save me-1"></i> Enregistrer
                                </button>
                            </div>
                        {{ form_end(formVisiteGuerite) }}
                    {% else %}
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Le formulaire d'enregistrement n'est pas disponible.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================
    SCRIPTS
    ============================================ -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Auto‑disparition des flash messages après 6 secondes
            const alerts = document.querySelectorAll('.flash-message');
            alerts.forEach(alert => {
                setTimeout(() => {
                    alert.style.opacity = '0';
                    setTimeout(() => alert.remove(), 500);
                }, 6000);
            });

            // Animation d'apparition des lignes de tableau déjà gérée par CSS,
            // mais on peut forcer un affichage si le navigateur ne supporte pas les animations.
            // (rien de plus nécessaire)
        });
    </script>
</body>
</html>
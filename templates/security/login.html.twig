{% extends 'base.html.twig' %}

{% block title %}Connexion - Dispromalt{% endblock %}

{% block body %}
<style>
    :root {
        --gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --gradient-accent: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        --gradient-blue: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        --shadow-soft: 0 4px 20px rgba(0,0,0,0.06);
        --shadow-hover: 0 12px 30px rgba(0,0,0,0.10);
        --shadow-glow: 0 20px 60px rgba(102, 126, 234, 0.25);
    }

    * { transition: all 0.25s ease; }

    .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        background: #f0f2f7;
        background-image:
            radial-gradient(at 0% 0%, rgba(102, 126, 234, 0.15) 0px, transparent 50%),
            radial-gradient(at 100% 100%, rgba(240, 147, 251, 0.15) 0px, transparent 50%),
            radial-gradient(at 50% 50%, rgba(79, 172, 254, 0.06) 0px, transparent 50%);
        position: relative;
        overflow: hidden;
    }

    .login-wrapper::before,
    .login-wrapper::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.4;
        pointer-events: none;
    }
    .login-wrapper::before {
        width: 400px; height: 400px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        top: -100px; left: -100px;
        animation: float1 15s ease-in-out infinite;
    }
    .login-wrapper::after {
        width: 350px; height: 350px;
        background: linear-gradient(135deg, #f093fb, #f5576c);
        bottom: -100px; right: -100px;
        animation: float2 18s ease-in-out infinite;
    }

    @keyframes float1 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(40px, 40px) scale(1.1); }
    }
    @keyframes float2 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(-40px, -40px) scale(1.1); }
    }

    .login-card {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 440px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        padding: 2.75rem 2.25rem;
        box-shadow: var(--shadow-glow);
        border: 1px solid rgba(255, 255, 255, 0.8);
    }

    .login-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        margin-bottom: 0.5rem;
    }
    .login-logo-icon {
        width: 52px; height: 52px;
        border-radius: 16px;
        background: var(--gradient-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.4rem;
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.35);
    }
    .login-logo-text {
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        color: #1e293b;
        margin: 0;
    }
    .login-subtitle {
        text-align: center;
        color: #64748b;
        font-size: 0.9rem;
        margin-bottom: 2rem;
    }

    .login-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.5rem;
        display: block;
    }
    .login-input-group {
        display: flex;
        align-items: stretch;
        border-radius: 12px;
        border: 1.5px solid #e2e8f0;
        background: #f8fafc;
        overflow: hidden;
        transition: all 0.25s ease;
    }
    .login-input-group:focus-within {
        border-color: #667eea;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.12);
    }
    .login-input-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 1rem;
        color: #94a3b8;
        font-size: 0.95rem;
        flex-shrink: 0;
    }
    .login-input-group:focus-within .login-input-icon {
        color: #667eea;
    }
    .login-input {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        padding: 0.85rem 0.5rem;
        font-size: 0.95rem;
        color: #1e293b;
        width: 100%;
    }
    .login-input::placeholder {
        color: #94a3b8;
        font-size: 0.9rem;
    }

    .password-toggle {
        background: none;
        border: none;
        padding: 0 1rem;
        color: #94a3b8;
        cursor: pointer;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
    }
    .password-toggle:hover {
        color: #667eea;
    }

    .login-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 1.25rem 0 1.5rem;
        font-size: 0.85rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .login-checkbox {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #64748b;
        cursor: pointer;
    }
    .login-checkbox input[type="checkbox"] {
        width: 18px; height: 18px;
        accent-color: #667eea;
        cursor: pointer;
        border-radius: 4px;
    }
    .login-checkbox label {
        cursor: pointer;
        margin: 0;
    }
    .login-link {
        color: #667eea;
        text-decoration: none;
        font-weight: 600;
    }
    .login-link:hover {
        color: #4c51bf;
        text-decoration: underline;
    }

    .login-btn {
        width: 100%;
        border: none;
        border-radius: 12px;
        padding: 0.95rem 1.5rem;
        font-weight: 700;
        font-size: 1rem;
        color: #fff;
        background: var(--gradient-primary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.35);
        transition: all 0.25s ease;
    }
    .login-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(102, 126, 234, 0.45);
    }
    .login-btn:active {
        transform: translateY(0);
    }

    .login-alert {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.9rem 1rem;
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        border: 1px solid #fecaca;
        border-left: 4px solid #dc2626;
        border-radius: 12px;
        color: #991b1b;
        font-size: 0.85rem;
        margin-bottom: 1.5rem;
        animation: shake 0.4s ease-in-out;
    }
    .login-alert i { font-size: 1.1rem; flex-shrink: 0; }

    @keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-6px); }
        75% { transform: translateX(6px); }
    }

    .login-divider {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 1.75rem 0 1.25rem;
        color: #94a3b8;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .login-divider::before,
    .login-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
    }

    .login-footer {
        text-align: center;
        font-size: 0.8rem;
        color: #94a3b8;
        line-height: 1.6;
    }
    .login-footer .copyright {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        margin-bottom: 0.4rem;
        font-weight: 600;
        color: #64748b;
    }

    .security-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.85rem;
        background: rgba(67, 233, 123, 0.12);
        color: #059669;
        border-radius: 50px;
        font-size: 0.72rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    @media (max-width: 576px) {
        .login-card { padding: 2rem 1.5rem; border-radius: 20px; }
        .login-logo-text { font-size: 1.5rem; }
        .login-logo-icon { width: 46px; height: 46px; font-size: 1.2rem; }
    }
</style>

<div class="login-wrapper">
    <div class="login-card">

        {# En-tête : Logo + Identité #}
        <div class="login-logo">
            <h2 class="login-logo-text">
                Dispro<span class="text-primary">malt</span>
            </h2>
        </div>
        <p class="login-subtitle">
            <i class="fas fa-shield-alt text-success me-1"></i>
            Espace de Connexion Sécurisé
        </p>

        {# Alerte d'erreur #}
        {% if error %}
            <div class="login-alert">
                <i class="fas fa-exclamation-triangle"></i>
                <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
            </div>
        {% endif %}

        {# Formulaire #}
        <form method="post" autocomplete="on">

            <div class="mb-3">
                <label for="inputEmail" class="login-label">
                    <i class="fas fa-envelope me-1"></i> Adresse Email
                </label>
                <div class="login-input-group">
                    <div class="login-input-icon">
                        <i class="fas fa-user"></i>
                    </div>
                    <input type="email"
                           value="{{ last_username }}"
                           name="email"
                           id="inputEmail"
                           class="login-input"
                           placeholder="nom@entreprise.com"
                           autocomplete="email"
                           required
                           autofocus>
                </div>
            </div>

            <div class="mb-3">
                <label for="inputPassword" class="login-label">
                    <i class="fas fa-lock me-1"></i> Mot de Passe
                </label>
                <div class="login-input-group">
                    <div class="login-input-icon">
                        <i class="fas fa-key"></i>
                    </div>
                    <input type="password"
                           name="password"
                           id="inputPassword"
                           class="login-input"
                           placeholder="••••••••"
                           autocomplete="current-password"
                           required>
                    <button type="button" class="password-toggle" id="togglePassword" aria-label="Afficher le mot de passe">
                        <i class="fas fa-eye" id="toggleIcon"></i>
                    </button>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="login-options">
                <div class="login-checkbox">
                    <input type="checkbox" name="_remember_me" id="_remember_me" checked>
                    <label for="_remember_me">Se souvenir de moi</label>
                </div>
                <a href="#" class="login-link">Mot de passe oublié ?</a>
            </div>

            <button class="login-btn" type="submit">
                Se Connecter
                <i class="fas fa-arrow-right"></i>
            </button>
        </form>

        {# ═══════════════════════════════════════════════════════
           ✅ BANNIÈRE D'INSTALLATION PWA — visible sur tous les navigateurs
        ═══════════════════════════════════════════════════════ #}
        <div id="pwa-install-container" class="mt-4 pt-3" style="border-top: 1px dashed #e2e8f0; display: none;">
            <div class="text-center mb-2">
                <small class="text-muted" style="font-size: 0.75rem; font-weight: 600;">
                    <i class="fas fa-mobile-alt me-1 text-primary"></i>
                    INSTALLER L'APPLICATION
                </small>
                <p class="text-muted mb-0 mt-1" style="font-size: 0.72rem;">
                    Accès rapide &amp; mode hors-ligne
                </p>
            </div>

            <pwa-install
                id="pwa-install-component"
                manifest-url="/manifest.json"
                install-description="Installez l'application Dispromalt sur votre appareil pour un accès rapide et un fonctionnement hors-ligne."
                use-local-storage
                style="--tint-color: #667eea; --install-button-color: #667eea; display: block; margin: 0 auto;"
            ></pwa-install>

            <div class="text-center mt-2">
                <button type="button" class="btn btn-sm btn-link text-muted p-0" style="font-size: 0.72rem; text-decoration: none;" onclick="document.getElementById('pwa-install-container').style.display='none';">
                    Plus tard
                </button>
            </div>
        </div>

        <div class="login-divider">Connexion Sécurisée</div>

        <div class="text-center">
            <span class="security-badge">
                <i class="fas fa-lock"></i> SSL / Chiffrement Actif
            </span>
        </div>

        <div class="login-footer">
            <div class="copyright">
                <i class="fas fa-copyright"></i>
                {{ 'now'|date('Y') }} Dispromalt
            </div>
            <div>
                Besoin d'aide ?
                <a href="#" class="login-link">Contactez l'administrateur</a>
            </div>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {

        // ── Toggle mot de passe ──────────────────────────────
        const toggleBtn = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('inputPassword');
        const toggleIcon = document.getElementById('toggleIcon');

        if (toggleBtn && passwordInput && toggleIcon) {
            toggleBtn.addEventListener('click', function() {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                toggleIcon.classList.toggle('fa-eye');
                toggleIcon.classList.toggle('fa-eye-slash');
            });
        }

        // ── Bannière d'installation PWA ──────────────────────
        const pwaContainer = document.getElementById('pwa-install-container');
        const pwaInstall = document.getElementById('pwa-install-component');

        if (pwaContainer && pwaInstall) {

            // Vérifier si l'app est déjà installée (mode standalone)
            const isStandalone =
                window.matchMedia('(display-mode: standalone)').matches ||
                window.navigator.standalone === true;

            if (isStandalone) {
                console.log('✅ App déjà installée — pas de bannière');
                return;
            }

            // Vérifier si l'utilisateur a déjà refusé dans cette session
            const dismissed = sessionStorage.getItem('pwa-install-dismissed');
            if (dismissed) return;

            // Attendre que le composant soit prêt
            const showBanner = () => {
                pwaContainer.style.display = 'block';

                // Auto-ouvrir le dialogue après 2 secondes
                setTimeout(() => {
                    if (pwaInstall.isInstallAvailable && !pwaInstall.isUnderStandaloneMode) {
                        try {
                            pwaInstall.showDialog();
                        } catch (e) {
                            console.log('Dialogue auto non disponible — l\'utilisateur peut cliquer');
                        }
                    }
                }, 2000);
            };

            // Écouter l'événement "ready" du composant, ou fallback sur un timeout
            if (typeof pwaInstall.addEventListener === 'function') {
                pwaInstall.addEventListener('pwa-install-available', showBanner);
                // Fallback après 3 secondes si l'événement ne se déclenche pas
                setTimeout(() => {
                    if (pwaContainer.style.display === 'none') {
                        showBanner();
                    }
                }, 3000);
            } else {
                showBanner();
            }
        }
    });
</script>
{% endblock %}
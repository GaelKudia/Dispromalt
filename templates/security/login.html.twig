{% extends 'base.html.twig' %}

{% block title %}Connexion - Dispromalt{% endblock %}

{% block body %}
<style>
    :root {
        --primary: #4f46e5;
        --primary-dark: #4338ca;
        --primary-light: #818cf8;
        --ink-900: #0f172a;
        --ink-700: #334155;
        --ink-500: #64748b;
        --ink-400: #94a3b8;
        --ink-200: #e2e8f0;
        --ink-100: #f1f5f9;
        --success: #059669;
        --danger: #dc2626;
    }

    * {
        box-sizing: border-box;
    }

    html, body {
        height: 100%;
        width: 100%;
        overflow-x: hidden;
        margin: 0;
        padding: 0;
    }

    /* ═══════════════════════════════════════════════════
       FOND PLEIN ÉCRAN
    ═══════════════════════════════════════════════════ */
    .login-wrapper {
        min-height: 100vh;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        background: #f0f2f7;
        background-image:
            radial-gradient(at 0% 0%, rgba(102, 126, 234, 0.12) 0px, transparent 50%),
            radial-gradient(at 100% 100%, rgba(240, 147, 251, 0.12) 0px, transparent 50%),
            radial-gradient(at 50% 50%, rgba(79, 172, 254, 0.06) 0px, transparent 50%);
        position: relative;
        overflow: hidden;
    }

    .login-wrapper::before,
    .login-wrapper::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.35;
        pointer-events: none;
    }
    .login-wrapper::before {
        width: 500px; height: 500px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        top: -180px; left: -180px;
        animation: float1 18s ease-in-out infinite;
    }
    .login-wrapper::after {
        width: 450px; height: 450px;
        background: linear-gradient(135deg, #f093fb, #f5576c);
        bottom: -180px; right: -180px;
        animation: float2 20s ease-in-out infinite;
    }

    @keyframes float1 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(50px, 50px) scale(1.1); }
    }
    @keyframes float2 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(-50px, -50px) scale(1.1); }
    }

    /* ═══════════════════════════════════════════════════
       CARTE CARRÉE — Compacte et équilibrée
    ═══════════════════════════════════════════════════ */
    .login-card {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 400px;              /* ← réduit : plus carré */
        aspect-ratio: 1 / 1;           /* ← forme carrée */
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        padding: 2rem 2rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        box-shadow:
            0 25px 60px -15px rgba(15, 23, 42, 0.18),
            0 10px 30px -10px rgba(79, 70, 229, 0.15),
            0 0 0 1px rgba(255, 255, 255, 0.9) inset;
        border: 1px solid rgba(255, 255, 255, 0.8);
        animation: cardAppear 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @keyframes cardAppear {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* ─── Logo & En-tête ─── */
    .login-logo {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }
    .login-logo-img {
        height: 56px;
        width: auto;
        max-width: 150px;
        object-fit: contain;
        filter: drop-shadow(0 6px 14px rgba(79, 70, 229, 0.18));
    }
    .login-logo-text {
        font-size: 1.5rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        color: var(--ink-900);
        margin: 0;
        text-align: center;
    }
    .login-logo-text .accent {
        color: var(--primary);
    }

    .login-subtitle {
        text-align: center;
        color: var(--ink-500);
        font-size: 0.82rem;
        margin-bottom: 1.25rem;
        font-weight: 500;
        line-height: 1.4;
    }

    /* ─── Alerte d'erreur ─── */
    .login-alert {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.75rem 0.95rem;
        background: linear-gradient(135deg, #fef2f2, #fee2e2);
        border: 1px solid #fecaca;
        border-left: 4px solid var(--danger);
        border-radius: 10px;
        color: #991b1b;
        font-size: 0.82rem;
        font-weight: 500;
        margin-bottom: 1rem;
        animation: shake 0.4s ease-in-out;
    }
    .login-alert i {
        font-size: 1rem;
        color: var(--danger);
        flex-shrink: 0;
    }

    @keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-6px); }
        75% { transform: translateX(6px); }
    }

    /* ─── Champs ─── */
    .form-group {
        margin-bottom: 0.9rem;
    }
    .login-label {
        display: block;
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--ink-700);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.4rem;
    }
    .login-label i {
        color: var(--primary);
        margin-right: 0.3rem;
    }

    .login-input-group {
        display: flex;
        align-items: stretch;
        border: 1.5px solid var(--ink-200);
        border-radius: 10px;
        background: var(--ink-100);
        overflow: hidden;
        transition: all 0.25s ease;
    }
    .login-input-group:focus-within {
        border-color: var(--primary);
        background: #fff;
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12);
    }
    .login-input-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 0.85rem;
        color: var(--ink-400);
        font-size: 0.88rem;
        flex-shrink: 0;
        transition: color 0.25s ease;
    }
    .login-input-group:focus-within .login-input-icon {
        color: var(--primary);
    }
    .login-input {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        padding: 0.75rem 0.4rem;
        font-size: 0.88rem;
        color: var(--ink-900);
        width: 100%;
        font-weight: 500;
        font-family: inherit;
    }
    .login-input::placeholder {
        color: var(--ink-400);
        font-weight: 400;
    }

    .password-toggle {
        background: none;
        border: none;
        padding: 0 0.9rem;
        color: var(--ink-400);
        cursor: pointer;
        font-size: 0.88rem;
        display: flex;
        align-items: center;
    }
    .password-toggle:hover {
        color: var(--primary);
    }

    /* ─── Options ─── */
    .login-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 0.9rem 0 1.1rem;
        font-size: 0.78rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .login-checkbox {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--ink-500);
        cursor: pointer;
    }
    .login-checkbox input[type="checkbox"] {
        width: 16px;
        height: 16px;
        accent-color: var(--primary);
        cursor: pointer;
        border-radius: 4px;
    }
    .login-checkbox label {
        cursor: pointer;
        margin: 0;
        font-weight: 500;
    }
    .login-link {
        color: var(--primary);
        text-decoration: none;
        font-weight: 600;
    }
    .login-link:hover {
        color: var(--primary-dark);
        text-decoration: underline;
    }

    /* ─── Bouton ─── */
    .login-btn {
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: 0.85rem 1.25rem;
        font-weight: 700;
        font-size: 0.92rem;
        color: #fff;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        box-shadow: 0 10px 25px -8px rgba(79, 70, 229, 0.55);
        transition: all 0.25s ease;
        letter-spacing: -0.2px;
        font-family: inherit;
    }
    .login-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 32px -8px rgba(79, 70, 229, 0.65);
    }
    .login-btn:active {
        transform: translateY(0);
    }

    /* ─── Footer compact ─── */
    .login-footer {
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid var(--ink-200);
        text-align: center;
        font-size: 0.72rem;
        color: var(--ink-400);
        line-height: 1.5;
    }
    .login-footer .copyright {
        font-weight: 600;
        color: var(--ink-500);
        margin-bottom: 0.2rem;
    }
    .login-footer a {
        color: var(--primary);
        font-weight: 600;
        text-decoration: none;
    }
    .login-footer a:hover {
        text-decoration: underline;
    }

    /* ═══════════════════════════════════════════════════
       RESPONSIVE
    ═══════════════════════════════════════════════════ */
    @media (max-width: 480px) {
        .login-card {
            max-width: 100%;
            aspect-ratio: auto;         /* sur mobile : hauteur auto */
            padding: 1.75rem 1.5rem;
            border-radius: 20px;
        }
        .login-logo-img {
            height: 48px;
            max-width: 130px;
        }
        .login-logo-text {
            font-size: 1.35rem;
        }
        .login-subtitle {
            font-size: 0.78rem;
            margin-bottom: 1rem;
        }
        .login-input {
            font-size: 0.85rem;
            padding: 0.7rem 0.35rem;
        }
        .login-btn {
            padding: 0.8rem 1.1rem;
            font-size: 0.88rem;
        }
    }

    @media (max-width: 360px) {
        .login-card {
            padding: 1.5rem 1.2rem;
        }
        .login-logo-img {
            height: 42px;
            max-width: 110px;
        }
        .login-logo-text {
            font-size: 1.2rem;
        }
    }

    /* Très grand écran : la carte reste carrée */
    @media (min-width: 1400px) {
        .login-card {
            max-width: 420px;
        }
    }
</style>

<div class="login-wrapper">
    <div class="login-card">

        {# Logo + Nom #}
        <div class="login-logo">
            <img src="{{ asset('images/logo.png') }}"
                 alt="Logo Dispromalt"
                 class="login-logo-img">
            <h2 class="login-logo-text">
                Dispro<span class="accent">malt</span>
            </h2>
        </div>

        <p class="login-subtitle">
            <i class="fas fa-shield-alt text-success me-1"></i>
            Espace de Connexion Sécurisé
        </p>

        {# Alerte d'erreur #}
        {% if error %}
            <div class="login-alert">
                <i class="fas fa-exclamation-triangle"></i>
                <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
            </div>
        {% endif %}

        {# Formulaire #}
        <form method="post" autocomplete="on">

            <div class="form-group">
                <label for="inputEmail" class="login-label">
                    <i class="fas fa-envelope"></i>Adresse Email
                </label>
                <div class="login-input-group">
                    <div class="login-input-icon">
                        <i class="fas fa-user"></i>
                    </div>
                    <input type="email"
                           value="{{ last_username }}"
                           name="email"
                           id="inputEmail"
                           class="login-input"
                           placeholder="nom@entreprise.com"
                           autocomplete="email"
                           required
                           autofocus>
                </div>
            </div>

            <div class="form-group">
                <label for="inputPassword" class="login-label">
                    <i class="fas fa-lock"></i>Mot de Passe
                </label>
                <div class="login-input-group">
                    <div class="login-input-icon">
                        <i class="fas fa-key"></i>
                    </div>
                    <input type="password"
                           name="password"
                           id="inputPassword"
                           class="login-input"
                           placeholder="••••••••"
                           autocomplete="current-password"
                           required>
                    <button type="button" class="password-toggle" id="togglePassword" aria-label="Afficher le mot de passe">
                        <i class="fas fa-eye" id="toggleIcon"></i>
                    </button>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="login-options">
                <div class="login-checkbox">
                    <input type="checkbox" name="_remember_me" id="_remember_me" checked>
                    <label for="_remember_me">Se souvenir de moi</label>
                </div>
                <a href="#" class="login-link">Mot de passe oublié ?</a>
            </div>

            <button class="login-btn" type="submit">
                Se Connecter
                <i class="fas fa-arrow-right"></i>
            </button>
        </form>

        <div class="login-footer">
            <div class="copyright">
                <i class="fas fa-copyright me-1"></i>
                {{ 'now'|date('Y') }} Dispromalt
            </div>
        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const toggleBtn = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('inputPassword');
        const toggleIcon = document.getElementById('toggleIcon');

        if (toggleBtn && passwordInput && toggleIcon) {
            toggleBtn.addEventListener('click', function() {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                toggleIcon.classList.toggle('fa-eye');
                toggleIcon.classList.toggle('fa-eye-slash');
            });
        }
    });
</script>
{% endblock %}
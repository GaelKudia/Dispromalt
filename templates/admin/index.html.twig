                {# ============ ONGLET 10 : ÉTAT DU STOCK ============ #}
                <div class="tab-pane fade" id="pane-stock" role="tabpanel">

                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark m-0">
                                <i class="fas fa-warehouse text-success me-2"></i>État consolidé du stock
                            </h5>
                            <small class="text-muted">Vue synthétique de l'inventaire en temps réel.</small>
                        </div>
                    </div>

                    {# KPI Stock #}
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="stat-card stat-primary">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.68rem;">Articles référencés</h6>
                                        <h3 class="fw-bold m-0 text-dark" style="font-size: 1.8rem;">{{ articlesStock|default([])|length }}</h3>
                                    </div>
                                    <div class="stat-icon stat-icon-primary"><i class="fas fa-boxes"></i></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-card stat-success">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.68rem;">Quantité totale</h6>
                                        <h3 class="fw-bold m-0 text-dark" style="font-size: 1.8rem;">
                                            {{ totalQuantiteStock|default(0)|number_format(0, ',', ' ') }}
                                        </h3>
                                    </div>
                                    <div class="stat-icon stat-icon-success"><i class="fas fa-cubes"></i></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-card stat-purple">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.68rem;">Catégories</h6>
                                        <h3 class="fw-bold m-0 text-dark" style="font-size: 1.8rem;">{{ articlesParCategorie|default([])|length }}</h3>
                                    </div>
                                    <div class="stat-icon stat-icon-purple"><i class="fas fa-tags"></i></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-card stat-warning">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.68rem;">Alertes critiques</h6>
                                        <h3 class="fw-bold m-0 text-danger" style="font-size: 1.8rem;">{{ nbAlertesStock|default(0) }}</h3>
                                    </div>
                                    <div class="stat-icon stat-icon-warning"><i class="fas fa-exclamation-triangle"></i></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# ALERTES CRITIQUES PERSISTANTES #}
                    {% if nbAlertesStock|default(0) > 0 %}
                    <div class="form-card mb-4" style="background: rgba(220, 38, 38, 0.03); border-color: rgba(220, 38, 38, 0.15);">
                        <div class="form-card-header" style="border-bottom-color: rgba(220, 38, 38, 0.15);">
                            <div class="form-card-icon form-card-icon-red">
                                <i class="fas fa-exclamation-triangle"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="fw-bold m-0 text-danger">Articles sous le seuil critique</h5>
                                <small class="text-muted">{{ nbAlertesStock }} article(s) nécessitent une action</small>
                            </div>
                            {% set nbNonLances = 0 %}
                            {% for art in articlesEnAlerte %}
                                {% if not art.reapprovisionnementEnCours %}{% set nbNonLances = nbNonLances + 1 %}{% endif %}
                            {% endfor %}
                            {% if nbNonLances > 0 %}
                                <span class="badge badge-soft badge-soft-danger px-3 py-2">
                                    <i class="fas fa-bell me-1"></i>{{ nbNonLances }} non traité(s)
                                </span>
                            {% endif %}
                        </div>

                        <div class="table-responsive">
                            <table class="table table-modern table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Article</th>
                                        <th class="text-center">Stock actuel</th>
                                        <th class="text-center">Seuil</th>
                                        <th class="text-center">Écart</th>
                                        <th>Statut Réappro</th>
                                        <th>Lancé par</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for art in articlesEnAlerte %}
                                        {% set detail = alerteDetails[art.id]|default({'lanceur': null, 'dateLancement': null}) %}
                                        <tr>
                                            <td>
                                                <div class="fw-semibold text-dark">
                                                    <i class="fas fa-box text-danger me-2"></i>{{ art.nom }}
                                                    {% if art.reapprovisionnementEnCours %}
                                                        <span class="badge badge-soft badge-soft-primary ms-2" style="font-size: 0.65rem;">
                                                            <i class="fas fa-truck-loading me-1"></i>En cours
                                                        </span>
                                                    {% else %}
                                                        <span class="badge badge-soft badge-soft-danger ms-2" style="font-size: 0.65rem;">
                                                            <i class="fas fa-exclamation-triangle me-1"></i>Non traité
                                                        </span>
                                                    {% endif %}
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge badge-soft badge-soft-danger">{{ art.quantite }}</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge badge-soft badge-soft-warning">{{ art.seuilAlerte }}</span>
                                            </td>
                                            <td class="text-center fw-bold text-danger">
                                                -{{ art.seuilAlerte - art.quantite }}
                                            </td>
                                            <td>
                                                {% if art.reapprovisionnementEnCours %}
                                                    <span class="badge badge-soft badge-soft-primary">
                                                        <i class="fas fa-truck-loading me-1"></i>En cours
                                                    </span>
                                                    {% if art.dateReapprovisionnement %}
                                                        <div class="small text-muted mt-1">
                                                            <i class="fas fa-calendar-check me-1"></i>Prévu :
                                                            <strong class="text-primary">{{ art.dateReapprovisionnement|date('d/m/Y') }}</strong>
                                                        </div>
                                                    {% endif %}
                                                {% else %}
                                                    <span class="badge badge-soft badge-soft-secondary">
                                                        <i class="fas fa-hourglass-start me-1"></i>Non lancé
                                                    </span>
                                                    <div class="small text-muted mt-1">Action comptable requise</div>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if art.reapprovisionnementEnCours and detail.lanceur %}
                                                    <div class="small fw-semibold text-dark">
                                                        <i class="fas fa-user-circle me-1"></i>
                                                        {{ detail.lanceur.userIdentifier|split('@')|first }}
                                                    </div>
                                                    {% if detail.dateLancement %}
                                                        <div class="small text-muted">
                                                            <i class="far fa-clock me-1"></i>
                                                            {{ detail.dateLancement|date('d/m/Y H:i') }}
                                                        </div>
                                                    {% endif %}
                                                {% elseif art.reapprovisionnementEnCours %}
                                                    <span class="text-muted small">En cours (info non dispo)</span>
                                                {% else %}
                                                    <span class="text-muted small">—</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    {% endif %}

                    {# Graphiques #}
                    <div class="row g-3 mb-4">
                        <div class="col-lg-7">
                            <div class="form-card h-100">
                                <div class="form-card-header">
                                    <div class="form-card-icon form-card-icon-blue"><i class="fas fa-chart-bar"></i></div>
                                    <div>
                                        <h5 class="fw-bold m-0 text-dark">Top 10 articles (par quantité)</h5>
                                        <small class="text-muted">Articles les plus stockés</small>
                                    </div>
                                </div>
                                <div style="position: relative; height: 320px;">
                                    <canvas id="chartTopArticlesAdmin"></canvas>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="form-card h-100">
                                <div class="form-card-header">
                                    <div class="form-card-icon form-card-icon-green"><i class="fas fa-chart-pie"></i></div>
                                    <div>
                                        <h5 class="fw-bold m-0 text-dark">Répartition par catégorie</h5>
                                        <small class="text-muted">Volume par catégorie</small>
                                    </div>
                                </div>
                                <div style="position: relative; height: 320px;">
                                    <canvas id="chartCategoriesAdmin"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Synthèse par catégorie #}
                    <div class="form-card mb-4">
                        <div class="form-card-header">
                            <div class="form-card-icon form-card-icon-purple"><i class="fas fa-list"></i></div>
                            <div>
                                <h5 class="fw-bold m-0 text-dark">Synthèse par catégorie</h5>
                                <small class="text-muted">Répartition détaillée du stock</small>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-modern table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Catégorie</th>
                                        <th class="text-center">Nb articles</th>
                                        <th class="text-center">Quantité totale</th>
                                        <th class="text-center">Part</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% set totalGlobal = totalQuantiteStock|default(0) > 0 ? totalQuantiteStock : 1 %}
                                    {% for cat, data in articlesParCategorie|default({})|sort((a, b) => b.quantite <=> a.quantite) %}
                                        <tr>
                                            <td class="fw-semibold text-dark">
                                                <i class="fas fa-tag text-muted me-2"></i>{{ cat }}
                                            </td>
                                            <td class="text-center">
                                                <span class="badge badge-soft badge-soft-secondary">{{ data.count }}</span>
                                            </td>
                                            <td class="text-center fw-bold text-dark">
                                                {{ data.quantite|number_format(0, ',', ' ') }}
                                            </td>
                                            <td class="text-center">
                                                <div class="d-flex align-items-center gap-2 justify-content-center">
                                                    <div class="progress" style="width: 80px; height: 6px;">
                                                        <div class="progress-bar bg-success"
                                                             style="width: {{ (data.quantite / totalGlobal * 100)|round }}%;"></div>
                                                    </div>
                                                    <span class="small text-muted fw-bold">
                                                        {{ (data.quantite / totalGlobal * 100)|round(1) }}%
                                                    </span>
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">Aucune catégorie enregistrée.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    {# LISTE DES ARTICLES AVEC CRUD #}
                    <div class="form-card">
                        <div class="form-card-header">
                            <div class="form-card-icon form-card-icon-blue"><i class="fas fa-boxes"></i></div>
                            <div class="flex-grow-1">
                                <h5 class="fw-bold m-0 text-dark">Tous les articles</h5>
                                <small class="text-muted">{{ articlesStock|default([])|length }} article(s) enregistré(s)</small>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-modern table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Nom</th>
                                        <th class="text-center">Quantité</th>
                                        <th class="text-center">Seuil</th>
                                        <th class="text-center">Statut</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for art in articlesStock|default([]) %}
                                        <tr>
                                            <td class="fw-bold text-dark">
                                                <i class="fas fa-box text-secondary me-2"></i>{{ art.nom }}
                                            </td>
                                            <td class="text-center fw-bold">{{ art.quantite }}</td>
                                            <td class="text-center">{{ art.seuilAlerte }}</td>
                                            <td class="text-center">
                                                {% if art.quantite <= art.seuilAlerte %}
                                                    <span class="badge badge-soft badge-soft-danger">Bas</span>
                                                {% else %}
                                                    <span class="badge badge-soft badge-soft-success">OK</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-light border btn-sm text-primary"
                                                        data-bs-toggle="modal" data-bs-target="#editArticleModal"
                                                        data-id="{{ art.id }}"
                                                        data-nom="{{ art.nom }}"
                                                        data-quantite="{{ art.quantite }}"
                                                        data-seuil="{{ art.seuilAlerte }}"
                                                        data-token="{{ csrf_token('edit_article_' ~ art.id) }}"
                                                        title="Modifier">
                                                    <i class="fas fa-pen"></i>
                                                </button>
                                                <form action="{{ path('app_admin_article_delete', {id: art.id}) }}" method="POST" class="d-inline"
                                                      onsubmit="return confirm('⚠️ Supprimer l\'article « {{ art.nom }} » ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_article_' ~ art.id) }}">
                                                    <button type="submit" class="btn btn-light border btn-sm text-danger" title="Supprimer">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">Aucun article enregistré.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

{# ═══════════════════════════════════════════════════════════════
   MODALS DE MODIFICATION
═══════════════════════════════════════════════════════════════ #}

<!-- MODAL : Modifier une Catégorie -->
<div class="modal fade" id="editCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form method="POST" id="editCategoryForm" class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title"><i class="fas fa-pen me-2"></i>Modifier la catégorie</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" name="_token" id="editCategoryToken">
                <label class="form-label fw-bold">Nom de la catégorie</label>
                <input type="text" name="nom" id="editCategoryNom" class="form-control" required>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    <i class="fas fa-save me-1"></i>Enregistrer
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL : Modifier une Sous-Catégorie -->
<div class="modal fade" id="editSubCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form method="POST" id="editSubCategoryForm" class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-success text-white border-0">
                <h5 class="modal-title"><i class="fas fa-pen me-2"></i>Modifier la sous-catégorie</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" name="_token" id="editSubCategoryToken">
                <div class="mb-3">
                    <label class="form-label fw-bold">Nom</label>
                    <input type="text" name="nom" id="editSubCategoryNom" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Catégorie parente</label>
                    <select name="category_id" id="editSubCategoryCategory" class="form-select" required>
                        {% for category in categories %}
                            <option value="{{ category.id }}">{{ category.nom }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-success rounded-pill px-4">
                    <i class="fas fa-save me-1"></i>Enregistrer
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL : Modifier une Machine -->
<div class="modal fade" id="editMachineModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form method="POST" id="editMachineForm" class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-warning text-dark border-0">
                <h5 class="modal-title"><i class="fas fa-pen me-2"></i>Modifier la machine</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" name="_token" id="editMachineToken">
                <div class="mb-3">
                    <label class="form-label fw-bold">Nom de la machine</label>
                    <input type="text" name="nom" id="editMachineNom" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Sous-catégorie</label>
                    <select name="sub_category_id" id="editMachineSubCategory" class="form-select" required>
                        {% for sub in subCategories %}
                            <option value="{{ sub.id }}">{{ sub.nom }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-warning text-dark rounded-pill px-4">
                    <i class="fas fa-save me-1"></i>Enregistrer
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL : Modifier un Article -->
<div class="modal fade" id="editArticleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form method="POST" id="editArticleForm" class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-info text-white border-0">
                <h5 class="modal-title"><i class="fas fa-pen me-2"></i>Modifier l'article</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" name="_token" id="editArticleToken">
                <div class="mb-3">
                    <label class="form-label fw-bold">Nom de l'article</label>
                    <input type="text" name="nom" id="editArticleNom" class="form-control" required>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Quantité</label>
                        <input type="number" name="quantite" id="editArticleQuantite" class="form-control" min="0" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Seuil d'alerte</label>
                        <input type="number" name="seuil_alerte" id="editArticleSeuil" class="form-control" min="0" required>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-info text-white rounded-pill px-4">
                    <i class="fas fa-save me-1"></i>Enregistrer
                </button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const urlHash = window.location.hash;
        if (urlHash) {
            const triggerEl = document.querySelector(`button[data-bs-target="${urlHash}"]`);
            if (triggerEl) new bootstrap.Tab(triggerEl).show();
        }
        document.querySelectorAll('#adminTabs button[data-bs-toggle="tab"]').forEach(btn => {
            btn.addEventListener('shown.bs.tab', e => {
                history.replaceState(null, null, e.target.getAttribute('data-bs-target'));
            });
        });

        // Catégorie
        document.querySelectorAll('[data-bs-target="#editCategoryModal"]').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('editCategoryForm').action = '/admin/category/' + btn.dataset.id + '/edit';
                document.getElementById('editCategoryNom').value = btn.dataset.nom;
                document.getElementById('editCategoryToken').value = btn.dataset.token;
            });
        });

        // Sous-catégorie
        document.querySelectorAll('[data-bs-target="#editSubCategoryModal"]').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('editSubCategoryForm').action = '/admin/sub-category/' + btn.dataset.id + '/edit';
                document.getElementById('editSubCategoryNom').value = btn.dataset.nom;
                document.getElementById('editSubCategoryCategory').value = btn.dataset.categoryId;
                document.getElementById('editSubCategoryToken').value = btn.dataset.token;
            });
        });

        // Machine
        document.querySelectorAll('[data-bs-target="#editMachineModal"]').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('editMachineForm').action = '/admin/machine/' + btn.dataset.id + '/edit';
                document.getElementById('editMachineNom').value = btn.dataset.nom;
                document.getElementById('editMachineSubCategory').value = btn.dataset.subCategoryId;
                document.getElementById('editMachineToken').value = btn.dataset.token;
            });
        });

        // Article
        document.querySelectorAll('[data-bs-target="#editArticleModal"]').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('editArticleForm').action = '/admin/article/' + btn.dataset.id + '/edit';
                document.getElementById('editArticleNom').value = btn.dataset.nom;
                document.getElementById('editArticleQuantite').value = btn.dataset.quantite;
                document.getElementById('editArticleSeuil').value = btn.dataset.seuil;
                document.getElementById('editArticleToken').value = btn.dataset.token;
            });
        });

        // Graphique Top Articles
        const topArticlesAdmin = {{ topArticles|default([])|json_encode|raw }};
        const canvasTA = document.getElementById('chartTopArticlesAdmin');
        if (canvasTA && topArticlesAdmin.length > 0) {
            new Chart(canvasTA, {
                type: 'bar',
                data: {
                    labels: topArticlesAdmin.map(a => a.nom.length > 18 ? a.nom.substring(0, 18) + '…' : a.nom),
                    datasets: [{
                        label: 'Quantité',
                        data: topArticlesAdmin.map(a => a.quantite),
                        backgroundColor: topArticlesAdmin.map(a =>
                            a.quantite <= a.seuil ? 'rgba(220, 38, 38, 0.7)' : 'rgba(5, 150, 105, 0.7)'
                        ),
                        borderColor: topArticlesAdmin.map(a =>
                            a.quantite <= a.seuil ? 'rgb(220, 38, 38)' : 'rgb(5, 150, 105)'
                        ),
                        borderWidth: 1,
                        borderRadius: 6,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                afterLabel: function(context) {
                                    const art = topArticlesAdmin[context.dataIndex];
                                    return 'Seuil : ' + art.seuil + (art.quantite <= art.seuil ? ' ⚠️ ALERTE' : '');
                                }
                            }
                        }
                    },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
        }

        // Graphique Catégories
        const catLabelsAdmin = {{ categoriesLabels|default([])|json_encode|raw }};
        const catQuantitesAdmin = {{ categoriesQuantites|default([])|json_encode|raw }};
        const canvasCA = document.getElementById('chartCategoriesAdmin');
        if (canvasCA && catLabelsAdmin.length > 0) {
            const palette = [
                '#4f46e5', '#059669', '#d97706', '#dc2626', '#0891b2',
                '#7c3aed', '#be185d', '#0d9488', '#65a30d', '#ea580c',
                '#1e40af', '#9333ea', '#c026d3', '#0f766e', '#b45309'
            ];
            new Chart(canvasCA, {
                type: 'doughnut',
                data: {
                    labels: catLabelsAdmin,
                    datasets: [{
                        data: catQuantitesAdmin,
                        backgroundColor: catLabelsAdmin.map((_, i) => palette[i % palette.length]),
                        borderWidth: 2,
                        borderColor: '#fff',
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { boxWidth: 12, padding: 10, font: { size: 11 } }
                        }
                    }
                }
            });
        }
    });
</script>
</body>
</html>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Panneau de Contrôle Général - Administration</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --dg-primary: #1e293b;
            --dg-accent: #dc2626;
            --gradient-1: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --gradient-2: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            --gradient-3: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            --gradient-4: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
            --gradient-5: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            --gradient-purple: linear-gradient(135deg, #a855f7 0%, #6366f1 100%);
            --shadow-soft: 0 4px 20px rgba(0,0,0,0.06);
            --shadow-hover: 0 12px 30px rgba(0,0,0,0.10);
        }

        * { transition: all 0.25s ease; }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: #f0f2f7;
            background-image:
                radial-gradient(at 0% 0%, rgba(102, 126, 234, 0.08) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(168, 85, 247, 0.06) 0px, transparent 50%);
            min-height: 100vh;
        }

        .navbar-modern {
            background: rgba(30, 41, 59, 0.98);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }
        .navbar-brand-modern { font-weight: 800; font-size: 1.4rem; letter-spacing: -0.5px; }
        .role-pill {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: #e2e8f0;
            padding: 8px 16px;
            border-radius: 50px;
            font-size: 0.85rem;
        }

        .stat-card {
            border: none;
            border-radius: 18px;
            padding: 1.4rem;
            position: relative;
            overflow: hidden;
            background: #fff;
            box-shadow: var(--shadow-soft);
        }
        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: var(--gradient-3);
        }
        .stat-card.stat-primary::before { background: var(--gradient-3); }
        .stat-card.stat-success::before { background: var(--gradient-4); }
        .stat-card.stat-purple::before { background: var(--gradient-purple); }
        .stat-card.stat-warning::before { background: var(--gradient-5); }
        .stat-card.stat-info::before { background: var(--gradient-2); }
        .stat-card.stat-danger::before { background: linear-gradient(135deg, #dc2626, #f5576c); }
        .stat-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-hover); }

        .stat-icon {
            width: 56px; height: 56px;
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }
        .stat-icon-primary { background: rgba(79, 172, 254, 0.12); color: #3b82f6; }
        .stat-icon-success { background: rgba(67, 233, 123, 0.12); color: #10b981; }
        .stat-icon-purple  { background: rgba(168, 85, 247, 0.12); color: #9333ea; }
        .stat-icon-warning { background: rgba(250, 112, 154, 0.12); color: #f5576c; }
        .stat-icon-info    { background: rgba(240, 147, 251, 0.12); color: #d946ef; }
        .stat-icon-danger  { background: rgba(220, 38, 38, 0.12); color: #dc2626; }

        .main-card {
            border: none;
            border-radius: 20px;
            box-shadow: var(--shadow-soft);
            background: #fff;
            overflow: hidden;
        }
        .nav-tabs-modern {
            border-bottom: 1px solid #e2e8f0;
            padding: 0 1rem;
            gap: 0.25rem;
            flex-wrap: nowrap;
            overflow-x: auto;
            scrollbar-width: none;
        }
        .nav-tabs-modern::-webkit-scrollbar { display: none; }
        .nav-tabs-modern .nav-link {
            border: none !important;
            color: #64748b;
            font-weight: 600;
            font-size: 0.9rem;
            padding: 1rem 1.1rem;
            white-space: nowrap;
            border-radius: 0;
            position: relative;
            background: none;
        }
        .nav-tabs-modern .nav-link:hover { color: var(--dg-primary); }
        .nav-tabs-modern .nav-link.active { color: var(--dg-primary) !important; background: none; }
        .nav-tabs-modern .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: -1px; left: 1rem; right: 1rem;
            height: 3px;
            background: var(--gradient-1);
            border-radius: 3px 3px 0 0;
        }
        .nav-tabs-modern .nav-link i { margin-right: 0.5rem; }

        .table-modern { margin: 0; }
        .table-modern thead th {
            background: #f8fafc;
            color: #475569;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            padding: 1rem 0.9rem;
            border-bottom: 2px solid #e2e8f0;
            white-space: nowrap;
        }
        .table-modern tbody td {
            padding: 1rem 0.9rem;
            vertical-align: middle;
            border-color: #f1f5f9;
        }
        .table-modern tbody tr:hover { background: #f8fafc; }

        .badge-soft {
            padding: 0.4rem 0.75rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.75rem;
        }
        .badge-soft-warning { background: rgba(250, 112, 154, 0.12); color: #d63384; }
        .badge-soft-primary { background: rgba(79, 172, 254, 0.12); color: #2563eb; }
        .badge-soft-success { background: rgba(67, 233, 123, 0.15); color: #059669; }
        .badge-soft-danger  { background: rgba(220, 38, 38, 0.12); color: #dc2626; }
        .badge-soft-info    { background: rgba(14, 165, 233, 0.12); color: #0284c7; }
        .badge-soft-secondary { background: #f1f5f9; color: #475569; }
        .badge-soft-purple  { background: rgba(168, 85, 247, 0.12); color: #9333ea; }
        .badge-soft-gold    { background: rgba(212, 175, 55, 0.15); color: #8b6508; }

        .form-card {
            border: none;
            border-radius: 16px;
            background: #fff;
            border: 1px solid #eef2f7;
            padding: 1.75rem;
        }
        .form-card-header {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px dashed #e2e8f0;
        }
        .form-card-icon {
            width: 48px; height: 48px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }
        .form-card-icon-blue   { background: rgba(79, 172, 254, 0.12); color: #2563eb; }
        .form-card-icon-green  { background: rgba(67, 233, 123, 0.15); color: #059669; }
        .form-card-icon-yellow { background: rgba(250, 210, 90, 0.18); color: #ca8a04; }
        .form-card-icon-purple { background: rgba(168, 85, 247, 0.12); color: #9333ea; }
        .form-card-icon-red    { background: rgba(220, 38, 38, 0.12); color: #dc2626; }
        .form-card-icon-gold   { background: rgba(212, 175, 55, 0.15); color: #b8860b; }
        .form-card-icon-info   { background: rgba(240, 147, 251, 0.12); color: #d946ef; }

        .btn-modern {
            border-radius: 10px;
            font-weight: 600;
            padding: 0.7rem 1.25rem;
            border: none;
            transition: all 0.25s ease;
        }
        .btn-modern:hover { transform: translateY(-2px); box-shadow: 0 8px 16px rgba(0,0,0,0.12); }

        .form-control, .form-select {
            border-radius: 10px;
            border: 1px solid #e2e8f0;
            padding: 0.65rem 0.9rem;
            font-size: 0.9rem;
        }
        .form-control:focus, .form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.10);
        }

        .form-error-message,
        ul.form-error-message li {
            color: #dc2626;
            font-size: 0.78rem;
            font-weight: 500;
            list-style: none;
            padding-left: 0;
            margin-top: 4px;
            margin-bottom: 0;
        }
        .form-error-icon { display: none; }

        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: #94a3b8;
        }
        .empty-state i { font-size: 3rem; color: #cbd5e1; margin-bottom: 1rem; display: block; }

        .page-title { font-weight: 800; font-size: 1.85rem; letter-spacing: -0.5px; color: var(--dg-primary); margin: 0; }
        .page-subtitle { color: #64748b; font-size: 0.95rem; margin: 0; }

        .user-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 1.25rem;
            border-bottom: 1px solid #f1f5f9;
            gap: 1rem;
        }
        .user-item:hover { background: #f8fafc; }
        .user-item:last-child { border-bottom: none; }

        .text-purple { color: #9333ea !important; }
        .bg-purple-soft { background: rgba(168, 85, 247, 0.12) !important; }

        /* KPI 360 */
        .kpi360 {
            display: flex; justify-content: space-between; align-items: center;
            padding: 1rem 1.25rem; border-radius: 14px;
            background: #fff; border: 1px solid #eef2f7;
            box-shadow: var(--shadow-soft);
            height: 100%;
        }
        .kpi360 .kpi360-value { font-size: 1.75rem; font-weight: 800; line-height: 1; letter-spacing: -0.5px; }
        .kpi360 .kpi360-label { font-size: 0.68rem; color: #64748b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.25rem; }
        .kpi360 .kpi360-icon { font-size: 1.75rem; opacity: 0.4; }
    </style>
</head>
<body>

{# ============================================
   NAVBAR
============================================ #}
<nav class="navbar navbar-expand-lg navbar-modern py-3 sticky-top">
    <div class="container-fluid px-4">
        <a class="navbar-brand navbar-brand-modern text-white d-flex align-items-center" href="#">
            <img src="{{ asset('images/logo.png') }}" alt="Logo Dispromalt" style="height: 40px; width: auto; margin-right: 10px;">
            Dispro<span class="text-primary">malt</span>
            <span class="fw-light fs-6 text-white-50 ms-2">| Gérant imprimerie</span>
        </a>
        <div class="d-flex align-items-center gap-3">
            <div class="role-pill d-none d-md-inline-flex align-items-center">
                <i class="fas fa-user-shield text-warning me-2"></i>
                <span class="fw-bold">Super-Administrateur</span>
            </div>
            <a href="/logout" class="btn btn-danger btn-sm fw-bold px-3 rounded-pill">
                <i class="fas fa-sign-out-alt me-1"></i> Déconnexion
            </a>
        </div>
    </div>
</nav>

{# ============================================
   MAIN CONTAINER
============================================ #}
<div class="container-fluid py-4 px-4" style="max-width: 1600px;">

    {# En-tête #}
    <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1 class="page-title">Tableau de Bord Général</h1>
            <p class="page-subtitle">Supervision des flux de l'imprimerie et gestion globale des identifiants.</p>
        </div>
        <div class="text-muted small font-monospace">
            <i class="fas fa-calendar-alt me-1"></i> Système Actif & Sécurisé
        </div>
    </div>

    {# Flash Messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'danger' ? 'danger' : 'success' }} alert-dismissible fade show shadow-sm mb-4 border-0 rounded-3" role="alert">
                <i class="fas {{ label == 'danger' ? 'fa-exclamation-triangle' : 'fa-check-circle' }} me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# Cartes de statistiques #}
    <div class="row g-3 mb-4">
        <div class="col-md-4 col-xl-3">
            <div class="stat-card stat-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Demandes Totales</h6>
                        <h3 class="fw-bold m-0 text-dark" style="font-size: 2rem;">{{ demandes|length }}</h3>
                    </div>
                    <div class="stat-icon stat-icon-primary"><i class="fas fa-box"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-xl-3">
            <div class="stat-card stat-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Bons de Sortie</h6>
                        <h3 class="fw-bold m-0 text-dark" style="font-size: 2rem;">{{ bons|length }}</h3>
                    </div>
                    <div class="stat-icon stat-icon-success"><i class="fas fa-file-signature"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-xl-3">
            <div class="stat-card stat-purple">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Agents Enregistrés</h6>
                        <h3 class="fw-bold m-0 text-dark" style="font-size: 2rem;">{{ users|length }}</h3>
                    </div>
                    <div class="stat-icon stat-icon-purple"><i class="fas fa-users"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-xl-3">
            <div class="stat-card stat-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">Catégories / Machines</h6>
                        <h3 class="fw-bold m-0 text-dark" style="font-size: 2rem;">{{ categories|length }} / {{ machines|length }}</h3>
                    </div>
                    <div class="stat-icon stat-icon-warning"><i class="fas fa-layer-group"></i></div>
                </div>
            </div>
        </div>
    </div>

    {# ============================================
       CARTE PRINCIPALE À ONGLETS
    ============================================ #}
    <div class="main-card">

        <ul class="nav nav-tabs nav-tabs-modern" id="adminTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-360" data-bs-toggle="tab" data-bs-target="#pane-360" type="button" role="tab">
                    <i class="fas fa-globe text-primary"></i>Vue 360°
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-demandes" data-bs-toggle="tab" data-bs-target="#pane-demandes" type="button" role="tab">
                    <i class="fas fa-boxes text-primary"></i>Demandes
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-bons" data-bs-toggle="tab" data-bs-target="#pane-bons" type="button" role="tab">
                    <i class="fas fa-id-badge text-success"></i>Bons de Sortie
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-visites" data-bs-toggle="tab" data-bs-target="#pane-visites" type="button" role="tab">
                    <i class="fas fa-calendar-check text-info"></i>Visites & RDV
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-devis-admin" data-bs-toggle="tab" data-bs-target="#pane-devis-admin" type="button" role="tab">
                    <i class="fas fa-file-invoice-dollar text-warning"></i>Devis & Finances
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-caisse-admin" data-bs-toggle="tab" data-bs-target="#pane-caisse-admin" type="button" role="tab">
                    <i class="fas fa-cash-register text-success"></i>Mouvements Caisse
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-agents" data-bs-toggle="tab" data-bs-target="#pane-agents" type="button" role="tab">
                    <i class="fas fa-user-plus text-purple"></i>Comptes Agents
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-nominations" data-bs-toggle="tab" data-bs-target="#pane-nominations" type="button" role="tab">
                    <i class="fas fa-user-shield text-warning"></i>Nominations
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-structure" data-bs-toggle="tab" data-bs-target="#pane-structure" type="button" role="tab">
                    <i class="fas fa-sitemap text-primary"></i>Catégories
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-machines" data-bs-toggle="tab" data-bs-target="#pane-machines" type="button" role="tab">
                    <i class="fas fa-cogs text-secondary"></i>Machines
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-stock" data-bs-toggle="tab" data-bs-target="#pane-stock" type="button" role="tab">
                    <i class="fas fa-warehouse text-success"></i>État du Stock
                </button>
            </li>
        </ul>

        <div class="p-4">
            <div class="tab-content">

                {# ═══════════════════════════════════════════════
                   ONGLET 0 : VUE 360°
                ═══════════════════════════════════════════════ #}
                <div class="tab-pane fade show active" id="pane-360" role="tabpanel">

                    <h5 class="fw-bold text-dark mb-4">
                        <i class="fas fa-globe text-primary me-2"></i>Vue à 360° de l'activité
                    </h5>

                    {# KPIs globaux #}
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="kpi360">
                                <div>
                                    <div class="kpi360-value text-primary">{{ demandes|length }}</div>
                                    <div class="kpi360-label">Demandes</div>
                                </div>
                                <i class="fas fa-boxes kpi360-icon text-primary"></i>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi360">
                                <div>
                                    <div class="kpi360-value text-success">{{ bons|length }}</div>
                                    <div class="kpi360-label">Bons de sortie</div>
                                </div>
                                <i class="fas fa-file-signature kpi360-icon text-success"></i>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi360">
                                <div>
                                    <div class="kpi360-value text-warning">{{ nbDevisTotal|default(0) }}</div>
                                    <div class="kpi360-label">Devis émis</div>
                                </div>
                                <i class="fas fa-file-invoice-dollar kpi360-icon text-warning"></i>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi360">
                                <div>
                                    <div class="kpi360-value text-purple">{{ nbVisitesTotal|default(0) }}</div>
                                    <div class="kpi360-label">Visites / RDV</div>
                                </div>
                                <i class="fas fa-calendar-check kpi360-icon text-purple"></i>
                            </div>
                        </div>
                    </div>

                    {# ═══════════════════════════════════════════════
                       TRÉSORERIE — 3 SOLDES SÉPARÉS
                       Comptabilité | Caisse | Global
                    ═══════════════════════════════════════════════ #}
                    <div class="row g-3 mb-4">

                        {# Solde Comptabilité #}
                        <div class="col-lg-4">
                            <div class="stat-card stat-success h-100">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size:0.7rem;">
                                            <i class="fas fa-calculator text-success me-1"></i>Solde Comptabilité
                                        </h6>
                                        <div class="small text-muted">{{ nbMvtCompta|default(0) }} mouvement(s)</div>
                                    </div>
                                    <i class="fas fa-calculator fa-2x text-success opacity-25"></i>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small text-muted fw-semibold">USD</span>
                                    <span class="fw-bold text-success" style="font-size: 1.15rem;">
                                        {{ soldeComptaUSD|default(0)|number_format(2, ',', ' ') }} $
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="small text-muted fw-semibold">CDF</span>
                                    <span class="fw-bold text-primary" style="font-size: 1.15rem;">
                                        {{ soldeComptaCDF|default(0)|number_format(0, ',', ' ') }} FC
                                    </span>
                                </div>
                            </div>
                        </div>

                        {# Solde Caisse #}
                        <div class="col-lg-4">
                            <div class="stat-card stat-info h-100">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size:0.7rem;">
                                            <i class="fas fa-cash-register me-1" style="color:#d946ef;"></i>Solde Caisse
                                        </h6>
                                        <div class="small text-muted">{{ nbMvtCaissier|default(0) }} mouvement(s)</div>
                                    </div>
                                    <i class="fas fa-cash-register fa-2x opacity-25" style="color:#d946ef;"></i>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small text-muted fw-semibold">USD</span>
                                    <span class="fw-bold text-success" style="font-size: 1.15rem;">
                                        {{ soldeCaissierUSD|default(0)|number_format(2, ',', ' ') }} $
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="small text-muted fw-semibold">CDF</span>
                                    <span class="fw-bold text-primary" style="font-size: 1.15rem;">

                                                    <td>
                                                        <span class="badge badge-soft badge-soft-primary">
                                                            <i class="fas fa-folder me-1"></i>{{ sub.category.nom }}
                                                        </span>
                                                    </td>
                                                    <td class="text-end">
                                                        <button type="button" class="btn btn-light border btn-sm text-primary"

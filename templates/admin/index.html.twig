                                    <div>
                                        <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size:0.7rem;">
                                            <i class="fas fa-vault text-primary me-1"></i>Solde Global
                                        </h6>
                                        <div class="small text-muted">Cumul Comptabilité + Caisse</div>
                                    </div>
                                    <i class="fas fa-vault fa-2x text-primary opacity-25"></i>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small text-muted fw-semibold">USD</span>
                                    <span class="fw-bold text-success" style="font-size: 1.15rem;">
                                        {{ soldeGlobalUSD|default(0)|number_format(2, ',', ' ') }} $
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="small text-muted fw-semibold">CDF</span>
                                    <span class="fw-bold text-primary" style="font-size: 1.15rem;">
                                        {{ soldeGlobalCDF|default(0)|number_format(0, ',', ' ') }} FC
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# ═══════════════════════════════════════════════
                       OPÉRATIONS EN ATTENTE (Comptabilité + Caisse)
                    ═══════════════════════════════════════════════ #}
                    {% if (devisAiguiller|default([])|length > 0)
                       or (devisPretsADecaisser|default([])|length > 0)
                       or (devisEnAttenteCaisse|default([])|length > 0) %}
                    <div class="form-card mb-4">
                        <div class="form-card-header">
                            <div class="form-card-icon form-card-icon-yellow"><i class="fas fa-hourglass-half"></i></div>
                            <div class="flex-grow-1">
                                <h5 class="fw-bold m-0 text-dark">Opérations en attente</h5>
                                <small class="text-muted">Points de blocage dans le circuit Comptabilité & Caisse</small>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="kpi360">
                                    <div>
                                        <div class="kpi360-value text-warning">{{ devisAiguiller|default([])|length }}</div>
                                        <div class="kpi360-label">À aiguiller (Compta)</div>
                                    </div>
                                    <i class="fas fa-random kpi360-icon text-warning"></i>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="kpi360">
                                    <div>
                                        <div class="kpi360-value text-primary">{{ devisPretsADecaisser|default([])|length }}</div>
                                        <div class="kpi360-label">Prêts à décaisser (Compta)</div>
                                    </div>
                                    <i class="fas fa-money-bill-wave kpi360-icon text-primary"></i>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="kpi360">
                                    <div>
                                        <div class="kpi360-value text-purple">{{ devisEnAttenteCaisse|default([])|length }}</div>
                                        <div class="kpi360-label">En attente Caisse</div>
                                    </div>
                                    <i class="fas fa-cash-register kpi360-icon text-purple"></i>
                                </div>
                            </div>
                        </div>

                        {% if devisAiguiller|default([])|length > 0 %}
                        <div class="mt-4">
                            <h6 class="fw-bold text-warning mb-2">
                                <i class="fas fa-random me-2"></i>Devis à aiguiller
                            </h6>
                            <div class="table-responsive">
                                <table class="table table-modern table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Date</th>
                                            <th>Demandeur</th>
                                            <th>Montant</th>
                                            <th>Statut</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for d in devisAiguiller %}
                                            <tr>
                                                <td class="fw-bold">#{{ d.id }}</td>
                                                <td class="small">{{ d.createdAt ? d.createdAt|date('d/m/Y') : '—' }}</td>
                                                <td class="small">{{ d.user ? d.user.userIdentifier|split('@')|first : '—' }}</td>
                                                <td class="fw-bold">{{ d.montant|number_format(2, ',', ' ') }} {{ d.devise }}</td>
                                                <td><span class="badge badge-soft badge-soft-warning">{{ d.statut }}</span></td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        {% endif %}

                        {% if devisPretsADecaisser|default([])|length > 0 %}
                        <div class="mt-4">
                            <h6 class="fw-bold text-primary mb-2">
                                <i class="fas fa-money-bill-wave me-2"></i>Devis prêts à décaisser
                            </h6>
                            <div class="table-responsive">
                                <table class="table table-modern table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Date</th>
                                            <th>Demandeur</th>
                                            <th>Montant</th>
                                            <th>Statut</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for d in devisPretsADecaisser %}
                                            <tr>
                                                <td class="fw-bold">#{{ d.id }}</td>
                                                <td class="small">{{ d.createdAt ? d.createdAt|date('d/m/Y') : '—' }}</td>
                                                <td class="small">{{ d.user ? d.user.userIdentifier|split('@')|first : '—' }}</td>
                                                <td class="fw-bold">{{ d.montant|number_format(2, ',', ' ') }} {{ d.devise }}</td>
                                                <td><span class="badge badge-soft badge-soft-primary">{{ d.statut }}</span></td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        {% endif %}

                        {% if devisEnAttenteCaisse|default([])|length > 0 %}
                        <div class="mt-4">
                            <h6 class="fw-bold text-purple mb-2">
                                <i class="fas fa-cash-register me-2"></i>Devis en attente à la Caisse
                            </h6>
                            <div class="table-responsive">
                                <table class="table table-modern table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Date</th>
                                            <th>Demandeur</th>
                                            <th>Montant</th>
                                            <th>Statut</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for d in devisEnAttenteCaisse %}
                                            <tr>
                                                <td class="fw-bold">#{{ d.id }}</td>
                                                <td class="small">{{ d.createdAt ? d.createdAt|date('d/m/Y') : '—' }}</td>
                                                <td class="small">{{ d.user ? d.user.userIdentifier|split('@')|first : '—' }}</td>
                                                <td class="fw-bold">{{ d.montant|number_format(2, ',', ' ') }} {{ d.devise }}</td>
                                                <td><span class="badge badge-soft badge-soft-info">{{ d.statut }}</span></td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        {% endif %}
                    </div>
                    {% endif %}

                    {# Tableau récapitulatif par module #}
                    <div class="form-card">
                        <div class="form-card-header">
                            <div class="form-card-icon form-card-icon-blue"><i class="fas fa-list"></i></div>
                            <h5 class="fw-bold m-0 text-dark">Récapitulatif par module</h5>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-modern mb-0">
                                <thead>
                                    <tr>
                                        <th>Module</th>
                                        <th class="text-center">Total</th>
                                        <th class="text-center">En cours</th>
                                        <th class="text-center">Clôturé / Validé</th>
                                        <th class="text-center">Rejeté</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="fw-semibold"><i class="fas fa-boxes text-primary me-2"></i>Demandes</td>
                                        <td class="text-center fw-bold">{{ demandes|length }}</td>
                                        <td class="text-center"><span class="badge badge-soft badge-soft-warning">{{ demandes|filter(d => 'attente' in d.statut|lower)|length }}</span></td>
                                        <td class="text-center"><span class="badge badge-soft badge-soft-success">{{ demandes|filter(d => 'livr' in d.statut|lower)|length }}</span></td>
                                        <td class="text-center">—</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-semibold"><i class="fas fa-file-signature text-success me-2"></i>Bons de sortie</td>
                                        <td class="text-center fw-bold">{{ bons|length }}</td>
                                        <td class="text-center"><span class="badge badge-soft badge-soft-warning">{{ bons|filter(b => b.statut == 'Créé')|length }}</span></td>
                                        <td class="text-center"><span class="badge badge-soft badge-soft-success">{{ bons|filter(b => b.statut == 'Sortie effective' or b.statut == 'Validé Coordon')|length }}</span></td>
                                        <td class="text-center">—</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-semibold"><i class="fas fa-file-invoice-dollar text-warning me-2"></i>Devis</td>
                                        <td class="text-center fw-bold">{{ nbDevisTotal|default(0) }}</td>
                                        <td class="text-center"><span class="badge badge-soft badge-soft-warning">{{ nbDevisEnCours|default(0) }}</span></td>
                                        <td class="text-center"><span class="badge badge-soft badge-soft-success">{{ nbDevisDecaisses|default(0) }}</span></td>
                                        <td class="text-center"><span class="badge badge-soft badge-soft-danger">{{ nbDevisRejetes|default(0) }}</span></td>
                                    </tr>
                                    <tr>
                                        <td class="fw-semibold"><i class="fas fa-calendar-check text-info me-2"></i>Visites / RDV</td>
                                        <td class="text-center fw-bold">{{ nbVisitesTotal|default(0) }}</td>
                                        <td class="text-center"><span class="badge badge-soft badge-soft-warning">{{ visitesReservees|default([])|length }}</span></td>
                                        <td class="text-center"><span class="badge badge-soft badge-soft-success">{{ visitesTerminees|default([])|length }}</span></td>
                                        <td class="text-center">—</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                {# ============ ONGLET 1 : DEMANDES ============ #}
                <div class="tab-pane fade" id="pane-demandes" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark m-0"><i class="fas fa-boxes text-primary me-2"></i>Suivi des Demandes de Matériel</h5>
                            <small class="text-muted">Contrôle et validation des demandes de tous les services.</small>
                        </div>
                        <form method="get" class="d-flex align-items-center gap-2">
                            <div class="d-flex align-items-center gap-1">
                                <span class="small fw-bold text-muted text-nowrap">Du :</span>
                                <input type="date" name="date_debut" class="form-control form-control-sm"
                                       value="{{ date_debut|default('') }}" style="width: 140px;">
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <span class="small fw-bold text-muted text-nowrap">Au :</span>
                                <input type="date" name="date_fin" class="form-control form-control-sm"
                                       value="{{ date_fin|default('') }}" style="width: 140px;">
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm px-3 rounded-3" title="Filtrer">
                                <i class="fas fa-search"></i>
                            </button>
                            <a href="{{ path('app_admin_dashboard') }}" class="btn btn-secondary btn-sm px-3 rounded-3" title="Réinitialiser">
                                <i class="fas fa-undo"></i>
                            </a>
                        </form>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-modern table-hover">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Département</th>
                                    <th>Localisation</th>
                                    <th>Matériel</th>
                                    <th class="text-center">Quantité</th>
                                    <th>État</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for d in demandes %}
                                    <tr>
                                        <td class="fw-bold text-secondary">#{{ d.id }}</td>
                                        <td><span class="badge badge-soft badge-soft-secondary">{{ d.departement }}</span></td>
                                        <td>
                                            {% if d.localisation == 'sedwe' %}
                                                <span class="badge badge-soft badge-soft-primary"><i class="fas fa-map-marker-alt me-1"></i>SEDWE</span>
                                            {% elseif d.localisation == 'bonagere' %}
                                                <span class="badge badge-soft badge-soft-info"><i class="fas fa-map-marker-alt me-1"></i>BONAGÈRE</span>
                                            {% else %}
                                                <span class="badge badge-soft badge-soft-secondary"><i class="fas fa-building me-1"></i>DIRECTION</span>
                                            {% endif %}
                                        </td>
                                        <td class="fw-semibold text-dark">{{ d.materiel }}</td>
                                        <td class="text-center"><span class="badge badge-soft badge-soft-secondary">{{ d.quantite }}</span></td>
                                        <td>
                                            {% if d.statut == 'En attente' %}
                                                <span class="badge badge-soft badge-soft-warning"><i class="fas fa-clock me-1"></i>{{ d.statut }}</span>
                                            {% elseif 'Livré' in d.statut %}
                                                <span class="badge badge-soft badge-soft-info"><i class="fas fa-truck me-1"></i>{{ d.statut }}</span>
                                            {% else %}
                                                <span class="badge badge-soft badge-soft-success"><i class="fas fa-check-circle me-1"></i>{{ d.statut }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button class="btn btn-light border text-primary" title="Voir les détails"><i class="fas fa-eye"></i></button>
                                                <button class="btn btn-light border text-success" title="Valider"><i class="fas fa-check"></i></button>
                                                <button class="btn btn-light border text-danger" title="Refuser"><i class="fas fa-times"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="7">
                                            <div class="empty-state">
                                                <i class="fas fa-folder-open"></i>
                                                <div class="fw-bold">Aucune demande enregistrée</div>
                                                <small>Aucune demande de matériel n'est en cours.</small>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {# ============ ONGLET 2 : BONS DE SORTIE ============ #}
                <div class="tab-pane fade" id="pane-bons" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold text-dark m-0"><i class="fas fa-id-badge text-success me-2"></i>Registre des Bons de Sortie</h5>
                            <small class="text-muted">Contrôle des sorties effectives à la guérite.</small>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-modern table-hover">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Nom de l'Agent</th>
                                    <th>Département</th>
                                    <th>Référence</th>
                                    <th>État Sécurité</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for b in bons %}
                                    <tr>
                                        <td class="fw-bold text-secondary">#{{ b.id }}</td>
                                        <td class="fw-semibold text-dark">{{ b.nomEmploye }}</td>
                                        <td><span class="badge badge-soft badge-soft-secondary">{{ b.departement }}</span></td>
                                        <td class="text-muted small">Bon d'autorisation n°{{ b.id }}</td>
                                        <td>
                                            {% if b.statut == 'Créé' %}
                                                <span class="badge badge-soft badge-soft-warning"><i class="fas fa-clock me-1"></i>{{ b.statut }}</span>
                                            {% elseif b.statut == 'Validé Coordon' %}
                                                <span class="badge badge-soft badge-soft-primary"><i class="fas fa-pen-nib me-1"></i>{{ b.statut }}</span>
                                            {% else %}
                                                <span class="badge badge-soft badge-soft-success"><i class="fas fa-check-circle me-1"></i>{{ b.statut }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button class="btn btn-light border text-primary" title="Imprimer"><i class="fas fa-print"></i></button>
                                                <button class="btn btn-light border text-success" title="Autoriser"><i class="fas fa-shield-alt"></i></button>
                                                <button class="btn btn-light border text-danger" title="Bloquer"><i class="fas fa-ban"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="6">
                                            <div class="empty-state">
                                                <i class="fas fa-users-slash"></i>
                                                <div class="fw-bold">Aucun bon en circulation</div>
                                                <small>Aucun bon de sortie n'est actuellement en circulation.</small>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {# ═══════════════════════════════════════════════
                   ONGLET 3 : VISITES & RDV
                ═══════════════════════════════════════════════ #}
                <div class="tab-pane fade" id="pane-visites" role="tabpanel">

                    <h5 class="fw-bold text-dark mb-4">
                        <i class="fas fa-calendar-check text-info me-2"></i>Visites & Rendez-vous
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="stat-card stat-primary">
                                <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size:0.68rem;">Total</h6>
                                <h3 class="fw-bold m-0 text-primary">{{ nbVisitesTotal|default(0) }}</h3>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-card stat-warning">
                                <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size:0.68rem;">Réservées</h6>
                                <h3 class="fw-bold m-0 text-warning">{{ visitesReservees|default([])|length }}</h3>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-card stat-success">
                                <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size:0.68rem;">Terminées</h6>
                                <h3 class="fw-bold m-0 text-success">{{ visitesTerminees|default([])|length }}</h3>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-card stat-purple">
                                <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size:0.68rem;">Aujourd'hui</h6>
                                <h3 class="fw-bold m-0 text-purple">{{ nbVisitesJour|default(0) }}</h3>
                            </div>
                        </div>
                    </div>

                    <div class="form-card">
                        <div class="form-card-header">
                            <div class="form-card-icon form-card-icon-blue"><i class="fas fa-list"></i></div>
                            <h5 class="fw-bold m-0 text-dark">Toutes les visites</h5>
                            <span class="badge badge-soft badge-soft-primary ms-auto">{{ nbVisitesTotal|default(0) }} enregistrement(s)</span>
                        </div>
                        <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                            <table class="table table-modern table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Visiteur</th>
                                        <th>Motif</th>
                                        <th>Délégation</th>
                                        <th>Statut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for v in toutesVisites|default([]) %}
                                        <tr>
                                            <td class="small">{{ v.dateArrivee ? v.dateArrivee|date('d/m/Y H:i') : '—' }}</td>
                                            <td class="fw-semibold text-dark">{{ v.nomVisiteur }}</td>
                                            <td class="text-muted small">{{ v.motif ?? '—' }}</td>
                                            <td>
                                                {% if v.responsableDelegue %}
                                                    <span class="badge badge-soft badge-soft-info">
                                                        <i class="fas fa-share me-1"></i>{{ v.responsableDelegue.userIdentifier|split('@')|first }}
                                                    </span>
                                                {% else %}
                                                    <span class="text-muted small">—</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if v.statut == 'RESERVE' %}
                                                    <span class="badge badge-soft badge-soft-primary">Réservé</span>
                                                {% elseif v.statut == 'A_L_ACCUEIL' %}
                                                    <span class="badge badge-soft badge-soft-warning">À l'accueil</span>
                                                {% elseif v.statut == 'TERMINE' %}
                                                    <span class="badge badge-soft badge-soft-success">Terminé</span>
                                                {% elseif v.statut == 'DELEGUE' %}
                                                    <span class="badge badge-soft badge-soft-info">Délégué</span>
                                                {% else %}
                                                    <span class="badge badge-soft badge-soft-secondary">{{ v.statut }}</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr><td colspan="5" class="text-center text-muted py-4">Aucune visite enregistrée.</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                {# ═══════════════════════════════════════════════
                   ONGLET 4 : DEVIS & FINANCES
                ═══════════════════════════════════════════════ #}
                <div class="tab-pane fade" id="pane-devis-admin" role="tabpanel">

                    <h5 class="fw-bold text-dark mb-4">
                        <i class="fas fa-file-invoice-dollar text-warning me-2"></i>Devis & Finances
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="stat-card stat-primary">
                                <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size:0.68rem;">Total devis</h6>
                                <h3 class="fw-bold m-0 text-primary">{{ nbDevisTotal|default(0) }}</h3>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-card stat-warning">
                                <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size:0.68rem;">En cours</h6>
                                <h3 class="fw-bold m-0 text-warning">{{ nbDevisEnCours|default(0) }}</h3>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-card stat-success">
                                <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size:0.68rem;">Décaissés</h6>
                                <h3 class="fw-bold m-0 text-success">{{ nbDevisDecaisses|default(0) }}</h3>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-card stat-warning">
                                <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size:0.68rem;">Rejetés</h6>
                                <h3 class="fw-bold m-0 text-danger">{{ nbDevisRejetes|default(0) }}</h3>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="stat-card stat-success">
                                <h6 class="text-muted text-uppercase fw-bold mb-2">Total décaissé USD</h6>
                                <h3 class="fw-bold m-0 text-success">{{ totalDevisUSD|default(0)|number_format(2, ',', ' ') }} $</h3>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="stat-card stat-primary">
                                <h6 class="text-muted text-uppercase fw-bold mb-2">Total décaissé CDF</h6>
                                <h3 class="fw-bold m-0 text-primary">{{ totalDevisCDF|default(0)|number_format(0, ',', ' ') }} FC</h3>
                            </div>
                        </div>
                    </div>

                    <div class="form-card">
                        <div class="form-card-header">
                            <div class="form-card-icon form-card-icon-blue"><i class="fas fa-list"></i></div>
                            <h5 class="fw-bold m-0 text-dark">Derniers devis</h5>
                        </div>
                        <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                            <table class="table table-modern table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Date</th>
                                        <th>Demandeur</th>
                                        <th>Montant</th>
                                        <th>Statut</th>
                                        <th>Décaissé par</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for d in tousDevis|default([]) %}
                                        <tr>
                                            <td class="fw-bold">#{{ d.id }}</td>
                                            <td class="small">{{ d.createdAt ? d.createdAt|date('d/m/Y') : '—' }}</td>
                                            <td class="small">{{ d.user ? d.user.userIdentifier : (d.createdBy|default('—')) }}</td>
                                            <td class="fw-bold text-dark">{{ d.montant|number_format(2, ',', ' ') }} {{ d.devise }}</td>
                                            <td>
                                                {% if d.statut == 'DECAISSE' %}
                                                    <span class="badge badge-soft badge-soft-success">Décaissé</span>
                                                {% elseif d.statut == 'REJETE' %}
                                                    <span class="badge badge-soft badge-soft-danger">Rejeté</span>
                                                {% else %}
                                                    <span class="badge badge-soft badge-soft-warning">{{ d.statut }}</span>
                                                {% endif %}
                                            </td>
                                            <td class="small text-muted">
                                                {{ d.decaissePar ? d.decaissePar.userIdentifier|split('@')|first : '—' }}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr><td colspan="6" class="text-center text-muted py-4">Aucun devis.</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                {# ═══════════════════════════════════════════════
                   ONGLET 5 : MOUVEMENTS DE CAISSE
                ═══════════════════════════════════════════════ #}
                <div class="tab-pane fade" id="pane-caisse-admin" role="tabpanel">

                    <h5 class="fw-bold text-dark mb-4">
                        <i class="fas fa-cash-register text-success me-2"></i>Mouvements de caisse
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="stat-card stat-success">
                                <h6 class="text-muted text-uppercase fw-bold mb-2">Solde USD actuel</h6>
                                <h3 class="fw-bold m-0 text-success">{{ soldeGlobalUSD|default(0)|number_format(2, ',', ' ') }} $</h3>
                                <div class="small text-muted mt-2">
                                    ↑ Entrées : {{ totalEntreesUSD|default(0)|number_format(2, ',', ' ') }} $ • ↓ Sorties : {{ totalSortiesUSD|default(0)|number_format(2, ',', ' ') }} $
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="stat-card stat-primary">
                                <h6 class="text-muted text-uppercase fw-bold mb-2">Solde CDF actuel</h6>
                                <h3 class="fw-bold m-0 text-primary">{{ soldeGlobalCDF|default(0)|number_format(0, ',', ' ') }} FC</h3>
                                <div class="small text-muted mt-2">
                                    ↑ Entrées : {{ totalEntreesCDF|default(0)|number_format(0, ',', ' ') }} FC • ↓ Sorties : {{ totalSortiesCDF|default(0)|number_format(0, ',', ' ') }} FC
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-card">
                        <div class="form-card-header">
                            <div class="form-card-icon form-card-icon-blue"><i class="fas fa-list"></i></div>
                            <h5 class="fw-bold m-0 text-dark">Historique des mouvements</h5>
                        </div>
                        <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
                            <table class="table table-modern table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th>Montant</th>
                                        <th>Provenance</th>
                                        <th>Effectué par</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for m in mouvementsCaisse|default([]) %}
                                        <tr>
                                            <td class="small">{{ m.dateMouvement ? m.dateMouvement|date('d/m/Y H:i') : '—' }}</td>
                                            <td>
                                                {% if m.type == 'ENTREE' %}
                                                    <span class="badge badge-soft badge-soft-success"><i class="fas fa-arrow-down me-1"></i>Entrée</span>
                                                {% else %}
                                                    <span class="badge badge-soft badge-soft-danger"><i class="fas fa-arrow-up me-1"></i>Sortie</span>
                                                {% endif %}
                                            </td>
                                            <td class="fw-bold">{{ m.montant|number_format(2, ',', ' ') }} {{ m.devise }}</td>
                                            <td class="small text-muted">{{ m.provenance }}</td>
                                            <td class="small">{{ m.effectuePar ? m.effectuePar.userIdentifier|split('@')|first : '—' }}</td>
                                        </tr>
                                    {% else %}
                                        <tr><td colspan="5" class="text-center text-muted py-4">Aucun mouvement.</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                {# ============ ONGLET 6 : COMPTES AGENTS ============ #}
                <div class="tab-pane fade" id="pane-agents" role="tabpanel">
                    <div class="row g-4">
                        <div class="col-lg-5">
                            <div class="form-card">
                                <div class="form-card-header">
                                    <div class="form-card-icon form-card-icon-purple">
                                        <i class="fas fa-user-plus"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold m-0 text-dark">Créer un Compte Agent</h5>
                                        <small class="text-muted">Ajouter un nouveau membre à l'équipe.</small>
                                    </div>
                                </div>

                                {{ form_start(form) }}

                                    {% if form.vars.errors|length > 0 %}
                                        <div class="alert alert-danger rounded-3 mb-3" style="font-size:0.85rem;">
                                            <i class="fas fa-exclamation-triangle me-2"></i>
                                            <strong>Formulaire invalide :</strong>
                                            <ul class="mb-0 mt-2" style="padding-left:1rem;">
                                                {% for error in form.vars.errors %}
                                                    <li>{{ error.message }}</li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                    {% endif %}

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-secondary">
                                            Adresse Email de connexion <span class="text-danger">*</span>
                                        </label>
                                        {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'agent.nom@imprimerie.com'}}) }}
                                        {{ form_errors(form.email) }}
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-secondary">
                                            Département d'affectation / Rôle <span class="text-danger">*</span>
                                        </label>
                                        {{ form_widget(form.roles, {'attr': {'class': 'form-select'}}) }}
                                        {{ form_errors(form.roles) }}
                                        <small class="text-muted" style="font-size: 11px;">Utilisez l'onglet Nominations pour promouvoir un agent.</small>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-secondary">Localisation géographique</label>
                                        {{ form_widget(form.localisation, {'attr': {'class': 'form-select'}}) }}
                                        {{ form_errors(form.localisation) }}
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-secondary">
                                            Mot de passe provisoire <span class="text-danger">*</span>
                                        </label>
                                        {{ form_widget(form.password, {
                                            'attr': {
                                                'class': 'form-control',
                                                'placeholder': 'Saisissez le mot de passe à communiquer'
                                            }
                                        }) }}
                                        {{ form_errors(form.password) }}
                                        <small class="text-muted d-block mt-1" style="font-size: 11px;">
                                            <i class="fas fa-info-circle text-primary me-1"></i>
                                            Ce mot de passe sera haché en base. Notez-le puis transmettez-le à l'agent.
                                        </small>
                                    </div>

                                    <button type="submit" class="btn btn-modern w-100 text-white" style="background: var(--gradient-purple);">
                                        <i class="fas fa-user-check me-2"></i>Créer le Compte
                                    </button>
                                {{ form_end(form) }}
                            </div>
                        </div>

                        <div class="col-lg-7">
                            <div class="form-card p-0">
                                <div class="form-card-header px-4 pt-4 mb-0">
                                    <div class="form-card-icon form-card-icon-blue">
                                        <i class="fas fa-users-cog"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h5 class="fw-bold m-0 text-dark">Registre & Contrôle des Comptes</h5>
                                        <small class="text-muted">{{ users|length }} agent(s) enregistré(s)</small>
                                    </div>
                                </div>

                                <div style="max-height: 620px; overflow-y: auto;">
                                    {% for u in users %}
                                        <div class="user-item">
                                            <div style="flex: 1; min-width: 0;">
                                                <div class="fw-bold text-dark text-truncate" title="{{ u.email }}">
                                                    <i class="fas fa-user-circle text-muted me-2"></i>{{ u.email }}
                                                </div>

                                                <div class="d-flex flex-wrap gap-1 mt-2">
                                                    {% if u.isPDG %}
                                                        <span class="badge badge-soft badge-soft-gold"><i class="fas fa-crown me-1"></i>PDG</span>
                                                    {% endif %}
                                                    {% if 'ROLE_ADMIN' in u.roles %}
                                                        <span class="badge badge-soft badge-soft-danger"><i class="fas fa-user-shield me-1"></i>ADMIN</span>
                                                    {% endif %}
                                                    {% if 'ROLE_CHEF_COMPTA' in u.roles %}
                                                        <span class="badge badge-soft badge-soft-warning"><i class="fas fa-star me-1"></i>CHEF COMPTABLE</span>
                                                    {% elseif 'ROLE_COMPTA' in u.roles %}
                                                        <span class="badge badge-soft badge-soft-success">COMPTABLE</span>
                                                    {% endif %}
                                                    {% if 'ROLE_CAISSIER' in u.roles %}
                                                        <span class="badge badge-soft badge-soft-info"><i class="fas fa-cash-register me-1"></i>CAISSIER</span>
                                                    {% endif %}
                                                    {% if 'ROLE_RECEPTION' in u.roles or 'ROLE_ACCUEIL' in u.roles %}
                                                        <span class="badge badge-soft badge-soft-warning"><i class="fas fa-bell me-1"></i>RÉCEPTION</span>
                                                    {% elseif 'ROLE_GUERITE' in u.roles %}
                                                        <span class="badge badge-soft badge-soft-info"><i class="fas fa-shield-alt me-1"></i>GUÉRITE</span>
                                                    {% endif %}
                                                    {% if 'ROLE_STOCK' in u.roles %}
                                                        <span class="badge badge-soft badge-soft-primary"><i class="fas fa-boxes me-1"></i>STOCK</span>
                                                    {% endif %}
                                                    {% if 'ROLE_COORDON' in u.roles %}
                                                        <span class="badge badge-soft badge-soft-purple"><i class="fas fa-sitemap me-1"></i>COORDON</span>
                                                    {% endif %}
                                                    {% if 'ROLE_DG' in u.roles %}
                                                        <span class="badge badge-soft badge-soft-gold"><i class="fas fa-crown me-1"></i>DG</span>
                                                    {% endif %}

                                                    {% if not u.isPDG and 'ROLE_ADMIN' not in u.roles and 'ROLE_CHEF_COMPTA' not in u.roles and 'ROLE_COMPTA' not in u.roles and 'ROLE_RECEPTION' not in u.roles and 'ROLE_ACCUEIL' not in u.roles and 'ROLE_GUERITE' not in u.roles and 'ROLE_CAISSIER' not in u.roles and 'ROLE_STOCK' not in u.roles and 'ROLE_COORDON' not in u.roles and 'ROLE_DG' not in u.roles %}
                                                        <span class="badge badge-soft badge-soft-secondary font-monospace">{{ u.roles[0]|default('ROLE_USER') }}</span>
                                                    {% endif %}
                                                </div>

                                                <div class="mt-2 d-flex gap-2 flex-wrap">
                                                    {% if u.localisation is defined and u.localisation %}
                                                        <span class="badge badge-soft badge-soft-primary"><i class="fas fa-map-marker-alt me-1"></i>{{ u.localisation|upper }}</span>
                                                    {% else %}
                                                        <span class="badge badge-soft badge-soft-secondary"><i class="fas fa-building me-1"></i>DIRECTION</span>
                                                    {% endif %}
                                                    {% if u.isActif is defined and not u.isActif %}
                                                        <span class="badge badge-soft badge-soft-danger"><i class="fas fa-ban me-1"></i>Inactif</span>
                                                    {% else %}
                                                        <span class="badge badge-soft badge-soft-success"><i class="fas fa-circle me-1" style="font-size: 0.5rem;"></i>Actif</span>
                                                    {% endif %}
                                                </div>
                                            </div>

                                            <div class="d-flex gap-1 flex-shrink-0">
                                                {% if u.isPDG %}
                                                    <form action="{{ path('app_admin_destituer_pdg', {'id': u.id}) }}" method="POST" class="d-inline"
                                                          onsubmit="return confirm('Retirer le statut PDG à {{ u.email }} ?');">
                                                        <button type="submit" class="btn btn-light border btn-sm text-danger" title="Destituer PDG">
                                                            <i class="fas fa-crown"></i>
                                                        </button>
                                                    </form>
                                                {% endif %}
                                                {% if 'ROLE_CHEF_COMPTA' in u.roles %}
                                                    <form action="{{ path('app_admin_destituer_chef_compta', {'id': u.id}) }}" method="POST" class="d-inline"
                                                          onsubmit="return confirm('Retirer les privilèges de Chef Comptable ?');">
                                                        <button type="submit" class="btn btn-light border btn-sm text-danger" title="Destituer Chef Compta">
                                                            <i class="fas fa-user-slash"></i>
                                                        </button>
                                                    </form>
                                                {% endif %}
                                                <a href="{{ path('app_admin_user_edit', {'id': u.id}) }}" class="btn btn-light border btn-sm text-primary" title="Modifier">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form action="{{ path('app_admin_user_toggle', {'id': u.id}) }}" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-light border btn-sm {{ u.isActif|default(true) ? 'text-warning' : 'text-success' }}" title="{{ u.isActif|default(true) ? 'Désactiver' : 'Réactiver' }}">
                                                        <i class="fas {{ u.isActif|default(true) ? 'fa-toggle-on' : 'fa-toggle-off' }}"></i>
                                                    </button>
                                                </form>
                                                <form action="{{ path('app_admin_user_delete', {'id': u.id}) }}" method="POST" class="d-inline"
                                                      onsubmit="return confirm('⚠️ Supprimer définitivement {{ u.email }} ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ u.id) }}">
                                                    <button type="submit" class="btn btn-light border btn-sm text-danger" title="Supprimer">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# ============ ONGLET 7 : NOMINATIONS ============ #}
                <div class="tab-pane fade" id="pane-nominations" role="tabpanel">
                    <div class="row g-4">

                        {# ──────── Nommer un Caissier ──────── #}
                        <div class="col-lg-6">
                            <div class="form-card">
                                <div class="form-card-header">
                                    <div class="form-card-icon form-card-icon-blue">
                                        <i class="fas fa-cash-register"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold m-0 text-dark">Nommer un Caissier</h5>
                                        <small class="text-muted">Attribuer le rôle de gestion de caisse.</small>
                                    </div>
                                </div>
                                <form method="POST" action="{{ path('app_admin_assigner_caissier') }}">
                                    <label class="form-label small fw-bold text-secondary">Sélectionner un agent</label>
                                    <div class="input-group">
                                        <select name="user_id" class="form-select" required>
                                            <option value="" disabled selected>Choisir un agent...</option>
                                            {% for u in users %}
                                                {% if 'ROLE_CAISSIER' not in u.roles and 'ROLE_ADMIN' not in u.roles %}
                                                    <option value="{{ u.id }}">{{ u.email }}</option>
                                                {% endif %}
                                            {% endfor %}
                                        </select>
                                        <button type="submit" class="btn btn-modern btn-info text-white">
                                            <i class="fas fa-check me-1"></i> Nommer
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        {# ──────── Nommer un Chef Comptable ──────── #}
                        <div class="col-lg-6">
                            <div class="form-card">
                                <div class="form-card-header">
                                    <div class="form-card-icon form-card-icon-yellow">
                                        <i class="fas fa-user-shield"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold m-0 text-dark">Nommer un Chef Comptable</h5>
                                        <small class="text-muted">Promouvoir un agent au poste de responsable compta.</small>
                                    </div>
                                </div>
                                <form method="POST" action="{{ path('app_admin_assigner_chef_compta') }}">
                                    <label class="form-label small fw-bold text-secondary">Sélectionner un agent</label>
                                    <div class="input-group">
                                        <select name="user_id" class="form-select" required>
                                            <option value="" disabled selected>Choisir un agent...</option>
                                            {% for u in listeComptables|default(users) %}
                                                {% if 'ROLE_CHEF_COMPTA' not in u.roles and 'ROLE_ADMIN' not in u.roles %}
                                                    <option value="{{ u.id }}">{{ u.email }}</option>
                                                {% endif %}
                                            {% endfor %}
                                        </select>
                                        <button type="submit" class="btn btn-modern btn-warning text-dark">
                                            <i class="fas fa-star me-1"></i> Promouvoir
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        {# ──────── Nommer le PDG ──────── #}
                        <div class="col-lg-6">
                            <div class="form-card">
                                <div class="form-card-header">
                                    <div class="form-card-icon form-card-icon-gold">
                                        <i class="fas fa-crown"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold m-0 text-dark">Nommer le PDG</h5>
                                        <small class="text-muted">Une seule personne peut être PDG à la fois.</small>
                                    </div>
                                </div>

                                <form method="POST" action="{{ path('app_admin_assigner_pdg') }}">
                                    <label class="form-label small fw-bold text-secondary">Sélectionner l'utilisateur</label>
                                    <div class="input-group">
                                        <select name="user_id" class="form-select" required>
                                            <option value="" disabled selected>Choisir un utilisateur...</option>
                                            {% for u in users %}
                                                {% if not u.isPDG and 'ROLE_ADMIN' not in u.roles %}
                                                    <option value="{{ u.id }}">
                                                        {{ u.email }}
                                                        {% if 'ROLE_DG' in u.roles %} — (a déjà ROLE_DG){% endif %}
                                                    </option>
                                                {% endif %}
                                            {% endfor %}
                                        </select>
                                        <button type="submit" class="btn btn-modern btn-warning text-dark">
                                            <i class="fas fa-crown me-1"></i> Nommer
                                        </button>
                                    </div>
                                </form>

                                {% set pdgActuel = null %}
                                {% for u in users %}
                                    {% if u.isPDG %}{% set pdgActuel = u %}{% endif %}
                                {% endfor %}

                                {% if pdgActuel %}
                                    <div class="alert alert-warning rounded-3 mt-3 mb-0 d-flex justify-content-between align-items-center">
                                        <div>
                                            <i class="fas fa-crown me-2"></i>
                                            <strong>PDG actuel :</strong> {{ pdgActuel.email }}
                                        </div>
                                        <form method="POST" action="{{ path('app_admin_destituer_pdg', {'id': pdgActuel.id}) }}"
                                              onsubmit="return confirm('Retirer le statut PDG à {{ pdgActuel.email }} ?');"
                                              class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-user-slash me-1"></i> Destituer
                                            </button>
                                        </form>
                                    </div>
                                {% else %}
                                    <div class="alert alert-light rounded-3 mt-3 mb-0 text-muted small">
                                        <i class="fas fa-info-circle me-1"></i> Aucun PDG nommé actuellement.
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {# ──────── Créer un Nouveau Service ──────── #}
                        <div class="col-lg-6">
                            <div class="form-card">
                                <div class="form-card-header">
                                    <div class="form-card-icon form-card-icon-green">
                                        <i class="fas fa-building"></i>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold m-0 text-dark">Créer un Nouveau Service</h5>
                                        <small class="text-muted">Ajouter un département à l'organisation.</small>
                                    </div>
                                </div>
                                {{ form_start(formService) }}
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold text-secondary">Nom du Service</label>
                                        {{ form_widget(formService.nom, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Comptabilité, Logistique...'}}) }}
                                    </div>
                                    <button type="submit" class="btn btn-modern btn-primary w-100">
                                        <i class="fas fa-plus-circle me-2"></i>Enregistrer le Service
                                    </button>
                                {{ form_end(formService) }}
                            </div>
                        </div>

                        {# ──────── Rôles disponibles ──────── #}
                        <div class="col-lg-6">
                            <div class="form-card h-100">
                                <div class="form-card-header">

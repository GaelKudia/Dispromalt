<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Modifier Utilisateur - Administration</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>
<body class="bg-light">
    <div class="container py-5" style="max-width: 600px;">
        <div class="card border-0 shadow-sm mt-5">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="m-0 fw-bold"><i class="fas fa-user-edit me-2 text-primary"></i>Modifier l'utilisateur</h5>
            </div>
            <div class="card-body p-4">
                <form method="POST">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Adresse Email :</label>
                        <input type="email" name="email" class="form-control" value="{{ user.email }}" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Rôle Assigné :</label>
                        <select name="role" class="form-select">
                            <option value="ROLE_USER" {% if user.roles[0] == 'ROLE_USER' %}selected{% endif %}>Opérationnel (ROLE_USER)</option>
                            <option value="ROLE_STOCK" {% if user.roles[0] == 'ROLE_STOCK' %}selected{% endif %}>Magasinier (ROLE_STOCK)</option>
                            <option value="ROLE_COORDON" {% if user.roles[0] == 'ROLE_COORDON' %}selected{% endif %}>Coordonnateur (ROLE_COORDON)</option>
                            <option value="ROLE_COMPTA" {% if user.roles[0] == 'ROLE_COMPTA' %}selected{% endif %}>Comptabilité (ROLE_COMPTA)</option>
                            <option value="ROLE_GUERITE" {% if user.roles[0] == 'ROLE_GUERITE' %}selected{% endif %}>Agent Guérite (ROLE_GUERITE)</option>
                            <option value="ROLE_DG" {% if user.roles[0] == 'ROLE_DG' %}selected{% endif %}>Directeur Général (ROLE_DG)</option>
                            <option value="ROLE_ADMIN" {% if user.roles[0] == 'ROLE_ADMIN' %}selected{% endif %}>Administrateur (ROLE_ADMIN)</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-secondary">Changer le mot de passe :</label>
                        <input type="password" name="password" class="form-control" placeholder="Laisser vide si inchangé">
                        <div class="form-text text-muted">Saisir un mot de passe uniquement si l'employé demande une réinitialisation.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary fw-bold flex-grow-1">Sauvegarder les modifications</button>
                        <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-secondary fw-bold">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Modifier Utilisateur - Administration</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        .form-switch .form-check-input { width: 48px; height: 26px; cursor: pointer; }
        .form-switch .form-check-input:checked { background-color: #0d6efd; border-color: #0d6efd; }
        .form-switch .form-check-input:focus { border-color: #86b7fe; box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25); }
    </style>
</head>
<body class="bg-light">
    <div class="container py-5" style="max-width: 600px;">
        
        <!-- Bouton Retour en haut -->
        <div class="mb-3 d-flex justify-content-between align-items-center">
            <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-secondary btn-sm fw-bold">
                <i class="fas fa-arrow-left me-1"></i> Menu Principal
            </a>
            <span class="text-muted small"><i class="fas fa-lock me-1"></i> Espace Administrateur</span>
        </div>

        {# ✅ BLOC DE MESSAGES (Succès / Erreurs) #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'danger' ? 'danger' : 'success' }} alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas {{ label == 'danger' ? 'fa-exclamation-triangle' : 'fa-check-circle' }} me-2"></i> 
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="m-0 fw-bold">
                    <i class="fas fa-user-edit me-2 text-primary"></i>Modifier l'utilisateur
                </h5>
                {% if user.isChefService %}
                    <span class="badge bg-warning text-dark fw-bold">
                        <i class="fas fa-crown me-1"></i>CHEF DE SERVICE
                    </span>
                {% endif %}
            </div>

            <div class="card-body p-4">
                {# ✅ DÉBUT DU FORMULAIRE SYMFONY #}
                {{ form_start(form) }}

                    {# ==========================================
                       EMAIL
                    ========================================== #}
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Adresse Email :</label>
                        {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.email) }}
                    </div>

                    {# ==========================================
                       RÔLE
                    ========================================== #}
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Rôle Assigné :</label>
                        {{ form_widget(form.roles, {'attr': {'class': 'form-select', 'id': 'roleSelect'}}) }}
                        {{ form_errors(form.roles) }}
                    </div>

                    {# ==========================================
                       SERVICE DE RATTACHEMENT
                    ========================================== #}
                    <div class="mb-3" id="serviceBlock">
                        <label class="form-label small fw-bold text-secondary">Service de rattachement :</label>
                        {{ form_widget(form.service, {'attr': {'class': 'form-select', 'id': 'serviceSelect'}}) }}
                        {{ form_errors(form.service) }}
                        <div class="form-text text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Obligatoire pour un agent opérationnel et pour être chef de service.
                        </div>
                    </div>

                    {# ==========================================
                       NOMINATION CHEF DE SERVICE
                    ========================================== #}
                    <div class="mb-3" id="chefBlock">
                        <label class="form-label small fw-bold text-secondary">
                            <i class="fas fa-user-tie text-warning me-1"></i>Nomination au poste de Chef de Service :
                        </label>
                        <div class="form-check form-switch bg-light border rounded p-3 ps-4">
                            {{ form_widget(form.isChefService, {'attr': {'class': 'form-check-input ms-0 me-2', 'id': 'isChefService'}}) }}
                            <label class="form-check-label small fw-bold text-dark" for="isChefService">
                                Nommer cet agent comme <strong>Chef de son service</strong>
                            </label>
                            <div class="form-text text-muted mt-1 mb-0" style="margin-left: 0;">
                                Le chef de service peut valider les demandes de matériel et les devis émis par son équipe.
                            </div>
                        </div>

                        {# Avertissement dynamique si chef coché sans service #}
                        <div class="alert alert-danger mt-2 mb-0 py-2 small d-none" id="chefWarning">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            <strong>Attention :</strong> Un chef de service doit obligatoirement être rattaché à un service.
                        </div>
                    </div>

                    {# ==========================================
                       MOT DE PASSE
                    ========================================== #}
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-secondary">Changer le mot de passe :</label>
                        {{ form_widget(form.password, {'attr': {'class': 'form-control', 'placeholder': 'Laisser vide si inchangé'}}) }}
                        {{ form_errors(form.password) }}
                        <div class="form-text text-muted">
                            Saisir un mot de passe uniquement si l'employé demande une réinitialisation.
                        </div>
                    </div>

                    {# ==========================================
                       BOUTONS
                    ========================================== #}
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary fw-bold flex-grow-1">
                            <i class="fas fa-save me-1"></i> Sauvegarder les modifications
                        </button>
                        <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-danger fw-bold">
                            Annuler
                        </a>
                    </div>
                {{ form_end(form) }}
                {# ✅ FIN DU FORMULAIRE SYMFONY #}
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const roleSelect    = document.getElementById('roleSelect');
            const serviceBlock  = document.getElementById('serviceBlock');
            const serviceSelect = document.getElementById('serviceSelect');
            const chefBlock     = document.getElementById('chefBlock');
            const chefCheckbox  = document.getElementById('isChefService');
            const chefWarning   = document.getElementById('chefWarning');

            // Si un des éléments n'existe pas (ex: champ manquant), on arrête le script
            if(!roleSelect || !chefCheckbox) return;

            function updateUI() {
                const role = roleSelect.value;
                // On garde le bloc visible si le rôle est standard
                // Adapte cette liste si tes rôles dans UserType sont différents
                const rolesAvecService = [
                    'ROLE_USER', 'ROLE_STOCK', 'ROLE_COORDON',
                    'ROLE_COMPTA', 'ROLE_RECEPTION', 'ROLE_GUERITE', 'ROLE_CAISSIER'
                ];
                const rolesChefPossible = ['ROLE_USER', 'ROLE_STOCK', 'ROLE_COORDON', 'ROLE_COMPTA'];

                serviceBlock.style.display = rolesAvecService.includes(role) ? 'block' : 'none';
                if (rolesChefPossible.includes(role)) {
                    chefBlock.style.display = 'block';
                } else {
                    chefBlock.style.display = 'none';
                    chefCheckbox.checked = false;
                }
                verifierChef();
            }

            function verifierChef() {
                if (chefCheckbox.checked && (!serviceSelect.value || serviceSelect.value === '')) {
                    chefWarning.classList.remove('d-none');
                    serviceSelect.classList.add('is-invalid');
                } else {
                    chefWarning.classList.add('d-none');
                    serviceSelect.classList.remove('is-invalid');
                }
            }

            roleSelect.addEventListener('change', updateUI);
            chefCheckbox.addEventListener('change', verifierChef);
            serviceSelect.addEventListener('change', verifierChef);

            document.querySelector('form').addEventListener('submit', function(e) {
                if (chefCheckbox.checked && (!serviceSelect.value || serviceSelect.value === '')) {
                    e.preventDefault();
                    chefWarning.classList.remove('d-none');
                    serviceSelect.focus();
                    serviceSelect.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            });

            updateUI();
        });
    </script>
</body>
</html>
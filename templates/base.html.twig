<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Dispromalt{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <style>
        body { overflow-x: hidden; font-family: 'Source Sans Pro', sans-serif; background-color: #f4f6f9; }
        .login-page { background-color: #e3f2fd !important; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .sidebar { width: 250px; height: 100vh; position: fixed; top: 0; left: 0; background-color: #343a40; color: #c2c7d0; z-index: 1000; transition: all 0.3s ease-in-out; overflow-y: auto; }
        .sidebar .brand-link { padding: 15px; font-size: 1.25rem; background-color: #22252a; color: #fff; text-decoration: none; display: block; border-bottom: 1px solid #4b545c; }
        .sidebar .nav-link { color: #c2c7d0; padding: 10px 15px; display: block; text-decoration: none; font-size: 0.94rem; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background-color: rgba(255,255,255,0.1); color: #fff; border-left: 3px solid #0d6efd; }
        .sidebar .nav-section-title { color: #8a939c; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; padding: 14px 15px 6px; }
        .main-wrapper { margin-left: 250px; min-height: 100vh; transition: all 0.3s ease-in-out; }
        .top-navbar { background-color: #fff; border-bottom: 1px solid #dee2e6; padding: 10px 20px; }
        .content-body { padding: 20px; }
        .sidebar.collapsed { left: -250px; }
        .main-wrapper.expanded { margin-left: 0; }
    </style>

    {% block stylesheets %}{% endblock %}

    {# ═══════════════════════════════════════════════════════
       ✅ PWA — Helper du bundle SpomkyLabs/PwaBundle
       Injecte automatiquement :
       - <link rel="manifest">  (URL locale correcte)
       - <meta name="theme-color">
       - Favicons (32, 192, 512)
       - Apple touch icons
       - Enregistrement du Service Worker
    ═══════════════════════════════════════════════════════ #}
    {{ pwa() }}

    {# ✅ Composant Web universel pour la bannière d'installation
       Compatible Chrome, Edge, Firefox, Safari, Opera #}
    <script type="module" src="https://cdn.jsdelivr.net/npm/@khmyznikov/pwa-install@0.4.5/dist/index.min.js"></script>
</head>
<body class="{% if app.request.attributes.get('_route') == 'app_login' %}login-page{% endif %}">

    {% if app.request.attributes.get('_route') == 'app_login' %}
        {% block body %}{% endblock %}
    {% else %}
        <div class="sidebar">
            <a href="{{ path('app_dashboard') }}" class="brand-link text-center fw-bold">
                <i class="fas fa-print text-primary me-2"></i>Dispro<span class="text-primary">malt</span>
            </a>
            <div class="p-3">
                <nav class="nav flex-column">

                    {# ── Dashboard ── #}
                    <a class="nav-link {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %} mb-1 rounded"
                       href="{{ path('app_dashboard') }}">
                        <i class="fa-solid fa-gauge-high me-2"></i> Dashboard
                    </a>

                    {# ── Catégories ── #}
                    <a class="nav-link {% if app.request.attributes.get('_route') starts with 'app_category' %}active{% endif %} mb-1 rounded"
                       href="{{ path('app_category_index') }}">
                        <i class="fa-solid fa-layer-group me-2"></i> Catégories
                    </a>

                    {# ═══════════════════════════════════════════════════════
                       ESPACE CAISSE
                       → Uniquement pour le caissier nommé via /admin
                       → Plus ROLE_COMPTA : la comptabilité a son propre espace
                    ═══════════════════════════════════════════════════════ #}
                    {% if is_granted('ROLE_CAISSIER') or is_granted('ROLE_ADMIN') %}
                        <div class="nav-section-title">Espace Caisse</div>

                        <a class="nav-link {% if app.request.attributes.get('_route') == 'app_caisse_mouvements' %}active{% endif %} mb-1 rounded"
                           href="{{ path('app_caisse_mouvements') }}">
                            <i class="fa-solid fa-cash-register me-2"></i> Mes mouvements
                        </a>

                        <a class="nav-link {% if app.request.attributes.get('_route') == 'app_caisse_entree' %}active{% endif %} mb-1 rounded"
                           href="{{ path('app_caisse_entree') }}">
                            <i class="fa-solid fa-arrow-down me-2"></i> Enregistrer une entrée
                        </a>

                        <a class="nav-link {% if app.request.attributes.get('_route') == 'app_caisse_rdv_dg' %}active{% endif %} mb-1 rounded"
                           href="{{ path('app_caisse_rdv_dg') }}">
                            <i class="fa-solid fa-calendar-days me-2"></i> Planning RDV DG
                        </a>

                        <a class="nav-link {% if app.request.attributes.get('_route') == 'app_caisse_rdv_nouveau' %}active{% endif %} mb-1 rounded"
                           href="{{ path('app_caisse_rdv_nouveau') }}">
                            <i class="fa-solid fa-calendar-plus me-2"></i> Programmer Réunion
                        </a>
                    {% endif %}

                    {# ═══════════════════════════════════════════════════════
                       ESPACE COMPTABILITÉ
                       → Uniquement pour les comptables et chefs comptables
                       → Ils gardent leur tableau de bord /dashboard
                    ═══════════════════════════════════════════════════════ #}
                    {% if is_granted('ROLE_COMPTA') or is_granted('ROLE_CHEF_COMPTA') %}
                        <div class="nav-section-title">Comptabilité</div>

                        <a class="nav-link {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %} mb-1 rounded"
                           href="{{ path('app_dashboard') }}">
                            <i class="fa-solid fa-calculator me-2"></i> Tableau de bord compta
                        </a>

                        <a class="nav-link {% if app.request.attributes.get('_route') == 'app_historique_reappro' %}active{% endif %} mb-1 rounded"
                           href="{{ path('app_historique_reappro') }}">
                            <i class="fa-solid fa-clock-rotate-left me-2"></i> Historique réappro
                        </a>
                    {% endif %}

                    {# ── Rapports ── #}
                    <a class="nav-link {% if app.request.attributes.get('_route') == 'app_rapport' %}active{% endif %} mb-1 rounded"
                       href="{{ path('app_rapport') }}">
                        <i class="fa-solid fa-chart-line me-2"></i> Rapports
                    </a>

                </nav>
            </div>
        </div>

        <div class="main-wrapper">
            <div class="top-navbar d-flex justify-content-between align-items-center shadow-sm">
                <button class="btn btn-link text-dark" id="toggleSidebar"><i class="fa-solid fa-bars"></i></button>
                {% if app.user %}
                    <div class="d-flex align-items-center gap-3">
                        <span class="text-muted small">
                            <i class="fa-solid fa-user me-1"></i>{{ app.user.userIdentifier }}
                        </span>
                        <a href="{{ path('app_logout') }}" class="btn btn-primary btn-sm">Sign out</a>
                    </div>
                {% endif %}
            </div>

            <div class="content-body">
                {# ═══════════════════════════════════════════════════════
                   AFFICHAGE DES MESSAGES FLASH
                ═══════════════════════════════════════════════════════ #}
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                            {{ message|raw }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block main_content %}{% endblock %}
            </div>
        </div>
    {% endif %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const toggleBtn = document.getElementById('toggleSidebar');
        if (toggleBtn) {
            toggleBtn.addEventListener('click', function(e) {
                e.preventDefault();
                document.querySelector('.sidebar').classList.toggle('collapsed');
                document.querySelector('.main-wrapper').classList.toggle('expanded');
            });
        }
    </script>
    {% block javascripts %}{% endblock %}
</body>
</html>
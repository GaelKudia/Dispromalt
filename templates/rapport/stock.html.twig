{% extends 'base.html.twig' %}

{% block title %}Rapport de Stock - Dispromalt{% endblock %}

{% block main_content %}
<div class="container-fluid py-4">

    {# En-tête #}
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="fa-solid fa-chart-line text-primary me-2"></i>Rapport de Stock
            </h1>
            <p class="text-muted mb-0">Vue d'ensemble du stock par catégorie.</p>
        </div>
    </div>

    {# Cartes résumé #}
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size:0.7rem;">
                                Catégories
                            </h6>
                            <h3 class="fw-bold m-0 text-primary">{{ categories|length }}</h3>
                        </div>
                        <i class="fa-solid fa-layer-group fa-2x text-primary opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size:0.7rem;">
                                Articles total
                            </h6>
                            <h3 class="fw-bold m-0 text-success">
                                {% set total = 0 %}
                                {% for cat in categories %}
                                    {% set total = total + cat.subCategories|length %}
                                {% endfor %}
                                {{ total }}
                            </h3>
                        </div>
                        <i class="fa-solid fa-boxes fa-2x text-success opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase fw-bold mb-1" style="font-size:0.7rem;">
                                Date du rapport
                            </h6>
                            <h5 class="fw-bold m-0 text-dark">{{ "now"|date('d/m/Y H:i') }}</h5>
                        </div>
                        <i class="fa-solid fa-calendar fa-2x text-dark opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Tableau des catégories #}
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white rounded-top-4">
            <h5 class="mb-0 fw-semibold">
                <i class="fa-solid fa-list text-primary me-2"></i>Détail par catégorie
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:50px;">#</th>
                        <th>Catégorie</th>
                        <th class="text-center">Sous-catégories</th>
                        <th>Sous-catégories (liste)</th>
                    </tr>
                </thead>
                <tbody>
                {% for category in categories %}
                    <tr>
                        <td class="text-muted">{{ category.id }}</td>
                        <td class="fw-bold text-dark">
                            <i class="fa-solid fa-folder text-primary me-2"></i>{{ category.nom }}
                        </td>
                        <td class="text-center">
                            <span class="badge bg-primary">{{ category.subCategories|length }}</span>
                        </td>
                        <td>
                            {% if category.subCategories|length > 0 %}
                                {% for sub in category.subCategories %}
                                    <span class="badge bg-light text-dark border me-1 mb-1">
                                        {{ sub.nom }}
                                    </span>
                                {% endfor %}
                            {% else %}
                                <span class="text-muted small">— Aucune sous-catégorie —</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            <i class="fa-solid fa-inbox fa-2x d-block mb-2 opacity-50"></i>
                            Aucune catégorie enregistrée.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}